#!/usr/bin/env node
// laws-switch — the in-session half of the craft-compatibility switch.
//
// When the guard denies an incompatible craft load it leaves a pending decision behind. The agent
// (or the user) picks one of the four options and runs this. It does TWO things and deliberately
// no more: record the choice, then end the session by signalling it.
//
// It does NOT touch the transcript. A running Claude Code appends records as it works, so surgery
// against a live file races the writer; the launcher performs it after the process is gone.
// [LAW:no-ambient-temporal-coupling] the launcher owns the ordering, and this command's only job
// is to hand it a decision and get out of the way.
//
// usage: laws-switch <reject|tombstone|rewind_summarize|rewind_discard> [--summary <text>]

'use strict';
const fs = require('fs');
const path = require('path');
const cp = require('child_process');
const M = require(path.join(__dirname, '..', 'hooks', 'scripts', 'laws-excise.js'));

const CHOICES = Object.keys(M.SWITCH_ACTIONS);

function die(msg, code = 1) { process.stderr.write('laws-switch: ' + msg + '\n'); process.exit(code); }

const args = process.argv.slice(2);
// The choice is POSITIONAL AND FIRST, never searched for. Scanning for "the first token that is
// not a flag" would have to know which flags take values — `--summary "some text"` puts a bare
// word in argv that is not a choice — and a scanner that must track that is the same argv-parsing
// hazard claude-laws refuses to take on for claude's own flags, plus a new maintenance debt every
// time a flag is added. A fixed position cannot mistake a value for a positional.
const choice = args[0];
const sumAt = args.indexOf('--summary');
const summary = sumAt >= 0 ? args[sumAt + 1] : undefined;

if (!choice) die('usage: laws-switch <' + CHOICES.join('|') + '> [--summary <text>]', 2);
// A leading flag is its own error, never "unknown choice <flag>": the caller who wrote
// `--summary "some text" rewind_summarize` needs to hear that the ORDER is wrong, not that their
// summary is an unrecognised choice - which is the misdiagnosis the scan used to produce.
if (choice.startsWith('--')) die('the choice comes first: laws-switch <' + CHOICES.join('|') + '> [--summary <text>] — flags follow it, and a flag\'s value is never read as the choice.', 2);
if (!CHOICES.includes(choice)) die('unknown choice ' + JSON.stringify(choice) + '; expected one of ' + CHOICES.join(', '), 2);

// The launcher owns this directory; its absence means the session was not started via claude-laws,
// so there is no relaunch to hand the decision to. Say that plainly rather than writing a request
// nothing will ever read. [LAW:no-silent-failure]
const dir = process.env.LAWS_SWITCH_DIR;
if (!dir) die('LAWS_SWITCH_DIR is unset — this session was not launched by claude-laws, so a switch cannot be completed. Start the session with claude-laws to use the switch, or pick "reject" and stay in the current craft.');

const pendingPath = path.join(dir, 'pending.json');
if (!fs.existsSync(pendingPath)) die('no pending craft switch — the guard has not denied an incompatible load in this session.');
const pending = JSON.parse(fs.readFileSync(pendingPath, 'utf8'));

// `current` is the whole conflicting SET, comma-joined by the guard - a switch can retire more
// than one engaged craft, so this renders a list rather than assuming a single name.
const currentPretty = String(pending.current || '').split(',').filter(Boolean).map((c) => 'laws:' + c).join(', ');

// Reject changes nothing and needs no relaunch: the load was already denied, so the session is
// already in the state this option describes.
if (choice === 'reject') {
  fs.unlinkSync(pendingPath);
  process.stdout.write('Staying in ' + currentPretty + '. The laws:' + pending.incomingMedium + ' load was dropped; nothing else changed.\n');
  process.exit(0);
}

// The summary is the one place the excised craft can climb back into the conversation: it is
// composed while that craft is still fully loaded, and nothing can strip it from a running
// session's context first. This instruction is the only thing standing in the way, so it says so
// outright rather than assuming the point is obvious. [LAW:no-silent-failure]
if (choice === 'rewind_summarize' && !summary) {
  die('rewind_summarize needs --summary "<what you did since the craft loaded>". You are the only one who can write it: the summary is composed from your live context, and after the rewind that context is gone. Summarize YOUR WORK ONLY — what you did, decided, and left unfinished. Do NOT restate, paraphrase, or carry over any of the retiring craft\'s guidance, rules, or vocabulary: that guidance is being excised on purpose, and a summary that smuggles it back in defeats the switch you asked for.', 2);
}

fs.writeFileSync(path.join(dir, 'request.json'), JSON.stringify({
  sessionId: pending.sessionId,
  transcript: pending.transcript,
  incomingMedium: pending.incomingMedium,
  choice,
  summary,
}, null, 2) + '\n');
fs.unlinkSync(pendingPath);

// End the session so the launcher can apply the choice. An agent cannot end its own session from
// inside its tool loop, so the exit has to arrive from outside it. SIGTERM is that outside push:
// measured on 2.1.226 to exit Claude cleanly with the transcript intact and resumable, mid-turn
// included. After the session exits, bin/claude-laws rewrites the transcript (a live file cannot be
// edited under its writer) and relaunches with --resume. No inspector, no BUN_INSPECT: an ended
// session needs no open eval channel, so an inherited environment hands a nested process nothing.
//
// WHICH PROCESS TO SIGNAL. This command runs as a descendant of the very session it must end. The
// launcher exports its own pid as LAWS_LAUNCHER_PID, and the session is the launcher's direct child
// — the one node on this process's ancestry whose parent is the launcher. Resolving it by that
// relationship needs no match against the compiled binary's name (which drifts every release) and no
// pid the launcher had to capture while it held claude in the foreground. [LAW:one-source-of-truth]
// the launcher owns which pid is the session; this reads that relationship back rather than guessing.
//
// The recorded decision is already on disk before we get here, so every failure below still leaves
// the switch pending: exit the session by any means and the launcher applies it on relaunch.
// [LAW:no-silent-failure] each failure says so rather than reporting a completed switch.
const recorded = 'The switch is recorded; exit the session any way you like and it is applied on the relaunch.';
const launcherPid = Number(process.env.LAWS_LAUNCHER_PID);
if (!Number.isInteger(launcherPid) || launcherPid <= 1) {
  die('LAWS_LAUNCHER_PID names no launcher — this session was not started by claude-laws, so it cannot be ended from here. ' + recorded);
}

// [LAW:effects-at-boundaries] the `ps` read and the signal are the only effects, gathered here at
// the edge. `ppidOf` returns 0 for a pid that has no parent to read (gone, or unreadable), which
// the walk treats as the top of the chain.
function ppidOf(pid) {
  try {
    const out = cp.execFileSync('ps', ['-o', 'ppid=', '-p', String(pid)], { encoding: 'utf8' }).trim();
    return out ? Number(out) : 0;
  } catch (_e) { return 0; }
}

// Walk up from this process to the node whose parent IS the launcher. The bound is a guard against a
// cycle in a corrupted process table, never an expected depth. [LAW:no-silent-failure] a walk that
// reaches the top without finding the launcher returns 0 and the caller reports it.
function sessionPidUnder(launcher) {
  let cur = process.pid;
  for (let hop = 0; hop < 256; hop++) {
    const parent = ppidOf(cur);
    if (parent === launcher) return cur;
    if (parent <= 1) return 0;
    cur = parent;
  }
  return 0;
}

const target = sessionPidUnder(launcherPid);
if (!target) {
  die('could not find the claude session under launcher ' + launcherPid + ' on this process’s ancestry. ' + recorded);
}

// Say it BEFORE the signal: SIGTERM ends the session, which tears down this command’s own process
// tree, so a line printed afterwards may never flush.
process.stdout.write('Switching to laws:' + pending.incomingMedium + ' via ' + choice
  + '. Ending the session so the launcher can apply it; it resumes automatically.\n');
try {
  process.kill(target, 'SIGTERM');
} catch (err) {
  die('recorded the switch but could not signal the session (pid ' + target + ') to end: '
    + (err && err.message) + '. ' + recorded);
}
