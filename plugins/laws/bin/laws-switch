#!/usr/bin/env node
// laws-switch — the in-session half of the craft-compatibility switch.
//
// When the guard denies an incompatible craft load it leaves a pending decision behind. The agent
// (or the user) picks one of the four options and runs this. It does TWO things and deliberately
// no more: hand the choice to the hosted session over the switch channel, and release the
// engaged-craft locks that switch retired.
//
// It does NOT touch the transcript, and nothing on this path does. The switch is applied to the
// LIVE session's own state by the process that owns it, so the conversation keeps exactly one
// writer and there is no ordering to arrange between it and anyone else.
// [LAW:one-source-of-truth] the running session owns its conversation; this command owns nothing
// but the request.
//
// usage: laws-switch <reject|tombstone|rewind_summarize|rewind_discard> [--summary <text>]

'use strict';
const fs = require('fs');
const path = require('path');
const M = require(path.join(__dirname, '..', 'hooks', 'scripts', 'laws-excise.js'));
const { requestSwitch, PROVABLY_NOT_DELIVERED } = require(path.join(__dirname, '..', 'hooks', 'injector', 'switch-channel.js'));
const { spawnSync } = require('child_process');
// The router owns the engaged-craft lock's layout; this is the only sanctioned way to release one.
const ROUTER = path.join(__dirname, '..', 'hooks', 'scripts', 'skill-router.sh');

const CHOICES = Object.keys(M.SWITCH_ACTIONS);

function die(msg, code = 1) { process.stderr.write('laws-switch: ' + msg + '\n'); process.exit(code); }

const args = process.argv.slice(2);
// The choice is POSITIONAL AND FIRST, never searched for. Scanning for "the first token that is
// not a flag" would have to know which flags take values — `--summary "some text"` puts a bare
// word in argv that is not a choice — and a scanner that must track that is the same argv-parsing
// hazard claude-laws refuses to take on for claude's own flags, plus a new maintenance debt every
// time a flag is added. A fixed position cannot mistake a value for a positional.
const choice = args[0];
const sumAt = args.indexOf('--summary');
const summary = sumAt >= 0 ? args[sumAt + 1] : undefined;

if (!choice) die('usage: laws-switch <' + CHOICES.join('|') + '> [--summary <text>]', 2);
// A leading flag is its own error, never "unknown choice <flag>": the caller who wrote
// `--summary "some text" rewind_summarize` needs to hear that the ORDER is wrong, not that their
// summary is an unrecognised choice - which is the misdiagnosis the scan used to produce.
if (choice.startsWith('--')) die('the choice comes first: laws-switch <' + CHOICES.join('|') + '> [--summary <text>] — flags follow it, and a flag\'s value is never read as the choice.', 2);
if (!CHOICES.includes(choice)) die('unknown choice ' + JSON.stringify(choice) + '; expected one of ' + CHOICES.join(', '), 2);

// The launcher owns this directory, and the hosted session's channel lives inside it; its absence
// means this session has no host to enact anything. Say that plainly rather than proceeding toward
// a socket path that cannot exist. [LAW:no-silent-failure]
const dir = process.env.LAWS_SWITCH_DIR;
if (!dir) die('LAWS_SWITCH_DIR is unset — this session is not hosted by the laws launcher, so there is nothing that can enact a switch. Start the session through the launcher to use the switch, or pick "reject" and stay in the current craft.');

const pendingPath = path.join(dir, 'pending.json');
if (!fs.existsSync(pendingPath)) die('no pending craft switch — the guard has not denied an incompatible load in this session.');
const pending = JSON.parse(fs.readFileSync(pendingPath, 'utf8'));

// `current` is the whole conflicting SET, comma-joined by the guard - a switch can retire more
// than one engaged craft, so this renders a list rather than assuming a single name.
const currentPretty = String(pending.current || '').split(',').filter(Boolean).map((c) => 'laws:' + c).join(', ');

// Reject changes nothing and needs no session: the load was already denied, so the session is
// already in the state this option describes.
if (choice === 'reject') {
  fs.unlinkSync(pendingPath);
  process.stdout.write('Staying in ' + currentPretty + '. The laws:' + pending.incomingMedium + ' load was dropped; nothing else changed.\n');
  process.exit(0);
}

// The summary is the one place the excised craft can climb back into the conversation: it is
// composed while that craft is still fully loaded, and nothing can strip it from a running
// session's context first. This instruction is the only thing standing in the way, so it says so
// outright rather than assuming the point is obvious. [LAW:no-silent-failure]
if (choice === 'rewind_summarize' && !summary) {
  die('rewind_summarize needs --summary "<what you did since the craft loaded>". You are the only one who can write it: the summary is composed from your live context, and after the rewind that context is gone. Summarize YOUR WORK ONLY — what you did, decided, and left unfinished. Do NOT restate, paraphrase, or carry over any of the retiring craft\'s guidance, rules, or vocabulary: that guidance is being excised on purpose, and a summary that smuggles it back in defeats the switch you asked for.', 2);
}

// ONLY what the user decided goes on the wire. Which transcript, craft and session the switch
// concerns are the offer's to state, and the session reads them from the offer it wrote itself — so
// they are deliberately not sent, and a caller cannot substitute them. That is the whole security
// argument for this channel over an eval socket: the vocabulary is four names, not four names plus
// a target the caller chooses. See hooks/injector/switch-channel.js.
const liveRequest = { choice, summary };

// ONE way to enact a switch: ask the session that owns the conversation to change it. There is no
// second arm to fall back to and no preference to express — a request that reaches no session did
// not happen, and that is a failure to report, not a condition to route around.
(async () => {
  const live = await requestSwitch({ net: require('net'), dir, request: liveRequest });
  if (live.ok) {
    // The session consumed the offer when it applied the switch; it is not this process's to remove,
    // and unlinking a file that is already gone would throw here for no reason.
    // Releasing the engaged-craft markers is HALF the switch: the conversation no longer carries the
    // retired craft, but until its lock is released the guard still refuses the craft the user just
    // switched to — a switch that reports success and leaves the session unable to do the thing it
    // switched for. It happens here because here is the only place it can: the session never stops,
    // so there is no after-the-exit moment for anyone else to take it.
    //
    // Through the ROUTER, never by deleting a path composed here: the lock layout is the router's,
    // and a second spelling of it would be a second source for where a marker lives.
    // [LAW:one-source-of-truth]
    for (const craft of live.switchedFrom || []) {
      const retire = spawnSync(ROUTER, ['retire-craft'], {
        input: JSON.stringify({ session_id: pending.sessionId, craft }),
        encoding: 'utf8',
      });
      // Loud, and not fatal: the switch itself already happened and cannot be undone, so the useful
      // thing is to say which half did not complete rather than to imply neither did.
      // [LAW:no-silent-failure]
      if (retire.status !== 0) {
        // A spawn that never started leaves status null and stderr empty, so reading stderr alone
        // printed a warning with an empty parenthesis — loud in form and silent in content, which is
        // the failure this branch exists to prevent. [LAW:no-silent-failure]
        const why = (retire.stderr || '').trim() || (retire.error && retire.error.message) || 'no output';
        process.stderr.write('laws-switch: the switch was applied but laws:' + craft
          + ' could not be released (' + why + '); loading laws:'
          + pending.incomingMedium + ' may still be refused this session.\n');
      }
    }
    const retired = (live.switchedFrom || []).map((c) => 'laws:' + c).join(', ');
    process.stdout.write(
      'Switched to laws:' + live.switchedTo + ', live — this session was not restarted, and every file '
      + 'written since ' + retired + ' loaded is untouched on disk.\n'
      + (live.rewound ? 'The conversation was rewound in place.\n' : '')
      // Says only what `live.tombstoned` measured — a transcript fact. It used to say "Retired ... in
      // place", borrowing the vocabulary of the router's lock release, which a stdout-only reader
      // would take as confirmation of a release that may have just failed to stderr.
      + (live.tombstoned ? 'The conversation no longer loads ' + retired + '.\n' : ''),
    );
    process.exit(0);
  }
  // ONE question decides the wording, and EVERY failure is asked it alike — a session that refused,
  // one that went quiet, and one that was never there. The question is not "which arm is this" but
  // "could the switch already have run?", and it is answered from FACTS rather than from a table of
  // reason strings: the session says `mutated: false` when it refused before touching anything, and
  // the channel names the reasons that prove the request never arrived at all — an unhosted session
  // among them. Anything else — a throw mid-apply, an answer that would not encode, a peer that went
  // quiet — leaves it genuinely unknown, and unknown gets the warning. An omission can then only
  // make the message more cautious, never turn it into a false reassurance. [LAW:no-silent-failure]
  const untouched = live.mutated === false || PROVABLY_NOT_DELIVERED.includes(live.reason);
  const what = untouched
    ? 'Nothing was changed, and the pending decision is still there to retry.'
    : 'The switch may have run PART WAY. Your conversation may already have been rewound; check it before retrying.';
  // "was not applied", never "the session refused": a refusal is only one of the ways this ends, and
  // the reason string is what says which one. Naming the commonest arm in the fixed part of the
  // sentence would make the message wrong for every other arm — including the one where there was no
  // session to refuse anything. [LAW:no-silent-failure]
  die('the switch was not applied (' + live.reason + (live.detail ? ': ' + live.detail : '') + '). ' + what);
})();
