#!/usr/bin/env bash
# claude-laws — an opt-in launcher that makes the craft-compatibility switch enactable.
#
# Stock `claude` is untouched; you opt in by running this instead. It adds exactly two things:
#
#   1. BUN_INSPECT on an ephemeral loopback port, so the in-session `laws-switch` command can end
#      the session through Claude's own /exit. An agent cannot type a slash command into its own
#      session, so that exit has to arrive from outside its tool loop.
#   2. A relaunch loop. When a switch is chosen, the transcript surgery runs HERE — after Claude
#      has exited and nobody is appending to the file any more — and the session comes back with
#      `--resume`, reading the corrected transcript.
#
# Nothing here reads or patches Claude's bundle: no extraction, no minified anchors, no per-version
# cache. Both of the seams that would have required it were retired (see hooks/injector/SEAMS.md),
# so this launcher is version-robust by construction rather than by anchor-resolution machinery.
#
# [LAW:no-silent-failure] every setup step that can fail is checked, and a failure degrades to a
#   plain, working `claude` with a reason on stderr — never to a broken session and never silently.
# [LAW:dataflow-not-control-flow] the loop body is the same every pass; whether another pass
#   happens is a value (the request file) rather than a special case.

set -uo pipefail

log() { printf 'claude-laws: %s\n' "$1" >&2; }

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EXCISE="$PLUGIN_DIR/hooks/scripts/laws-excise.js"
ROUTER="$PLUGIN_DIR/hooks/scripts/skill-router.sh"

CLAUDE_BIN="${LAWS_CLAUDE_BIN:-$(command -v claude || true)}"
[ -n "$CLAUDE_BIN" ] || { log "no 'claude' on PATH; nothing to launch"; exit 127; }

# Any missing prerequisite means the switch cannot work — but the user asked for a Claude session,
# so give them a working one rather than an error. Degrade loudly, never silently.
if ! command -v node >/dev/null 2>&1; then
  log "node not found; launching plain claude (craft switching disabled)"
  exec "$CLAUDE_BIN" "$@"
fi
if [ ! -f "$EXCISE" ]; then
  log "gate not found at $EXCISE; launching plain claude (craft switching disabled)"
  exec "$CLAUDE_BIN" "$@"
fi

LAWS_SWITCH_DIR="$(mktemp -d "${TMPDIR:-/tmp}/laws-switch.XXXXXX")" || {
  log "could not create the switch directory; launching plain claude (craft switching disabled)"
  exec "$CLAUDE_BIN" "$@"
}
trap 'rm -rf "$LAWS_SWITCH_DIR"' EXIT

# HOLDING THE PORT UNTIL THE LAUNCH. A port that is picked and then released is a suggestion, not a
# reservation: between the release and bun's own bind, anything on the machine that asks the OS for
# an ephemeral port can take this one - a second claude-laws most of all, since two of them race
# through this same line. So the port is held by a LIVE listener and released immediately before
# claude starts, which narrows the window to bun's own bind instead of spanning the whole setup.
# It does not close it, and nothing here can: bun opens its own listener afterwards, and no process
# can hold a port on another process's behalf.
#
# WHAT LOSING THE RACE COSTS, measured against the real binary with the port already occupied:
# claude exits 1 with `error: Failed to start server. Is port <n> in use?` and opens no session at
# all. So the unhandled case is a launch that fails in the user's face, never a session that
# silently cannot switch. A retry is deliberately NOT built on top of that: recognising the failure
# means matching bun's internal error text, and reading claude's internals is the one thing this
# launcher refuses to do (see the header). Narrow the window; leave the rare loss loud.
#
# The fifo is opened READ-WRITE so this shell is its own reader and opening it cannot block, and the
# read is time-bounded so a listener that never comes up degrades instead of hanging forever.
#
# THE HOLDER MUST NOT OUTLIVE THIS SHELL, and the release below is what guarantees it. A background
# child inherits this launcher's stdout and stderr, so an orphaned holder does not merely waste a
# port - it holds those descriptors open and wedges anything capturing claude-laws' output until it
# dies. Observed, not theorised: with the release removed, the test suite hangs at the first
# `out=$(claude-laws ...)` rather than merely failing. The answer is the single unconditional
# release, not redirections that would make an orphan survivable - an orphan is not a state this
# code can reach, and hardening against unreachable states is how a second way to be wrong appears.
PORT_FIFO="$LAWS_SWITCH_DIR/port"
PORT=""
if mkfifo "$PORT_FIFO"; then
  exec 9<>"$PORT_FIFO"
  node -e 'const fs=require("fs"),s=require("net").createServer();s.listen(0,"127.0.0.1",()=>fs.writeFileSync(process.argv[1],s.address().port+"\n"))' "$PORT_FIFO" &
  PORT_HOLDER=$!
  IFS= read -r -t 10 PORT <&9
fi
if ! [[ "$PORT" =~ ^[0-9]+$ ]]; then
  # `exec` replaces this shell, so the EXIT trap above will never run - the directory has to be
  # taken along by hand or it outlives the process it belonged to.
  log "could not reserve an inspector port; launching plain claude (craft switching disabled)"
  rm -rf "$LAWS_SWITCH_DIR"
  exec "$CLAUDE_BIN" "$@"
fi

export LAWS_SWITCH_DIR
export BUN_INSPECT="ws://127.0.0.1:$PORT/dbg"

# WHO OWNS THIS SWITCH. Both variables above land in the environment of every process the agent
# spawns, so a nested `claude` from a Bash call inherits the whole handshake and looks exactly
# like the session that started it. Pinning the session id up front turns "is this my session"
# into an equality test the guard can run, instead of something it has to infer.
#
# WHY THE SWITCH MAY BE UNAVAILABLE, carried as a value rather than a branch: one scan over the
# user's argv yields the reason it cannot be offered, or empty when it can. The guard offers
# nothing without LAWS_SWITCH_SESSION, so each case is enforced by ABSENCE of the pin, not by a
# warning nobody reads. [LAW:dataflow-not-control-flow] [LAW:no-silent-failure] it still says so.
#
#   -p/--print   a relaunch re-sends the positional prompt, which would re-execute the user's
#                whole request. Rather than parse claude's flags to strip it - where a flag that
#                takes a value is indistinguishable from a positional, and a wrong guess silently
#                drops or duplicates the prompt - the feature is simply unavailable there. The
#                same hazard for an INTERACTIVE positional prompt is promptctl-routing-szb and is
#                NOT covered here; this case catches only the one-shot form.
#
#   -c/--continue/-r/--resume
#                the user has already chosen which conversation to open, and claude REFUSES the
#                pin alongside that choice - "--session-id can only be used with --continue or
#                --resume if --fork-session is also specified" (measured). So pinning anyway does
#                not degrade the switch, it breaks the launch outright, which is why this is a
#                scan for the selector rather than something the relaunch loop can paper over.
#                Adding --fork-session would make the pair legal and is deliberately not done: it
#                would silently turn the user's "continue" into a fork of their conversation,
#                redefining the flag they handed us. Withhold the switch instead.
#
#   --session-id the user pinned their own id. Minting a second one would put two --session-id
#                flags on one command line, so claude either refuses the launch or opens the
#                session under an id the user never asked for. Reusing THEIR id is deliberately
#                not done either: the pin exists so "is this my session" is an equality test on
#                an id this launcher alone minted, and adopting an id the user may also have
#                handed to something else gives that test a second claimant.
#
# THE SCAN MATCHES THE FLAG NAME, NOT THE WHOLE TOKEN. claude accepts both spellings of a flag that
# carries a value - `claude --session-id=<uuid> -p "say ok"` and `claude --resume=<uuid> -p "say ok"`
# both run (measured) - so a scan over whole tokens sees `--session-id=<uuid>` as an unrecognised
# positional, offers the switch anyway, and mints a SECOND --session-id onto the same command line:
# precisely the broken launch this scan exists to prevent. Trimming at the first `=` puts both
# spellings of one flag on one arm, so there is one rule per flag rather than one per spelling.
no_switch=""
for arg in "$@"; do
  case "${arg%%=*}" in
    -p|--print)
      no_switch="one-shot session (-p): a relaunch would re-send the prompt"; break;;
    -c|--continue|-r|--resume)
      no_switch="session selector ($arg): claude refuses --session-id alongside it, and the switch needs a pinned id"; break;;
    --session-id)
      no_switch="session id (--session-id): you pinned your own id, and the switch needs one this launcher minted"; break;;
  esac
done

FIRST_ARGS=()
if [ -n "$no_switch" ]; then
  log "craft switching disabled - $no_switch"
elif ! LAWS_SWITCH_SESSION="$(node -e 'console.log(require("crypto").randomUUID())' 2>/dev/null)" \
     || [ -z "$LAWS_SWITCH_SESSION" ]; then
  log "could not mint a session id; launching without craft switching"
else
  export LAWS_SWITCH_SESSION
  FIRST_ARGS=(--session-id "$LAWS_SWITCH_SESSION")
fi
# The deny message tells the agent to run `laws-switch`, so it has to BE runnable. Putting
# this bin dir on PATH is what makes that instruction true rather than aspirational.
export PATH="$PLUGIN_DIR/bin:$PATH"

REQUEST="$LAWS_SWITCH_DIR/request.json"

# The user's flags are the fixed part of every relaunch and are never rewritten. The session
# selector is the part that varies: --session-id pins the FIRST launch, and each switch replaces
# it with --resume. Held separately and replaced rather than appended, because appending to "$@"
# would accumulate a second --resume on the second switch of one session, and would leave the
# initial --session-id sitting alongside a --resume that supersedes it.
USER_ARGS=("$@")
SESSION_ARGS=(${FIRST_ARGS[@]+"${FIRST_ARGS[@]}"})

# REOPENING NEVER RE-PINS. Once claude has held a session under the pinned id, a second claim on it
# is refused outright - "Error: Session ID <uuid> is already in use." (measured against the real
# binary), exit 1, no session. So any relaunch of a session claude has ALREADY opened must arrive as
# --resume, and the initial --session-id has to be downgraded before it is reused.
#
# One rule, one place. Two relaunch paths need it - the recovery relaunch and the resume:false pass
# that reopens the session unchanged - and when each of them remembered the rule for itself, one of
# them remembered and the other did not. [LAW:one-source-of-truth] [LAW:single-enforcer]
#
# SESSION_ARGS is always empty or a <selector> <id> pair, so index 1 is the id whichever selector
# put it there: the first pass's --session-id and every later pass's --resume normalise the same
# way, with no pass-number special case, and an already-normalised --resume normalises to itself.
# An empty SESSION_ARGS (no pin was minted) stays empty and the relaunch is the user's own argv,
# unchanged. [LAW:dataflow-not-control-flow]
reopen_selector() { SESSION_ARGS=(${SESSION_ARGS[@]+--resume "${SESSION_ARGS[1]}"}); }

# A switch that cannot be completed must still leave the user IN a session. Exiting here would
# degrade the failure to no session at all - strictly worse than the state before the switch was
# asked for, and the opposite of what this file's header promises. The last-known-good
# SESSION_ARGS names the session the user was just in, so recovery reopens THAT session and then
# reports the failure through the exit status.
#
# THE RECOVERED SESSION IS OFFERED NO SWITCH. LAWS_SWITCH_SESSION, LAWS_SWITCH_DIR and BUN_INSPECT
# were exported once, near the top, and outlive this function - so a recovered session would offer
# the switch, write request.json and end itself through the inspector, looking entirely functional,
# and then land back HERE, where nothing reads the request and the EXIT trap deletes it. The user's
# decision would be consumed and discarded without a word. Withdrawing the three variables makes the
# switch genuinely unavailable rather than apparently working: the guard offers nothing, so nothing
# is written that can be lost. [LAW:no-silent-failure] the failure is already loud through the exit
# status; what must not happen is a second, quieter loss stacked on top of it.
recover() { # <what failed>
  log "$1"
  log "the switch was not completed; reopening the session as it was"
  reopen_selector
  env -u LAWS_SWITCH_SESSION -u LAWS_SWITCH_DIR -u BUN_INSPECT \
    "$CLAUDE_BIN" ${USER_ARGS[@]+"${USER_ARGS[@]}"} ${SESSION_ARGS[@]+"${SESSION_ARGS[@]}"}
  exit 1
}

# The reservation has done its whole job the moment claude is about to start: bun binds this port
# itself, so it must be free by now or the launch dies on EADDRINUSE. Released here and nowhere
# earlier - every line between the reservation and this one is a line the port cannot be stolen in.
# [LAW:no-silent-failure] exception: a holder that has already died reports a failure that is
# indistinguishable from success here, because the only thing this cares about is that the port is
# free, and it is free either way.
kill "$PORT_HOLDER" 2>/dev/null
wait "$PORT_HOLDER" 2>/dev/null
exec 9>&-

while :; do
  # bash 3.2 under `set -u` treats "${empty[@]}" as unbound, so expand through the +alternate form.
  "$CLAUDE_BIN" ${USER_ARGS[@]+"${USER_ARGS[@]}"} ${SESSION_ARGS[@]+"${SESSION_ARGS[@]}"}
  status=$?

  [ -f "$REQUEST" ] || exit "$status"

  # stdout carries the result JSON and stderr carries diagnostics, so they are kept apart: folding
  # stderr in would let one node warning corrupt the value the next step parses. [LAW:no-silent-failure]
  if ! applied="$(node "$EXCISE" --apply "$REQUEST")"; then
    rm -f "$REQUEST"
    recover "the craft switch could not be applied, so the transcript is unchanged (see the error above)"
  fi
  rm -f "$REQUEST"

  # One read of the result, US-separated (\x1f). A malformed result throws out of node rather than
  # being caught and returned as an empty string that later reads as "no session to resume".
  #
  # The separator is deliberately NOT a tab: bash collapses runs of IFS WHITESPACE, so an empty
  # leading field would shift every later field left and the emptiness checks below would read a
  # neighbour's value instead of the missing one. \x1f is not whitespace, so one separator is
  # exactly one field boundary and an absent value stays absent.
  #
  # switchedFrom is a SET - a switch can retire more than one engaged craft - and is joined on ','
  # explicitly rather than left to Array.prototype.toString, so the wire format is chosen here
  # instead of inherited from a coercion a future refactor could change without noticing. Craft
  # names are media slugs, so ',' cannot occur inside one and the split below is unambiguous.
  #
  # `resume` is READ, never re-derived. laws-excise's SWITCH_ACTIONS table already decided whether
  # this choice leaves anything to resume into (reject: false; tombstone and both rewinds: true),
  # and inferring it downstream from a non-empty sid would be a second answer to a question the
  # apply result already answers. A result that omits it throws rather than defaulting, so the two
  # can never quietly disagree. [LAW:one-source-of-truth]
  if ! parsed="$(printf '%s' "$applied" | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{const r=JSON.parse(d);if(typeof r.resume!=="boolean")throw new Error("apply result carries no resume decision");const from=Array.isArray(r.switchedFrom)?r.switchedFrom.join(","):(r.switchedFrom||"");process.stdout.write([r.sessionId||"",from,r.switchedTo||"",r.choice||"",r.resume?"1":""].join("\x1f"))})')"; then
    recover "the switch was applied but its result could not be read: $applied"
  fi
  IFS=$'\x1f' read -r sid switched_from switched_to choice resume <<< "$parsed"

  # Nothing to resume into means nothing to release either: the choice that reports resume:false
  # is the one that left the transcript exactly as it was, so retiring a craft here would undo an
  # engagement the switch deliberately kept. Same loop body, different value. [LAW:dataflow-not-control-flow]
  if [ -z "$resume" ]; then
    log "$choice leaves the session as it stands, so nothing is retired; reopening it unchanged"
    # Unchanged, but not un-relaunched: claude has already held this session, and the id that opened
    # it cannot open it a second time. Same downgrade as every other reopening.
    reopen_selector
    continue
  fi

  if [ -z "$sid" ] || [ -z "$switched_from" ]; then
    recover "the switch was applied but names no session or no retired craft, so it cannot be completed: $applied"
  fi

  # The second half of retiring the crafts. Without it the resumed session still holds the engaged
  # markers and the guard refuses the craft this switch was performed to reach. The lock lives behind
  # the router, which owns its layout. [LAW:one-source-of-truth]
  #
  # EVERY retired craft is released, not just one: the transcript surgery already removed all of
  # them, and leaving a single marker behind is enough for the guard to refuse the incoming craft
  # again - a switch that reports success and changes nothing observable. [LAW:composability]
  #
  # A failure here is loud but not fatal: the transcript surgery already happened, so refusing to
  # relaunch would strand the user's session entirely, which is strictly worse than a session that
  # comes back and still refuses one skill. Tell them exactly what will happen instead.
  IFS=',' read -r -a retired <<< "$switched_from"
  for craft in "${retired[@]}"; do
    [ -n "$craft" ] || continue
    if ! printf '{"session_id":"%s","craft":"%s"}' "$sid" "$craft" | "$ROUTER" retire-craft; then
      log "could not release laws:$craft from the engaged set; resuming anyway, but laws:$switched_to will still be refused this session"
    fi
  done

  log "switched from laws:${switched_from//,/, laws:} to laws:$switched_to via $choice; resuming"
  # Replaces the initial --session-id, and replaces itself on every switch after the first.
  SESSION_ARGS=(--resume "$sid")
done
