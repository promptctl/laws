#!/usr/bin/env bash
# install-launcher — put `claude-laws` on the user's shell PATH.
#
# WHY THIS EXISTS AT ALL. Claude Code adds a plugin's `bin/` to "the Bash tool's PATH while the
# plugin is enabled" — which reaches the agent inside a session and never reaches the terminal the
# user types in. The launcher is the thing a user has to run BEFORE there is a session, so it is
# precisely the one executable the plugin cannot deliver by being installed. There is no plugin
# manifest field, lifecycle hook or CLI subcommand that does this (checked against the plugin docs
# and `claude plugin --help`), so an explicit, opt-in command is the whole mechanism.
#
# WHAT GOES ON PATH IS A GENERATED STUB, NOT A SYMLINK. Plugin installs are version-stamped —
# `~/.claude/plugins/cache/<marketplace>/<plugin>/<version>` — so anything pointing into one goes
# stale the next time the plugin updates. A dangling symlink reports that as `command not found`,
# which names neither the cause nor the cure. The stub holds the same path and, when it has gone,
# says what happened and what to run. [LAW:no-silent-failure] the staleness is loud and diagnosed.
#
# usage: install-launcher [target-directory]     (default: ~/.local/bin)

set -uo pipefail

say()  { printf 'install-launcher: %s\n' "$1"; }
warn() { printf 'install-launcher: %s\n' "$1" >&2; }
die()  { warn "$1"; exit 1; }

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
LAUNCHER="$PLUGIN_DIR/bin/claude-laws"
# Only the DEFAULT needs HOME; an explicit argument does not. Both missing is the one combination
# with no answer, and it is asked directly rather than inferred from the path that composing it
# would have produced — a test against the literal "/.local/bin" would also fire on a caller who
# passed that directory on purpose, which is a different situation with the same spelling.
# [FRAMING:representation] check the fact, not a string that usually accompanies it.
TARGET_DIR="${1:-}"
if [ -z "$TARGET_DIR" ]; then
  [ -n "${HOME:-}" ] || die "HOME is unset, so there is no default install directory; pass one: install-launcher <directory>"
  TARGET_DIR="$HOME/.local/bin"
fi
TARGET="$TARGET_DIR/claude-laws"

[ -x "$LAUNCHER" ] || die "no launcher at $LAUNCHER — this script must run from inside the laws plugin."

# EVERY PREREQUISITE IS CHECKED HERE, because here is the last moment a person is present to act on
# a missing one. At first use the same failures are silent by design: launch.js answers all of them
# by falling back to stock claude, which is the right behaviour for a session and the wrong place to
# learn that hosting never worked. [LAW:verifiable-goals]
command -v node >/dev/null 2>&1 || die "node is required to host a session and is not on PATH; install node first."

# A CAPABILITY PROBE, NOT A VERSION COMPARISON. What the host actually needs is
# vm.SourceTextModule / vm.SyntheticModule under --experimental-vm-modules (see
# hooks/injector/bun-runtime.mjs, which links Bun's module graph with them). Asking node whether it
# HAS them answers the real question; asking its version number answers a proxy question with a
# minimum somebody would have to guess and then maintain. [LAW:parse-dont-validate]
#
# ONLY THE FLAGS THE PROBE IS ABOUT. `--disable-warning=ExperimentalWarning` was here to quiet the
# experimental notice and had to go: node rejects an unknown option before running the script at
# all (`node: bad option`, exit 9), and that flag postdates the capability being probed for. On a
# node old enough to lack it but new enough to have vm.SourceTextModule, the probe reported the
# exact opposite of the truth. The `2>/dev/null` below was already silencing the warning, so the
# flag bought nothing it was not already getting. [LAW:no-silent-failure] a diagnostic that can be
# confidently wrong is worse than none, and this one exists to be trusted at install time.
if ! node --experimental-vm-modules \
       -e 'const vm=require("vm"); if(!vm.SourceTextModule||!vm.SyntheticModule) process.exit(1)' 2>/dev/null; then
  warn "this node ($(node --version)) has no vm.SourceTextModule; hosted sessions will fall back to stock claude."
  warn "the launcher will still install and still work — it just cannot host until node is newer."
fi

command -v claude >/dev/null 2>&1 || warn "no 'claude' on PATH yet; the launcher needs one at run time."

mkdir -p "$TARGET_DIR" || die "could not create $TARGET_DIR"

# Refuse to clobber anything this script did not write. A file already at the target is either a
# previous install of ours — safe to replace, and how an update is applied — or somebody else's
# `claude-laws`, which is theirs and not ours to overwrite. The marker is what tells the two apart,
# so the check is a fact about the file rather than an assumption about the path.
# Two jobs, deliberately one string. It identifies a stub this installer wrote (so an update may
# replace it and a stranger's file may not), and it is the token a launcher greps for in the first
# 400 bytes of whatever `claude` resolved to, so that aliasing `claude` to this stub is refused
# instead of recursing forever. Both readers want the same fact — "this file leads back to a
# launcher" — so there is one marker rather than two that could be applied inconsistently.
#
# READ OUT OF THE LAUNCHER, never spelled again here. The token used to be authored in both files,
# and nothing but a test stood between a rename in one of them and a fork bomb: stubs stamped with
# the new token, launchers still grepping for the old one, every alias unrecognised. Taking it from
# the definition itself makes that unrepresentable rather than merely tested for.
# [LAW:one-source-of-truth]
MARKER_TOKEN=$(sed -n "s/^LAWS_LAUNCHER_SELF_MARKER='\([^']*\)'.*/\1/p" "$LAUNCHER" | head -1)
[ -n "$MARKER_TOKEN" ] || die "no LAWS_LAUNCHER_SELF_MARKER definition in $LAUNCHER; a stub written without it would not be recognised as a launcher, so refusing to write one."
MARKER="# $MARKER_TOKEN — generated by the laws plugin: install-launcher"
# OWNERSHIP IS DECIDED BY THE TOKEN ALONE, never by the sentence wrapped around it. The stub carries
# the whole line because that is what a human reads when they open the file, but recognising our own
# work must not depend on prose a later edit is free to reword: every stub written by an earlier
# version would stop matching, and its owner would be told their own installed launcher is a foreign
# file to move aside — blocking the upgrade path the README tells them to take. The token is the
# fact; the rest of the line is decoration on it. [LAW:one-source-of-truth]
if [ -e "$TARGET" ] && ! grep -qF "$MARKER_TOKEN" "$TARGET" 2>/dev/null; then
  die "$TARGET already exists and was not written by this installer; move it aside or pass a different directory."
fi

# STAGE, PROVE, THEN COMMIT — in that order, because the destination may already hold a launcher
# that works. Building at the destination and checking afterwards means a failed check has already
# destroyed the thing it was meant to protect, and re-running the installer after a plugin update is
# exactly what the README tells people to do. Everything is therefore assembled here, and one `mv`
# on the same filesystem is the single moment anything the user relies on changes.
#
# The trap covers the staging directory on EVERY exit, including each `die` below. Without it the
# one write in this file whose guard fires would leave debris in the user's own bin directory.
# [LAW:no-ambient-temporal-coupling] the commit point is a place in the file, not a hope about order.
STAGE="$TARGET_DIR/.claude-laws-install.$$"
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE" || die "could not create a staging directory in $TARGET_DIR"
CANDIDATE="$STAGE/claude-laws"

# %q quotes the path for the shell, so a plugin directory containing a space or a quote produces a
# stub that still parses. Composing the line by hand is how a generated file acquires a syntax error
# that only some users ever see.
printf '#!/usr/bin/env bash\n%s\n' "$MARKER" > "$CANDIDATE" || die "could not write the candidate stub"
cat >> "$CANDIDATE" <<'STUB'
#
# Do not edit. This stub only hands over to the launcher in the laws plugin it was installed from;
# everything that decides how a session starts lives there. Re-run install-launcher to regenerate.
STUB
printf 'LAUNCHER=%q\n' "$LAUNCHER" >> "$CANDIDATE"
cat >> "$CANDIDATE" <<'STUB'
if [ ! -x "$LAUNCHER" ]; then
  printf 'claude-laws: the laws plugin this launcher points at is gone:\n  %s\n' "$LAUNCHER" >&2
  printf 'claude-laws: plugin installs are version-stamped, so this happens when the plugin updates.\n' >&2
  printf 'claude-laws: run '"'"'claude'"'"' for a session now; to repoint this, ask Claude Code to run: install-launcher\n' >&2
  # Deliberately NOT a fall back to stock claude, though every degrade inside the launcher is one.
  # Falling back means resolving `claude` and re-exec'ing it, which is the launcher's job precisely
  # because it carries the guard against a `claude` that resolves back to this launcher — an alias
  # that would loop forever. Reproducing that guard here would be a second copy of one rule, and
  # skipping it would ship the loop. This stub hands over to the plugin or says it cannot; the
  # session policy stays in the one place that owns it. [LAW:single-enforcer] [LAW:decomposition]
  exit 78
fi
exec "$LAUNCHER" "$@"
STUB
chmod +x "$CANDIDATE" || die "could not make the candidate stub executable"

# PROVE IT RUNS, rather than reporting success because the write returned 0. A stand-in takes the
# place of the claude binary: the hosted plan cannot extract a graph from it and falls back, so the
# whole chain — stub, launcher, plan list, fallback — executes in a fraction of a second without
# starting a session. [LAW:verifiable-goals] the check is the installer's to run, not the user's.
#
# THE STAND-IN IS WRITTEN, NOT FOUND. This used to be `/usr/bin/true`, which is absent on distroless
# images and on NixOS, where the install would then fail while being perfectly correct — the same
# host-layout assumption already removed twice in this file. `command -v true` does not fix it:
# `true` is a shell builtin, so that yields the bare word `true` and not a path. Writing the
# stand-in assumes nothing beyond the shell already running this script.
#
# It also records that it RAN, so the probe checks the chain reached the binary rather than trusting
# an exit code that any early return could also produce. [LAW:no-silent-failure]
printf '#!/bin/sh\ntouch "$(dirname "$0")/ran"\nexit 0\n' > "$STAGE/claude" \
  || die "could not write the probe stand-in"
chmod +x "$STAGE/claude" || die "could not make the probe stand-in executable"
probe="$(LAWS_CLAUDE_BIN="$STAGE/claude" "$CANDIDATE" 2>&1)"; probe_rc=$?
probe_ran=1; [ -e "$STAGE/ran" ] && probe_ran=0
if [ "$probe_rc" -ne 0 ] || [ "$probe_ran" -ne 0 ]; then
  warn "did not install $TARGET: the launcher this plugin would install did not reach a session."
  [ "$probe_ran" -eq 0 ] || warn "  the launcher never invoked the binary it was given"
  printf '%s\n' "$probe" >&2
  warn "nothing was changed; anything already at $TARGET is untouched."
  exit 1
fi

# The one moment anything the user relies on changes. Same filesystem as the staging directory, so
# the replacement is atomic: there is no instant in which $TARGET is half-written or absent.
mv "$CANDIDATE" "$TARGET" || die "could not move the verified launcher into $TARGET"

say "installed $TARGET"

# Naming the directory is not the same as it being reachable, and a `command not found` right after
# a success message is the worst way to discover the difference.
case ":$PATH:" in
  *":$TARGET_DIR:"*) say "run: claude-laws" ;;
  *) say "$TARGET_DIR is not on your PATH. Add it to your shell profile:"
     printf '\n  export PATH="%s:$PATH"\n\n' "$TARGET_DIR" ;;
esac
say "stock 'claude' is untouched; opt in per session by running claude-laws instead."
