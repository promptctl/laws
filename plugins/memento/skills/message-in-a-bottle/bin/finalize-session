#!/usr/bin/env bash
# finalize-session — the mandatory session close-out: schedule a delayed
# self-handoff into the current session. The launcher returns immediately; a
# detached worker delivers the handoff after a fixed delay.
#
# Two transports, most reliable first:
#   tmux    — in-place reset (/clear or /compact) verified by reading the pane
#             back, then paste the message. Deterministic; no focus concerns.
#   iTerm2  — kill the running claude and relaunch it fresh with the message as
#             its initial prompt, via `write text` to the exact session (no focus
#             steal, no readback needed — a new process is guaranteed fresh).
# Neither available is a hard failure. There is no third arm: delivery into a live
# session is what this script does, and a session it cannot reach is one it cannot
# close out.
#
# Modes:
#   launcher:       finalize-session [message...]
#   tmux worker:    finalize-session --worker <target> <reset> <msgfile> <goalfile>
#   iTerm2 worker:  finalize-session --iterm-worker <uuid> <claude_pid> <msgfile> <goalfile> <flags>

set -euo pipefail

# [LAW:one-source-of-truth] timing lives here once. HANDOFF_DELAY_SECONDS is how
# long to wait before firing; SETTLE_SECONDS is how long to let the reset render
# before reading the pane back to verify it ran (tmux).
HANDOFF_DELAY_SECONDS=10
SETTLE_SECONDS=5
# Upper bound on how long to wait for a freshly relaunched claude to become ready
# — its banner drawn, input box up — before queueing a carried /goal into it
# (iTerm2 transport only). We POLL the session contents and proceed the instant it
# is ready; on timeout we surface a failure rather than blind-writing into a
# not-yet-ready input box. This mirrors the tmux worker's pane read-back, and
# [LAW:no-silent-failure] closes the race a fixed boot sleep could only narrow.
CLAUDE_READY_TIMEOUT_SECONDS=30
CLAUDE_READY_POLL_SECONDS=0.5

# [LAW:one-source-of-truth] the static framing wrapped around the agent's message
# lives here once. The launcher composes PREFIX + agent message + SUFFIX into the
# single value that flows to the transport; workers stay dumb conduits.
HANDOFF_PREFIX=$(cat <<'PREFIX'
=== Below is a message from an agent on behalf of the user ===
PREFIX
)
HANDOFF_SUFFIX=$(cat <<'SUFFIX'
=== The above message was sent on behalf of the user, but as it was sent from an agent, double checking the claims is wise.  When in doubt, note any divergence and run the '/next' skill to proceed.  Do NOT ask the user if you should run '/next'. ===
SUFFIX
)

# The message's first 3 sentences, one per line. Stops early so a long message
# doesn't slow the common case. (tmux only.)
_first_three_sentences() {
  local text="$1" result="" count=0 i char
  for ((i=0; i<${#text}; i++)); do
    char="${text:$i:1}"
    result+="$char"
    if [[ "$char" == "." || "$char" == "!" || "$char" == "?" ]]; then
      printf '%s\n' "$result"
      result=""
      ((count++)) || true
      [[ $count -ge 3 ]] && return 0
    fi
  done
  printf '%s\n' "$result"
}

# Whether the message asks for a compacted handoff — true only on an AFFIRMATIVE
# mention of /compact in the first 3 sentences.
#
# [LAW:parse-dont-validate] The reset mode is a binary the author chose, but prose
# cannot carry a binary faithfully: to a matcher, a mention and an invocation look
# identical. `--reset` is the parsed form and wins outright; this inference serves
# messages that pass no flag, and it is deliberately biased toward `clear`.
#
# The bias is not caution for its own sake — the two errors cost wildly different
# amounts. A wrong `clear` costs the next agent one summary it has to rebuild. A
# wrong `compact` carries the previous session's context across a boundary that may
# exist precisely to stop it. On 2026-08-16 a handoff reading "Do NOT use /compact
# ... a blank slate is required" compacted, because a word-boundary match cannot
# see a negation — so the more emphatically an author forbade compaction, the
# surer it was to happen, and the misfire announced itself only in a line the
# skill's own turn-ending rule forbids the author to stay and read. Under
# ambiguity, take the harmless error.
_wants_compact() {
  local sentence
  while IFS= read -r sentence; do
    # Sentences arrive with their terminator attached, so the trailing class must
    # admit punctuation as well as whitespace and end-of-line.
    [[ "$sentence" =~ (^|[[:space:]])/compact([[:space:]]|[.,:;!?]|$) ]] || continue
    # A negated mention is ambiguous, not a request: skip this sentence and let a
    # later affirmative one — or the `clear` default — decide. Character classes
    # rather than ${var,,} keep this working on bash 3.2, which is what
    # /usr/bin/bash still is on macOS.
    [[ "$sentence" =~ (^|[^A-Za-z])([Nn][Oo][Tt]|[Nn][Ee][Vv][Ee][Rr]|[Aa][Vv][Oo][Ii][Dd]|[Ww][Ii][Tt][Hh][Oo][Uu][Tt]|[Ss][Kk][Ii][Pp])([^A-Za-z]|$) ]] && continue
    [[ "$sentence" == *"n't"* || "$sentence" == *"N'T"* ]] && continue
    return 0
  done < <(_first_three_sentences "$1")
  return 1
}

# The inferred reset mode as a word, so the caller can treat it as a plain default.
_infer_reset() {
  if _wants_compact "$1"; then printf 'compact'; else printf 'clear'; fi
}

# Walk the process ancestry from the launcher's parent up to the interactive
# `claude` process — the one to kill and relaunch. Matched by program name so it
# survives whatever flags the user launched with.
_find_claude_pid() {
  local pid="${PPID}" cmd i
  for i in 1 2 3 4 5 6 7 8; do
    [ -n "$pid" ] && [ "$pid" -gt 1 ] || return 1
    cmd=$(ps -o command= -p "$pid" 2>/dev/null) || return 1
    case "$cmd" in
      claude|claude\ *|*/claude|*/claude\ *) printf '%s' "$pid"; return 0 ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
  done
  return 1
}

# The tmux pane this process is running inside, discovered from process ancestry
# instead of from $TMUX_PANE.
#
# A session hosted by `claude daemon run` — which is every session when
# remoteControlAtStartup is on — is spawned by the daemon, not by the pane's
# shell, so it inherits none of tmux's environment. $TMUX and $TMUX_PANE are
# simply absent even though a pane four levels up is displaying that session and
# taking its keystrokes. Reading the environment alone therefore reports "no
# transport" for a session that plainly has one, and the close-out silently stops
# happening for precisely the longest-running sessions — the ones with the most
# worth handing off.
#
# [FRAMING:representation] $TMUX_PANE is a copy of a fact, propagated by
# inheritance and lost the moment something breaks the chain. The fact itself is
# "an ancestor of mine is some pane's process." Ask the territory, not the map
# that went missing.
#
# [LAW:no-silent-failure] the match is descent and nothing else — never the
# working directory, never "the only pane that looks plausible." A process with
# no pane ancestor gets no pane: this returns 1 and the caller falls through to
# the next transport, rather than pasting a handoff into an unrelated window.
#
# WHY DESCENT NEEDS MORE THAN A PID. Pids are recycled, so "an ancestor's pid
# equals a pane's pid" is not by itself proof that the pane's process is that
# ancestor. Two forgeries are available to a recycled pid, and each is closed by
# making the snapshot carry a fact the recycled pid cannot supply:
#
#   A pane outliving its process. With remain-on-exit set, a pane whose process
#   has exited stays listed and keeps advertising that dead pid (observed: kill a
#   pane's process and list-panes still reports its pid, with pane_dead=1). Once
#   that pid is reissued to something in this chain, the pid match is a
#   coincidence and the handoff lands in a window showing a corpse. #{pane_dead}
#   is what tells them apart, so it rides along in the snapshot and dead rows
#   never enter the match set.
#
#   An ancestor exiting mid-walk. Age tells this one apart: a parent is never
#   younger than its child, so elapsed time must not decrease as the walk climbs.
#   A pid reissued after its holder died is younger than the descendant that
#   claimed it, and the walk stops rather than wandering into a stranger's tree.
#
# Together they are a proof to the resolution of the clock. Non-decreasing age
# from hop zero means every matched ancestor is at least as old as this process,
# so it has held its pid continuously since before this process existed — which
# is before the pane list was read. Two processes cannot hold one pid at one
# instant, so the live pane recorded at that pid is that ancestor.
#
# That clock ticks once a second, and no portable shell carries a faster one:
# etime is [[dd-]hh:]mm:ss, `ps -o lstart=` is whole seconds as well, and the one
# genuinely finer source — /proc/<pid>/stat's start time — does not exist on
# macOS, where this transport mostly runs. Both were measured before being ruled
# out. So one case stays open: a pid reissued within the same second this process
# started reads as the same age and passes. Reaching it also needs `ps -e` to
# read the ppid row and the row for the pid it names on opposite sides of that
# reuse. A second later, the age check refuses it.
#
# [LAW:effects-at-boundaries] both snapshots are taken here, at the edge, and the
# resolution below is arithmetic over those two values. One whole-table ps rather
# than a query per hop is what makes that true: pid and age are read at a single
# instant, so nothing shifts underneath the walk.
_discover_tmux_pane() {
  local panes proctable
  command -v tmux >/dev/null 2>&1 || return 1
  panes=$(tmux list-panes -a -F 'pane #{pane_id} #{pane_pid} #{pane_dead}' 2>/dev/null) || return 1
  [ -n "$panes" ] || return 1
  proctable=$(ps -eo pid=,ppid=,etime=) || return 1
  # The literal 'pane' lead-in is tmux labelling its own rows, so one pass can
  # tell the two snapshots apart without a separator line to get out of step.
  printf '%s\n%s\n' "$panes" "$proctable" | awk -v self=$$ -v maxhops=16 '
    # ps renders elapsed time as [[dd-]hh:]mm:ss; fold it left into seconds so
    # any of the three widths compares against any other.
    function ageof(raw,   days, parts, fields, i, seconds) {
      days = 0
      if (raw ~ /-/) {
        days = substr(raw, 1, index(raw, "-") - 1) + 0
        raw = substr(raw, index(raw, "-") + 1)
      }
      fields = split(raw, parts, ":")
      seconds = 0
      for (i = 1; i <= fields; i++) seconds = seconds * 60 + parts[i] + 0
      return days * 86400 + seconds
    }
    # [LAW:parse-dont-validate] a whitelist, not a blacklist of the dead value:
    # only a row that positively asserts liveness joins the match set. tmux
    # expands a format field it does not know to the empty string (verified on
    # 3.6a: `#{no_such_field}` renders as nothing, it does not survive as a
    # literal), so on a tmux predating #{pane_dead} the row arrives with three
    # fields and an uninitialised $4 — and `$4 != 1` would read that as alive,
    # silently reverting discovery to the bare pid match this guard exists to
    # close. The price of strictness is that such a tmux matches no pane at all
    # and the caller declines; that is the safe direction, and the one the
    # elapsed-time check below already takes for the same reason.
    $1 == "pane" { if (NF == 4 && $4 == "0") pane[$3] = $2; next }
    NF == 3      { parent[$1] = $2; elapsed[$1] = $3 }
    END {
      pid = self
      descendant_age = -1
      for (hop = 0; hop < maxhops; hop++) {
        if (!(pid in parent)) exit 1
        # [LAW:parse-dont-validate] an elapsed time this cannot read is not an
        # age of zero, which would quietly reduce the walk to bare pid matching.
        # It is a failure to establish descent, and it refuses the pane.
        if (elapsed[pid] !~ /^([0-9]+-)?([0-9]+:)?[0-9]+:[0-9][0-9]$/) exit 1
        age = ageof(elapsed[pid])
        if (age < descendant_age) exit 1
        if (pid in pane) { print pane[pid]; exit 0 }
        descendant_age = age
        pid = parent[pid]
        if (pid + 0 <= 1) exit 1
      }
      exit 1
    }'
}

# A pane id resolved to the tmux target that addresses it, or 1 if tmux does not
# own that pane.
#
# [LAW:parse-dont-validate] display-message cannot be asked this question
# directly, because it answers the same way whether or not the pane exists: given
# a pane id no server owns it exits 0 with every field empty, so the target format
# renders as the literal ":." — an answer-shaped void, non-empty and therefore
# indistinguishable from a real target to any caller that only checks emptiness.
# Worse, tmux then reads ":." as a live address meaning current-session:current-
# window.current-pane, so a stale pane id does not fail loudly; it silently
# retargets the handoff at whatever the user happens to be looking at when the
# worker fires. (Verified on tmux 3.6a: `display-message -t %4242` exits 0 and
# renders ":.", while `list-panes -t %4242` exits 1.)
#
# Asking for #{pane_id} alongside the target makes the reply carry its own proof:
# a target is this pane's target only if the id tmux echoes back is the id we
# asked about. That refuses the stale id and the degenerate ":." alike.
#
# The id alone is not enough, for the same reason the walk above carries
# #{pane_dead}: owning a pane and displaying a live process are different facts,
# and remain-on-exit separates them. A dead pane answers exactly like a live one
# — verified on 3.6a by killing a pane's process on a scratch server, after which
# `display-message` still exits 0 and still echoes `%0 1 t:1.1`. Admitted on the
# id alone it would satisfy this, short-circuit the discovery that would have
# refused it, and leave the worker sending keys into a corpse. So liveness is
# demanded here in the same words the walk demands it: a positive "0", never the
# absence of a "1". A tmux too old to know #{pane_dead} renders it empty and is
# refused by both, which is the point of saying it the same way twice.
_pane_target() {
  local pane="${1:-}" reply rest
  [ -n "$pane" ] || return 1
  reply=$(tmux display-message -p -t "$pane" \
            '#{pane_id} #{pane_dead} #{session_name}:#{window_index}.#{pane_index}' 2>/dev/null) || return 1
  [ "${reply%% *}" = "$pane" ] || return 1
  rest="${reply#* }"
  [ "${rest%% *}" = "0" ] || return 1
  printf '%s' "${rest#* }"
}

# The flags claude was launched with, reduced to a safe whitelist: permission
# mode, model, and the skip-permissions toggles — the ones that make the fresh
# session match the user's setup. Everything else is dropped, and scanning STOPS
# at the first positional argument.
#
# [LAW:types-are-the-program] this is load-bearing, not defensive. message-in-a-
# bottle hands the message off as a positional PROMPT (iTerm2 relaunch does
# `claude ... "$(cat msgfile)"`), so a session that was itself born from a prior
# handoff carries a giant multi-word prompt in its own argv. The old "keep every
# token that isn't argv0/resume" logic then splices that entire prompt into the
# next relaunch's flag string, corrupting it. Whitelisting and halting at the
# first positional makes that impossible by construction. [LAW:no-silent-failure]
# we would rather drop an exotic flag than smuggle a prompt into the flags.
_claude_flags() {
  local cmd="$1" out="" tok next i n
  local -a toks
  IFS=' ' read -r -a toks <<<"$cmd" || true
  n=${#toks[@]}
  i=1  # skip argv0
  while [ "$i" -lt "$n" ]; do
    tok="${toks[$i]}"
    next="${toks[$((i+1))]:-}"
    case "$tok" in
      --dangerously-skip-permissions|--allow-dangerously-skip-permissions|--verbose)
        out+="${out:+ }$tok"; i=$((i+1)) ;;
      --model|--permission-mode)
        if [ $((i+1)) -lt "$n" ]; then out+="${out:+ }$tok $next"; i=$((i+2))
        else i=$((i+1)); fi ;;
      --model=*|--permission-mode=*)
        out+="${out:+ }$tok"; i=$((i+1)) ;;
      -c|--continue|--resume=*)
        i=$((i+1)) ;;
      -r|--resume)
        # resume's value is optional; drop it only when the next token isn't a flag
        if [ $((i+1)) -lt "$n" ] && [ "${next#-}" = "$next" ]; then i=$((i+2))
        else i=$((i+1)); fi ;;
      *)
        break ;;  # first positional = the prompt; never propagate it or anything after
    esac
  done
  printf '%s' "$out"
}

# Read the currently-visible contents of the iTerm2 session with the given UUID.
# This is the iTerm2 analog of tmux's `capture-pane -p`: the readiness probe polls
# it for the relaunched claude's banner before queueing a carried /goal, so the
# goal is never written into a not-yet-ready input box. In the direct-iTerm2 path
# (the only one that reaches this — the launcher prefers tmux when both exist) the
# killed claude's alternate screen is torn down on exit, so a banner match here can
# only be the fresh relaunch, not a stale one lingering in scrollback.
_iterm_session_contents() {
  local uuid="$1"
  # [LAW:no-silent-failure] surface osascript errors into the worker log rather
  # than swallowing them — the healthy read writes nothing to stderr (found →
  # returns text; UUID absent → empty, exit 0), so this only speaks up on a real
  # AppleScript/iTerm2 fault, which is exactly the clue a silent 30s timeout lacks.
  osascript <<OSA 2>>/dev/stderr
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (unique id of s) is "${uuid}" then
          return contents of s
        end if
      end repeat
    end repeat
  end repeat
end tell
OSA
}

# [LAW:types-are-the-program] one discriminator at the entry; everything
# downstream operates on validated, typed inputs for exactly one mode.
case "${1:-}" in
  --worker)       MODE=tmux-worker; shift ;;
  --iterm-worker) MODE=iterm-worker; shift ;;
  *)              MODE=launcher ;;
esac

case "$MODE" in

  launcher)
    # [LAW:dataflow-not-control-flow] an optional carried goal is a leading
    # --goal <condition> value, stripped here so the remainder is the message.
    # /clear, /compact, and a fresh relaunch all wipe the session-scoped /goal, so
    # without this the next agent wakes with no goal and the autonomous run stops.
    # Absent → empty string; the same code path runs, the value decides the effect.
    GOAL=""
    RESET_ARG=""
    while :; do
      case "${1:-}" in
        --goal)
          GOAL="${2:-}"
          shift 2 || { echo "--goal requires a condition argument" >&2; exit 2; }
          ;;
        # [LAW:parse-dont-validate] the checkpoint for reset mode: an unrecognised
        # value is refused here, so everything downstream holds one of two words.
        --reset)
          RESET_ARG="${2:-}"
          case "$RESET_ARG" in
            clear|compact) ;;
            *) echo "--reset takes 'clear' or 'compact', got '${RESET_ARG}'" >&2; exit 2 ;;
          esac
          shift 2 || { echo "--reset requires a mode argument" >&2; exit 2; }
          ;;
        *) break ;;
      esac
    done

    # [LAW:dataflow-not-control-flow] the message is a value carrying a canonical
    # default — /next, the standard "pull the next ticket" handoff. Omitting argv
    # selects that default; it never yields an empty handoff, so no guard follows.
    AGENT_MESSAGE="${*:-/next}"

    # [LAW:dataflow-not-control-flow] reset mode is one value with two sources —
    # the explicit flag when the author passed one, the message's own text
    # otherwise — resolved by a default, not by a branch in the control flow.
    # [LAW:one-source-of-truth] the only place RESET is assigned. (tmux only.)
    RESET="${RESET_ARG:-$(_infer_reset "$AGENT_MESSAGE")}"

    # [LAW:one-source-of-truth] the wrapped value is assembled once, here.
    MESSAGE=$(printf '%s\n%s\n%s' "$HANDOFF_PREFIX" "$AGENT_MESSAGE" "$HANDOFF_SUFFIX")

    # [LAW:dataflow-not-control-flow] the message flows through a tempfile as a
    # value, bypassing every shell-quoting hazard between argv → worker →
    # transport. No escaping branches anywhere.
    MSGFILE=$(mktemp -t finalize-msg.XXXXXX)
    GOALFILE=$(mktemp -t finalize-goal.XXXXXX)
    LOGFILE=""
    trap 'rm -f -- "$MSGFILE" "$GOALFILE" ${LOGFILE:+"$LOGFILE"}' EXIT
    printf '%s' "$MESSAGE" > "$MSGFILE"
    # [LAW:dataflow-not-control-flow] the goal rides its own tempfile as a value,
    # empty when none was carried. Workers read it and re-issue /goal only when it
    # is non-empty; nothing branches on a separate "has goal" flag.
    printf '%s' "$GOAL" > "$GOALFILE"

    # Resolve own path for both ./script and PATH-lookup invocations.
    if [[ "$0" == */* ]]; then
      SELF_RAW="$0"
    else
      SELF_RAW=$(command -v -- "$0") \
        || { echo "cannot resolve own path from \$0=$0" >&2; exit 2; }
    fi
    SELF="$(cd "$(dirname "$SELF_RAW")" && pwd)/$(basename "$SELF_RAW")"

    # [LAW:parse-dont-validate] this is the parse of the environment into a
    # transport: it yields a value that could not exist beforehand (a tmux target,
    # or an iTerm2 session uuid plus the claude pid to relaunch), and every worker
    # below is typed on that value. Detection lives here once
    # [LAW:single-enforcer]; workers never re-detect.
    #
    # The pane resolves from two spellings of one question — inherited when this
    # process is a child of the pane's shell, discovered from ancestry when a
    # daemon broke that chain — and they collapse to a single value here so no
    # code below has to know which spelling answered. [LAW:one-source-of-truth]
    # Each spelling is accepted only once tmux confirms it still names that pane,
    # and a spelling that fails to resolve hands the question on rather than
    # consuming the attempt. The inherited copy going stale is the same "the map
    # went missing" failure discovery exists for, so it must not be able to lose
    # the handoff on discovery's behalf. [FRAMING:representation]
    TARGET=$(_pane_target "${TMUX_PANE:-}") \
      || TARGET=$(_pane_target "$(_discover_tmux_pane || true)") \
      || TARGET=""
    if [[ -n "$TARGET" ]]; then
      if [[ -n "${FINALIZE_DRY_RUN:-}" ]]; then
        echo "[dry-run] transport=tmux target=$TARGET reset=/$RESET msgfile=$MSGFILE"
        echo "[dry-run] carried goal: ${GOAL:-(none)}"
        exit 0
      fi
      LOGFILE=$(mktemp -t finalize-log.XXXXXX)
      nohup "$SELF" --worker "$TARGET" "$RESET" "$MSGFILE" "$GOALFILE" \
        </dev/null >>"$LOGFILE" 2>&1 &
      trap - EXIT
      echo "handoff scheduled → tmux $TARGET (/$RESET) in ${HANDOFF_DELAY_SECONDS}s (log: $LOGFILE)"

    elif [[ "${TERM_PROGRAM:-}" == "iTerm.app" && -n "${ITERM_SESSION_ID:-}" ]] \
         && osascript -e 'tell application "iTerm2" to get version' >/dev/null 2>&1; then
      UUID="${ITERM_SESSION_ID#*:}"
      CLAUDE_PID=$(_find_claude_pid) \
        || { echo "iTerm2 transport: cannot locate the claude process to relaunch" >&2; exit 2; }
      FLAGS=$(_claude_flags "$(ps -o command= -p "$CLAUDE_PID" 2>/dev/null)")
      if [[ -n "${FINALIZE_DRY_RUN:-}" ]]; then
        echo "[dry-run] transport=iTerm2 uuid=$UUID claude_pid=$CLAUDE_PID flags=[$FLAGS]"
        echo "[dry-run] would relaunch: claude ${FLAGS:+$FLAGS }\"\$(cat '$MSGFILE')\""
        echo "[dry-run] carried goal: ${GOAL:-(none)}"
        exit 0
      fi
      LOGFILE=$(mktemp -t finalize-log.XXXXXX)
      nohup "$SELF" --iterm-worker "$UUID" "$CLAUDE_PID" "$MSGFILE" "$GOALFILE" "$FLAGS" \
        </dev/null >>"$LOGFILE" 2>&1 &
      trap - EXIT
      echo "handoff scheduled → iTerm2 (kill+relaunch, fresh) in ${HANDOFF_DELAY_SECONDS}s (log: $LOGFILE)"

    else
      # [LAW:parse-dont-validate] the failure arm of the parse above. Exiting
      # nonzero is the whole of it: the close-out did not happen, and the caller
      # learns that from the exit code rather than from prose it may not read.
      # [LAW:no-silent-failure] writing the message to a file here would be an
      # answer-shaped void — exit 0 with the shape of delivery and none of the
      # substance, since nothing reads that file. A message parked on disk is a
      # message lost, and lost loudly beats lost while claiming success.
      echo "finalize-session: no tmux or iTerm2 transport; nothing to deliver into." >&2
      echo "Claude must be running in a tmux pane or an iTerm2 session to close out." >&2
      echo "No pane owns this process: neither \$TMUX_PANE nor any ancestor pid" >&2
      echo "matches a live tmux pane, so there is no window that is showing this" >&2
      echo "session to hand off into." >&2
      exit 2
      # MSGFILE and GOALFILE cleaned by the EXIT trap.
    fi
    ;;

  tmux-worker)
    if [[ $# -ne 4 ]]; then
      echo "internal error: worker expects exactly 4 args" >&2
      exit 2
    fi
    TARGET="$1"
    RESET="$2"
    MSGFILE="$3"
    GOALFILE="$4"

    BUFFER="finalize-$$"
    GOALBUF="finalize-goal-$$"
    trap 'rm -f "$MSGFILE" "$GOALFILE"' EXIT
    log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }

    case "$RESET" in
      clear)   REGISTERED_RE='Claude Code v[0-9]' ;;
      compact) REGISTERED_RE='Compacting conversation|Conversation compacted' ;;
    esac

    log "waking; target=$TARGET reset=/$RESET"
    sleep "$HANDOFF_DELAY_SECONDS"

    tmux send-keys -t "$TARGET" Escape
    sleep 1
    tmux send-keys -t "$TARGET" "/$RESET"
    sleep 0.5
    tmux send-keys -t "$TARGET" Enter
    sleep "$SETTLE_SECONDS"

    if tmux capture-pane -t "$TARGET" -p | grep -qE "$REGISTERED_RE"; then
      log "/$RESET registered; sending message"
      tmux load-buffer -b "$BUFFER" "$MSGFILE"
      tmux paste-buffer -d -b "$BUFFER" -t "$TARGET" -p
      sleep 0.5
      tmux send-keys -t "$TARGET" Enter

      # [LAW:dataflow-not-control-flow] carry the goal only when the value is
      # present. It goes in as a queued input *after* the handoff prompt, so it
      # never races the handoff turn — Claude type-aheads it and the session-scoped
      # /goal governs the turns that follow. The /clear or /compact above wiped it.
      if [[ -s "$GOALFILE" ]]; then
        log "re-establishing carried goal"
        sleep 1
        { printf '/goal '; cat "$GOALFILE"; } | tmux load-buffer -b "$GOALBUF" -
        tmux paste-buffer -d -b "$GOALBUF" -t "$TARGET" -p
        sleep 0.5
        tmux send-keys -t "$TARGET" Enter
      fi
    else
      log "MISFIRE: /$RESET did not register; message NOT sent"
      tmux send-keys -t "$TARGET" -l "finalize-session handoff misfired: the scheduled /$RESET never registered, so the queued handoff was NOT sent. Please tell the user the finalize-session handoff misfired."
      sleep 0.5
      tmux send-keys -t "$TARGET" Enter
    fi
    ;;

  iterm-worker)
    if [[ $# -lt 4 ]]; then
      echo "internal error: iterm-worker expects at least 4 args" >&2
      exit 2
    fi
    UUID="$1"
    CLAUDE_PID="$2"
    MSGFILE="$3"
    GOALFILE="$4"
    FLAGS="${5:-}"

    trap 'rm -f "$MSGFILE" "$GOALFILE"' EXIT
    log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }

    log "waking; iterm uuid=$UUID claude_pid=$CLAUDE_PID flags=[$FLAGS]"
    sleep "$HANDOFF_DELAY_SECONDS"

    # Kill the running claude so the launching shell regains the session, then
    # relaunch fresh. TERM first, escalate to KILL if it lingers.
    if kill -0 "$CLAUDE_PID" 2>/dev/null; then
      kill -TERM "$CLAUDE_PID" 2>/dev/null || true
      for _ in $(seq 1 20); do kill -0 "$CLAUDE_PID" 2>/dev/null || break; sleep 0.5; done
      if kill -0 "$CLAUDE_PID" 2>/dev/null; then
        log "claude $CLAUDE_PID survived TERM; sending KILL"
        kill -KILL "$CLAUDE_PID" 2>/dev/null || true
        sleep 1
      fi
      log "claude $CLAUDE_PID terminated"
    else
      log "claude $CLAUDE_PID already gone"
    fi

    # Let the shell draw its prompt before typing into it.
    sleep 2

    # The shell evaluates $(cat MSGFILE), so the whole message rides in the file
    # — no message text is embedded in argv or AppleScript. Build the literal the
    # shell should run, then AppleScript-escape only \ and " for the write.
    RELAUNCH="claude ${FLAGS:+$FLAGS }\"\$(cat '${MSGFILE}')\""
    AS=${RELAUNCH//\\/\\\\}
    AS=${AS//\"/\\\"}

    if osascript <<OSA 2>>/dev/stderr
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (unique id of s) is "${UUID}" then
          write s text "${AS}"
          return
        end if
      end repeat
    end repeat
  end repeat
end tell
OSA
    then
      log "relaunch command sent to iTerm2 session $UUID"
      # [LAW:dataflow-not-control-flow] re-establish the carried goal as a queued
      # input into the freshly relaunched claude — same value-decides-effect shape
      # as tmux. The relaunch started a new process, so the /goal was wiped.
      if [[ -s "$GOALFILE" ]]; then
        # [LAW:no-silent-failure] mirror the tmux worker's read-back: poll the
        # session until the relaunched claude has drawn its banner (input box up,
        # ready for type-ahead) rather than blind-sleeping a fixed boot delay that
        # a slow boot would outrun. Proceed the instant it is ready; if it never
        # becomes ready within the bound, surface the failure below — the carried
        # goal is NEVER logged as re-established when it was not delivered.
        # 'Claude Code v[0-9]' is the fresh-boot banner the tmux worker keys on too.
        log "waiting for relaunched claude to become ready (up to ${CLAUDE_READY_TIMEOUT_SECONDS}s)"
        READY=""
        DEADLINE=$(( $(date +%s) + CLAUDE_READY_TIMEOUT_SECONDS ))
        while [[ $(date +%s) -le $DEADLINE ]]; do
          # Capture then grep a herestring — never `osascript | grep`: with
          # pipefail, grep -q closing the pipe early SIGPIPEs osascript (its output
          # exceeds the pipe buffer), and pipefail would then report a MATCH as a
          # failure, spuriously declaring the session not-ready.
          SNAP=$(_iterm_session_contents "$UUID")
          if grep -qE 'Claude Code v[0-9]' <<<"$SNAP"; then
            READY=1
            break
          fi
          sleep "$CLAUDE_READY_POLL_SECONDS"
        done

        if [[ -z "$READY" ]]; then
          log "ERROR: relaunched claude in session $UUID did not become ready within ${CLAUDE_READY_TIMEOUT_SECONDS}s; carried goal NOT delivered. Deliver it manually once the session is up: /goal $(cat "$GOALFILE")"
        else
          # Ready: let the input box settle a beat, then queue the goal (mirrors
          # the tmux worker's sleep-1 before its goal paste).
          sleep 1
          log "claude ready; re-establishing carried goal"
          GOALCMD="/goal $(cat "$GOALFILE")"
          GAS=${GOALCMD//\\/\\\\}
          GAS=${GAS//\"/\\\"}
          if osascript <<OSA2 2>>/dev/stderr
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (unique id of s) is "${UUID}" then
          write s text "${GAS}"
          return
        end if
      end repeat
    end repeat
  end repeat
end tell
OSA2
          then
            log "carried goal re-established in iTerm2 session $UUID"
          else
            log "ERROR: could not re-establish carried goal in session $UUID"
          fi
        fi
      fi
    else
      log "ERROR: could not write relaunch to iTerm2 session $UUID"
    fi

    # Give the shell time to read the message file before the trap removes it.
    sleep 3
    ;;
esac
