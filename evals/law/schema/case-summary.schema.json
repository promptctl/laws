{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "law-evals/case-summary/3",
  "title": "Sensitivity record of one law-eval case: verdict counts per arm, and each arm read against the no-guidance arm",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "law",
    "case",
    "case_kind",
    "split",
    "model",
    "arms",
    "comparisons"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "law": {
      "type": "string"
    },
    "case": {
      "type": "string"
    },
    "case_kind": {
      "enum": [
        "fork",
        "over-firing"
      ]
    },
    "split": {
      "enum": [
        "tuning",
        "holdout"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "description": "the one model every recorded run was asked for (and, per the harness, served by); null when no run has a record"
    },
    "arms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runs",
          "held",
          "violated",
          "off_fork",
          "inconclusive",
          "failed",
          "run_ids"
        ],
        "properties": {
          "runs": {
            "type": "integer",
            "minimum": 0
          },
          "held": {
            "type": "integer",
            "minimum": 0
          },
          "violated": {
            "type": "integer",
            "minimum": 0
          },
          "off_fork": {
            "type": "integer",
            "minimum": 0
          },
          "inconclusive": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "description": "runs that ended without a record (failed-runs.json); not in runs"
          },
          "run_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control",
          "arm",
          "reading",
          "p_value"
        ],
        "properties": {
          "control": {
            "enum": [
              "none",
              "none+diluted"
            ],
            "description": "the no-guidance arm run in the same context as `arm`"
          },
          "arm": {
            "type": "string"
          },
          "reading": {
            "enum": [
              "separate",
              "regressed",
              "saturated",
              "indistinguishable",
              "unmeasurable"
            ]
          },
          "p_value": {
            "type": [
              "number",
              "null"
            ],
            "description": "two-sided Fisher exact test on held vs violated counts; null when fewer than half of either arm's runs, failed ones included, reached the fork"
          }
        }
      }
    }
  },
  "description": "Frozen as of promptctl-law-evals-qdn.3yt. A change to this schema is its own ticket."
}
