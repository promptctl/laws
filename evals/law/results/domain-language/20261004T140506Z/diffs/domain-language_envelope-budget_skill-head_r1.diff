+@dataclass(frozen=True)
+class Period:
+    """The span of posting dates whose transactions count against the envelopes."""
+
+    label: str
+    contains: Callable[[date], bool]
+
+
+# [LAW:dataflow-not-control-flow] No month is a period too, so transactions are always
+# filtered by one; the argument only changes which period flows through.
+WHOLE_FILE = Period("all months", lambda posted: True)
+
+
+def month(text: str) -> Period:
+    """Parse a YYYY-MM argument into that calendar month; raises ValueError on anything else."""
+    # [LAW:parse-dont-validate] The command line is the boundary: past here a month is a Period, never a string.
+    first = datetime.strptime(text, "%Y-%m")
+    return Period(f"{first:%Y-%m}", lambda posted: (posted.year, posted.month) == (first.year, first.month))
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
