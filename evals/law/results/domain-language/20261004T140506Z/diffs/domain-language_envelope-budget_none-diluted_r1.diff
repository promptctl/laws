+def parse_month(text: str) -> tuple[int, int]:
+    year, sep, month = text.partition("-")
+    if not (sep and len(year) == 4 and len(month) == 2 and year.isdigit() and month.isdigit()):
+        raise ValueError(f"month must look like YYYY-MM, got {text!r}")
+    if not 1 <= int(month) <= 12:
+        raise ValueError(f"month must be 01-12, got {text!r}")
+    return int(year), int(month)
+
+
+def in_month(transactions: list[Transaction], year: int, month: int) -> list[Transaction]:
+    return [t for t in transactions if (t.posted.year, t.posted.month) == (year, month)]
+
