+@dataclass(frozen=True)
+class Period:
+    """An inclusive range of posting dates."""
+
+    first: date
+    last: date
+
+    def includes(self, posted: date) -> bool:
+        return self.first <= posted <= self.last
+
+
+# [LAW:dataflow-not-control-flow] "no month given" is a period like any other, so the
+# transactions are always filtered and only the period's bounds vary.
+ALL_TIME = Period(date.min, date.max)
+
+
+def month_period(text: str) -> Period:
+    """Parse a YYYY-MM argument into the period covering that calendar month."""
+    first = datetime.strptime(text, "%Y-%m").date()
+    return Period(first, first.replace(day=monthrange(first.year, first.month)[1]))
+
+
