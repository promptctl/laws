+# [LAW:parse-dont-validate] the YYYY-MM text is checked once, here at the command line;
+# a malformed month raises and argparse reports it as a usage error.
+def calendar_month(text: str) -> Period:
+    first = datetime.strptime(text, "%Y-%m")
+    return lambda posted: (posted.year, posted.month) == (first.year, first.month)
