+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    def __contains__(self, day: date) -> bool:
+        return (day.year, day.month) == (self.year, self.month)
+
+
+class AllTime:
+    def __contains__(self, day: date) -> bool:
+        return True
+
+
+# [LAW:dataflow-not-control-flow] "no month" is a period like any other, so the
+# transactions are always filtered by period and only the period's value varies.
+Period = Month | AllTime
+
+
+# [LAW:parse-dont-validate] the command line is the one place a month is text; past
+# here it is a Month, and a malformed one is an argparse usage error (exit status 2).
+def parse_month(text: str) -> Month:
+    try:
+        parsed = datetime.strptime(text, "%Y-%m")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"{text!r} is not a month in YYYY-MM form") from None
+    return Month(parsed.year, parsed.month)
+
+
+def parse_period(args: list[str]) -> Period:
+    parser = argparse.ArgumentParser(description="What is left in each envelope after a period's transactions.")
+    parser.add_argument(
+        "period",
+        nargs="?",
+        type=parse_month,
+        default=AllTime(),
+        metavar="YYYY-MM",
+        help="count only this month's transactions (default: every transaction in the file)",
+    )
+    return parser.parse_args(args).period
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
