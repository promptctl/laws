+def parse_period(args: list[str]) -> Period:
+    # [LAW:parse-dont-validate] The command line is checked once, here; what comes out
+    # is a Period, so "no month" is just the period that contains every date.
+    match args:
+        case []:
+            return lambda posted: True
+        case [text]:
+            try:
+                month = datetime.strptime(text, "%Y-%m")
+            except ValueError:
+                raise ValueError(f"not a month (expected YYYY-MM): {text!r}") from None
+            return lambda posted: (posted.year, posted.month) == (month.year, month.month)
+        case _:
+            raise ValueError("expected at most one month")
+
