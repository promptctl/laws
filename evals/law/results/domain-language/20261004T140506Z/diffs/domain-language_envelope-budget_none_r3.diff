+def parse_month(text: str) -> tuple[int, int]:
+    try:
+        year, month = text.split("-")
+        if len(year) != 4 or len(month) != 2:
+            raise ValueError
+        first = date(int(year), int(month), 1)
+    except ValueError:
+        raise ValueError(f"invalid month {text!r}, expected YYYY-MM") from None
+    return first.year, first.month
+
+
+def in_month(transactions: list[Transaction], month: tuple[int, int]) -> list[Transaction]:
+    return [t for t in transactions if (t.posted.year, t.posted.month) == month]
