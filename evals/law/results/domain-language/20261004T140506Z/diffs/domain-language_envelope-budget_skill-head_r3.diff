+# The budget period: decides whether a posting date falls inside it.
+Period = Callable[[date], bool]
+
+
+def all_time(posted: date) -> bool:
+    return True
+
+
+def calendar_month(text: str) -> Period:
+    # [LAW:parse-dont-validate] the command-line text becomes a Period here or is rejected; nothing later re-checks it
+    try:
+        first_day = date.fromisoformat(f"{text}-01")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}") from None
+    return lambda posted: (posted.year, posted.month) == (first_day.year, first_day.month)
+
+
+def parse_period(args: list[str]) -> Period:
+    parser = argparse.ArgumentParser(description="What is left in each envelope after the period's transactions.")
+    # [LAW:dataflow-not-control-flow] no month is the all-time period, so the filter below always runs
+    parser.add_argument("month", nargs="?", type=calendar_month, default=all_time, metavar="YYYY-MM",
+                        help="count only this calendar month's transactions (default: all of them)")
+    return parser.parse_args(args).month
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
