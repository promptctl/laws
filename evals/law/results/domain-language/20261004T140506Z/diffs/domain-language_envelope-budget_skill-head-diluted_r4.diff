+def calendar_month(text: str) -> Period:
+    try:
+        first = date.fromisoformat(f"{text}-01")
+    except ValueError:
+        raise ValueError(f"not a month (expected YYYY-MM): {text!r}") from None
+    return lambda posted: (posted.year, posted.month) == (first.year, first.month)
+
+
+# [LAW:parse-dont-validate] the command line becomes a Period here, once; nothing
+# downstream sees a raw or missing month.
+def parse_period(args: list[str]) -> Period:
+    match args:
+        case []:
+            return all_time
+        case [month]:
+            return calendar_month(month)
+        case _:
+            raise ValueError(f"expected at most one month, got {len(args)} arguments")
