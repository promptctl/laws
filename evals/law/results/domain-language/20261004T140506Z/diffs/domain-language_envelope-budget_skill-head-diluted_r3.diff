+def parse_period(args: list[str]) -> Callable[[date], bool]:
+    """The period the command line asks for, as a test on a transaction's posting date."""
+    # [LAW:dataflow-not-control-flow] "no month" is the period containing every date, so main always filters.
+    if not args:
+        return lambda posted: True
+    (text,) = args
+    month = datetime.strptime(text, "%Y-%m")
+    return lambda posted: (posted.year, posted.month) == (month.year, month.month)
