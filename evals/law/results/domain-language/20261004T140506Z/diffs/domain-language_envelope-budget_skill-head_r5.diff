+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    def __contains__(self, posted: date) -> bool:
+        return (posted.year, posted.month) == (self.year, self.month)
+
+    def __str__(self) -> str:
+        return f"{self.year:04d}-{self.month:02d}"
+
+
+class AllTime:
+    def __contains__(self, posted: date) -> bool:
+        return True
+
+    def __str__(self) -> str:
+        return "all time"
+
+
+Period = Month | AllTime
+
+
+def parse_month(text: str) -> Month:
+    try:
+        parsed = datetime.strptime(text, "%Y-%m")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}") from None
+    return Month(parsed.year, parsed.month)
+
+
+def parse_period(args: list[str]) -> Period:
+    parser = argparse.ArgumentParser(description="What is left in each envelope after a period's transactions.")
+    # [LAW:dataflow-not-control-flow] no month is the AllTime period, not a skipped filter
+    parser.add_argument("month", nargs="?", type=parse_month, default=AllTime(), metavar="YYYY-MM",
+                        help="count only this month's transactions (default: every transaction)")
+    return parser.parse_args(args).month
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
     return [Envelope(name, Decimal(amount)) for name, amount in json.loads(path.read_text()).items()]
 
