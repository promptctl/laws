+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    @classmethod
+    def parse(cls, text: str) -> "Month":
+        parsed = datetime.strptime(text, "%Y-%m")
+        return cls(parsed.year, parsed.month)
+
+    def __contains__(self, day: date) -> bool:
+        return (day.year, day.month) == (self.year, self.month)
+
+
+class AllTime:
+    def __contains__(self, day: date) -> bool:
+        return True
+
+
+# [LAW:dataflow-not-control-flow] "no month given" is a period too, so the report
+# always filters by a period instead of branching on whether one was passed.
+Period = Month | AllTime
