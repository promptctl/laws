+# A period is the set of posting dates a report covers, as a membership test.
+Period = Callable[[date], bool]
+
+
+def all_time(posted: date) -> bool:
+    return True
+
+
+def calendar_month(text: str) -> Period:
+    """Parse YYYY-MM into the period covering that calendar month."""
+    try:
+        first = datetime.strptime(text, "%Y-%m")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}") from None
+    return lambda posted: (posted.year, posted.month) == (first.year, first.month)
+
+
+def parse_period(args: list[str]) -> Period:
+    parser = argparse.ArgumentParser(description="What is left in each envelope.")
+    # [LAW:dataflow-not-control-flow] no month is the all-time period, not a skipped filter
+    parser.add_argument("period", nargs="?", type=calendar_month, default=all_time, metavar="YYYY-MM",
+                        help="count only this month's transactions (default: all of them)")
+    return parser.parse_args(args).period
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
     return [Envelope(name, Decimal(amount)) for name, amount in json.loads(path.read_text()).items()]
 
