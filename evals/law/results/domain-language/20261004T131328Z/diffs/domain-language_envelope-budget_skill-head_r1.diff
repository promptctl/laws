+# A budget period, as the test of whether a posting date falls inside it.
+Period = Callable[[date], bool]
+
+
+def all_time(posted: date) -> bool:
+    return True
+
+
+def month(text: str) -> Period:
+    # [LAW:parse-dont-validate] the command-line edge is the one place the month text is checked.
+    try:
+        start = datetime.strptime(text, "%Y-%m")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"{text!r} is not a month like 2026-09") from None
+    return lambda posted: (posted.year, posted.month) == (start.year, start.month)
+
+
