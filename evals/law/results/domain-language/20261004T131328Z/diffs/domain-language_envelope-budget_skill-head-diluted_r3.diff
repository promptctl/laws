+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    @classmethod
+    def parse(cls, text: str) -> "Month":
+        """Parse YYYY-MM; raises ValueError for anything else."""
+        try:
+            parsed = datetime.strptime(text, "%Y-%m")
+        except ValueError:
+            raise ValueError(f"not a month in YYYY-MM form: {text!r}") from None
+        return cls(parsed.year, parsed.month)
+
+    def contains(self, posted: date) -> bool:
+        return (posted.year, posted.month) == (self.year, self.month)
