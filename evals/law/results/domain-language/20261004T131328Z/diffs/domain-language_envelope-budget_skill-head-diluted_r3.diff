+def parse_period(args: list[str]) -> Callable[[date], bool]:
+    """The budget period named on the command line, as a test on a posting date."""
+    # [LAW:dataflow-not-control-flow] "no month" is the period containing every date,
+    # so main filters unconditionally and only the predicate varies.
+    match args:
+        case []:
+            return lambda posted: True
+        case [text]:
+            return Month.parse(text).contains
+        case _:
+            raise ValueError(f"expected at most one month, got {len(args)} arguments")
+
