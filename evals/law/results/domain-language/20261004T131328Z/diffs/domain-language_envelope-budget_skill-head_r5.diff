+# A reporting period, as the test for whether a posting date falls inside it.
+Period = Callable[[date], bool]
+
+
+def whole_file(posted: date) -> bool:
+    return True
+
+
+def calendar_month(text: str) -> Period:
+    """Parse YYYY-MM; raises ValueError on anything else."""
+    first_day = datetime.strptime(text, "%Y-%m").date()
+    return lambda posted: (posted.year, posted.month) == (first_day.year, first_day.month)
+
+
+def parse_args(args: list[str]) -> Period:
+    parser = argparse.ArgumentParser(description="What is left in each envelope after a period's transactions.")
+    parser.add_argument(
+        "month",
+        nargs="?",
+        type=calendar_month,
+        default=whole_file,
+        metavar="YYYY-MM",
+        help="count only this month's transactions (default: every transaction in the file)",
+    )
+    return parser.parse_args(args).month
+
