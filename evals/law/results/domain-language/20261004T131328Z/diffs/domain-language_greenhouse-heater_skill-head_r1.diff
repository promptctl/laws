+def heater_on(temp_c: float, relay: bool) -> bool:
+    """Whether the relay should be closed for this reading, given its current state.
+
+    Thermostat hysteresis: a heater that is on stays on until the temperature reaches
+    TARGET_C + HYSTERESIS_C, and one that is off stays off until it falls to
+    TARGET_C - HYSTERESIS_C. Inside the deadband the relay holds its state.
+    """
+    # [LAW:dataflow-not-control-flow] the relay state only selects which threshold applies
+    switch_point_c = TARGET_C + HYSTERESIS_C if relay else TARGET_C - HYSTERESIS_C
+    return temp_c < switch_point_c or (temp_c == switch_point_c and not relay)
 
 
