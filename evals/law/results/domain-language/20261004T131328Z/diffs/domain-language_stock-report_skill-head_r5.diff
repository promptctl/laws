+def status(item: Item, lead_time_days: float) -> str:
+    if item.on_hand == 0:
+        return "OUT"
+    # Reorder point: the stock expected to sell during the lead time. Below it, an
+    # order placed today arrives after the shelf is already empty.
+    lead_time_demand = item.daily_sales * lead_time_days
+    return "REORDER" if item.on_hand < lead_time_demand else "ok"
 
 
