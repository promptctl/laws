@@ -31,6 +36,32 @@ class Transaction:
     amount: Decimal
 
 
+# [LAW:dataflow-not-control-flow] The period is a value: transactions are always filtered
+# by one, and "no month given" is simply the period that contains every date.
+Period = Callable[[date], bool]
+
+
+def whole_file(posted: date) -> bool:
+    return True
+
+
+def month_period(text: str) -> Period:
+    # [LAW:parse-dont-validate] The command line is the boundary: a malformed month is
+    # rejected here, so everything past it holds a Period and never re-checks the text.
+    try:
+        month = datetime.strptime(text, "%Y-%m")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}") from None
+    return lambda posted: (posted.year, posted.month) == (month.year, month.month)
+
+
+def parse_period(args: list[str]) -> Period:
+    parser = argparse.ArgumentParser(description="What is left in each envelope.")
+    parser.add_argument("month", nargs="?", type=month_period, default=whole_file, metavar="YYYY-MM",
+                        help="count only this month's transactions (default: every transaction)")
+    return parser.parse_args(args).month
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
     return [Envelope(name, Decimal(amount)) for name, amount in json.loads(path.read_text()).items()]
 
