+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    @classmethod
+    def parse(cls, text: str) -> "Month":
+        match = re.fullmatch(r"(\d{4})-(0[1-9]|1[0-2])", text)
+        if match is None:
+            raise ValueError(f"not a month (expected YYYY-MM): {text!r}")
+        return cls(int(match[1]), int(match[2]))
+
+    def contains(self, day: date) -> bool:
+        return (day.year, day.month) == (self.year, self.month)
+
+
+Period = Callable[[date], bool]
+
+
+# [LAW:dataflow-not-control-flow] the period is always a predicate over posting dates, so
+# the transactions are always filtered; "no month" is the predicate that admits every date.
+def parse_period(args: list[str]) -> Period:
+    match args:
+        case []:
+            return lambda posted: True
+        case [month]:
+            return Month.parse(month).contains
+        case _:
+            raise ValueError(f"expected at most one month, got {len(args)} arguments")
+
+
