+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    @classmethod
+    def parse(cls, text: str) -> "Month":
+        """Parse YYYY-MM; raises ValueError on anything else."""
+        parsed = datetime.strptime(text, "%Y-%m")
+        return cls(parsed.year, parsed.month)
+
+    def __contains__(self, day: date) -> bool:
+        return (day.year, day.month) == (self.year, self.month)
+
+
+class UsageError(Exception):
+    pass
+
+
+def parse_period(args: list[str]) -> Month | None:
+    """The budget period named on the command line; None is the whole file."""
+    # [LAW:parse-dont-validate] the command line is checked here once; main only sees a period
+    match args:
+        case []:
+            return None
+        case [text]:
+            try:
+                return Month.parse(text)
+            except ValueError:
+                raise UsageError(f"not a month (expected YYYY-MM): {text!r}") from None
+        case _:
+            raise UsageError(f"expected at most one month, got {len(args)} arguments")
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
     return [Envelope(name, Decimal(amount)) for name, amount in json.loads(path.read_text()).items()]
 
