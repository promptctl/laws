+def parse_month(text: str) -> tuple[int, int]:
+    year, _, month = text.partition("-")
+    if not (len(year) == 4 and len(month) == 2 and year.isascii() and year.isdigit()
+            and month.isascii() and month.isdigit() and 1 <= int(month) <= 12):
+        raise ValueError(f"month must look like 2026-09, not {text!r}")
+    return int(year), int(month)
+
+
+def in_month(transactions: list[Transaction], month: tuple[int, int]) -> list[Transaction]:
+    return [t for t in transactions if (t.posted.year, t.posted.month) == month]
+
+
