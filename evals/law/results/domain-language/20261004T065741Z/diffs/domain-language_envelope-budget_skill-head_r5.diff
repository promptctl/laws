+# [LAW:dataflow-not-control-flow] The period is a value: transactions are always filtered
+# by one, and "no month given" is the period that contains every date.
+Period = Callable[[date], bool]
+
+
+def all_time(posted: date) -> bool:
+    return True
+
+
+def month(text: str) -> Period:
+    """Parse a calendar month written YYYY-MM into the period covering it."""
+    if not re.fullmatch(r"\d{4}-\d{2}", text):
+        raise ValueError(f"expected YYYY-MM, got {text!r}")
+    first = date.fromisoformat(f"{text}-01")
+    return lambda posted: (posted.year, posted.month) == (first.year, first.month)
+
