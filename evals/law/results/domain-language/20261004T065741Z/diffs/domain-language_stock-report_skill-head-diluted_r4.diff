+def status(item: Item, lead_time_days: float) -> str:
+    # [LAW:dataflow-not-control-flow] lead time is a value passed in, so a supplier
+    # change is a new number, not a new code path.
+    # Reorder point = lead-time demand: what will sell before a new order can arrive.
+    lead_time_demand = item.daily_sales * lead_time_days
+    if item.on_hand == 0:
+        return "OUT"
+    if item.on_hand < lead_time_demand:
+        return "REORDER"
+    return "ok"
 
 
