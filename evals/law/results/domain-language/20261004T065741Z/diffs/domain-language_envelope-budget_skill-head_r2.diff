+@dataclass(frozen=True)
+class Period:
+    """Half-open range of posting dates: start <= posted < end."""
+
+    start: date
+    end: date
+
+    def __contains__(self, posted: date) -> bool:
+        return self.start <= posted < self.end
+
+
+# [LAW:dataflow-not-control-flow] "no month given" is a period like any other, so the
+# report always filters by a period and never branches on whether one was asked for.
+ALL_TIME = Period(date.min, date.max)
+
+
+def parse_month(text: str) -> Period:
+    """The calendar month written as YYYY-MM, e.g. 2026-09."""
+    try:
+        start = datetime.strptime(text, "%Y-%m").date()
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}") from None
+    months = start.year * 12 + start.month  # months since year 0, so this is the following month
+    return Period(start, date(months // 12, months % 12 + 1, 1))
+
+
