+# [LAW:dataflow-not-control-flow] The period is a value: main always filters, and
+# "no month given" is just the period that contains every date.
+Period = Callable[[date], bool]
+
+
+def every_date(posted: date) -> bool:
+    return True
+
+
+def calendar_month(text: str) -> Period:
+    """Parse 'YYYY-MM' into the period covering that calendar month."""
+    try:
+        first = datetime.strptime(text, "%Y-%m")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}") from None
+    return lambda posted: (posted.year, posted.month) == (first.year, first.month)
+
