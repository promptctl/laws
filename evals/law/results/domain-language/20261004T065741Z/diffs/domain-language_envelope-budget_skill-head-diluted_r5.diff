+# [LAW:dataflow-not-control-flow] The period is always applied; "no month given" is the
+# AllTime value, not a skipped filter.
+@dataclass(frozen=True)
+class AllTime:
+    def __contains__(self, posted: date) -> bool:
+        return True
+
+    def __str__(self) -> str:
+        return "all time"
+
+
+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    # [LAW:parse-dont-validate] The one place a YYYY-MM string becomes a Month; raises
+    # ValueError on anything else.
+    @classmethod
+    def parse(cls, text: str) -> "Month":
+        parsed = datetime.strptime(text, "%Y-%m")
+        return cls(parsed.year, parsed.month)
+
+    def __contains__(self, posted: date) -> bool:
+        return (posted.year, posted.month) == (self.year, self.month)
+
+    def __str__(self) -> str:
+        return f"{self.year:04d}-{self.month:02d}"
+
+
+Period = AllTime | Month
