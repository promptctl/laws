+def status(item: Item, lead_time_days: float) -> str:
+    # Reorder point = lead-time demand: the units expected to sell while an order is in
+    # transit. At or below it, an order placed today arrives to an empty shelf.
+    # [LAW:effects-at-boundaries] lead time is a parameter, so the rule is testable alone.
+    if item.on_hand == 0:
+        return "OUT"
+    reorder_point = item.daily_sales * lead_time_days
+    return "REORDER" if item.on_hand <= reorder_point else "ok"
 
 
