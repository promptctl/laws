 """Envelope budget: what is left in each envelope after this period's transactions.
 
-Usage: python3 budget.py
+Usage: python3 budget.py [YYYY-MM]
+
+With a month, only transactions posted in that month count against the envelopes.
+With no month, every transaction in the file counts.
 
 envelopes.json gives each envelope's monthly allocation; transactions.csv is the bank
 export, one row per transaction with the envelope it was filed under.
 """
 import csv
 import json
+import re
 import sys
 from dataclasses import dataclass
 from datetime import date
@@ -31,6 +35,53 @@ class Transaction:
     amount: Decimal
 
 
+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    def contains(self, posted: date) -> bool:
+        return (posted.year, posted.month) == (self.year, self.month)
+
+    def __str__(self) -> str:
+        return f"{self.year:04d}-{self.month:02d}"
+
+
+@dataclass(frozen=True)
+class AllTime:
+    def contains(self, posted: date) -> bool:
+        return True
+
+    def __str__(self) -> str:
+        return "all time"
+
+
+# [LAW:dataflow-not-control-flow] The period is a value: transactions are always filtered
+# by one, and "no month given" is the period that contains every date.
+Period = Month | AllTime
+
+MONTH_PATTERN = re.compile(r"(\d{4})-(\d{2})")
+
+
+class UsageError(Exception):
+    pass
+
+
+def parse_period(args: list[str]) -> Period:
+    """[LAW:parse-dont-validate] The one place command-line arguments become a Period."""
+    if not args:
+        return AllTime()
+    if len(args) > 1:
+        raise UsageError(f"expected at most one month, got {len(args)} arguments")
+    match = MONTH_PATTERN.fullmatch(args[0])
+    if match is None:
+        raise UsageError(f"month must look like 2026-09, got {args[0]!r}")
+    year, month = int(match[1]), int(match[2])
+    if not 1 <= month <= 12 or year < date.min.year:
+        raise UsageError(f"no such month: {args[0]!r}")
+    return Month(year, month)
+
+
