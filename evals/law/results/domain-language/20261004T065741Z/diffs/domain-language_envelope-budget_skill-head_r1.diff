+# [LAW:dataflow-not-control-flow] The period is a value: transactions are always
+# filtered by one, and "no month given" is simply the period that contains every date.
+Period = Callable[[date], bool]
+
+MONTH_PATTERN = re.compile(r"(\d{4})-(0[1-9]|1[0-2])")
+
+
+class UsageError(Exception):
+    pass
+
+
+def every_date(posted: date) -> bool:
+    return True
+
+
+def calendar_month(year: int, month: int) -> Period:
+    return lambda posted: (posted.year, posted.month) == (year, month)
+
+
+def parse_period(args: list[str]) -> Period:
+    """[LAW:parse-dont-validate] The command line becomes a Period here or is rejected."""
+    match args:
+        case []:
+            return every_date
+        case [text] if found := MONTH_PATTERN.fullmatch(text):
+            return calendar_month(int(found[1]), int(found[2]))
+        case [text]:
+            raise UsageError(f"not a month (expected YYYY-MM): {text!r}")
+        case _:
+            raise UsageError(f"expected at most one month, got {len(args)} arguments")
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
     return [Envelope(name, Decimal(amount)) for name, amount in json.loads(path.read_text()).items()]
 
