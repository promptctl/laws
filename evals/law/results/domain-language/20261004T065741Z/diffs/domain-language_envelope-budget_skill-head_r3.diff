+# [LAW:dataflow-not-control-flow] The budget period is a value: transactions are always
+# filtered by one, and "no month given" is simply the period that contains every date.
+Period = Callable[[date], bool]
+
+
+def all_time(posted: date) -> bool:
+    return True
+
+
+def month(text: str) -> Period:
+    """Parse a YYYY-MM argument into the period covering that calendar month."""
+    # [LAW:parse-dont-validate] strptime raises ValueError on anything that is not a real
+    # month; argparse turns that into a usage error, so no unparsed month travels inland.
+    first = datetime.strptime(text, "%Y-%m")
+    return lambda posted: (posted.year, posted.month) == (first.year, first.month)
+
