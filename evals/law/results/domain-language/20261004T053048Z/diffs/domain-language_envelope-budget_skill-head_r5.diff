+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    def __contains__(self, posted: date) -> bool:
+        return (posted.year, posted.month) == (self.year, self.month)
+
+    def __str__(self) -> str:
+        return f"{self.year:04d}-{self.month:02d}"
+
+
+class AllTime:
+    def __contains__(self, posted: date) -> bool:
+        return True
+
+    def __str__(self) -> str:
+        return "all time"
+
+
+# [LAW:dataflow-not-control-flow] "no month given" is a period that contains every date, so
+# the same filter runs on every invocation and only the period value varies.
+Period = Month | AllTime
+
+
+class UsageError(Exception):
+    pass
+
+
+# [LAW:parse-dont-validate] the one place the command line becomes a Period; nothing past
+# here sees the raw argument.
+def parse_period(args: list[str]) -> Period:
+    match args:
+        case []:
+            return AllTime()
+        case [text]:
+            try:
+                parsed = datetime.strptime(text, "%Y-%m")
+            except ValueError:
+                raise UsageError(f"not a month (expected YYYY-MM): {text!r}") from None
+            return Month(parsed.year, parsed.month)
+        case _:
+            raise UsageError(f"expected at most one month, got {len(args)} arguments")
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
     return [Envelope(name, Decimal(amount)) for name, amount in json.loads(path.read_text()).items()]
 
