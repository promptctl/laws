+# [LAW:dataflow-not-control-flow] The period is a predicate over posting dates, so "all
+# time" and "one month" are two values on the same path rather than a filter that is skipped.
+Period = Callable[[date], bool]
+
+
+def all_time(posted: date) -> bool:
+    return True
+
+
+def month(text: str) -> Period:
+    """Parse a YYYY-MM calendar month into the period that contains exactly its dates."""
+    # [LAW:parse-dont-validate] The only place the raw argument is read; a malformed month
+    # is a usage error here, never a period that quietly matches nothing.
+    match = re.fullmatch(r"(\d{4})-(0[1-9]|1[0-2])", text)
+    if match is None:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}")
+    year_month = (int(match[1]), int(match[2]))
+    return lambda posted: (posted.year, posted.month) == year_month
+
+
