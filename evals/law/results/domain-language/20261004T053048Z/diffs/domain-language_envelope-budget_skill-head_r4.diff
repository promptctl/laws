+@dataclass(frozen=True)
+class Period:
+    """The span of posting dates a report covers."""
+
+    label: str
+    contains: Callable[[date], bool]
+
+
+ALL_TIME = Period("all time", lambda posted: True)
+
+
+def parse_month(text: str) -> Period:
+    # [LAW:parse-dont-validate] the command line is the one place a month is checked;
+    # everything past it holds a Period and never re-reads the string.
+    try:
+        first = datetime.strptime(text, "%Y-%m")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"{text!r} is not a month; expected YYYY-MM, e.g. 2026-09") from None
+    return Period(f"{first:%Y-%m}", lambda posted: (posted.year, posted.month) == (first.year, first.month))
+
+
