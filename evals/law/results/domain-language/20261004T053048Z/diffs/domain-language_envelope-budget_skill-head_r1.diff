+# [LAW:dataflow-not-control-flow] The period is always applied; "no month given" is
+# the period that contains every date, not a skipped filter.
+Period = Callable[[date], bool]
+
+
+def all_time(posted: date) -> bool:
+    return True
+
+
+# [LAW:parse-dont-validate] The only place the month argument is checked: it returns a
+# Period or fails argument parsing, so nothing downstream sees the raw string.
+def calendar_month(text: str) -> Period:
+    match = re.fullmatch(r"(\d{4})-(\d{2})", text)
+    if match is None:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}")
+    year, month = int(match[1]), int(match[2])
+    if not 1 <= month <= 12:
+        raise argparse.ArgumentTypeError(f"no such month: {text!r}")
+    return lambda posted: (posted.year, posted.month) == (year, month)
+
