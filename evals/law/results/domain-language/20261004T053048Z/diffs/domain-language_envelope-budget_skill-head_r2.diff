+def parse_month(text: str) -> Period:
+    """The argparse type for the month argument: 'YYYY-MM' -> that calendar month."""
+    try:
+        first = datetime.strptime(text, "%Y-%m")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}") from None
+    return Period(f"{first:%Y-%m}", lambda posted: (posted.year, posted.month) == (first.year, first.month))
+
