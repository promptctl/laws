+class UsageError(Exception):
+    pass
+
+
+# [LAW:dataflow-not-control-flow] The period is a value: transactions are always filtered
+# by one, and "no month given" is the period that contains every date.
+@dataclass(frozen=True)
+class Month:
+    year: int
+    month: int
+
+    @classmethod
+    def parse(cls, text: str) -> "Month":
+        try:
+            first = datetime.strptime(text, "%Y-%m")
+        except ValueError:
+            raise UsageError(f"bad month {text!r}; expected YYYY-MM, like 2026-09") from None
+        return cls(first.year, first.month)
+
+    def __contains__(self, day: date) -> bool:
+        return (day.year, day.month) == (self.year, self.month)
+
+
+@dataclass(frozen=True)
+class AllTime:
+    def __contains__(self, day: date) -> bool:
+        return True
+
+
+Period = Month | AllTime
+
+
+# [LAW:parse-dont-validate] The command line is checked here once; main only sees a Period.
+def parse_period(args: list[str]) -> Period:
+    match args:
+        case []:
+            return AllTime()
+        case [text]:
+            return Month.parse(text)
+        case _:
+            raise UsageError(f"expected at most one month, got {len(args)} arguments")
+
+
