+def parse_period(args: list[str]) -> Period:
+    """The period named on the command line; raises ValueError when it is not one."""
+    # [LAW:dataflow-not-control-flow] no month is a period too (all time), so the filter always runs
+    match args:
+        case []:
+            return lambda posted: True
+        case [text]:
+            month = datetime.strptime(text, "%Y-%m")
+            return lambda posted: (posted.year, posted.month) == (month.year, month.month)
+        case _:
+            raise ValueError(f"expected at most one month, got {len(args)} arguments")
