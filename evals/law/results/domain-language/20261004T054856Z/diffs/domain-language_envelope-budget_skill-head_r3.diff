+@dataclass(frozen=True)
+class Period:
+    """Half-open range of posting dates: first <= posted < end."""
+
+    first: date
+    end: date
+
+    def __contains__(self, posted: date) -> bool:
+        return self.first <= posted < self.end
+
+
+# [LAW:dataflow-not-control-flow] "no month" is just the widest period, so filtering always runs.
+ALL_TIME = Period(date.min, date.max)
+
+
+def parse_month(text: str) -> Period:
+    """The calendar month written as YYYY-MM; raises ValueError for anything else."""
+    year, _, month = text.partition("-")
+    if (len(year), len(month)) != (4, 2):
+        raise ValueError(f"expected a month as YYYY-MM, got {text!r}")
+    first = date(int(year), int(month), 1)
+    end = date(first.year + first.month // 12, first.month % 12 + 1, 1)
+    return Period(first, end)
+
+
+def parse_period(args: list[str]) -> Period:
+    """The period the command-line arguments ask for: one month, or all time when there are none."""
+    if len(args) > 1:
+        raise ValueError(f"expected at most one month, got {len(args)}")
+    return parse_month(args[0]) if args else ALL_TIME
+
+
 def load_envelopes(path: Path = ENVELOPES_FILE) -> list[Envelope]:
     return [Envelope(name, Decimal(amount)) for name, amount in json.loads(path.read_text()).items()]
 
