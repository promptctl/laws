+# [LAW:dataflow-not-control-flow] The budget period is a value: a predicate over posting
+# dates. The report always filters by one; "no month given" is just the period that
+# contains every date.
+Period = Callable[[date], bool]
+
+
+def all_time(posted: date) -> bool:
+    return True
+
+
+def parse_month(text: str) -> Period:
+    """Parse a calendar month written YYYY-MM into the period covering it."""
+    # [LAW:parse-dont-validate] The argument is checked once, here; a malformed month
+    # raises ValueError rather than becoming a period that silently matches nothing.
+    try:
+        first_day = date.fromisoformat(f"{text}-01")
+    except ValueError:
+        raise ValueError(f"not a month (expected YYYY-MM): {text!r}") from None
+    return lambda posted: (posted.year, posted.month) == (first_day.year, first_day.month)
+
+
