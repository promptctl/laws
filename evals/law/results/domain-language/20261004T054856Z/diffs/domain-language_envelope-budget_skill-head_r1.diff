+@dataclass(frozen=True)
+class Period:
+    """An inclusive range of posting dates."""
+
+    first: date
+    last: date
+
+    def includes(self, day: date) -> bool:
+        return self.first <= day <= self.last
+
+
+# [LAW:dataflow-not-control-flow] "no month given" is a period too, so the filter always runs.
+ALL_TIME = Period(date.min, date.max)
+
+
+def month_period(text: str) -> Period:
+    """Parse a YYYY-MM argument into that calendar month; raises ValueError otherwise."""
+    first = datetime.strptime(text, "%Y-%m").date()
+    return Period(first, first.replace(day=calendar.monthrange(first.year, first.month)[1]))
+
+
