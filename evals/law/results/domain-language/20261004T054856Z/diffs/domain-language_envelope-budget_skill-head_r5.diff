+@dataclass(frozen=True)
+class Period:
+    label: str
+    contains: Callable[[date], bool]
+
+
+ALL_TIME = Period("all time", lambda posted: True)
+
+
+def parse_month(text: str) -> Period:
+    try:
+        first = date.fromisoformat(f"{text}-01")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"expected a month as YYYY-MM, got {text!r}") from None
+    return Period(text, lambda posted: (posted.year, posted.month) == (first.year, first.month))
