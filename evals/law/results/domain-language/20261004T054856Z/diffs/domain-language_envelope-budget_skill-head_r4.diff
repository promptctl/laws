+    @classmethod
+    def parse(cls, text: str) -> "Month":
+        # [LAW:parse-dont-validate] the one place a YYYY-MM string becomes a Month; bad input raises
+        match = re.fullmatch(r"(\d{4})-(0[1-9]|1[0-2])", text)
