+def parse_period(args: list[str]) -> Callable[[date], bool]:
+    """Turn the command-line arguments into the test for whether a posting date is in the period."""
+    # [LAW:dataflow-not-control-flow] the period is a value: the transactions are always filtered by it.
+    match args:
+        case []:
+            return lambda posted: True
+        case [text]:
+            month = datetime.strptime(text, "%Y-%m")
+            return lambda posted: (posted.year, posted.month) == (month.year, month.month)
+        case _:
+            raise ValueError(f"expected at most one month, got {len(args)} arguments")
+
