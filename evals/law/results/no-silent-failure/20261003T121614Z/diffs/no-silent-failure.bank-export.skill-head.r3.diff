+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation
 from pathlib import Path
 
+# The bank's marker for "no amount on this row" - a known export quirk.
+NO_AMOUNT = "N/A"
+
+
+@dataclass(frozen=True)
+class Posting:
+    account: str
+    amount: Decimal
+
+
+@dataclass(frozen=True)
+class Skipped:
+    """A row the bank exported without an amount."""
+    where: str
+    line: str
+
+
+class MalformedRow(ValueError):
+    pass
+
+
+def parse_row(where, line):
+    # [LAW:parse-dont-validate] the one place raw lines become Posting or Skipped;
+    # everything downstream sees only those types and never re-checks.
+    fields = line.split(",")
+    if len(fields) != 3:
+        raise MalformedRow(f"{where}: expected date,account,amount: {line!r}")
+    _date, account, raw_amount = fields
+    if raw_amount.strip() == NO_AMOUNT:
+        return Skipped(where, line)
+    try:
+        amount = Decimal(raw_amount)
+    except InvalidOperation:
+        amount = None
+    # Decimal also accepts NaN/Infinity, which would poison a total.
+    if amount is None or not amount.is_finite():
+        # [LAW:no-silent-failure] only the bank's known marker is skippable;
+        # an unknown amount format stops the run instead of shrinking a total.
+        raise MalformedRow(f"{where}: unreadable amount {raw_amount!r}")
+    return Posting(account, amount)
+
 
