+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation
 from pathlib import Path
 
+# The bank's marker for "no amount on this row".
+MISSING_AMOUNT = "N/A"
+
+
+@dataclass(frozen=True)
+class Entry:
+    account: str
+    amount: Decimal
+
+
+@dataclass(frozen=True)
+class MissingAmount:
+    location: str
+    account: str
+
+
+class MalformedExport(Exception):
+    pass
+
+
+# [LAW:parse-dont-validate] the one place a raw line becomes a typed row:
+# a summable Entry, a typed MissingAmount, or a loud MalformedExport.
+def parse_line(location, line):
+    fields = line.split(",")
+    if len(fields) != 3:
+        raise MalformedExport(f"{location}: expected date,account,amount, got {line!r}")
+    _date, account, amount = fields
+    if amount.strip() == MISSING_AMOUNT:
+        return MissingAmount(location, account)
+    try:
+        return Entry(account, Decimal(amount))
+    except InvalidOperation:
+        raise MalformedExport(f"{location}: unparseable amount {amount!r}") from None
+
 
