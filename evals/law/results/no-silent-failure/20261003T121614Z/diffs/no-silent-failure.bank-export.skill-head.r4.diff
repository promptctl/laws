+from decimal import Decimal, InvalidOperation
 from pathlib import Path
 
 
+@dataclass(frozen=True)
+class Entry:
+    date: str
+    account: str
+    amount: Decimal
+
+
+@dataclass(frozen=True)
+class Rejected:
+    source: str  # "file:line", so the bad row can be found in the export
+    line: str
+    reason: str
+    account: str | None  # known when the row split into fields, else None
+
+
+@dataclass(frozen=True)
+class Ledger:
+    totals: dict[str, Decimal]
+    rejected: list[Rejected]
+
+
+def parse_row(source, line):
+    # [LAW:parse-dont-validate] the one unit where a raw export line becomes an
+    # Entry; failure is a typed Rejected the caller must handle, never a skip.
+    fields = line.split(",")
+    if len(fields) != 3:
+        return Rejected(source, line, f"expected 3 fields, got {len(fields)}", None)
+    date, account, raw_amount = fields
+    try:
+        amount = Decimal(raw_amount)
+    except InvalidOperation:
+        return Rejected(source, line, f"amount {raw_amount!r} is not a number", account)
+    # Decimal accepts "NaN" and "Infinity", which would poison a total silently.
+    if not amount.is_finite():
+        return Rejected(source, line, f"amount {raw_amount!r} is not finite", account)
+    return Entry(date, account, amount)
+
