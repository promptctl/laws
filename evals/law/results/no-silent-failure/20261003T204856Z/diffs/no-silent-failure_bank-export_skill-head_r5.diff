 import sys
 from decimal import Decimal
 from pathlib import Path
 
 
+# The bank's marker for "no amount available" in the amount column.
+AMOUNT_UNAVAILABLE = "N/A"
+
+
+def parse_amount(text):
+    """Return the amount as a Decimal, or None for the bank's N/A marker.
+
+    Anything else that is not a number still raises: only the known marker
+    is an expected absence.
+    """
+    # [LAW:parse-dont-validate] the one place the amount column is interpreted;
+    # absence is a distinct value, never a zero that looks like a real amount.
+    text = text.strip()
+    if text == AMOUNT_UNAVAILABLE:
+        return None
+    return Decimal(text)
+
+
 def read_rows(path):
