+@dataclass(frozen=True)
+class UnreadableAmount:
+    """A row whose amount column is not a finite number."""
+    path: Path
+    line_number: int
+    account: str
+    raw_amount: str
+
+
+def parse_row(path, line_number, line):
+    # [LAW:parse-dont-validate] The one place the amount column is checked:
+    # a row leaves here as an Entry with a finite Decimal or as an
+    # UnreadableAmount, so nothing downstream re-examines the text.
+    _date, account, raw_amount = line.split(",")
+    try:
+        amount = Decimal(raw_amount)
+    except InvalidOperation:
+        return UnreadableAmount(path, line_number, account, raw_amount)
+    # Decimal accepts "NaN" and "Infinity"; either would poison the account's sum.
+    if not amount.is_finite():
+        return UnreadableAmount(path, line_number, account, raw_amount)
+    return Entry(account, amount)
+
