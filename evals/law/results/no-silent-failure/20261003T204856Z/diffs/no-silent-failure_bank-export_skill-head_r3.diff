 import sys
+from dataclasses import dataclass
 from decimal import Decimal
 from pathlib import Path
 
+# The bank's placeholder for an amount it did not export.
+MISSING_AMOUNT = "N/A"
+
+
+@dataclass(frozen=True)
+class Posting:
+    account: str
+    amount: Decimal
+
+
+@dataclass(frozen=True)
+class MissingAmount:
+    """A row the bank exported without an amount; it cannot be summed."""
+    path: Path
+    line_number: int
+    date: str
+    account: str
+
+
+# [LAW:parse-dont-validate] The one place a raw line becomes a Posting or a
+# MissingAmount; nothing downstream re-inspects the amount text.
+def parse_row(path, line_number, line):
+    date, account, amount = line.split(",")
+    if amount.strip() == MISSING_AMOUNT:
+        return MissingAmount(path, line_number, date, account)
+    return Posting(account, Decimal(amount))
+
 
