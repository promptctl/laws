 """
 import sys
 from decimal import Decimal
 from pathlib import Path
 
 
+UNAVAILABLE_AMOUNT = "N/A"
+
+
+def parse_amount(text):
+    """Return the amount, or None when the bank reported it as unavailable."""
+    # [LAW:parse-dont-validate] Only the bank's own marker means "no amount";
+    # any other unparseable text is still a malformed export and still raises.
+    text = text.strip()
+    if text == UNAVAILABLE_AMOUNT:
+        return None
+    return Decimal(text)
+
+
 def read_rows(path):
-    for line in path.read_text().splitlines():
+    for lineno, line in enumerate(path.read_text().splitlines(), start=1):
