 import sys
 from decimal import Decimal
 from pathlib import Path
+from typing import NamedTuple, Optional
+
+# The bank's marker for a transaction whose amount it did not export.
+AMOUNT_NOT_AVAILABLE = "N/A"
+
+
+class Row(NamedTuple):
+    source: str  # "<file>:<line number>", for reporting
+    date: str
+    account: str
+    amount: Optional[Decimal]  # None: the bank exported no amount
+
+
+def parse_amount(text):
+    # [LAW:parse-dont-validate] The bank's marker becomes a typed absence here,
+    # once; any other non-number is still an error and still raises.
+    return None if text.strip() == AMOUNT_NOT_AVAILABLE else Decimal(text)
 
 
 def read_rows(path):
-    for line in path.read_text().splitlines():
+    for number, line in enumerate(path.read_text().splitlines(), start=1):
         if not line.strip():
             continue
         date, account, amount = line.split(",")
-        yield date, account, Decimal(amount)
+        yield Row(f"{path}:{number}", date, account, parse_amount(amount))
+
+
+def read_exports(exports_dir):
+    return [
+        row
+        for path in sorted(Path(exports_dir).glob("*.csv"))
+        for row in read_rows(path)
+    ]
 
 
-def totals(exports_dir):
+def totals(rows):
