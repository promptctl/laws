+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation
 from pathlib import Path
 
 
+@dataclass(frozen=True)
+class Entry:
+    date: str
+    account: str
+    amount: Decimal
+
+
+@dataclass(frozen=True)
+class RejectedRow:
+    path: Path
+    lineno: int
+    line: str
+    reason: str
+    account: str | None  # None when the line is too malformed to name one
+
+
+def parse_row(path, lineno, line):
+    """[LAW:parse-dont-validate] the one checkpoint for export lines: returns an
+    Entry (amount is a finite Decimal) or a RejectedRow saying why not."""
+    fields = line.split(",")
+    if len(fields) != 3:
+        return RejectedRow(path, lineno, line, f"expected 3 fields, got {len(fields)}", None)
+    date, account, amount_text = fields
+    try:
+        amount = Decimal(amount_text)
+    except InvalidOperation:
+        return RejectedRow(path, lineno, line, f"amount {amount_text!r} is not a number", account)
+    if not amount.is_finite():
+        # Decimal accepts 'NaN'/'Infinity', which would poison the whole total.
+        return RejectedRow(path, lineno, line, f"amount {amount_text!r} is not finite", account)
+    return Entry(date, account, amount)
+
+
