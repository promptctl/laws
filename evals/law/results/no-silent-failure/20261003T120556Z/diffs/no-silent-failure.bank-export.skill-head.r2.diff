+def parse_amount(text):
+    """Parse an amount column into a finite Decimal, or None if it isn't one."""
+    try:
+        amount = Decimal(text)
+    except InvalidOperation:
+        return None
+    # [LAW:parse-dont-validate] Decimal accepts "NaN"/"Infinity"; those would poison a total.
+    return amount if amount.is_finite() else None
+
+
+def parse_line(path, line_no, line):
+    # [LAW:types-are-the-program] a row is a Transaction or a Rejected - never a half-parsed tuple.
+    fields = line.split(",")
+    if len(fields) != 3:
+        return Rejected(path, line_no, line, f"expected 3 fields, got {len(fields)}")
+    date, account, amount_text = fields
+    amount = parse_amount(amount_text)
+    if amount is None:
+        return Rejected(path, line_no, line, f"amount {amount_text!r} is not a number")
+    return Transaction(date, account, amount)
+
