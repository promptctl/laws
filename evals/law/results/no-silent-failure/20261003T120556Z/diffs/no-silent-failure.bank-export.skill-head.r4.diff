+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation
 from pathlib import Path
 
 
+@dataclass(frozen=True)
+class Entry:
+    date: str
+    account: str
+    amount: Decimal
+
+
+@dataclass(frozen=True)
+class Rejected:
+    path: Path
+    lineno: int
+    line: str
+    reason: str
+
+
+def parse_amount(text):
+    # [LAW:parse-dont-validate] the one checkpoint for amounts: a finite Decimal
+    # or None. Decimal() also accepts "NaN"/"Infinity", which would poison a sum.
+    try:
+        amount = Decimal(text)
+    except InvalidOperation:
+        return None
+    return amount if amount.is_finite() else None
+
+
+def parse_line(path, lineno, line):
+    fields = line.split(",")
+    if len(fields) != 3:
+        return Rejected(path, lineno, line, f"expected 3 fields, got {len(fields)}")
+    date, account, amount_text = fields
+    amount = parse_amount(amount_text)
+    if amount is None:
+        return Rejected(path, lineno, line, f"amount {amount_text!r} for {account} is not a number")
+    return Entry(date, account, amount)
+
+
