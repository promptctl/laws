+def _check_object(raw, where, fields, defaults):
+    """Problems with one JSON object: wrong shape, unknown, missing or ill-typed keys."""
+    if not isinstance(raw, dict):
+        return [f"{where}: must be an object, got {raw!r}"]
+    problems = []
+    for key in raw.keys() - fields.keys():
+        close = get_close_matches(key, fields, n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    for key, (ok, expected) in fields.items():
+        if key not in raw:
+            if key not in defaults:
+                problems.append(f'{where}: missing "{key}"')
+        elif not ok(raw[key]):
+            problems.append(f'{where}: "{key}" must be {expected}, got {raw[key]!r}')
+    return sorted(problems)
+
+
+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError naming every mistake.
+
+    [LAW:parse-dont-validate] This is the only place the policy's shape is checked;
+    everything that deletes takes the Policy it returns, so no rule is ever read
+    for the first time halfway through a run.
+    """
+    problems = _check_object(raw, "policy", POLICY_FIELDS, POLICY_DEFAULTS)
+    rules = raw.get("rules") if isinstance(raw, dict) else None
+    rules = rules if isinstance(rules, list) else []
+    for i, rule in enumerate(rules):
+        problems += _check_object(rule, f"rules[{i}]", RULE_FIELDS, {})
+    if not problems:
+        # A snapshot matching two prefixes would belong to two rules at once.
+        for j, later in enumerate(rules):
+            for i, earlier in enumerate(rules[:j]):
+                a, b = earlier["prefix"], later["prefix"]
+                if a.startswith(b) or b.startswith(a):
+                    problems.append(
+                        f'rules[{j}]: prefix "{b}" overlaps rules[{i}] prefix "{a}"'
+                    )
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", POLICY_DEFAULTS["dry_run"]),
+        rules=tuple(Rule(rule["prefix"], rule["keep"]) for rule in rules),
+    )
+
+
+def apply(policy):
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError(
+            [f'policy: "snapshot_dir" {str(policy.snapshot_dir)!r} is not a directory']
+        )
+    # The whole list is worked out before the first deletion.
+    for path in expired(policy):
+        if policy.dry_run:
             print(f"would delete {path}")
         else:
             path.unlink()
             print(f"deleted {path}")
+
+
+def snapshots(root, prefix):
+    """Newest first: names end in an ISO date, so name order is age order."""
+    return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
+
+
+def expired(policy):
+    """Every snapshot the policy no longer keeps, rule by rule."""
+    return [
+        path
+        for rule in policy.rules
+        for path in snapshots(policy.snapshot_dir, rule.prefix)[rule.keep:]
+    ]
