@@ -0,0 +1,95 @@
+"""Parse the contents of a retention policy file into a Policy, or say what is wrong with it."""
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+
+class PolicyError(ValueError):
+    """Every problem found in a policy, one message per problem."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def parse(raw):
+    """Turn decoded policy JSON into a Policy; raise PolicyError listing every mistake."""
+    # [LAW:parse-dont-validate] The only place policy shape is checked: retention
+    # takes a Policy, so no rule can reach a deletion with a field missing.
+    if not isinstance(raw, dict):
+        raise PolicyError(["the policy must be a JSON object"])
+    problems = _unknown_keys(raw, ("snapshot_dir", "dry_run", "rules"), "policy")
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if not isinstance(snapshot_dir, str) or not snapshot_dir:
+        problems.append(f'policy: "snapshot_dir" must be a non-empty string, got {_show(raw, "snapshot_dir")}')
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append(f'policy: "dry_run" must be true or false, got {dry_run!r}')
+
+    raw_rules = raw.get("rules")
+    if not isinstance(raw_rules, list):
+        problems.append(f'policy: "rules" must be a list, got {_show(raw, "rules")}')
+        raw_rules = []
+    for index, raw_rule in enumerate(raw_rules):
+        problems += _rule_problems(raw_rule, f"rules[{index}]")
+    if problems:
+        raise PolicyError(problems)
+
+    rules = tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules)
+    problems = _overlapping_prefixes(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, rules)
+
+
+def _rule_problems(raw_rule, where):
+    if not isinstance(raw_rule, dict):
+        return [f"{where}: a rule must be a JSON object, got {raw_rule!r}"]
+    problems = _unknown_keys(raw_rule, ("prefix", "keep"), where)
+    prefix = raw_rule.get("prefix")
+    if not isinstance(prefix, str) or not prefix:
+        problems.append(f'{where}: "prefix" must be a non-empty string, got {_show(raw_rule, "prefix")}')
+    keep = raw_rule.get("keep")
+    # bool is an int subclass: without the type check, "keep": true would mean keep 1.
+    if type(keep) is not int or keep < 0:
+        problems.append(f'{where}: "keep" must be a whole number, 0 or more, got {_show(raw_rule, "keep")}')
+    return problems
+
+
+def _unknown_keys(obj, known, where):
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = get_close_matches(key, known, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    return problems
+
+
+def _overlapping_prefixes(rules):
+    """A snapshot must belong to one rule, so no prefix may start with another."""
+    return [
+        f'rules[{i}] and rules[{j}]: prefixes "{a.prefix}" and "{b.prefix}" match the same snapshots'
+        for i, a in enumerate(rules)
+        for j, b in enumerate(rules)
+        if i < j and (a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix))
+    ]
+
+
+def _show(obj, key):
+    return repr(obj[key]) if key in obj else "nothing (the key is missing)"
