+    # Everything that can be wrong with the policy is found here, before delete runs.
+    try:
+        with open(argv[1]) as f:
+            parsed = policy.parse(json.load(f))
+        doomed = retention.plan(parsed)
+    except OSError as e:
+        problems = [str(e)]
+    except json.JSONDecodeError as e:
+        problems = [f"not valid JSON: {e}"]
+    except policy.PolicyError as e:
+        problems = e.problems
+    else:
+        retention.delete(doomed, parsed.dry_run)
+        return 0
+    print(f"prune.py: {argv[1]} has a mistake; nothing was deleted:", file=sys.stderr)
+    for problem in problems:
+        print(f"  {problem}", file=sys.stderr)
+    return 1
 
 
