+
+def _key_problems(where, obj, required, optional=frozenset()):
+    allowed = required | optional
+    for key in sorted(required - obj.keys()):
+        yield f'{where}: missing "{key}"'
+    for key in sorted(obj.keys() - allowed, key=str):
+        close = difflib.get_close_matches(str(key), allowed, n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        yield f'{where}: unknown key "{key}"{hint}'
+
+
+def _is_count(value):
