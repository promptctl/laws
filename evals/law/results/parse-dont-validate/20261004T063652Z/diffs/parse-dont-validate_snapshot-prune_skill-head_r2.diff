+class PolicyError(Exception):
+    """The policy file is wrong; `problems` lists every mistake found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError.
+
+    [LAW:parse-dont-validate] The whole policy is checked here, before any rule
+    runs; apply() only accepts the Policy this returns, so it cannot start
+    deleting on a policy whose later rules are broken.
+    """
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy: must be a JSON object"])
+
+    problems = list(_key_problems("policy", raw, {"snapshot_dir", "rules"}, {"dry_run"}))
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if "snapshot_dir" in raw:
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append('policy: "snapshot_dir" must be a non-empty string')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'policy: "snapshot_dir" {snapshot_dir!r} is not an existing directory')
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append('policy: "dry_run" must be true or false')
+
+    raw_rules = raw.get("rules", [])
+    if not isinstance(raw_rules, list):
+        problems.append('policy: "rules" must be a list')
+        raw_rules = []
+
+    prefixes = []
+    for i, rule in enumerate(raw_rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where}: must be a JSON object")
+            continue
+        prefix = rule.get("prefix")
+        if isinstance(prefix, str):
+            where += f' (prefix "{prefix}")'
+        problems.extend(_key_problems(where, rule, {"prefix", "keep"}))
+        if "prefix" in rule:
+            if not isinstance(prefix, str) or not prefix:
+                problems.append(f'{where}: "prefix" must be a non-empty string')
+            elif GLOB_OR_PATH_CHARS & set(prefix):
+                problems.append(f'{where}: "prefix" must not contain any of * ? [ / \\')
+            else:
+                prefixes.append((where, prefix))
+        if "keep" in rule and not _is_count(rule["keep"]):
+            problems.append(f'{where}: "keep" must be a whole number, 0 or more')
+
+    # Each snapshot must belong to exactly one rule, or the smaller "keep" silently wins.
+    for n, (where, prefix) in enumerate(prefixes):
+        for other_where, other in prefixes[:n]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(f"{where}: matches the same files as {other_where}")
+
+    if problems:
