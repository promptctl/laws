 """Delete the snapshots a retention policy no longer keeps."""
+from dataclasses import dataclass
+from difflib import get_close_matches
 from pathlib import Path
 
 
+class PolicyError(ValueError):
+    """The policy cannot be applied; `problems` names every mistake found.
+
+    Only ever raised before the first deletion.
+    """
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def _is_text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int subclass; `"keep": true` is a mistake, not keep=1
+    return type(value) is int and value >= 0
+
+
+# field name -> (accepts, what to tell the user it must be)
+_POLICY_FIELDS = {
+    "snapshot_dir": (_is_text, "a non-empty string"),
+    "dry_run": (lambda value: isinstance(value, bool), "true or false"),
+    "rules": (lambda value: isinstance(value, list), "a list of rules"),
+}
+_RULE_FIELDS = {
+    "prefix": (_is_text, "a non-empty string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+
+
+def _field_problems(where, obj, fields, optional=()):
+    if not isinstance(obj, dict):
+        return [f"{where}: must be an object, got {obj!r}"]
+    problems = []
+    for key in obj:
+        if key not in fields:
+            close = get_close_matches(key, fields, n=1)
+            hint = f" (did you mean {close[0]!r}?)" if close else ""
+            problems.append(f"{where}: unknown key {key!r}{hint}")
+    for name, (accepts, expected) in fields.items():
+        if name not in obj:
+            if name not in optional:
+                problems.append(f"{where}: missing {name!r}")
+        elif not accepts(obj[name]):
+            problems.append(f"{where}: {name!r} must be {expected}, got {obj[name]!r}")
+    return problems
+
+
+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError.
+
+    [LAW:parse-dont-validate] the only way to get a Policy, so apply() and
+    prune() never meet a missing or mistyped field halfway through deleting.
+    """
+    problems = _field_problems("policy", raw, _POLICY_FIELDS, optional=("dry_run",))
+    rules = raw.get("rules") if isinstance(raw, dict) else None
+    rules = rules if isinstance(rules, list) else []
+
+    prefixes = []
+    for number, rule in enumerate(rules, start=1):
+        prefix = rule.get("prefix") if isinstance(rule, dict) else None
+        where = f"rule {number} (prefix {prefix!r})" if _is_text(prefix) else f"rule {number}"
+        problems += _field_problems(where, rule, _RULE_FIELDS)
+        if _is_text(prefix):
+            prefixes.append((number, prefix))
+
+    # A snapshot must belong to exactly one rule, or two `keep` counts fight over it.
+    for i, (number_a, a) in enumerate(prefixes):
+        for number_b, b in prefixes[i + 1:]:
+            if a.startswith(b) or b.startswith(a):
+                problems.append(
+                    f"rules {number_a} and {number_b}: prefixes {a!r} and {b!r} "
+                    "match the same snapshots"
+                )
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", False),
+        rules=tuple(Rule(rule["prefix"], rule["keep"]) for rule in rules),
+    )
+
