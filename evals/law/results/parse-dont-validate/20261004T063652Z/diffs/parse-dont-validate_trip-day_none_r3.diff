+def day_problem(day):
+    """Why `day` isn't a usable ?day= value, or None if it is one."""
+    if not day:
+        return "day is required, as YYYY-MM-DD"
+    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", day, re.ASCII):
+        return f"day must look like YYYY-MM-DD, got {day!r}"
+    try:
+        date.fromisoformat(day)
+    except ValueError as e:
+        return f"day {day!r} is not a real calendar date: {e}"
+    return None
