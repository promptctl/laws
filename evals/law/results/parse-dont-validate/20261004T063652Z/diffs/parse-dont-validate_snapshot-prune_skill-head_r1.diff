@@ -0,0 +1,107 @@
+"""Parse a retention policy document into a Policy, reporting every mistake in it at once."""
+import difflib
+import json
+from dataclasses import dataclass
+from itertools import combinations
+from pathlib import Path
+from typing import Callable
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+# [LAW:parse-dont-validate] A Policy can only come out of parse(), so anything
+# that takes one (retention.apply) never has to re-check the policy file.
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+class PolicyError(Exception):
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+REQUIRED = object()
+
+
+@dataclass(frozen=True)
+class Field:
+    accepts: Callable
+    expected: str
+    default: object = REQUIRED
+
+
+def _is_text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is a subclass of int; `"keep": true` is not a count
+    return type(value) is int and value >= 0
+
+
+POLICY_FIELDS = {
+    "snapshot_dir": Field(_is_text, "a non-empty string"),
+    "dry_run": Field(lambda v: type(v) is bool, "true or false", default=False),
+    "rules": Field(lambda v: isinstance(v, list), "a list of rules"),
+}
+RULE_FIELDS = {
+    "prefix": Field(_is_text, "a non-empty string"),
+    "keep": Field(_is_count, "a whole number, 0 or more"),
+}
+
+
+def _read(obj, where, fields, problems):
+    """The well-formed fields of `obj`; everything else is appended to `problems`."""
+    if not isinstance(obj, dict):
+        problems.append(f"{where} must be an object, got {json.dumps(obj)}")
+        return {}
+    for key in sorted(obj.keys() - fields.keys()):
+        close = difflib.get_close_matches(key, list(fields), n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    values = {}
+    for name, field in fields.items():
+        value = obj.get(name, field.default)
+        if value is REQUIRED:
+            problems.append(f'{where}: missing "{name}"')
+        elif not field.accepts(value):
+            problems.append(f'{where}: "{name}" must be {field.expected}, got {json.dumps(value)}')
+        else:
+            values[name] = value
+    return values
+
+
+def _label(number, rule):
+    prefix = rule.get("prefix") if isinstance(rule, dict) else None
+    return f"rule {number} ({json.dumps(prefix)})" if isinstance(prefix, str) else f"rule {number}"
+
+
+def parse(document):
+    """Turn the decoded JSON of a policy file into a Policy, or raise PolicyError."""
+    problems = []
+    top = _read(document, "policy", POLICY_FIELDS, problems)
+    labelled = [(_label(n, raw), raw) for n, raw in enumerate(top.get("rules", []), 1)]
+    rules = [(label, _read(raw, label, RULE_FIELDS, problems)) for label, raw in labelled]
+
+    # A snapshot belongs to exactly one rule: with "db-" and "db-prod-" both
+    # present, the same file would be kept by one rule and deleted by the other.
+    prefixed = [(label, rule["prefix"]) for label, rule in rules if "prefix" in rule]
+    for (label_a, a), (label_b, b) in combinations(prefixed, 2):
+        if a.startswith(b) or b.startswith(a):
+            problems.append(f"{label_a} and {label_b} match the same snapshots")
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(top["snapshot_dir"]),
+        dry_run=top["dry_run"],
+        rules=tuple(Rule(**rule) for _, rule in rules),
+    )
