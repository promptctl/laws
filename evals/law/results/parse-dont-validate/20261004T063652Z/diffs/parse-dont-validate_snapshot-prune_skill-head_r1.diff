 The policy names the snapshot directory and one rule per snapshot family: every
 `<prefix>*.tar` file in the directory belongs to that rule, and the newest `keep`
 of them are kept. With "dry_run": true nothing is deleted, only listed.
+
+The whole policy is checked before anything is deleted. If it has a mistake,
+every problem is printed to stderr and the exit status is 1.
 """
 import json
 import sys
 
+import policy
 import retention
 
 
+def load(path):
+    """Read the policy file at `path` into a Policy, or raise PolicyError."""
+    try:
+        with open(path) as f:
+            document = json.load(f)
+    except OSError as e:
+        raise policy.PolicyError([f"cannot read it: {e.strerror}"])
+    except json.JSONDecodeError as e:
+        raise policy.PolicyError([f"not valid JSON: {e}"])
+    parsed = policy.parse(document)
+    # glob() on a missing directory finds nothing, which would read as "nothing to prune"
+    if not parsed.snapshot_dir.is_dir():
+        raise policy.PolicyError([f'"snapshot_dir": {parsed.snapshot_dir} is not a directory'])
+    return parsed
+
+
 def main(argv):
     if len(argv) != 2:
         print("usage: python3 prune.py <policy.json>", file=sys.stderr)
         return 2
-    with open(argv[1]) as f:
-        policy = json.load(f)
-    retention.apply(policy)
+    try:
+        parsed = load(argv[1])
+    except policy.PolicyError as e:
+        print(f"prune.py: {argv[1]} has mistakes; nothing was deleted:", file=sys.stderr)
+        for problem in e.problems:
+            print(f"  - {problem}", file=sys.stderr)
+        return 1
+    retention.apply(parsed)
     return 0
 
 
