diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..e73998f 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,101 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(ValueError):
+    """The policy is wrong; `problems` lists everything found, one per line."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    # Check the whole policy first, so a mistake in a later rule can't leave
+    # the earlier rules already applied.
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Return a list of everything wrong with the policy; empty if it is fine."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = _key_problems("policy", policy, POLICY_KEYS, POLICY_KEYS - {"dry_run"})
+
+    if "snapshot_dir" in policy:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append('"snapshot_dir" must be a non-empty string')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'"snapshot_dir": {snapshot_dir!r} is not a directory')
+
+    if not isinstance(policy.get("dry_run", False), bool):
+        problems.append('"dry_run" must be true or false')
+
+    if "rules" in policy:
+        rules = policy["rules"]
+        if not isinstance(rules, list):
+            problems.append('"rules" must be a list')
+        else:
+            problems.extend(_rules_problems(rules))
+    return problems
+
+
+def _rules_problems(rules):
+    problems = []
+    prefixes = []  # (where, prefix) of the rules seen so far
+    for n, rule in enumerate(rules, 1):
+        where = f"rule {n}"
+        if not isinstance(rule, dict):
+            problems.append(f"{where} must be a JSON object")
+            continue
+        if isinstance(rule.get("prefix"), str):
+            where = f'rule {n} ({rule["prefix"]!r})'
+        problems.extend(_key_problems(where, rule, RULE_KEYS, RULE_KEYS))
+
+        if "prefix" in rule:
+            prefix = rule["prefix"]
+            if not isinstance(prefix, str) or not prefix:
+                problems.append(f'{where}: "prefix" must be a non-empty string')
+            else:
+                # A file matched by two rules would be deleted by one of them
+                # even when the other says to keep it.
+                for other_where, other in prefixes:
+                    if prefix.startswith(other) or other.startswith(prefix):
+                        problems.append(
+                            f"{where}: prefix overlaps with {other_where}, "
+                            "so some snapshots would belong to both rules")
+                prefixes.append((where, prefix))
+
+        if "keep" in rule:
+            keep = rule["keep"]
+            if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+                problems.append(
+                    f'{where}: "keep" must be a whole number, 0 or more, not {keep!r}')
+    return problems
+
+
+def _key_problems(where, obj, allowed, required):
+    problems = []
+    missing = sorted(required - obj.keys())
+    for key in sorted(obj.keys() - allowed):
+        close = difflib.get_close_matches(key, missing or sorted(allowed), n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    for key in missing:
+        problems.append(f'{where}: missing "{key}"')
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
