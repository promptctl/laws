+"""The retention policy, and the one place a policy file is checked."""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+class PolicyError(ValueError):
+    """Everything wrong with a policy file, one problem per entry."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+def _is_name(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_flag(value):
+    return isinstance(value, bool)
+
+
+def _is_list(value):
+    return isinstance(value, list)
+
+
+def _is_count(value):
+    # bool is an int in Python; `"keep": true` is not a count.
+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
+
+
+# key -> (check, what the value must be). Keys in OPTIONAL may be omitted.
+POLICY_FIELDS = {
+    "snapshot_dir": (_is_name, "a non-empty string"),
+    "dry_run": (_is_flag, "true or false"),
+    "rules": (_is_list, "a list of rules"),
+}
+RULE_FIELDS = {
+    "prefix": (_is_name, "a non-empty string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+OPTIONAL = {"dry_run": False}
+
+
+def _problems(obj, fields, where):
+    if not isinstance(obj, dict):
+        return [f"{where}: must be an object, got {json.dumps(obj)}"]
+    found = []
+    # Unknown keys are errors, not ignored: a misspelt "dry_run" would
+    # otherwise turn a rehearsal into a real deletion.
+    for key in sorted(obj.keys() - fields.keys()):
+        close = difflib.get_close_matches(key, fields, n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        found.append(f'{where}: unknown key "{key}"{hint}')
+    for key, (ok, expected) in fields.items():
+        if key not in obj:
+            if key not in OPTIONAL:
+                found.append(f'{where}: missing "{key}"')
+        elif not ok(obj[key]):
+            found.append(f'{where}: "{key}" must be {expected}, got {json.dumps(obj[key])}')
+    return found
+
+
+def _rule_label(number, raw):
+    prefix = raw.get("prefix") if isinstance(raw, dict) else None
+    return f'rule {number} ("{prefix}")' if _is_name(prefix) else f"rule {number}"
+
+
+def parse(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError listing every problem.
+
+    [LAW:parse-dont-validate] Everything that deletes takes a Policy, so an
+    unchecked policy file cannot reach a deletion.
+    """
+    problems = _problems(raw, POLICY_FIELDS, "policy")
+    raw_rules = raw.get("rules") if isinstance(raw, dict) else None
+    raw_rules = raw_rules if _is_list(raw_rules) else []
+    labels = [_rule_label(n, r) for n, r in enumerate(raw_rules, start=1)]
+    for label, raw_rule in zip(labels, raw_rules):
+        problems += _problems(raw_rule, RULE_FIELDS, label)
+
+    # A snapshot must belong to exactly one rule; with "db-" and "db-old-" both
+    # present, the same file would be counted (and deleted) under two rules.
+    named = [(label, r["prefix"]) for label, r in zip(labels, raw_rules)
+             if isinstance(r, dict) and _is_name(r.get("prefix"))]
+    for i, (label, prefix) in enumerate(named):
+        for other_label, other in named[i + 1:]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(f"{label} and {other_label}: prefixes overlap, "
+                                "so some snapshots would belong to both rules")
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", OPTIONAL["dry_run"]),
+        rules=tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules),
+    )
