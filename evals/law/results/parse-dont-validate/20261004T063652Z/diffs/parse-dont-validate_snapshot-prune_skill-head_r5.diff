+@dataclass(frozen=True)
+class Pruning:
+    """What one rule does to its snapshot family."""
+    rule: object
+    kept: tuple
+    doomed: tuple
 
 
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
-    return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
+    # The prefix is matched literally, never as a glob pattern.
+    return sorted(
+        (p for p in root.iterdir() if p.name.startswith(prefix) and p.name.endswith(".tar")),
+        reverse=True,
+    )
 
 
-def prune(root, rule, dry_run):
-    for path in snapshots(root, rule["prefix"])[rule["keep"]:]:
-        if dry_run:
-            print(f"would delete {path}")
-        else:
-            path.unlink()
-            print(f"deleted {path}")
+def plan(policy):
+    """Decide every rule's deletions up front; touches nothing.
+
+    Raises OSError if the snapshot directory cannot be read.
+    """
+    prunings = []
+    for rule in policy.rules:
+        family = snapshots(policy.snapshot_dir, rule.prefix)
+        prunings.append(Pruning(rule, tuple(family[:rule.keep]), tuple(family[rule.keep:])))
+    return prunings
+
+
+def apply(prunings, dry_run):
+    for pruning in prunings:
+        # One line per rule, including rules that matched nothing: a mistyped
+        # prefix shows up as "0 snapshots" instead of as silence.
+        print(f"{pruning.rule.prefix}: {len(pruning.kept) + len(pruning.doomed)} snapshots, "
+              f"keeping {len(pruning.kept)}, deleting {len(pruning.doomed)}", file=sys.stderr)
+        for path in pruning.doomed:
+            if dry_run:
+                print(f"would delete {path}")
+            else:
+                path.unlink()
+                print(f"deleted {path}")
diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..b88c80d
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,103 @@
+"""Run with: python3 -m unittest test_prune"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+FAMILIES = {"db-": 6, "media-": 4, "logs-": 6}
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.snapshots = self.root / "snapshots"
+        self.snapshots.mkdir()
+        for prefix, count in FAMILIES.items():
+            for day in range(1, count + 1):
+                (self.snapshots / f"{prefix}2026-09-{day:02}.tar").touch()
+
+    def run_prune(self, policy):
+        path = self.root / "policy.json"
+        path.write_text(policy if isinstance(policy, str) else json.dumps(policy))
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            code = prune.main(["prune.py", str(path)])
+        return code, out.getvalue(), err.getvalue()
+
+    def policy(self, **changes):
+        base = {
+            "snapshot_dir": str(self.snapshots),
+            "rules": [{"prefix": "db-", "keep": 3}, {"prefix": "media-", "keep": 2},
+                      {"prefix": "logs-", "keep": 4}],
+        }
+        return {**base, **changes}
+
+    def remaining(self):
+        return sorted(p.name for p in self.snapshots.iterdir())
+
+    def assert_rejected(self, policy, *expected):
+        before = self.remaining()
+        code, out, err = self.run_prune(policy)
+        self.assertEqual(code, 1)
+        self.assertEqual(out, "")
+        self.assertEqual(self.remaining(), before)
+        for text in expected:
+            self.assertIn(text, err)
+
+    def test_valid_policy_keeps_the_newest_of_each_family(self):
+        code, out, _ = self.run_prune(self.policy())
+        self.assertEqual(code, 0)
+        self.assertEqual(self.remaining(), [
+            "db-2026-09-04.tar", "db-2026-09-05.tar", "db-2026-09-06.tar",
+            "logs-2026-09-03.tar", "logs-2026-09-04.tar", "logs-2026-09-05.tar",
+            "logs-2026-09-06.tar", "media-2026-09-03.tar", "media-2026-09-04.tar",
+        ])
+        self.assertEqual(len(out.splitlines()), 7)
+
+    def test_dry_run_deletes_nothing(self):
+        before = self.remaining()
+        code, out, _ = self.run_prune(self.policy(dry_run=True))
+        self.assertEqual(code, 0)
+        self.assertEqual(self.remaining(), before)
+        self.assertEqual(len(out.splitlines()), 7)
+
+    def test_misspelt_keep_in_the_last_rule_deletes_nothing(self):
+        rules = [{"prefix": "db-", "keep": 3}, {"prefix": "media-", "keep": 2},
+                 {"prefix": "logs-", "kepe": 4}]
+        self.assert_rejected(self.policy(rules=rules),
+                             'rule 3 ("logs-"): unknown key "kepe" (did you mean "keep"?)',
+                             'rule 3 ("logs-"): missing "keep"')
+
+    def test_every_problem_is_reported_at_once(self):
+        rules = [{"prefix": "db-", "keep": -1}, {"prefix": "", "keep": 2}, "logs-"]
+        self.assert_rejected(self.policy(rules=rules, dry_rn=True),
+                             'unknown key "dry_rn" (did you mean "dry_run"?)',
+                             'rule 1 ("db-"): "keep" must be a whole number',
+                             'rule 2: "prefix" must be a non-empty string',
+                             "rule 3: must be an object")
+
+    def test_wrongly_typed_values_are_rejected(self):
+        for keep in (True, 2.5, "3", None):
+            self.assert_rejected(self.policy(rules=[{"prefix": "db-", "keep": keep}]), '"keep" must be')
+        self.assert_rejected(self.policy(dry_run="false"), '"dry_run" must be true or false')
+
+    def test_overlapping_prefixes_are_rejected(self):
+        rules = [{"prefix": "db-", "keep": 3}, {"prefix": "db-2026", "keep": 1}]
+        self.assert_rejected(self.policy(rules=rules), "prefixes overlap")
+
+    def test_missing_snapshot_dir_is_rejected(self):
+        self.assert_rejected(self.policy(snapshot_dir=str(self.root / "snapshot")), "snapshot")
+
+    def test_malformed_json_is_rejected(self):
+        self.assert_rejected('{"snapshot_dir": ', "nothing was deleted")
+        self.assert_rejected("[]", "policy: must be an object")
+
+
+if __name__ == "__main__":
+    unittest.main()
