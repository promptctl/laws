@@ -5,10 +5,20 @@ Usage: python3 prune.py <policy.json>
 The policy names the snapshot directory and one rule per snapshot family: every
 `<prefix>*.tar` file in the directory belongs to that rule, and the newest `keep`
 of them are kept. With "dry_run": true nothing is deleted, only listed.
+
+The whole policy is checked, and every rule's deletions are worked out, before
+the first file is removed. If the policy file or the snapshot directory has a
+problem, the problems are reported and nothing is deleted.
+
+Exit codes: 0 pruned (or listed, for a dry run); 1 bad policy or unreadable
+snapshot directory, nothing deleted; 2 wrong usage.
+
+Deletions go to stdout, one per line. The per-rule summary and errors go to stderr.
 """
 import json
 import sys
 
+import policy
 import retention
 
 
@@ -16,9 +26,16 @@ def main(argv):
     if len(argv) != 2:
         print("usage: python3 prune.py <policy.json>", file=sys.stderr)
         return 2
-    with open(argv[1]) as f:
-        policy = json.load(f)
-    retention.apply(policy)
+    try:
+        with open(argv[1]) as f:
+            parsed = policy.parse(json.load(f))
+        prunings = retention.plan(parsed)
+    except (OSError, json.JSONDecodeError, policy.PolicyError) as error:
+        print(f"prune.py: {argv[1]}: nothing was deleted because:", file=sys.stderr)
+        for line in str(error).splitlines():
+            print(f"  {line}", file=sys.stderr)
+        return 1
+    retention.apply(prunings, parsed.dry_run)
     return 0
 
 
