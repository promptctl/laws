+def by_project(entries):
+    """Hours per project, biggest first; ties in project name order."""
+    projects = defaultdict(Decimal)
+    for entry in entries:
+        projects[entry.project] += entry.hours
+    return dict(sorted(projects.items(), key=lambda item: (-item[1], item[0])))
