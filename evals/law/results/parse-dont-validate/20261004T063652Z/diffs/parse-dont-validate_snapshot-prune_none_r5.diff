 """Delete the snapshots a retention policy no longer keeps."""
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+# Characters that would make a prefix match more than its own family: glob
+# metacharacters and path separators.
+UNSAFE_PREFIX_CHARS = set("*?[]/\\")
+
+
+class PolicyError(ValueError):
+    """The policy is unusable; `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+def validate(policy):
+    """Return every problem found in the policy, as a list of messages.
+
+    An empty list means the policy is safe to apply. Nothing is deleted here.
+    """
+    if not isinstance(policy, dict):
+        return [f"policy must be a JSON object, not {_kind(policy)}"]
+
+    problems = [
+        f"unknown key {key!r} (expected one of: {_names(POLICY_KEYS)})"
+        for key in sorted(set(policy) - POLICY_KEYS)
+    ]
+
+    if "snapshot_dir" not in policy:
+        problems.append("missing 'snapshot_dir'")
+    elif not isinstance(policy["snapshot_dir"], str) or not policy["snapshot_dir"]:
+        problems.append("'snapshot_dir' must be a non-empty string")
+    elif not Path(policy["snapshot_dir"]).is_dir():
+        problems.append(
+            f"'snapshot_dir' {policy['snapshot_dir']!r} is not an existing directory"
+        )
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append("'dry_run' must be true or false")
+
+    if "rules" not in policy:
+        problems.append("missing 'rules'")
+    elif not isinstance(policy["rules"], list):
+        problems.append("'rules' must be a list")
+    else:
+        problems.extend(_validate_rules(policy["rules"]))
+
+    return problems
+
+
+def _validate_rules(rules):
+    problems = []
+    prefixes = []  # (label, prefix) of the rules whose prefix is usable
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where}: must be a JSON object, not {_kind(rule)}")
+            continue
+        if isinstance(rule.get("prefix"), str):
+            where += f" (prefix {rule['prefix']!r})"
+
+        for key in sorted(set(rule) - RULE_KEYS):
+            problems.append(
+                f"{where}: unknown key {key!r} (expected: {_names(RULE_KEYS)})"
+            )
+
+        if "prefix" not in rule:
+            problems.append(f"{where}: missing 'prefix'")
+        elif not isinstance(rule["prefix"], str) or not rule["prefix"]:
+            problems.append(f"{where}: 'prefix' must be a non-empty string")
+        elif UNSAFE_PREFIX_CHARS & set(rule["prefix"]):
+            problems.append(
+                f"{where}: 'prefix' must not contain any of "
+                f"{' '.join(sorted(UNSAFE_PREFIX_CHARS))}"
+            )
+        else:
+            prefixes.append((where, rule["prefix"]))
+
+        if "keep" not in rule:
+            problems.append(f"{where}: missing 'keep'")
+        elif type(rule["keep"]) is not int or rule["keep"] < 0:
+            problems.append(
+                f"{where}: 'keep' must be a whole number >= 0, not {rule['keep']!r}"
+            )
+
+    # A snapshot must belong to exactly one rule, so no prefix may be the start
+    # of another (which also covers the same prefix appearing twice).
+    for n, (where, prefix) in enumerate(prefixes):
+        for other_where, other in prefixes[:n]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(
+                    f"{where}: overlaps with {other_where}, so some snapshots "
+                    "would match both rules"
+                )
+    return problems
+
+
+def _kind(value):
+    return {dict: "an object", list: "a list", str: "a string", bool: "a boolean",
+            type(None): "null"}.get(type(value), "a number")
+
+
+def _names(keys):
+    return ", ".join(repr(k) for k in sorted(keys))
+
 
 def apply(policy):
+    """Prune every rule. Raises PolicyError, before deleting anything, if the
+    policy is invalid."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
