+
+@dataclass(frozen=True)
+class RulePlan:
+    rule: Rule
+    kept: tuple[Path, ...]
+    doomed: tuple[Path, ...]
 
 
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
-    return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
+    return sorted(
+        (p for p in root.iterdir() if p.name.startswith(prefix) and p.name.endswith(".tar")),
+        reverse=True,
+    )
+
+
+def plan(policy: Policy):
+    """Decide, for every rule, what stays and what goes. Deletes nothing."""
+    root = policy.snapshot_dir
+    if not root.is_dir():
+        raise PolicyError([f'policy: "snapshot_dir" {str(root)!r} is not a directory'])
+    plans = []
+    for rule in policy.rules:
+        found = snapshots(root, rule.prefix)
+        plans.append(RulePlan(rule, tuple(found[:rule.keep]), tuple(found[rule.keep:])))
+    return plans
+
+
+def execute(plans, dry_run):
+    for p in plans:
+        for path in p.doomed:
+            if dry_run:
+                print(f"would delete {path}")
+            else:
+                path.unlink()
+                print(f"deleted {path}")
+        # [LAW:nothing-unseen] one line per rule even when it matched nothing,
+        # so a prefix that matches no files is visible rather than silent.
+        verb = "would delete" if dry_run else "deleted"
+        found = len(p.kept) + len(p.doomed)
+        print(f"{p.rule.prefix}: {found} found, {len(p.kept)} kept, {verb} {len(p.doomed)}")
 
 
-def prune(root, rule, dry_run):
-    for path in snapshots(root, rule["prefix"])[rule["keep"]:]:
-        if dry_run:
-            print(f"would delete {path}")
-        else:
-            path.unlink()
-            print(f"deleted {path}")
+def apply(policy: Policy):
+    # [LAW:no-ambient-temporal-coupling] the whole plan exists before the
+    # first unlink, so nothing about the policy can fail halfway through.
+    execute(plan(policy), policy.dry_run)
diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..1e6e411
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,99 @@
+"""Run with: python3 -m unittest test_prune"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+FAMILIES = {"db-": 6, "media-": 4, "logs-": 6}
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name)
+        self.snapshots = self.dir / "snapshots"
+        self.snapshots.mkdir()
+        for prefix, count in FAMILIES.items():
+            for day in range(1, count + 1):
+                (self.snapshots / f"{prefix}2026-09-{day:02}.tar").touch()
+
+    def names(self):
+        return sorted(p.name for p in self.snapshots.iterdir())
+
+    def run_prune(self, policy, **overrides):
+        body = {"snapshot_dir": str(self.snapshots), "rules": policy, **overrides}
+        path = self.dir / "policy.json"
+        path.write_text(json.dumps(body))
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(io.StringIO()):
+            code = prune.main(["prune.py", str(path)])
+        return code, err.getvalue()
+
+    def assert_refused(self, expected, policy, **overrides):
+        before = self.names()
+        code, err = self.run_prune(policy, **overrides)
+        self.assertEqual(code, 1)
+        self.assertIn(expected, err)
+        self.assertEqual(self.names(), before, "a refused policy must delete nothing")
+
+    def test_keeps_the_newest_of_each_family(self):
+        code, _ = self.run_prune([{"prefix": "db-", "keep": 3}, {"prefix": "media-", "keep": 2}])
+        self.assertEqual(code, 0)
+        kept = [n for n in self.names() if not n.startswith("logs-")]
+        self.assertEqual(kept, [
+            "db-2026-09-04.tar", "db-2026-09-05.tar", "db-2026-09-06.tar",
+            "media-2026-09-03.tar", "media-2026-09-04.tar",
+        ])
+
+    def test_dry_run_deletes_nothing(self):
+        before = self.names()
+        code, _ = self.run_prune([{"prefix": "db-", "keep": 1}], dry_run=True)
+        self.assertEqual(code, 0)
+        self.assertEqual(self.names(), before)
+
+    def test_misspelt_key_in_a_later_rule_stops_earlier_rules(self):
+        self.assert_refused('rules[2]: unknown key "kepe" (did you mean "keep"?)', [
+            {"prefix": "db-", "keep": 3},
+            {"prefix": "media-", "keep": 2},
+            {"prefix": "logs-", "kepe": 4},
+        ])
+
+    def test_reports_every_problem_at_once(self):
+        _, err = self.run_prune([{"prefix": "db-", "keep": "3"}, {"keep": -1}])
+        self.assertIn('rules[0]: "keep" must be', err)
+        self.assertIn('rules[1]: missing "prefix"', err)
+        self.assertIn('rules[1]: "keep" must be', err)
+
+    def test_misspelt_dry_run_is_refused(self):
+        self.assert_refused('unknown key "dry_runn"', [{"prefix": "db-", "keep": 1}], dry_runn=True)
+
+    def test_wrong_types_are_refused(self):
+        self.assert_refused('"keep" must be', [{"prefix": "db-", "keep": True}])
+        self.assert_refused('"dry_run" must be', [{"prefix": "db-", "keep": 1}], dry_run="false")
+        self.assert_refused('"rules" must be', {"prefix": "db-", "keep": 1})
+
+    def test_rules_claiming_the_same_files_are_refused(self):
+        self.assert_refused("both rules would prune the same files",
+                            [{"prefix": "db-", "keep": 3}, {"prefix": "db-2026", "keep": 1}])
+        self.assert_refused("both rules would prune the same files",
+                            [{"prefix": "db-", "keep": 3}, {"prefix": "db-", "keep": 1}])
+
+    def test_missing_snapshot_dir_is_refused(self):
+        self.assert_refused("is not a directory", [{"prefix": "db-", "keep": 1}],
+                            snapshot_dir=str(self.dir / "nope"))
+
+    def test_invalid_json_is_refused(self):
+        path = self.dir / "policy.json"
+        path.write_text('{"snapshot_dir": ')
+        with contextlib.redirect_stderr(io.StringIO()) as err:
+            self.assertEqual(prune.main(["prune.py", str(path)]), 1)
+        self.assertIn("not valid JSON", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
