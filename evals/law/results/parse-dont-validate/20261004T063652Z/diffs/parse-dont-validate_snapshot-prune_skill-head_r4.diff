+"""Parse a retention policy file into a Policy.
+
+A Policy can only be built from a file with no mistakes in it, so code that
+holds one never has to re-check it. Every mistake found is reported at once.
+"""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Callable
+
+
+class PolicyError(Exception):
+    """The policy cannot be acted on; `problems` lists every reason why."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+@dataclass(frozen=True)
+class _Field:
+    ok: Callable[[Any], bool]
+    expected: str
+    required: bool = True
+    default: Any = None
+
+
+def _is_text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int in Python; `"keep": true` is not a count.
+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
+
+
+_POLICY_FIELDS = {
+    "snapshot_dir": _Field(_is_text, "a non-empty string"),
+    "rules": _Field(lambda v: isinstance(v, list), "a list of rules"),
+    "dry_run": _Field(lambda v: isinstance(v, bool), "true or false", required=False, default=False),
+}
+_RULE_FIELDS = {
+    "prefix": _Field(_is_text, "a non-empty string"),
+    "keep": _Field(_is_count, "a whole number, 0 or more"),
+}
+
+
+def _read_fields(where, raw, fields, problems):
+    """The valid fields of one JSON object; everything wrong with it goes to `problems`."""
+    if not isinstance(raw, dict):
+        problems.append(f"{where}: must be an object, got {json.dumps(raw)}")
+        return {}
+    # Unknown keys are errors, not ignored: a misspelt "dry_run" would
+    # otherwise turn a rehearsal into a real deletion.
+    for key in sorted(raw.keys() - fields.keys()):
+        near = difflib.get_close_matches(key, fields.keys(), n=1)
+        hint = f' (did you mean "{near[0]}"?)' if near else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    values = {}
+    for key, field in fields.items():
+        if key not in raw:
+            if field.required:
+                problems.append(f'{where}: missing "{key}"')
+            else:
+                values[key] = field.default
+        elif not field.ok(raw[key]):
+            problems.append(f'{where}: "{key}" must be {field.expected}, got {json.dumps(raw[key])}')
+        else:
+            values[key] = raw[key]
+    return values
+
+
+def _overlaps(prefixes):
+    """Pairs of rules that would both claim the same snapshot files."""
+    seen = list(enumerate(prefixes))
+    return [
+        (i, a, j, b)
+        for i, a in seen
+        for j, b in seen
+        if a is not None and b is not None and (i < j if a == b else i != j) and b.startswith(a)
+    ]
+
+
+def parse(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError."""
+    # [LAW:parse-dont-validate] the only way to get a Policy is through here.
+    problems = []
+    top = _read_fields("policy", raw, _POLICY_FIELDS, problems)
+    rules = [
+        _read_fields(f"rules[{i}]", rule, _RULE_FIELDS, problems)
+        for i, rule in enumerate(top.get("rules", []))
+    ]
+    for i, a, j, b in _overlaps([rule.get("prefix") for rule in rules]):
+        problems.append(
+            f'rules[{i}] and rules[{j}]: prefix "{a}" also matches the "{b}" snapshots, '
+            "so both rules would prune the same files"
+        )
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(top["snapshot_dir"]),
+        dry_run=top["dry_run"],
+        rules=tuple(Rule(**rule) for rule in rules),
+    )
+
+
+def load(path):
+    """Read and parse a policy file."""
+    with open(path) as f:
+        text = f.read()
+    try:
+        raw = json.loads(text)
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    return parse(raw)
