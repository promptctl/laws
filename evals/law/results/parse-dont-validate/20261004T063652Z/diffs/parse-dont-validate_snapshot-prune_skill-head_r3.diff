@@ -0,0 +1,88 @@
+"""Run with: python3 -m unittest test_prune"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+FAMILIES = {"db-": 6, "media-": 4, "logs-": 6}
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name)
+        self.snapshots = self.dir / "snapshots"
+        self.snapshots.mkdir()
+        for prefix, count in FAMILIES.items():
+            for day in range(1, count + 1):
+                (self.snapshots / f"{prefix}2026-09-{day:02d}.tar").touch()
+
+    def run_prune(self, policy):
+        path = self.dir / "policy.json"
+        path.write_text(policy if isinstance(policy, str) else json.dumps(policy))
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            code = prune.main(["prune.py", str(path)])
+        return code, err.getvalue()
+
+    def policy(self, rules, **extra):
+        return {"snapshot_dir": str(self.snapshots), "rules": rules, **extra}
+
+    def remaining(self):
+        return sorted(p.name for p in self.snapshots.iterdir())
+
+    def assert_rejected_untouched(self, policy, *expected):
+        before = self.remaining()
+        code, err = self.run_prune(policy)
+        self.assertEqual(code, 1)
+        self.assertEqual(self.remaining(), before)
+        for text in expected:
+            self.assertIn(text, err)
+
+    def test_valid_policy_keeps_the_newest(self):
+        code, _ = self.run_prune(self.policy([{"prefix": "db-", "keep": 2}]))
+        self.assertEqual(code, 0)
+        kept = [n for n in self.remaining() if n.startswith("db-")]
+        self.assertEqual(kept, ["db-2026-09-05.tar", "db-2026-09-06.tar"])
+
+    def test_dry_run_deletes_nothing(self):
+        before = self.remaining()
+        code, _ = self.run_prune(self.policy([{"prefix": "db-", "keep": 0}], dry_run=True))
+        self.assertEqual(code, 0)
+        self.assertEqual(self.remaining(), before)
+
+    def test_typo_in_a_later_rule_deletes_nothing(self):
+        self.assert_rejected_untouched(
+            self.policy([{"prefix": "db-", "keep": 3},
+                         {"prefix": "media-", "keep": 2},
+                         {"prefix": "logs-", "kepe": 4}]),
+            'rules[2]: unknown key "kepe" (did you mean "keep"?)',
+            'rules[2]: missing "keep"')
+
+    def test_every_problem_is_reported_at_once(self):
+        self.assert_rejected_untouched(
+            self.policy([{"prefix": "db-", "keep": -1}, {"prefix": "", "keep": "3"}],
+                        dryrun=True),
+            'unknown key "dryrun" (did you mean "dry_run"?)',
+            'rules[0]: "keep"', 'rules[1]: "prefix"', 'rules[1]: "keep"')
+
+    def test_overlapping_prefixes_are_rejected(self):
+        self.assert_rejected_untouched(
+            self.policy([{"prefix": "db-", "keep": 3}, {"prefix": "db-2026", "keep": 1}]),
+            "overlap")
+
+    def test_invalid_json_is_rejected(self):
+        self.assert_rejected_untouched('{"snapshot_dir": ', "not valid JSON")
+
+    def test_missing_snapshot_dir_is_rejected(self):
+        policy = {"snapshot_dir": str(self.dir / "nope"), "rules": [{"prefix": "db-", "keep": 1}]}
+        self.assert_rejected_untouched(policy, "not a directory")
+
+
+if __name__ == "__main__":
+    unittest.main()
