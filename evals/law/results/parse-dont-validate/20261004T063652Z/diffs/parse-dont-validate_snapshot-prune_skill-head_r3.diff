+"""The retention policy: what a policy file must look like, and nothing else.
+
+`load` and `parse` are the only way to get a `Policy`. They either return one that
+is complete and well-formed or raise `PolicyError` listing every problem found, so
+code holding a `Policy` never has to check it again.
+"""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+class PolicyError(Exception):
+    """A policy file that cannot be used; `problems` has one line per mistake."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+def load(path):
+    with open(path) as f:
+        try:
+            raw = json.load(f)
+        except json.JSONDecodeError as e:
+            raise PolicyError([f"not valid JSON: {e}"]) from e
+    return parse(raw)
+
+
+# [LAW:parse-dont-validate] The one checkpoint for policy files: raw JSON in, a
+# Policy out. Every problem is collected so one run reports all of them.
+def parse(raw):
+    problems = []
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy must be a JSON object"])
+    _check_keys(raw, "policy", {"snapshot_dir", "rules"}, {"dry_run"}, problems)
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if "snapshot_dir" in raw and not (isinstance(snapshot_dir, str) and snapshot_dir):
+        problems.append('policy: "snapshot_dir" must be a non-empty string')
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append('policy: "dry_run" must be true or false')
+
+    raw_rules = raw.get("rules", [])
+    if not isinstance(raw_rules, list):
+        problems.append('policy: "rules" must be a list')
+        raw_rules = []
+    rules = [_parse_rule(r, f"rules[{i}]", problems) for i, r in enumerate(raw_rules)]
+
+    # A snapshot must belong to exactly one rule, or which `keep` applies is a guess.
+    prefixes = [(i, r["prefix"]) for i, r in enumerate(raw_rules)
+                if isinstance(r, dict) and isinstance(r.get("prefix"), str) and r["prefix"]]
+    for i, a in prefixes:
+        for j, b in prefixes:
+            if i < j and (a.startswith(b) or b.startswith(a)):
+                problems.append(
+                    f'rules[{i}] and rules[{j}]: prefixes "{a}" and "{b}" overlap, '
+                    "so some snapshots would match both rules")
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, tuple(rules))
+
+
+def _parse_rule(raw, where, problems):
+    if not isinstance(raw, dict):
+        problems.append(f"{where}: must be an object")
+        return None
+    _check_keys(raw, where, {"prefix", "keep"}, set(), problems)
+
+    prefix = raw.get("prefix")
+    if "prefix" in raw:
+        if not (isinstance(prefix, str) and prefix):
+            # An empty prefix would match every snapshot in the directory.
+            problems.append(f'{where}: "prefix" must be a non-empty string')
+        elif "/" in prefix:
+            problems.append(f'{where}: "prefix" must not contain "/"')
+
+    keep = raw.get("keep")
+    # bool is an int in Python; `"keep": true` is not a count.
+    if "keep" in raw and not (isinstance(keep, int) and not isinstance(keep, bool) and keep >= 0):
+        problems.append(f'{where}: "keep" must be a whole number, 0 or more')
+
+    return Rule(prefix, keep)
+
+
+def _check_keys(obj, where, required, optional, problems):
+    known = required | optional
+    for key in sorted(obj.keys() - known):
+        close = difflib.get_close_matches(key, sorted(known - obj.keys()), n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    for key in sorted(required - obj.keys()):
+        problems.append(f'{where}: missing "{key}"')
