+"""Parse the JSON of a retention policy file into a Policy."""
+import json
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+
+class PolicyError(Exception):
+    """Everything wrong with a policy file, one problem per line."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def _text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _count(value):
+    return type(value) is int and value >= 0  # bool is an int subclass; true is not a count
+
+
+# field -> (accepts, what a legal value looks like)
+POLICY_FIELDS = {
+    "snapshot_dir": (_text, "a non-empty string"),
+    "dry_run": (lambda value: isinstance(value, bool), "true or false"),
+    "rules": (lambda value: isinstance(value, list), "a list of rules"),
+}
+POLICY_DEFAULTS = {"dry_run": False}
+RULE_FIELDS = {
+    "prefix": (_text, "a non-empty string"),
+    "keep": (_count, "a whole number, 0 or more"),
+}
+
+
+def parse(raw):
+    """Return the Policy that `raw` (decoded JSON) describes, or raise PolicyError.
+
+    Reports every problem at once, so one run of prune.py is enough to fix the file.
+    """
+    # [LAW:parse-dont-validate] the only place a policy is checked; retention takes
+    # a Policy and never looks at raw JSON
+    problems = []
+    top = _read(raw, "policy", POLICY_FIELDS, POLICY_DEFAULTS, problems)
+    raw_rules = top["rules"] if isinstance(top.get("rules"), list) else []
+    rules = [
+        _read(raw_rule, f"rules[{i}]", RULE_FIELDS, {}, problems)
+        for i, raw_rule in enumerate(raw_rules)
+    ]
+    problems += _overlaps(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(top["snapshot_dir"]),
+        dry_run=top["dry_run"],
+        rules=tuple(Rule(rule["prefix"], rule["keep"]) for rule in rules),
+    )
+
+
+def _read(raw, where, fields, defaults, problems):
+    """Return the fields of the JSON object `raw`, appending what is wrong with it."""
+    if not isinstance(raw, dict):
+        problems.append(f"{where}: must be an object, got {json.dumps(raw)}")
+        return {}
+    for key in sorted(raw.keys() - fields.keys()):
+        hint = get_close_matches(key, fields, n=1)
+        meant = f" (did you mean {hint[0]!r}?)" if hint else ""
+        problems.append(f"{where}: unknown key {key!r}{meant}")
+    values = {**defaults, **raw}
+    for name, (accepts, expected) in fields.items():
+        if name not in values:
+            problems.append(f"{where}: missing {name!r}")
+        elif not accepts(values[name]):
+            problems.append(
+                f"{where}: {name!r} must be {expected}, got {json.dumps(values[name])}"
+            )
+    return values
+
+
+def _overlaps(rules):
+    """A snapshot matching two rules' prefixes would be pruned twice."""
+    prefixes = [
+        (i, rule["prefix"]) for i, rule in enumerate(rules) if _text(rule.get("prefix"))
+    ]
+    return [
+        f"rules[{j}]: prefix {longer!r} also matches rules[{i}] prefix {shorter!r}"
+        for i, shorter in prefixes
+        for j, longer in prefixes
+        if i != j and longer.startswith(shorter) and (longer != shorter or i < j)
+    ]
