diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..428985b 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,8 +1,86 @@
 """Delete the snapshots a retention policy no longer keeps."""
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(ValueError):
+    """The policy has mistakes in it; `problems` lists every one found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+def check(policy):
+    """Return every problem found in the policy; empty means safe to apply."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = [f"unknown key {key!r}" for key in sorted(policy.keys() - POLICY_KEYS)]
+
+    root = policy.get("snapshot_dir")
+    if "snapshot_dir" not in policy:
+        problems.append("missing 'snapshot_dir'")
+    elif not isinstance(root, str) or not root:
+        problems.append(f"'snapshot_dir' must be a non-empty string, not {root!r}")
+    elif not Path(root).is_dir():
+        problems.append(f"'snapshot_dir' {root!r} is not a directory")
+
+    if not isinstance(policy.get("dry_run", False), bool):
+        problems.append(f"'dry_run' must be true or false, not {policy['dry_run']!r}")
+
+    rules = policy.get("rules")
+    if "rules" not in policy:
+        problems.append("missing 'rules'")
+    elif not isinstance(rules, list):
+        problems.append(f"'rules' must be a list, not {rules!r}")
+    else:
+        problems.extend(check_rules(rules))
+    return problems
+
+
+def check_rules(rules):
+    problems = []
+    prefixes = []
+    for n, rule in enumerate(rules, 1):
+        if not isinstance(rule, dict):
+            problems.append(f"rule {n}: must be a JSON object, not {rule!r}")
+            continue
+        where = f"rule {n} ({rule['prefix']!r})" if "prefix" in rule else f"rule {n}"
+        problems.extend(f"{where}: unknown key {key!r}" for key in sorted(rule.keys() - RULE_KEYS))
+
+        prefix = rule.get("prefix")
+        if "prefix" not in rule:
+            problems.append(f"{where}: missing 'prefix'")
+        elif not isinstance(prefix, str) or not prefix:
+            # an empty prefix would match every snapshot of every family
+            problems.append(f"{where}: 'prefix' must be a non-empty string")
+        elif any(c in prefix for c in "*?[]/\\"):
+            problems.append(f"{where}: 'prefix' must not contain wildcards or path separators")
+        else:
+            prefixes.append((n, prefix))
+
+        keep = rule.get("keep")
+        if "keep" not in rule:
+            problems.append(f"{where}: missing 'keep'")
+        elif type(keep) is not int or keep < 0:
+            problems.append(f"{where}: 'keep' must be a whole number, 0 or more, not {keep!r}")
+
+    # a snapshot matched by two rules would be pruned by whichever keeps fewer
+    for i, (n, prefix) in enumerate(prefixes):
+        for m, other in prefixes[i + 1:]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(f"rule {n} ({prefix!r}) and rule {m} ({other!r}) match the same snapshots")
+    return problems
+
 
 def apply(policy):
+    # check the whole policy first, so a mistake in a later rule can't leave
+    # the earlier rules already applied
+    problems = check(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
