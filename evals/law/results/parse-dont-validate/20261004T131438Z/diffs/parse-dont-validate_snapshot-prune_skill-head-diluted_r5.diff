+"""The retention policy file: its shape, and the one place it is checked."""
+import json
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+
+class PolicyError(Exception):
+    """The policy file cannot be used; `problems` lists every reason found."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def load(path):
+    """Read and check the policy file, raising PolicyError if any part is wrong."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read the file: {e.strerror}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    policy = parse(raw)
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f'"snapshot_dir": {str(policy.snapshot_dir)!r} is not a directory'])
+    return policy
+
+
+# [LAW:parse-dont-validate] The only check of the policy's shape: retention
+# takes the Policy this returns, so a malformed rule cannot reach a deletion.
+def parse(raw):
+    """Turn decoded JSON into a Policy, reporting every problem at once."""
+    if not isinstance(raw, dict):
+        raise PolicyError(["the policy must be a JSON object"])
+    problems = _unknown_keys(raw, ("snapshot_dir", "dry_run", "rules"), "policy")
+    problems += _field(raw, "snapshot_dir", "policy", _is_nonempty_str, "a non-empty string")
+    if not isinstance(raw.get("dry_run", False), bool):
+        problems.append(f'policy: "dry_run" must be true or false, got {raw["dry_run"]!r}')
+    problems += _field(raw, "rules", "policy", lambda v: isinstance(v, list), "a list")
+    rules = raw.get("rules")
+    rules = rules if isinstance(rules, list) else []
+    for i, rule in enumerate(rules):
+        problems += _rule_problems(rule, f"rules[{i}]")
+    problems += _overlaps(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", False),
+        rules=tuple(Rule(r["prefix"], r["keep"]) for r in rules),
+    )
+
+
+def _rule_problems(rule, where):
+    if not isinstance(rule, dict):
+        return [f"{where}: must be an object, got {rule!r}"]
+    return (
+        _unknown_keys(rule, ("prefix", "keep"), where)
+        + _field(rule, "prefix", where, lambda v: isinstance(v, str), "a string")
+        + _field(rule, "keep", where, _is_count, "a whole number, 0 or more")
+    )
+
+
+def _overlaps(rules):
+    """A snapshot must belong to one rule, so no prefix may start with another."""
+    prefixes = [
+        (i, rule["prefix"])
+        for i, rule in enumerate(rules)
+        if isinstance(rule, dict) and isinstance(rule.get("prefix"), str)
+    ]
+    return [
+        f"rules[{i}] and rules[{j}]: prefixes {a!r} and {b!r} overlap, "
+        "so some snapshots would belong to both rules"
+        for n, (i, a) in enumerate(prefixes)
+        for j, b in prefixes[n + 1:]
+        if a.startswith(b) or b.startswith(a)
+    ]
+
+
+def _unknown_keys(obj, known, where):
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = get_close_matches(key, known, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    return problems
+
+
+def _field(obj, key, where, is_valid, expected):
+    if key not in obj:
+        return [f'{where}: missing "{key}"']
+    if not is_valid(obj[key]):
+        return [f'{where}: "{key}" must be {expected}, got {obj[key]!r}']
+    return []
+
+
+def _is_nonempty_str(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is a subclass of int; "keep": true is not a count
+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
