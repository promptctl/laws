diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..7616094
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,100 @@
+"""Run with: python3 -m unittest"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+FAMILIES = {"db-": 6, "media-": 4, "logs-": 6}
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.snapshot_dir = self.root / "snapshots"
+        self.snapshot_dir.mkdir()
+        for prefix, count in FAMILIES.items():
+            for day in range(1, count + 1):
+                (self.snapshot_dir / f"{prefix}2026-09-{day:02}.tar").touch()
+
+    def run_prune(self, policy):
+        """Return (exit status, stderr, snapshot names left) for a policy."""
+        path = self.root / "policy.json"
+        path.write_text(policy if isinstance(policy, str) else json.dumps(policy))
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(io.StringIO()):
+            status = prune.main(["prune.py", str(path)])
+        return status, err.getvalue(), sorted(p.name for p in self.snapshot_dir.iterdir())
+
+    def policy(self, **overrides):
+        return {
+            "snapshot_dir": str(self.snapshot_dir),
+            "rules": [
+                {"prefix": "db-", "keep": 3},
+                {"prefix": "media-", "keep": 2},
+                {"prefix": "logs-", "keep": 4},
+            ],
+        } | overrides
+
+    def assert_rejected(self, policy, *expected):
+        before = sorted(p.name for p in self.snapshot_dir.iterdir())
+        status, err, after = self.run_prune(policy)
+        self.assertEqual(status, 1)
+        self.assertEqual(after, before)
+        for text in expected:
+            self.assertIn(text, err)
+
+    def test_valid_policy_keeps_the_newest_of_each_family(self):
+        status, err, left = self.run_prune(self.policy())
+        self.assertEqual((status, err), (0, ""))
+        self.assertEqual(left, [
+            "db-2026-09-04.tar", "db-2026-09-05.tar", "db-2026-09-06.tar",
+            "logs-2026-09-03.tar", "logs-2026-09-04.tar",
+            "logs-2026-09-05.tar", "logs-2026-09-06.tar",
+            "media-2026-09-03.tar", "media-2026-09-04.tar",
+        ])
+
+    def test_dry_run_deletes_nothing(self):
+        status, _, left = self.run_prune(self.policy(dry_run=True))
+        self.assertEqual(status, 0)
+        self.assertEqual(len(left), sum(FAMILIES.values()))
+
+    def test_misspelled_key_in_a_later_rule_deletes_nothing(self):
+        policy = self.policy()
+        policy["rules"][2] = {"prefix": "logs-", "kepe": 4}
+        self.assert_rejected(
+            policy,
+            'rules[2]: unknown key "kepe" (did you mean "keep"?)',
+            'rules[2]: missing "keep"',
+        )
+
+    def test_every_problem_is_reported_together(self):
+        policy = self.policy(dry_run="false")
+        policy["rules"][0]["keep"] = -1
+        policy["rules"][1]["keep"] = "2"
+        self.assert_rejected(policy, '"dry_run"', "rules[0]", "rules[1]")
+
+    def test_misspelled_dry_run_is_rejected(self):
+        policy = self.policy()
+        policy["dry-run"] = True
+        self.assert_rejected(policy, 'unknown key "dry-run" (did you mean "dry_run"?)')
+
+    def test_overlapping_prefixes_are_rejected(self):
+        policy = self.policy()
+        policy["rules"].append({"prefix": "db-2026", "keep": 1})
+        self.assert_rejected(policy, "rules[0] and rules[3]")
+
+    def test_missing_snapshot_dir_is_rejected(self):
+        self.assert_rejected(self.policy(snapshot_dir=str(self.root / "snapshot")), "is not a directory")
+
+    def test_invalid_json_is_rejected(self):
+        self.assert_rejected('{"snapshot_dir": ', "not valid JSON")
+
+
+if __name__ == "__main__":
+    unittest.main()
