+"""Parse a retention policy file into a Policy, or report everything wrong with it."""
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(Exception):
+    """The policy file cannot be used; `problems` lists every mistake found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def load(path):
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read policy file: {e}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    return parse(raw)
+
+
+# [LAW:parse-dont-validate] The only way to get a Policy is through here, so
+# retention never sees a rule with a missing or mistyped field.
+def parse(raw):
+    """Collects every problem rather than stopping at the first, so one run of
+    the tool is enough to fix the whole file."""
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy must be a JSON object"])
+    problems = _key_problems(raw, POLICY_KEYS, required={"snapshot_dir", "rules"}, where="policy")
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if "snapshot_dir" in raw:
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append(f'"snapshot_dir" must be a non-empty string, got {snapshot_dir!r}')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'"snapshot_dir" {snapshot_dir!r} is not an existing directory')
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append(f'"dry_run" must be true or false, got {dry_run!r}')
+
+    raw_rules = raw.get("rules", [])
+    if not isinstance(raw_rules, list):
+        problems.append(f'"rules" must be a list, got {raw_rules!r}')
+        raw_rules = []
+    for i, raw_rule in enumerate(raw_rules):
+        problems.extend(_rule_problems(raw_rule, where=f"rules[{i}]"))
+
+    if problems:
+        raise PolicyError(problems)
+
+    rules = tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules)
+    overlaps = _overlap_problems(rules)
+    if overlaps:
+        raise PolicyError(overlaps)
+    return Policy(Path(snapshot_dir), dry_run, rules)
+
+
+def _key_problems(obj, allowed, required, where):
+    problems = [
+        f"{where}: unknown key {key!r} (allowed: {', '.join(sorted(allowed))})"
+        for key in obj
+        if key not in allowed
+    ]
+    problems += [f"{where}: missing required key {key!r}" for key in sorted(required - obj.keys())]
+    return problems
+
+
+def _rule_problems(raw_rule, where):
+    if not isinstance(raw_rule, dict):
+        return [f"{where}: must be an object, got {raw_rule!r}"]
+    if isinstance(raw_rule.get("prefix"), str):
+        where = f'{where} (prefix {raw_rule["prefix"]!r})'
+    problems = _key_problems(raw_rule, RULE_KEYS, required=RULE_KEYS, where=where)
+    prefix = raw_rule.get("prefix")
+    if "prefix" in raw_rule and (not isinstance(prefix, str) or not prefix):
+        problems.append(f'{where}: "prefix" must be a non-empty string, got {prefix!r}')
+    keep = raw_rule.get("keep")
+    # bool is an int in Python; `"keep": true` is a mistake, not "keep 1".
+    if "keep" in raw_rule and (isinstance(keep, bool) or not isinstance(keep, int) or keep < 0):
+        problems.append(f'{where}: "keep" must be a whole number >= 0, got {keep!r}')
+    return problems
+
+
+def _overlap_problems(rules):
+    """A snapshot belongs to exactly one rule; if one prefix starts with
+    another, the shorter rule would also count and delete the longer's files."""
+    return [
+        f"rules[{i}] prefix {a.prefix!r} and rules[{j}] prefix {b.prefix!r} overlap: "
+        "the same snapshots would match both rules"
+        for i, a in enumerate(rules)
+        for j, b in enumerate(rules)
+        if i < j and (a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix))
+    ]
