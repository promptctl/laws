diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..2ebc08d
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,101 @@
+"""A policy with a mistake in it must delete nothing; a good one prunes as before."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+HERE = Path(__file__).parent
+DAYS = [f"2026-09-0{d}" for d in range(1, 7)]
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.snaps = self.root / "snapshots"
+        self.snaps.mkdir()
+        for family in ("db-", "media-", "logs-"):
+            for day in DAYS:
+                (self.snaps / f"{family}{day}.tar").touch()
+
+    def run_prune(self, policy):
+        path = self.root / "policy.json"
+        path.write_text(policy if isinstance(policy, str) else json.dumps(policy))
+        return subprocess.run([sys.executable, HERE / "prune.py", path],
+                              capture_output=True, text=True)
+
+    def policy(self, *rules, **extra):
+        return {"snapshot_dir": str(self.snaps), "rules": list(rules), **extra}
+
+    def left(self):
+        return sorted(p.name for p in self.snaps.iterdir())
+
+    def assert_refused(self, policy, *mentions):
+        before = self.left()
+        result = self.run_prune(policy)
+        self.assertEqual(result.returncode, 1, result.stderr)
+        self.assertEqual(self.left(), before)
+        self.assertEqual(result.stdout, "")
+        self.assertIn("nothing was deleted", result.stderr)
+        for text in mentions:
+            self.assertIn(text, result.stderr)
+
+    def test_valid_policy_keeps_newest(self):
+        result = self.run_prune(self.policy({"prefix": "db-", "keep": 3},
+                                            {"prefix": "media-", "keep": 2}))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.left(),
+                         [f"db-{d}.tar" for d in DAYS[3:]]
+                         + [f"logs-{d}.tar" for d in DAYS]
+                         + [f"media-{d}.tar" for d in DAYS[4:]])
+
+    def test_dry_run_deletes_nothing(self):
+        before = self.left()
+        result = self.run_prune(self.policy({"prefix": "db-", "keep": 3}, dry_run=True))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.left(), before)
+        self.assertIn("would delete", result.stdout)
+
+    def test_typo_in_last_rule_stops_earlier_rules(self):
+        self.assert_refused(self.policy({"prefix": "db-", "keep": 3},
+                                        {"prefix": "media-", "keep": 2},
+                                        {"prefix": "logs-", "kepe": 4}),
+                            'rules[2] (prefix "logs-")', '"kepe"', 'did you mean "keep"',
+                            'missing "keep"')
+
+    def test_every_problem_is_reported(self):
+        self.assert_refused(self.policy({"prefix": "db-", "keep": "3"}, {"keep": 2}),
+                            "rules[0]", "rules[1]", 'missing "prefix"')
+
+    def test_misspelt_dry_run_is_not_a_real_run(self):
+        self.assert_refused(self.policy({"prefix": "db-", "keep": 3}, dry_rnu=True),
+                            '"dry_rnu"', 'did you mean "dry_run"')
+
+    def test_bad_values(self):
+        for keep in (-1, 2.5, True, None, "3"):
+            with self.subTest(keep=keep):
+                self.assert_refused(self.policy({"prefix": "db-", "keep": keep}), '"keep" must be')
+        self.assert_refused(self.policy({"prefix": "", "keep": 1}), '"prefix" must be')
+        self.assert_refused(self.policy({"prefix": "db-", "keep": 1}, dry_run="false"),
+                            '"dry_run" must be')
+
+    def test_rules_claiming_the_same_snapshots(self):
+        self.assert_refused(self.policy({"prefix": "db-", "keep": 3}, {"prefix": "db-", "keep": 1}),
+                            "also matches")
+        self.assert_refused(self.policy({"prefix": "db-2026", "keep": 3}, {"prefix": "db-", "keep": 1}),
+                            "also matches")
+
+    def test_missing_pieces(self):
+        self.assert_refused({"rules": [{"prefix": "db-", "keep": 1}]}, 'missing "snapshot_dir"')
+        self.assert_refused({"snapshot_dir": str(self.snaps)}, 'missing "rules"')
+        self.assert_refused([], "must be a JSON object")
+        self.assert_refused('{"snapshot_dir": ', "cannot read")
+        self.assert_refused({"snapshot_dir": str(self.root / "nope"), "rules": []},
+                            "is not a directory")
+
+
+if __name__ == "__main__":
+    unittest.main()
