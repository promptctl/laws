+"""The retention policy: what a policy file has to say before anything is deleted."""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class PolicyError(ValueError):
+    """Everything wrong with a policy file, not just the first thing."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+# [LAW:parse-dont-validate] The one place a policy is checked. retention only
+# accepts the Policy this returns, so no deletion can start from an unchecked file.
+def parse(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError listing every problem."""
+    if not isinstance(raw, dict):
+        raise PolicyError([f"policy must be a JSON object, not {_show(raw)}"])
+    problems = _unknown_keys(raw, _POLICY_FIELDS, "policy")
+    snapshot_dir = _field(raw, "snapshot_dir", _POLICY_FIELDS, "policy", problems)
+    # A misspelt "dry_run" is caught above as an unknown key, so the default
+    # can never turn an intended dry run into a real one.
+    dry_run = _field({"dry_run": False, **raw}, "dry_run", _POLICY_FIELDS, "policy", problems)
+    raw_rules = _field(raw, "rules", _POLICY_FIELDS, "policy", problems)
+    rules = [_parse_rule(r, i, problems) for i, r in enumerate(raw_rules or [])]
+    problems += _overlaps([r for r in rules if r.prefix is not None])
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, tuple(rules))
+
+
+def _parse_rule(raw, index, problems):
+    where = f"rules[{index}]"
+    if not isinstance(raw, dict):
+        problems.append(f"{where}: must be a JSON object, not {_show(raw)}")
+        return Rule(None, None)
+    if isinstance(raw.get("prefix"), str):
+        where += f" (prefix {_show(raw['prefix'])})"
+    problems += _unknown_keys(raw, _RULE_FIELDS, where)
+    return Rule(
+        _field(raw, "prefix", _RULE_FIELDS, where, problems),
+        _field(raw, "keep", _RULE_FIELDS, where, problems),
+    )
+
+
+def _is_count(value):
+    # bool is an int in Python; a negative keep would slice from the wrong end
+    # and delete the newest snapshots.
+    return type(value) is int and value >= 0
+
+
+# field name -> (accepts, description of what is accepted)
+_POLICY_FIELDS = {
+    "snapshot_dir": (lambda v: isinstance(v, str) and v != "", "a non-empty string"),
+    "dry_run": (lambda v: isinstance(v, bool), "true or false"),
+    "rules": (lambda v: isinstance(v, list), "a list of rules"),
+}
+_RULE_FIELDS = {
+    # An empty prefix would match every .tar file in the directory.
+    "prefix": (lambda v: isinstance(v, str) and v != "", "a non-empty string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+
+
+def _field(raw, key, fields, where, problems):
+    """The value of a well-formed field; None, with the problem recorded, otherwise."""
+    accepts, expected = fields[key]
+    if key not in raw:
+        problems.append(f'{where}: missing "{key}"')
+    elif not accepts(raw[key]):
+        problems.append(f'{where}: "{key}" must be {expected}, not {_show(raw[key])}')
+    else:
+        return raw[key]
+    return None
+
+
+def _unknown_keys(raw, fields, where):
+    problems = []
+    for key in raw:
+        if key not in fields:
+            close = difflib.get_close_matches(key, fields, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    return problems
+
+
+def _overlaps(rules):
+    """Two rules claiming the same files: which `keep` wins would be an accident of order."""
+    return [
+        f"rules[{j}] (prefix {_show(b.prefix)}) also matches the snapshots of "
+        f"rules[{i}] (prefix {_show(a.prefix)})"
+        for i, a in enumerate(rules)
+        for j, b in enumerate(rules)
+        if i != j and a.prefix.startswith(b.prefix) and (a.prefix != b.prefix or i < j)
+    ]
+
+
+def _show(value):
+    return json.dumps(value)
