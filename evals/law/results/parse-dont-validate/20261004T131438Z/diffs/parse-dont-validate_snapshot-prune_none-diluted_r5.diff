diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..7b9d320 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,102 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir": True, "dry_run": False, "rules": True}  # name -> required
+RULE_KEYS = {"prefix": True, "keep": True}
+
+
+class PolicyError(ValueError):
+    """The policy is unusable; `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy first, so a mistake never leaves a half-done prune."""
+    problems = check(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def check(policy):
+    """Return a message for every problem in the policy; empty if it is fine."""
+    if not isinstance(policy, dict):
+        return ["the policy must be a JSON object"]
+    problems = _key_problems("policy", policy, POLICY_KEYS)
+
+    if "snapshot_dir" in policy:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append(f"snapshot_dir must be a directory path, not {snapshot_dir!r}")
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f"snapshot_dir {snapshot_dir!r} is not an existing directory")
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append(f"dry_run must be true or false, not {policy['dry_run']!r}")
+
+    if "rules" in policy:
+        rules = policy["rules"]
+        if isinstance(rules, list):
+            problems += _rules_problems(rules)
+        else:
+            problems.append(f"rules must be a list, not {rules!r}")
+    return problems
+
+
+def _key_problems(where, obj, known):
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = difflib.get_close_matches(key, known, n=1)
+            hint = f" (did you mean {close[0]!r}?)" if close else ""
+            problems.append(f"{where}: unknown key {key!r}{hint}")
+    for key, required in known.items():
+        if required and key not in obj:
+            problems.append(f"{where}: missing {key!r}")
+    return problems
+
+
+def _rules_problems(rules):
+    problems = []
+    prefixes = []  # (rule label, prefix) of the rules whose prefix is usable
+    for number, rule in enumerate(rules, 1):
+        where = f"rule {number}"
+        if not isinstance(rule, dict):
+            problems.append(f"{where}: must be a JSON object, not {rule!r}")
+            continue
+        if isinstance(rule.get("prefix"), str):
+            where += f" (prefix {rule['prefix']!r})"
+        problems += _key_problems(where, rule, RULE_KEYS)
+
+        if "prefix" in rule:
+            prefix = rule["prefix"]
+            if not isinstance(prefix, str) or not prefix:
+                problems.append(f"{where}: prefix must be a non-empty string, not {prefix!r}")
+            elif any(c in prefix for c in "*?[]/\\"):
+                problems.append(f"{where}: prefix must be a plain file name prefix, "
+                                "without wildcards or path separators")
+            else:
+                prefixes.append((where, prefix))
+
+        if "keep" in rule:
+            keep = rule["keep"]
+            if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+                problems.append(f"{where}: keep must be a whole number >= 0, not {keep!r}")
+
+    for i, (where, prefix) in enumerate(prefixes):
+        for other_where, other in prefixes[:i]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(f"{where}: prefix overlaps with {other_where}, "
+                                "so some snapshots would fall under both rules")
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
