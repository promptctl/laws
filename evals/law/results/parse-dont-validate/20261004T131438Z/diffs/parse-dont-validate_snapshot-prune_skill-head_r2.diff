+"""Parse the contents of a retention policy file into a Policy.
+
+parse() either returns a Policy that is safe to act on or raises PolicyError
+listing every problem found, so one run reports all the mistakes in the file.
+"""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Callable
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+class PolicyError(Exception):
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Field:
+    ok: Callable[[object], bool]
+    expected: str
+    required: bool = True
+
+
+def _is_nonempty_str(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is a subclass of int; `"keep": true` is a mistake, not a count of 1.
+    return type(value) is int and value >= 0
+
+
+POLICY_FIELDS = {
+    "snapshot_dir": Field(_is_nonempty_str, "a non-empty string"),
+    "dry_run": Field(lambda v: isinstance(v, bool), "true or false", required=False),
+    "rules": Field(lambda v: isinstance(v, list), "a list of rules"),
+}
+
+RULE_FIELDS = {
+    # An empty prefix would claim every .tar file in the directory.
+    "prefix": Field(_is_nonempty_str, "a non-empty string"),
+    "keep": Field(_is_count, "a whole number, 0 or more"),
+}
+
+
+def _problems(obj, where, fields):
+    if not isinstance(obj, dict):
+        return [f"{where}: must be an object, got {json.dumps(obj)}"]
+    problems = []
+    # Unknown keys are errors, not ignored: a misspelt "dry_run" would otherwise
+    # turn a rehearsal into a real deletion.
+    for key in obj:
+        if key not in fields:
+            close = difflib.get_close_matches(key, fields, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    for key, field in fields.items():
+        if key not in obj:
+            if field.required:
+                problems.append(f'{where}: missing "{key}"')
+        elif not field.ok(obj[key]):
+            problems.append(
+                f'{where}: "{key}" must be {field.expected}, got {json.dumps(obj[key])}'
+            )
+    return problems
+
+
+def _overlaps(rules):
+    """A snapshot must belong to one rule; overlapping prefixes claim it twice."""
+    return [
+        f'rules[{i}] and rules[{j}]: prefixes "{a.prefix}" and "{b.prefix}" overlap, '
+        "so the same snapshots would be pruned by both rules"
+        for i, a in enumerate(rules)
+        for j, b in enumerate(rules)
+        if i < j and (a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix))
+    ]
+
+
+def parse(raw):
+    # [LAW:parse-dont-validate] The only place policy JSON is checked: retention
+    # takes a Policy, so no deletion can start from an unchecked file.
+    problems = _problems(raw, "policy", POLICY_FIELDS)
+    raw_rules = raw.get("rules") if isinstance(raw, dict) else None
+    raw_rules = raw_rules if isinstance(raw_rules, list) else []
+    for i, raw_rule in enumerate(raw_rules):
+        problems += _problems(raw_rule, f"rules[{i}]", RULE_FIELDS)
+    if problems:
+        raise PolicyError(problems)
+
+    rules = tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules)
+    problems = _overlaps(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(raw["snapshot_dir"]), raw.get("dry_run", False), rules)
