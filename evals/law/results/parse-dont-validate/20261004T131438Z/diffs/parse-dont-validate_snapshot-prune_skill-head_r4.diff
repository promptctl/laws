+"""Read a retention policy file into a form that is safe to act on."""
+from dataclasses import dataclass
+from difflib import get_close_matches
+import json
+from pathlib import Path
+
+
+class PolicyError(Exception):
+    """The policy file is unusable; `problems` lists every mistake found in it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+def load(path):
+    """The checked policy in the file at `path`, or PolicyError."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read policy file: {e}"])
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"])
+    policy = parse(raw)
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f'snapshot_dir "{policy.snapshot_dir}" is not a directory'])
+    return policy
+
+
+# [LAW:parse-dont-validate] The only place policy JSON is checked: everything
+# downstream takes a Policy, so a mistyped key cannot surface mid-deletion.
+def parse(raw):
+    """The Policy described by decoded JSON, or PolicyError naming every mistake."""
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy must be a JSON object"])
+    problems = _key_problems(raw, "policy", required=("snapshot_dir", "rules"), optional=("dry_run",))
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if "snapshot_dir" in raw and not (isinstance(snapshot_dir, str) and snapshot_dir):
+        problems.append('policy: "snapshot_dir" must be a non-empty string')
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append('policy: "dry_run" must be true or false')
+
+    rules = []
+    raw_rules = raw.get("rules", [])
+    if not isinstance(raw_rules, list):
+        problems.append('policy: "rules" must be a list')
+        raw_rules = []
+    for i, raw_rule in enumerate(raw_rules):
+        rule_problems = _rule_problems(raw_rule, i)
+        problems.extend(rule_problems)
+        if not rule_problems:
+            rules.append(Rule(raw_rule["prefix"], raw_rule["keep"]))
+    problems.extend(_overlap_problems(rules))
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, tuple(rules))
+
+
+def _rule_problems(raw_rule, i):
+    if not isinstance(raw_rule, dict):
+        return [f"rules[{i}]: must be an object"]
+    prefix = raw_rule.get("prefix")
+    where = f"rules[{i}] ({json.dumps(prefix)})" if "prefix" in raw_rule else f"rules[{i}]"
+    problems = _key_problems(raw_rule, where, required=("prefix", "keep"))
+    # An empty prefix would claim every .tar file in the directory.
+    if "prefix" in raw_rule and not (isinstance(prefix, str) and prefix):
+        problems.append(f'{where}: "prefix" must be a non-empty string')
+    keep = raw_rule.get("keep")
+    # bool is an int in Python; a negative keep would slice from the wrong end.
+    if "keep" in raw_rule and not (type(keep) is int and keep >= 0):
+        problems.append(f'{where}: "keep" must be a whole number, 0 or more')
+    return problems
+
+
+def _key_problems(obj, where, required, optional=()):
+    allowed = (*required, *optional)
+    problems = []
+    for key in obj:
+        if key not in allowed:
+            guess = get_close_matches(key, allowed, n=1)
+            hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    problems.extend(f'{where}: missing "{key}"' for key in required if key not in obj)
+    return problems
+
+
+def _overlap_problems(rules):
+    """Two rules whose prefixes nest would both claim the same files."""
+    return [
+        f'rules: prefix "{a.prefix}" also matches the files of prefix "{b.prefix}"'
+        for i, a in enumerate(rules)
+        for j, b in enumerate(rules)
+        if i != j and b.prefix.startswith(a.prefix) and (a.prefix != b.prefix or i < j)
+    ]
