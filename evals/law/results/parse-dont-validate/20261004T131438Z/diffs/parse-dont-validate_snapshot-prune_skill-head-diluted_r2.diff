@@ -0,0 +1,95 @@
+"""Turn the contents of a policy file into a Policy, or say everything that is wrong with it."""
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+
+class PolicyError(ValueError):
+    """The policy cannot be used; `problems` lists every mistake found in it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def _is_name(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int subclass: "keep": true must not mean keep 1
+    return type(value) is int and value >= 0
+
+
+# field -> (check, what a valid value looks like)
+_POLICY_FIELDS = {
+    "snapshot_dir": (_is_name, "a non-empty string"),
+    "dry_run": (lambda value: isinstance(value, bool), "true or false"),
+    "rules": (lambda value: isinstance(value, list), "a list"),
+}
+_POLICY_DEFAULTS = {"dry_run": False}
+_RULE_FIELDS = {
+    "prefix": (_is_name, "a non-empty string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+
+
+def _problems(raw, where, fields, defaults=()):
+    """Every mistake in one JSON object: unknown keys, missing fields, wrong values."""
+    if not isinstance(raw, dict):
+        return [f"{where}: must be an object, got {raw!r}"]
+    problems = []
+    for key in sorted(raw.keys() - fields.keys()):
+        guess = get_close_matches(key, fields, n=1)
+        hint = f" (did you mean {guess[0]!r}?)" if guess else ""
+        problems.append(f"{where}: unknown key {key!r}{hint}")
+    for key, (is_valid, expected) in fields.items():
+        if key in raw:
+            if not is_valid(raw[key]):
+                problems.append(f"{where}: {key!r} must be {expected}, got {raw[key]!r}")
+        elif key not in defaults:
+            problems.append(f"{where}: missing {key!r}")
+    return problems
+
+
+def _overlaps(prefixes):
+    """A snapshot must belong to one rule, so no prefix may start with another."""
+    return [
+        f"rules {i + 1} and {j + 1}: prefixes {a!r} and {b!r} match the same files"
+        for i, a in enumerate(prefixes)
+        for j, b in enumerate(prefixes)
+        if i < j and (a.startswith(b) or b.startswith(a))
+    ]
+
+
+# [LAW:parse-dont-validate] the only way to get a Policy is through here, so
+# retention never meets a rule that is missing a field or has a wrong value.
+def parse_policy(raw):
+    """Return the Policy described by decoded JSON `raw`, or raise PolicyError."""
+    problems = _problems(raw, "policy", _POLICY_FIELDS, _POLICY_DEFAULTS)
+    raw_rules = raw.get("rules") if isinstance(raw, dict) else None
+    raw_rules = raw_rules if isinstance(raw_rules, list) else []
+    for number, raw_rule in enumerate(raw_rules, 1):
+        problems += _problems(raw_rule, f"rule {number}", _RULE_FIELDS)
+    if not problems:
+        problems = _overlaps([raw_rule["prefix"] for raw_rule in raw_rules])
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", _POLICY_DEFAULTS["dry_run"]),
+        rules=tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules),
+    )
