 """
 import json
 import sys
 
 import retention
+from policy import PolicyError, parse_policy
+
+
+def load_policy(path):
+    """The Policy in the file at `path`; PolicyError if it cannot be used."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read the file: {e.strerror}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    policy = parse_policy(raw)
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f"policy: 'snapshot_dir' {str(policy.snapshot_dir)!r} is not a directory"])
+    return policy
 
 
 def main(argv):
     if len(argv) != 2:
         print("usage: python3 prune.py <policy.json>", file=sys.stderr)
         return 2
-    with open(argv[1]) as f:
-        policy = json.load(f)
+    try:
+        policy = load_policy(argv[1])
+    except PolicyError as e:
+        print(f"prune.py: {argv[1]} has mistakes, nothing was deleted:", file=sys.stderr)
+        for problem in e.problems:
+            print(f"  {problem}", file=sys.stderr)
+        return 1
     retention.apply(policy)
     return 0
 
