diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..7b6e282 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,102 @@
 """Delete the snapshots a retention policy no longer keeps."""
+from difflib import get_close_matches
 from pathlib import Path
 
+POLICY_KEYS = ("snapshot_dir", "dry_run", "rules")
+RULE_KEYS = ("prefix", "keep")
+
+
+class PolicyError(ValueError):
+    """The policy has mistakes; `problems` lists every one that was found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Validate the whole policy first, so a mistake never leaves a half-done prune."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Return every problem found in the policy; an empty list means it is usable."""
+    if not isinstance(policy, dict):
+        return ["the policy must be a JSON object"]
+    problems = unknown_keys(policy, POLICY_KEYS)
+
+    if "snapshot_dir" not in policy:
+        problems.append("missing 'snapshot_dir'")
+    elif not isinstance(policy["snapshot_dir"], str) or not policy["snapshot_dir"]:
+        problems.append("'snapshot_dir' must be a non-empty string")
+    elif not Path(policy["snapshot_dir"]).is_dir():
+        problems.append(f"snapshot_dir {policy['snapshot_dir']!r} is not a directory")
+
+    if not isinstance(policy.get("dry_run", False), bool):
+        problems.append("'dry_run' must be true or false")
+
+    if "rules" not in policy:
+        problems.append("missing 'rules'")
+    elif not isinstance(policy["rules"], list):
+        problems.append("'rules' must be a list")
+    else:
+        problems += validate_rules(policy["rules"])
+    return problems
+
+
+def validate_rules(rules):
+    problems = []
+    prefixes = []  # (rule name, prefix) of the rules whose prefix is usable
+    for i, rule in enumerate(rules):
+        name = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{name}: must be an object")
+            continue
+        prefix = rule.get("prefix")
+        if isinstance(prefix, str):
+            name += f" (prefix {prefix!r})"
+        mistakes = unknown_keys(rule, RULE_KEYS)
+
+        if "prefix" not in rule:
+            mistakes.append("missing 'prefix'")
+        elif not isinstance(prefix, str) or not prefix:
+            mistakes.append("'prefix' must be a non-empty string")
+        elif any(c in prefix for c in "*?[/\\"):
+            mistakes.append("'prefix' must not contain wildcards or path separators")
+        else:
+            prefixes.append((name, prefix))
+
+        keep = rule.get("keep")
+        if "keep" not in rule:
+            mistakes.append("missing 'keep'")
+        elif isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+            mistakes.append(f"'keep' must be a whole number, 0 or more, not {keep!r}")
+
+        problems += [f"{name}: {mistake}" for mistake in mistakes]
+
+    for i, (name, prefix) in enumerate(prefixes):
+        for other_name, other in prefixes[i + 1:]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(f"{name} and {other_name}: prefixes overlap, "
+                                "so the same files would fall under both rules")
+    return problems
+
+
+def unknown_keys(obj, known):
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = get_close_matches(str(key), known, n=1)
+            hint = f" (did you mean {close[0]!r}?)" if close else ""
+            problems.append(f"unknown key {key!r}{hint}")
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
