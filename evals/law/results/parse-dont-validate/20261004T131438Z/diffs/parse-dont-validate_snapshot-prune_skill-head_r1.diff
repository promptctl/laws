+def _problems(where, obj, required, optional=None):
+    """Every way `obj` fails to be an object with exactly these keys."""
+    if not isinstance(obj, dict):
+        return [f"{where}: must be an object, got {obj!r}"]
+    fields = {**required, **(optional or {})}
+    found = []
+    for key, value in obj.items():
+        if key not in fields:
+            close = difflib.get_close_matches(key, fields, n=1)
+            hint = f" (did you mean {close[0]!r}?)" if close else ""
+            found.append(f"{where}: unknown key {key!r}{hint}")
+        else:
+            accepts, expected = fields[key]
+            if not accepts(value):
+                found.append(f"{where}: {key!r} must be {expected}, got {value!r}")
+    found += [f"{where}: missing required key {key!r}" for key in required if key not in obj]
+    return found
+
+
+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError.
+
+    # [LAW:parse-dont-validate] The only place a policy is checked: everything
+    past here takes a Policy and can no longer meet a malformed one mid-deletion.
+    """
+    found = _problems("policy", raw, _POLICY_REQUIRED, _POLICY_OPTIONAL)
+    raw_rules = raw.get("rules") if isinstance(raw, dict) else None
+    if isinstance(raw_rules, list):
+        for i, rule in enumerate(raw_rules):
+            found += _problems(f"rules[{i}]", rule, _RULE_REQUIRED)
+    if found:
+        raise PolicyError(found)
 
