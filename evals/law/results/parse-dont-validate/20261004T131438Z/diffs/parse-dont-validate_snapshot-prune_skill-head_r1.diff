+    rules = tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules)
+    # Families are matched by prefix, so overlapping prefixes would put one
+    # snapshot under two rules and the smaller `keep` would win.
+    overlaps = [
+        f"rules[{i}] and rules[{j}]: prefix {a.prefix!r} also matches the "
+        f"{b.prefix!r} snapshots, so they would be pruned twice"
+        for i, a in enumerate(rules)
+        for j, b in enumerate(rules)
+        if i != j and b.prefix.startswith(a.prefix) and (a.prefix != b.prefix or i < j)
+    ]
+    if overlaps:
+        raise PolicyError(overlaps)
+    return Policy(Path(raw["snapshot_dir"]), raw.get("dry_run", False), rules)
