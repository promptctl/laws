+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+def _is_name(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int subclass: `"keep": true` must not mean keep 1.
+    return type(value) is int and value >= 0
+
+
+# key -> (accepts, what a legal value is)
+_POLICY_REQUIRED = {
+    "snapshot_dir": (_is_name, "a non-empty string"),
+    "rules": (lambda v: isinstance(v, list), "a list of rules"),
+}
+_POLICY_OPTIONAL = {"dry_run": (lambda v: isinstance(v, bool), "true or false")}
+# An empty prefix would glob every family's snapshots; a negative keep would
+# slice from the wrong end and delete the newest ones.
+_RULE_REQUIRED = {
+    "prefix": (_is_name, "a non-empty string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
 
-def snapshots(root, prefix):
