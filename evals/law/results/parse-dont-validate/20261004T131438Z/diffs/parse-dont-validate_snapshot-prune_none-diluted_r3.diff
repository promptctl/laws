diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..f52aee3 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,105 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(ValueError):
+    """The policy is not safe to apply; `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Validate the whole policy, then prune. Raises PolicyError before deleting anything."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Return a list of human-readable problems with the policy (empty if it is fine)."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = _unknown_keys(policy, POLICY_KEYS)
+
+    if "snapshot_dir" not in policy:
+        problems.append('missing "snapshot_dir"')
+    elif not isinstance(policy["snapshot_dir"], str) or not policy["snapshot_dir"]:
+        problems.append('"snapshot_dir" must be a non-empty string')
+    elif not Path(policy["snapshot_dir"]).is_dir():
+        problems.append(f'"snapshot_dir": {policy["snapshot_dir"]!r} is not a directory')
+
+    if not isinstance(policy.get("dry_run", False), bool):
+        problems.append('"dry_run" must be true or false')
+
+    if "rules" not in policy:
+        problems.append('missing "rules"')
+    elif not isinstance(policy["rules"], list):
+        problems.append('"rules" must be a list')
+    else:
+        problems += _validate_rules(policy["rules"])
+    return problems
+
+
+def _validate_rules(rules):
+    problems = []
+    prefixes = []
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where}: must be an object")
+            continue
+        prefix = rule.get("prefix")
+        if isinstance(prefix, str):
+            where += f" (prefix {prefix!r})"
+        found = _unknown_keys(rule, RULE_KEYS)
+
+        if "prefix" not in rule:
+            found.append('missing "prefix"')
+        elif not isinstance(prefix, str) or not prefix:
+            # an empty prefix would match every snapshot in the directory
+            found.append('"prefix" must be a non-empty string')
+        elif any(c in prefix for c in "*?[]/\\"):
+            found.append('"prefix" must not contain wildcards or path separators')
+        else:
+            prefixes.append((i, prefix))
+
+        if "keep" not in rule:
+            found.append('missing "keep"')
+        elif type(rule["keep"]) is not int or rule["keep"] < 0:
+            # a negative keep would slice from the wrong end and delete the newest
+            found.append(f'"keep" must be a whole number >= 0, not {rule["keep"]!r}')
+
+        problems += [f"{where}: {p}" for p in found]
+
+    # a snapshot matching two rules would be pruned by both
+    for n, (i, a) in enumerate(prefixes):
+        for j, b in prefixes[n + 1:]:
+            if a.startswith(b) or b.startswith(a):
+                problems.append(
+                    f"rules[{i}] and rules[{j}]: prefixes {a!r} and {b!r} "
+                    "match the same snapshots")
+    return problems
+
+
+def _unknown_keys(obj, known):
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = difflib.get_close_matches(str(key), known, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'unknown key "{key}"{hint}')
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
