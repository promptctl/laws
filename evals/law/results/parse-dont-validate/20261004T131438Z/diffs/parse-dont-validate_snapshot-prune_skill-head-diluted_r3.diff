diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..c56f269
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,119 @@
+"""Run with: python3 -m unittest"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import policy
+import prune
+
+DATES = [f"2026-09-0{d}" for d in range(1, 7)]
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name)
+        self.snapshots = self.dir / "snapshots"
+        self.snapshots.mkdir()
+        for family in ("db-", "media-", "logs-"):
+            for date in DATES:
+                (self.snapshots / f"{family}{date}.tar").touch()
+
+    def run_prune(self, policy_json):
+        """Returns (exit status, stderr, sorted names of surviving snapshots)."""
+        path = self.dir / "policy.json"
+        path.write_text(json.dumps(policy_json) if not isinstance(policy_json, str) else policy_json)
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(io.StringIO()):
+            status = prune.main(["prune.py", str(path)])
+        return status, err.getvalue(), sorted(p.name for p in self.snapshots.iterdir())
+
+    def policy(self, **overrides):
+        return {
+            "snapshot_dir": str(self.snapshots),
+            "rules": [
+                {"prefix": "db-", "keep": 3},
+                {"prefix": "media-", "keep": 2},
+                {"prefix": "logs-", "keep": 4},
+            ],
+            **overrides,
+        }
+
+    def assert_rejected_untouched(self, policy_json, *expected_in_stderr):
+        before = sorted(p.name for p in self.snapshots.iterdir())
+        status, err, after = self.run_prune(policy_json)
+        self.assertEqual(status, 1)
+        self.assertEqual(after, before)
+        self.assertIn("nothing deleted", err)
+        for text in expected_in_stderr:
+            self.assertIn(text, err)
+
+    def test_valid_policy_keeps_newest(self):
+        status, err, after = self.run_prune(self.policy())
+        self.assertEqual((status, err), (0, ""))
+        self.assertEqual(
+            after,
+            [f"db-{d}.tar" for d in DATES[3:]]
+            + [f"logs-{d}.tar" for d in DATES[2:]]
+            + [f"media-{d}.tar" for d in DATES[4:]],
+        )
+
+    def test_dry_run_deletes_nothing(self):
+        status, _, after = self.run_prune(self.policy(dry_run=True))
+        self.assertEqual(status, 0)
+        self.assertEqual(len(after), 18)
+
+    def test_typo_in_last_rule_deletes_nothing(self):
+        bad = self.policy()
+        bad["rules"][2] = {"prefix": "logs-", "kepe": 4}
+        self.assert_rejected_untouched(
+            bad, 'rules[2]: unknown key "kepe" (did you mean "keep"?)', 'rules[2]: missing "keep"'
+        )
+
+    def test_misspelled_dry_run_is_not_a_real_run(self):
+        self.assert_rejected_untouched(self.policy(dry_rnu=True), 'unknown key "dry_rnu" (did you mean "dry_run"?)')
+
+    def test_every_problem_is_reported_at_once(self):
+        bad = self.policy(dry_run="yes")
+        bad["rules"][0]["keep"] = -1
+        bad["rules"][1]["keep"] = "2"
+        self.assert_rejected_untouched(bad, "dry_run must be", "rules[0]: keep must be", "rules[1]: keep must be")
+
+    def test_bad_values(self):
+        for rule, expected in [
+            ({"prefix": "db-", "keep": True}, "keep must be"),
+            ({"prefix": "db-", "keep": 1.5}, "keep must be"),
+            ({"prefix": "", "keep": 1}, "prefix must be a non-empty string"),
+            ({"prefix": "*", "keep": 1}, "prefix must not contain"),
+            ({"prefix": "../x", "keep": 1}, "prefix must not contain"),
+            ("db-", "must be an object"),
+        ]:
+            with self.subTest(rule=rule):
+                self.assert_rejected_untouched(self.policy(rules=[rule]), expected)
+
+    def test_overlapping_prefixes(self):
+        rules = [{"prefix": "db-", "keep": 3}, {"prefix": "d", "keep": 0}]
+        self.assert_rejected_untouched(self.policy(rules=rules), 'rules[1]: prefix "d" overlaps prefix "db-"')
+
+    def test_missing_snapshot_dir(self):
+        self.assert_rejected_untouched(self.policy(snapshot_dir=str(self.dir / "snapshot")), "is not a directory")
+
+    def test_unreadable_or_malformed_file(self):
+        self.assert_rejected_untouched('{"snapshot_dir": ', "not valid JSON")
+        self.assert_rejected_untouched("[]", "policy must be a JSON object")
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err):
+            self.assertEqual(prune.main(["prune.py", str(self.dir / "nope.json")]), 1)
+        self.assertIn("cannot read file", err.getvalue())
+
+    def test_parse_returns_checked_policy(self):
+        parsed = policy.parse({"snapshot_dir": "s", "rules": [{"prefix": "db-", "keep": 0}]})
+        self.assertEqual(parsed, policy.Policy(Path("s"), False, (policy.Rule("db-", 0),)))
+
+
+if __name__ == "__main__":
+    unittest.main()
