+"""Read a retention policy file into a checked Policy, or say what is wrong with it."""
+import json
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+# A prefix is spliced into a glob pattern under snapshot_dir, so these would
+# change which files a rule owns.
+_PREFIX_FORBIDDEN = "*?[]/"
+
+
+class PolicyError(ValueError):
+    """The policy cannot be used; `problems` lists every reason found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+# [LAW:parse-dont-validate] retention only accepts a Policy, and a Policy only
+# comes out of parse(), so nothing can be deleted under an unchecked policy.
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def load(path):
+    """Read and check the policy file at `path`. Raises PolicyError."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read file: {e.strerror}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e.msg} (line {e.lineno}, column {e.colno})"]) from e
+    policy = parse(raw)
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f'snapshot_dir "{policy.snapshot_dir}" is not a directory'])
+    return policy
+
+
+def parse(raw):
+    """Turn decoded JSON into a Policy. Raises PolicyError naming every mistake."""
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy must be a JSON object"])
+    problems = _key_problems("policy", raw, required=("snapshot_dir", "rules"), optional=("dry_run",))
+
+    snapshot_dir = raw.get("snapshot_dir", "")
+    if "snapshot_dir" in raw and not (isinstance(snapshot_dir, str) and snapshot_dir):
+        problems.append("snapshot_dir must be a non-empty string")
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append("dry_run must be true or false")
+
+    raw_rules = raw.get("rules", [])
+    if not isinstance(raw_rules, list):
+        problems.append("rules must be a list")
+        raw_rules = []
+    rules = []
+    for i, raw_rule in enumerate(raw_rules):
+        where = f"rules[{i}]"
+        rule_problems = _rule_problems(where, raw_rule)
+        problems += rule_problems
+        if rule_problems:
+            continue
+        rule = Rule(raw_rule["prefix"], raw_rule["keep"])
+        # Each snapshot must belong to exactly one rule, or two `keep` counts
+        # would compete over the same files.
+        problems += [
+            f'{where}: prefix "{rule.prefix}" overlaps prefix "{other.prefix}" of an earlier rule'
+            for other in rules
+            if rule.prefix.startswith(other.prefix) or other.prefix.startswith(rule.prefix)
+        ]
+        rules.append(rule)
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, tuple(rules))
+
+
+def _rule_problems(where, raw_rule):
+    if not isinstance(raw_rule, dict):
+        return [f"{where}: must be an object"]
+    problems = _key_problems(where, raw_rule, required=("prefix", "keep"))
+    if "prefix" in raw_rule:
+        prefix = raw_rule["prefix"]
+        if not (isinstance(prefix, str) and prefix):
+            problems.append(f"{where}: prefix must be a non-empty string")
+        elif any(c in _PREFIX_FORBIDDEN for c in prefix):
+            problems.append(f"{where}: prefix must not contain any of {_PREFIX_FORBIDDEN}")
+    if "keep" in raw_rule:
+        keep = raw_rule["keep"]
+        # bool is an int subclass; `"keep": true` is a mistake, not keep-one.
+        if type(keep) is not int or keep < 0:
+            problems.append(f"{where}: keep must be a whole number, 0 or more")
+    return problems
+
+
+def _key_problems(where, obj, required, optional=()):
+    known = [*required, *optional]
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = get_close_matches(key, known, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    problems += [f'{where}: missing "{key}"' for key in required if key not in obj]
+    return problems
