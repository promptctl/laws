+DAY_FORMAT = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+
+
+def parse_day(query_string):
+    # [LAW:parse-dont-validate] The one place the raw `day` string is checked; everything
+    # past here takes a `date`, so trips.py never sees an unparsed day.
+    values = parse_qs(query_string).get("day")
+    if not values:
+        raise BadRequest("day is required, as YYYY-MM-DD (e.g. /trips?day=2026-09-14)")
+    raw = values[0]
+    match = DAY_FORMAT.fullmatch(raw)
+    if not match:
+        raise BadRequest(f"day must be in YYYY-MM-DD form, got {raw!r}")
+    try:
+        return date(*map(int, match.groups()))
+    except ValueError as e:
+        raise BadRequest(f"day {raw!r} is not a real calendar date: {e}") from e
+
+
