@@ -0,0 +1,138 @@
+"""Read a retention policy file into a Policy, or say everything that is wrong with it."""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+class PolicyError(Exception):
+    """The policy file cannot be used; `problems` lists every reason found."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class _Field:
+    accepts: object
+    expected: str
+    default: object = None
+    required: bool = True
+
+
+# bool is an int in Python, so `true` would otherwise pass as a count of 1.
+def _is_count(value):
+    return type(value) is int and value >= 0
+
+
+def _is_name(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_bool(value):
+    return isinstance(value, bool)
+
+
+def _is_list(value):
+    return isinstance(value, list)
+
+
+_POLICY_FIELDS = {
+    "snapshot_dir": _Field(_is_name, "a non-empty string"),
+    "dry_run": _Field(_is_bool, "true or false", default=False, required=False),
+    "rules": _Field(_is_list, "a list of rules"),
+}
+
+# An empty prefix would claim every .tar file in the directory, so it is refused.
+_RULE_FIELDS = {
+    "prefix": _Field(_is_name, "a non-empty string"),
+    "keep": _Field(_is_count, "a whole number, 0 or more"),
+}
+
+
+def _read(obj, where, fields, problems):
+    """Pick `fields` out of a JSON object, recording every way it departs from them."""
+    if not isinstance(obj, dict):
+        problems.append(f"{where}: expected an object, got {json.dumps(obj)}")
+        return {}
+    absent = [name for name in fields if name not in obj]
+    for key in obj:
+        if key not in fields:
+            guess = difflib.get_close_matches(key, absent, n=1)
+            hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    values = {}
+    for name, field in fields.items():
+        if name not in obj:
+            if field.required:
+                problems.append(f'{where}: missing "{name}"')
+            values[name] = field.default
+        elif field.accepts(obj[name]):
+            values[name] = obj[name]
+        else:
+            problems.append(
+                f'{where}: "{name}" must be {field.expected}, got {json.dumps(obj[name])}'
+            )
+    return values
+
+
+def _overlaps(rules):
+    """Two prefixes where one starts with the other both claim the same snapshots."""
+    named = [(where, r["prefix"]) for where, r in rules if r.get("prefix") is not None]
+    for i, (where, prefix) in enumerate(named):
+        for earlier_where, earlier in named[:i]:
+            if prefix.startswith(earlier) or earlier.startswith(prefix):
+                yield (
+                    f'{where}: prefix "{prefix}" overlaps {earlier_where} prefix '
+                    f'"{earlier}", so some snapshots would belong to both rules'
+                )
+
+
+def parse(raw):
+    """Turn decoded JSON into a Policy. Raises PolicyError listing every problem."""
+    problems = []
+    top = _read(raw, "policy", _POLICY_FIELDS, problems)
+    rules = [
+        (f"rules[{i}]", _read(rule, f"rules[{i}]", _RULE_FIELDS, problems))
+        for i, rule in enumerate(top.get("rules") or [])
+    ]
+    problems.extend(_overlaps(rules))
+    if problems:
+        raise PolicyError(problems)
+    # [LAW:parse-dont-validate] past this point a Policy is known good; nothing
+    # downstream re-checks keys or types.
+    return Policy(
+        snapshot_dir=Path(top["snapshot_dir"]),
+        dry_run=top["dry_run"],
+        rules=tuple(Rule(**rule) for _, rule in rules),
+    )
+
+
+def load(path):
+    """Read and parse the policy file at `path`. Raises PolicyError if it is unusable."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read policy file: {e.strerror}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    policy = parse(raw)
+    # A mistyped directory would otherwise match no snapshots and look like a clean run.
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f'policy: "snapshot_dir" {policy.snapshot_dir} is not a directory'])
+    return policy
