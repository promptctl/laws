+"""Parse a retention policy document into a Policy, or report everything wrong with it."""
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+class PolicyError(ValueError):
+    """The policy cannot be applied; `problems` lists every reason found."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+_REQUIRED = object()
+
+
+def _is_text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int subclass; `"keep": true` is a mistake, not a count of 1
+    return type(value) is int and value >= 0
+
+
+# name -> (accepts, what a valid value is, default)
+_POLICY_FIELDS = {
+    "snapshot_dir": (_is_text, "a non-empty string", _REQUIRED),
+    "dry_run": (lambda v: isinstance(v, bool), "true or false", False),
+    "rules": (lambda v: isinstance(v, list), "a list of rules", _REQUIRED),
+}
+_RULE_FIELDS = {
+    "prefix": (_is_text, "a non-empty string", _REQUIRED),
+    "keep": (_is_count, "a whole number, 0 or more", _REQUIRED),
+}
+
+
+def _read(obj, where, fields, problems):
+    """The valid fields of `obj`; anything missing, mistyped or unknown goes to `problems`."""
+    if not isinstance(obj, dict):
+        problems.append(f"{where}: must be an object, got {obj!r}")
+        return {}
+    for key in sorted(obj.keys() - fields.keys()):
+        near = get_close_matches(key, fields, n=1)
+        hint = f' (did you mean "{near[0]}"?)' if near else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    values = {}
+    for name, (accepts, expected, default) in fields.items():
+        value = obj.get(name, default)
+        if value is _REQUIRED:
+            problems.append(f'{where}: missing "{name}"')
+        elif not accepts(value):
+            problems.append(f'{where}: "{name}" must be {expected}, got {value!r}')
+        else:
+            values[name] = value
+    return values
+
+
+def parse(document):
+    """Policy from a decoded JSON document. Raises PolicyError listing every problem."""
+    # [LAW:parse-dont-validate] the only place a policy is checked; retention takes
+    # a Policy, so it cannot be handed a rule that fails halfway through a run
+    problems = []
+    top = _read(document, "policy", _POLICY_FIELDS, problems)
+    rules = [_read(rule, f"rules[{i}]", _RULE_FIELDS, problems)
+             for i, rule in enumerate(top.get("rules", []))]
+
+    # a snapshot matching two prefixes would be counted, and deleted, by both rules
+    prefixes = [(i, rule["prefix"]) for i, rule in enumerate(rules) if "prefix" in rule]
+    for n, (i, a) in enumerate(prefixes):
+        for j, b in prefixes[n + 1:]:
+            if a.startswith(b) or b.startswith(a):
+                problems.append(f'rules[{i}] and rules[{j}]: prefixes "{a}" and "{b}" '
+                                "match the same snapshots")
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(top["snapshot_dir"]), top["dry_run"],
+                  tuple(Rule(**rule) for rule in rules))
