diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..c5af444
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,88 @@
+"""python3 -m unittest test_prune"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+NAMES = [f"{family}-2026-09-0{day}.tar" for family in ("db", "media", "logs") for day in range(1, 7)]
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name)
+        self.snapshots = self.dir / "snapshots"
+        self.snapshots.mkdir()
+        for name in NAMES:
+            (self.snapshots / name).touch()
+
+    def run_policy(self, **overrides):
+        policy = {"snapshot_dir": str(self.snapshots), "rules": [], **overrides}
+        path = self.dir / "policy.json"
+        path.write_text(json.dumps(policy))
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = prune.main(["prune.py", str(path)])
+        return status, err.getvalue()
+
+    def remaining(self):
+        return sorted(p.name for p in self.snapshots.iterdir())
+
+    def assert_refused(self, expected, **overrides):
+        status, err = self.run_policy(**overrides)
+        self.assertEqual(status, 1)
+        self.assertIn(expected, err)
+        self.assertEqual(self.remaining(), sorted(NAMES))
+
+    def test_keeps_newest(self):
+        status, _ = self.run_policy(rules=[{"prefix": "db-", "keep": 2}])
+        self.assertEqual(status, 0)
+        self.assertEqual([n for n in self.remaining() if n.startswith("db-")],
+                         ["db-2026-09-05.tar", "db-2026-09-06.tar"])
+        self.assertEqual(len(self.remaining()), 14)
+
+    def test_dry_run_deletes_nothing(self):
+        status, _ = self.run_policy(dry_run=True, rules=[{"prefix": "db-", "keep": 0}])
+        self.assertEqual(status, 0)
+        self.assertEqual(self.remaining(), sorted(NAMES))
+
+    def test_typo_in_last_rule_deletes_nothing(self):
+        self.assert_refused('rules[2]: unknown key "kepe" (did you mean "keep"?)', rules=[
+            {"prefix": "db-", "keep": 3},
+            {"prefix": "media-", "keep": 2},
+            {"prefix": "logs-", "kepe": 4},
+        ])
+
+    def test_reports_every_problem(self):
+        _, err = self.run_policy(dry_runn=True, rules=[{"prefix": "", "keep": -1}])
+        for expected in ('unknown key "dry_runn"', '"prefix" must be', '"keep" must be'):
+            self.assertIn(expected, err)
+
+    def test_refuses_bad_values(self):
+        for rule in ({"prefix": "db-", "keep": "3"}, {"prefix": "db-", "keep": True},
+                     {"prefix": "db-", "keep": -1}, {"prefix": "db-"}, "db-"):
+            with self.subTest(rule=rule):
+                self.assert_refused("rules[0]", rules=[rule])
+
+    def test_refuses_overlapping_prefixes(self):
+        self.assert_refused("match the same snapshots", rules=[
+            {"prefix": "db-", "keep": 3}, {"prefix": "db-2026", "keep": 1}])
+
+    def test_refuses_missing_snapshot_dir(self):
+        self.assert_refused("is not a directory", snapshot_dir=str(self.dir / "snapshot"),
+                            rules=[{"prefix": "db-", "keep": 3}])
+
+    def test_refuses_malformed_json(self):
+        path = self.dir / "policy.json"
+        path.write_text("{")
+        with contextlib.redirect_stderr(io.StringIO()):
+            self.assertEqual(prune.main(["prune.py", str(path)]), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
