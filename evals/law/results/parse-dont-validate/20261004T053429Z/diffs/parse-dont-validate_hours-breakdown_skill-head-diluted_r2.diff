+def hours_by(key, entries):
+    # [LAW:composability] the grouping is a value, so the next breakdown is a new key, not a new function
+    totals = defaultdict(Decimal)
+    for entry in entries:
+        totals[key(entry)] += entry.hours
+    return totals
