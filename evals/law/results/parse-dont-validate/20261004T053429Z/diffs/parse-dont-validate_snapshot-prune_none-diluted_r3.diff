-    return 0
+    problems = []
+    try:
+        with open(argv[1]) as f:
+            policy = json.load(f, object_pairs_hook=_reject_duplicate_keys)
+    except OSError as e:
+        problems = [f"cannot read the file: {e.strerror}"]
+    except ValueError as e:
+        problems = [f"not valid JSON: {e}"]
+    if not problems:
+        try:
+            retention.apply(policy)
+        except retention.PolicyError as e:
+            problems = e.problems
+        else:
+            return 0
+    print(f"{argv[1]}: invalid policy, nothing was deleted:", file=sys.stderr)
+    for problem in problems:
+        print(f"  - {problem}", file=sys.stderr)
+    return 1
 
 
