+def _reject_duplicate_keys(pairs):
+    # json keeps only the last of two identical keys, silently.
+    keys = [key for key, _ in pairs]
+    for key in keys:
+        if keys.count(key) > 1:
+            raise ValueError(f'key "{key}" appears more than once in the same object')
+    return dict(pairs)
+
+
