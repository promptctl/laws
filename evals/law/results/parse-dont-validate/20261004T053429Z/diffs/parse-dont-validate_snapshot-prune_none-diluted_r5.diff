diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..9937c38 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,8 +1,86 @@
 """Delete the snapshots a retention policy no longer keeps."""
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(ValueError):
+    """The policy is malformed; `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+def validate(policy):
+    """Return a list of everything wrong with the policy (empty if it is fine)."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = []
+    for key in sorted(policy.keys() - POLICY_KEYS):
+        problems.append(f"unknown key {key!r} (expected one of {sorted(POLICY_KEYS)})")
+
+    snapshot_dir = policy.get("snapshot_dir")
+    if "snapshot_dir" not in policy:
+        problems.append("missing 'snapshot_dir'")
+    elif not isinstance(snapshot_dir, str) or not snapshot_dir:
+        problems.append(f"'snapshot_dir' must be a non-empty string, not {snapshot_dir!r}")
+    elif not Path(snapshot_dir).is_dir():
+        problems.append(f"'snapshot_dir' {snapshot_dir!r} is not a directory")
+
+    if not isinstance(policy.get("dry_run", False), bool):
+        problems.append(f"'dry_run' must be true or false, not {policy['dry_run']!r}")
+
+    rules = policy.get("rules")
+    if "rules" not in policy:
+        problems.append("missing 'rules'")
+    elif not isinstance(rules, list):
+        problems.append(f"'rules' must be a list, not {rules!r}")
+    else:
+        prefixes = []
+        for n, rule in enumerate(rules, 1):
+            problems.extend(f"rule {n}: {p}" for p in _validate_rule(rule))
+            if isinstance(rule, dict) and isinstance(rule.get("prefix"), str):
+                prefixes.append((n, rule["prefix"]))
+        # A snapshot matched by two rules would be pruned by whichever keeps fewer.
+        for i, (n1, p1) in enumerate(prefixes):
+            for n2, p2 in prefixes[i + 1:]:
+                if p1.startswith(p2) or p2.startswith(p1):
+                    problems.append(
+                        f"rules {n1} and {n2}: prefixes {p1!r} and {p2!r} match the same files")
+    return problems
+
+
+def _validate_rule(rule):
+    if not isinstance(rule, dict):
+        return [f"must be an object, not {rule!r}"]
+    problems = []
+    for key in sorted(rule.keys() - RULE_KEYS):
+        problems.append(f"unknown key {key!r} (expected one of {sorted(RULE_KEYS)})")
+
+    prefix = rule.get("prefix")
+    if "prefix" not in rule:
+        problems.append("missing 'prefix'")
+    elif not isinstance(prefix, str) or not prefix:
+        problems.append(f"'prefix' must be a non-empty string, not {prefix!r}")
+    elif any(c in prefix for c in "*?[]/\\"):
+        problems.append(f"'prefix' {prefix!r} must not contain wildcards or path separators")
+
+    keep = rule.get("keep")
+    if "keep" not in rule:
+        problems.append("missing 'keep'")
+    elif isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+        problems.append(f"'keep' must be a non-negative whole number, not {keep!r}")
+    return problems
+
 
 def apply(policy):
+    # Check the whole policy before touching anything, so a mistake in a later
+    # rule cannot leave the earlier ones already pruned.
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
