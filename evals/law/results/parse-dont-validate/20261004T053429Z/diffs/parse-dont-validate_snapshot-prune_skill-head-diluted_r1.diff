+"""The retention policy: everything a policy file must say before anything is deleted."""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class PolicyError(Exception):
+    """The policy cannot be used. Carries every problem found, not only the first."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+# key -> required?
+_POLICY_KEYS = {"snapshot_dir": True, "dry_run": False, "rules": True}
+_RULE_KEYS = {"prefix": True, "keep": True}
+
+
+def load(path):
+    """Read a policy file. Raises PolicyError if it is unreadable or wrong in any way."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read the file: {e.strerror}"]) from e
+    except ValueError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    policy = parse(raw)
+    # A misspelt directory matches no snapshots, which would look like a clean run.
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f'policy: "snapshot_dir" {str(policy.snapshot_dir)!r} is not a directory'])
+    return policy
+
+
+def parse(raw):
+    """Turn decoded JSON into a Policy, or raise PolicyError listing every problem.
+
+    [LAW:parse-dont-validate] This is the only place the raw dict is inspected;
+    retention works on Policy and Rule, which cannot be missing a field.
+    """
+    problems = _key_problems(raw, "policy", _POLICY_KEYS)
+    if not isinstance(raw, dict):
+        raise PolicyError(problems)
+
+    if "snapshot_dir" in raw and not _is_nonempty_str(raw["snapshot_dir"]):
+        problems.append(f'policy: "snapshot_dir" must be a non-empty string, got {raw["snapshot_dir"]!r}')
+    if not isinstance(raw.get("dry_run", False), bool):
+        problems.append(f'policy: "dry_run" must be true or false, got {raw["dry_run"]!r}')
+
+    rules = raw.get("rules", [])
+    if not isinstance(rules, list):
+        problems.append(f'policy: "rules" must be a list, got {rules!r}')
+        rules = []
+    prefixes = []
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        problems += _key_problems(rule, where, _RULE_KEYS)
+        if not isinstance(rule, dict):
+            continue
+        if "prefix" in rule:
+            if _is_nonempty_str(rule["prefix"]):
+                prefixes.append((where, rule["prefix"]))
+            else:
+                problems.append(f'{where}: "prefix" must be a non-empty string, got {rule["prefix"]!r}')
+        if "keep" in rule and not _is_count(rule["keep"]):
+            problems.append(f'{where}: "keep" must be a whole number, 0 or more, got {rule["keep"]!r}')
+
+    # A snapshot belongs to exactly one rule; overlapping prefixes would prune it twice.
+    for n, (where_a, a) in enumerate(prefixes):
+        for where_b, b in prefixes[n + 1:]:
+            if a.startswith(b) or b.startswith(a):
+                problems.append(f"{where_a} and {where_b}: prefixes {a!r} and {b!r} match the same snapshots")
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", False),
+        rules=tuple(Rule(prefix=r["prefix"], keep=r["keep"]) for r in rules),
+    )
+
+
+def _key_problems(obj, where, keys):
+    if not isinstance(obj, dict):
+        return [f"{where}: must be an object, got {obj!r}"]
+    problems = []
+    for key in sorted(obj.keys() - keys.keys()):
+        guess = difflib.get_close_matches(key, keys, n=1)
+        hint = f" (did you mean {guess[0]!r}?)" if guess else ""
+        problems.append(f"{where}: unknown key {key!r}{hint}")
+    for key, required in keys.items():
+        if required and key not in obj:
+            problems.append(f"{where}: missing required key {key!r}")
+    return problems
+
+
+def _is_nonempty_str(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is a subclass of int; "keep": true is a mistake, not a 1.
+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
