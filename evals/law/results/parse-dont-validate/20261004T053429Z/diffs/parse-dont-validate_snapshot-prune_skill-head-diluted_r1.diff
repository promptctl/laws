diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..dd07fec
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,92 @@
+"""Run with: python3 -m unittest test_prune"""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+PRUNE = Path(__file__).with_name("prune.py")
+DAYS = [f"2026-09-0{d}" for d in range(1, 7)]
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = Path(self.enterContext(tempfile.TemporaryDirectory()))
+        self.snapshots = self.tmp / "snapshots"
+        self.snapshots.mkdir()
+        for family in ("db-", "media-", "logs-"):
+            for day in DAYS:
+                (self.snapshots / f"{family}{day}.tar").touch()
+
+    def run_prune(self, policy):
+        path = self.tmp / "policy.json"
+        path.write_text(policy if isinstance(policy, str) else json.dumps(policy))
+        return subprocess.run([sys.executable, str(PRUNE), str(path)], capture_output=True, text=True)
+
+    def policy(self, **overrides):
+        base = {
+            "snapshot_dir": str(self.snapshots),
+            "rules": [{"prefix": "db-", "keep": 3}, {"prefix": "media-", "keep": 2}, {"prefix": "logs-", "keep": 4}],
+        }
+        return {**base, **overrides}
+
+    def remaining(self):
+        return sorted(p.name for p in self.snapshots.iterdir())
+
+    def assert_rejected(self, policy, *expected_in_stderr):
+        before = self.remaining()
+        result = self.run_prune(policy)
+        self.assertEqual(result.returncode, 1, result.stderr)
+        self.assertEqual(self.remaining(), before, "an invalid policy must delete nothing")
+        self.assertNotIn("Traceback", result.stderr)
+        for text in expected_in_stderr:
+            self.assertIn(text, result.stderr)
+
+    def test_valid_policy_keeps_newest(self):
+        result = self.run_prune(self.policy())
+        self.assertEqual(result.returncode, 0, result.stderr)
+        expected = (
+            [f"db-{d}.tar" for d in DAYS[3:]]
+            + [f"logs-{d}.tar" for d in DAYS[2:]]
+            + [f"media-{d}.tar" for d in DAYS[4:]]
+        )
+        self.assertEqual(self.remaining(), expected)
+
+    def test_dry_run_deletes_nothing(self):
+        before = self.remaining()
+        result = self.run_prune(self.policy(dry_run=True))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.remaining(), before)
+        self.assertIn("would delete", result.stdout)
+
+    def test_misspelt_key_in_last_rule(self):
+        rules = [{"prefix": "db-", "keep": 3}, {"prefix": "media-", "keep": 2}, {"prefix": "logs-", "kepe": 4}]
+        self.assert_rejected(self.policy(rules=rules), "rules[2]", "'kepe'", "did you mean 'keep'")
+
+    def test_misspelt_dry_run(self):
+        self.assert_rejected(self.policy(dry_runn=True), "'dry_runn'", "did you mean 'dry_run'")
+
+    def test_reports_every_problem(self):
+        rules = [{"prefix": "", "keep": 3}, {"prefix": "media-", "keep": "2"}, {"prefix": "logs-", "keep": -1}]
+        self.assert_rejected(self.policy(rules=rules), "rules[0]", "rules[1]", "rules[2]")
+
+    def test_wrong_types(self):
+        self.assert_rejected(self.policy(dry_run="false"), '"dry_run"')
+        self.assert_rejected(self.policy(rules={"prefix": "db-", "keep": 3}), '"rules"')
+        self.assert_rejected(self.policy(rules=[{"prefix": "db-", "keep": True}]), '"keep"')
+        self.assert_rejected([], "must be an object")
+
+    def test_overlapping_prefixes(self):
+        rules = [{"prefix": "db-", "keep": 3}, {"prefix": "db-2026", "keep": 1}]
+        self.assert_rejected(self.policy(rules=rules), "match the same snapshots")
+
+    def test_missing_snapshot_dir(self):
+        self.assert_rejected(self.policy(snapshot_dir=str(self.tmp / "snapshotz")), "is not a directory")
+
+    def test_invalid_json(self):
+        self.assert_rejected('{"snapshot_dir": ', "not valid JSON")
+
+
+if __name__ == "__main__":
+    unittest.main()
