+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
+
+
+POLICY_FIELDS = {
+    "snapshot_dir": Field(_is_nonempty_str, "a non-empty string"),
+    "dry_run": Field(lambda v: isinstance(v, bool), "true or false", required=False),
+    "rules": Field(lambda v: isinstance(v, list), "a list of rules"),
+}
+
+RULE_FIELDS = {
+    "prefix": Field(_is_nonempty_str, "a non-empty string"),
+    "keep": Field(_is_count, "a whole number, 0 or more"),
+}
+
+
+def _field_problems(where, obj, fields):
+    if not isinstance(obj, dict):
+        return [f"{where}: expected an object, got {json_type(obj)}"]
+    problems = []
+    for key in obj:
+        if key not in fields:
+            close = difflib.get_close_matches(key, fields, n=1)
+            hint = f" (did you mean {close[0]!r}?)" if close else ""
+            problems.append(f"{where}: unknown key {key!r}{hint}")
+    for name, field in fields.items():
+        if name not in obj:
+            if field.required:
+                problems.append(f"{where}: missing {name!r}")
+        elif not field.accepts(obj[name]):
+            problems.append(
+                f"{where}: {name!r} must be {field.expected}, got {obj[name]!r}"
+            )
