diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..9d3be48 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,111 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+REQUIRED_POLICY_KEYS = {"snapshot_dir", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(ValueError):
+    """The policy is not safe to act on; `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Validate the whole policy first, so a bad rule can't leave a half-done prune."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Every problem with the policy, as messages; empty if it is safe to apply."""
+    if not isinstance(policy, dict):
+        return [f"policy must be a JSON object, not {_kind(policy)}"]
+    problems = _key_problems(policy, POLICY_KEYS, REQUIRED_POLICY_KEYS, "policy")
+
+    if "snapshot_dir" in policy:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append('"snapshot_dir" must be a non-empty string')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'"snapshot_dir": {snapshot_dir!r} is not an existing directory')
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append(f'"dry_run" must be true or false, not {_kind(policy["dry_run"])}')
+
+    if "rules" in policy:
+        rules = policy["rules"]
+        if not isinstance(rules, list):
+            problems.append(f'"rules" must be a list, not {_kind(rules)}')
+        else:
+            problems.extend(_rules_problems(rules))
+    return problems
+
+
+def _rules_problems(rules):
+    problems = []
+    prefixes = []  # (where, prefix) of the rules whose prefix is usable
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where} must be an object, not {_kind(rule)}")
+            continue
+        if isinstance(rule.get("prefix"), str):
+            where += f' (prefix "{rule["prefix"]}")'
+        problems.extend(_key_problems(rule, RULE_KEYS, RULE_KEYS, where))
+
+        if "prefix" in rule:
+            prefix = rule["prefix"]
+            if not isinstance(prefix, str) or not prefix:
+                problems.append(f'{where}: "prefix" must be a non-empty string')
+            elif any(c in prefix for c in "*?[]/\\"):
+                problems.append(f'{where}: "prefix" must not contain any of * ? [ ] / \\')
+            else:
+                prefixes.append((where, prefix))
+
+        if "keep" in rule:
+            keep = rule["keep"]
+            # bool is an int in Python, and a negative keep would slice off the newest.
+            if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+                problems.append(f'{where}: "keep" must be a whole number >= 0, not {keep!r}')
+
+    for n, (where, prefix) in enumerate(prefixes):
+        for other_where, other in prefixes[:n]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(
+                    f"{where}: prefix overlaps {other_where}, so some snapshots would fall under both rules"
+                )
+    return problems
+
+
+def _key_problems(obj, allowed, required, where):
+    problems = []
+    for key in obj:
+        if key not in allowed:
+            close = difflib.get_close_matches(key, allowed, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    for key in sorted(required - obj.keys()):
+        problems.append(f'{where}: missing "{key}"')
+    return problems
+
+
+def _kind(value):
+    if value is None:
+        return "null"
+    return {dict: "an object", list: "a list", str: "a string", bool: "a boolean"}.get(
+        type(value), "a number"
+    )
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
