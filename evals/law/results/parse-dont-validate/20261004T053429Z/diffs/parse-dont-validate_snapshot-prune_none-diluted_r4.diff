diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..cfb0d7f 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,112 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = ("snapshot_dir", "dry_run", "rules")
+RULE_KEYS = ("prefix", "keep")
+
+
+class PolicyError(ValueError):
+    """The policy is unusable; `problems` lists every mistake found in it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy first, so a bad rule can't leave a half-done prune."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Every mistake in the policy, as a list of messages; empty if it is usable."""
+    if not isinstance(policy, dict):
+        return ["policy: must be a JSON object"]
+    problems = unknown_keys(policy, POLICY_KEYS, "policy")
+
+    root = policy.get("snapshot_dir")
+    if "snapshot_dir" not in policy:
+        problems.append('policy: missing "snapshot_dir"')
+    elif not isinstance(root, str) or not root:
+        problems.append('policy: "snapshot_dir" must be a non-empty string')
+    elif not Path(root).is_dir():
+        problems.append(f'policy: snapshot_dir "{root}" is not an existing directory')
+
+    if not isinstance(policy.get("dry_run", False), bool):
+        problems.append('policy: "dry_run" must be true or false')
+
+    rules = policy.get("rules")
+    if "rules" not in policy:
+        problems.append('policy: missing "rules"')
+    elif not isinstance(rules, list):
+        problems.append('policy: "rules" must be a list')
+    else:
+        for i, rule in enumerate(rules):
+            problems += rule_problems(rule, f"rules[{i}]")
+        problems += overlap_problems(rules)
+    return problems
+
+
+def unknown_keys(obj, known, where):
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = difflib.get_close_matches(key, known, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    return problems
+
+
+def rule_problems(rule, where):
+    if not isinstance(rule, dict):
+        return [f"{where}: must be a JSON object"]
+    prefix = rule.get("prefix")
+    if isinstance(prefix, str) and prefix:
+        where = f'{where} ("{prefix}")'
+    problems = unknown_keys(rule, RULE_KEYS, where)
+
+    if "prefix" not in rule:
+        problems.append(f'{where}: missing "prefix"')
+    elif not isinstance(prefix, str) or not prefix:
+        # an empty prefix would match every snapshot in the directory
+        problems.append(f'{where}: "prefix" must be a non-empty string')
+    elif any(c in prefix for c in "*?[]/\\"):
+        problems.append(f'{where}: "prefix" must not contain wildcards or path separators')
+
+    keep = rule.get("keep")
+    if "keep" not in rule:
+        problems.append(f'{where}: missing "keep"')
+    elif not isinstance(keep, int) or isinstance(keep, bool) or keep < 0:
+        problems.append(f'{where}: "keep" must be a whole number, 0 or more, not {keep!r}')
+    return problems
+
+
+def overlap_problems(rules):
+    """A snapshot must belong to one rule only, so no prefix may start with another."""
+    prefixes = [
+        (i, rule["prefix"])
+        for i, rule in enumerate(rules)
+        if isinstance(rule, dict) and isinstance(rule.get("prefix"), str) and rule["prefix"]
+    ]
+    problems = []
+    for n, (i, a) in enumerate(prefixes):
+        for j, b in prefixes[n + 1:]:
+            if a == b:
+                problems.append(f'rules[{i}] and rules[{j}]: both use prefix "{a}"')
+            elif a.startswith(b) or b.startswith(a):
+                problems.append(
+                    f'rules[{i}] and rules[{j}]: prefixes "{a}" and "{b}" overlap, '
+                    "so some snapshots would match both rules"
+                )
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
