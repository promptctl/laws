diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..0ded002
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,107 @@
+"""Run with: python3 -m unittest test_prune"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+NAMES = [f"{family}-2026-09-0{day}.tar"
+         for family in ("db", "media", "logs") for day in range(1, 7)]
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name)
+        self.snapshots = self.dir / "snapshots"
+        self.snapshots.mkdir()
+        for name in NAMES:
+            (self.snapshots / name).touch()
+
+    def run_prune(self, policy):
+        """Returns (exit status, stderr) for a policy given as a dict or raw text."""
+        text = policy if isinstance(policy, str) else json.dumps(
+            {"snapshot_dir": str(self.snapshots), **policy})
+        path = self.dir / "policy.json"
+        path.write_text(text)
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(io.StringIO()):
+            status = prune.main(["prune.py", str(path)])
+        return status, err.getvalue()
+
+    def remaining(self):
+        return sorted(p.name for p in self.snapshots.iterdir())
+
+    def assert_rejected(self, policy, *expected):
+        status, err = self.run_prune(policy)
+        self.assertEqual(status, 1)
+        self.assertEqual(self.remaining(), sorted(NAMES))
+        for text in expected:
+            self.assertIn(text, err)
+
+    def test_keeps_newest_of_each_family(self):
+        status, _ = self.run_prune({"rules": [{"prefix": "db-", "keep": 2},
+                                              {"prefix": "logs-", "keep": 6}]})
+        self.assertEqual(status, 0)
+        kept = [n for n in NAMES if not n.startswith("db-")]
+        self.assertEqual(self.remaining(),
+                         sorted(kept + ["db-2026-09-05.tar", "db-2026-09-06.tar"]))
+
+    def test_dry_run_deletes_nothing(self):
+        status, _ = self.run_prune({"dry_run": True,
+                                    "rules": [{"prefix": "db-", "keep": 0}]})
+        self.assertEqual(status, 0)
+        self.assertEqual(self.remaining(), sorted(NAMES))
+
+    def test_typo_in_last_rule_deletes_nothing(self):
+        self.assert_rejected(
+            {"rules": [{"prefix": "db-", "keep": 3},
+                       {"prefix": "media-", "keep": 2},
+                       {"prefix": "logs-", "kepe": 4}]},
+            "rule 3: unknown key 'kepe' (did you mean 'keep'?)",
+            "rule 3: missing 'keep'")
+
+    def test_misspelled_dry_run_is_not_a_real_run(self):
+        self.assert_rejected({"dry_rnu": True,
+                              "rules": [{"prefix": "db-", "keep": 0}]},
+                             "unknown key 'dry_rnu' (did you mean 'dry_run'?)")
+
+    def test_bad_values(self):
+        self.assert_rejected(
+            {"dry_run": "yes", "rules": [{"prefix": "db-", "keep": -1},
+                                         {"prefix": "", "keep": "3"},
+                                         "logs-"]},
+            "'dry_run' must be true or false",
+            "rule 1: 'keep' must be a whole number",
+            "rule 2: 'prefix' must be a non-empty string",
+            "rule 2: 'keep' must be a whole number",
+            "rule 3: must be an object")
+
+    def test_overlapping_prefixes(self):
+        self.assert_rejected({"rules": [{"prefix": "db-", "keep": 3},
+                                        {"prefix": "db-2026", "keep": 1}]},
+                             "rules 1 and 2: prefixes 'db-' and 'db-2026' overlap")
+
+    def test_missing_snapshot_dir(self):
+        self.assert_rejected(
+            json.dumps({"snapshot_dir": str(self.dir / "nope"),
+                        "rules": [{"prefix": "db-", "keep": 1}]}),
+            "is not a directory")
+
+    def test_not_json(self):
+        self.assert_rejected("{not json", "not valid JSON")
+
+    def test_missing_policy_file(self):
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err):
+            status = prune.main(["prune.py", str(self.dir / "absent.json")])
+        self.assertEqual(status, 1)
+        self.assertIn("cannot read", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
