+"""Parse a retention policy file into a Policy, or report everything wrong with it."""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class PolicyError(ValueError):
+    """The policy cannot be used; `problems` lists every reason, one per entry."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def _is_text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_prefix(value):
+    return _is_text(value) and "/" not in value
+
+
+def _is_count(value):
+    # bool is an int subclass; `"keep": true` is a mistake, not a count
+    return type(value) is int and value >= 0
+
+
+# key -> (check, what the value must be); any other key is a mistake
+_POLICY_KEYS = {
+    "snapshot_dir": (_is_text, "a non-empty string"),
+    "rules": (lambda value: isinstance(value, list), "a list of rules"),
+    "dry_run": (lambda value: type(value) is bool, "true or false"),
+}
+_POLICY_OPTIONAL = {"dry_run"}
+_RULE_KEYS = {
+    "prefix": (_is_prefix, "a non-empty string without '/'"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+
+
+def _key_problems(where, obj, keys, optional=frozenset()):
+    problems = []
+    for name in sorted(obj.keys() - keys.keys()):
+        close = difflib.get_close_matches(name, keys, n=1)
+        hint = f" (did you mean '{close[0]}'?)" if close else ""
+        problems.append(f"{where}: unknown key '{name}'{hint}")
+    for name, (ok, expected) in keys.items():
+        if name not in obj:
+            if name not in optional:
+                problems.append(f"{where}: missing '{name}'")
+        elif not ok(obj[name]):
+            problems.append(
+                f"{where}: '{name}' must be {expected}, got {json.dumps(obj[name])}")
+    return problems
+
+
+def _rule_problems(rules):
+    problems = []
+    for number, rule in enumerate(rules, 1):
+        if isinstance(rule, dict):
+            problems += _key_problems(f"rule {number}", rule, _RULE_KEYS)
+        else:
+            problems.append(
+                f"rule {number}: must be an object, got {json.dumps(rule)}")
+    # A snapshot matching two rules would be deleted by one and then missing for
+    # the other, which is another way to crash halfway through a prune.
+    prefixes = [(number, rule["prefix"]) for number, rule in enumerate(rules, 1)
+                if isinstance(rule, dict) and _is_prefix(rule.get("prefix"))]
+    for i, (first, a) in enumerate(prefixes):
+        for second, b in prefixes[i + 1:]:
+            if a.startswith(b) or b.startswith(a):
+                problems.append(
+                    f"rules {first} and {second}: prefixes '{a}' and '{b}' overlap, "
+                    f"so the same snapshot would belong to both")
+    return problems
+
+
+# [LAW:parse-dont-validate] the only way to get a Policy is through here, so
+# retention never has to ask whether a key is present or a count is sane.
+def parse(text):
+    """Turn policy file text into a Policy; raise PolicyError listing every problem."""
+    try:
+        raw = json.loads(text)
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy must be a JSON object"])
+
+    problems = _key_problems("policy", raw, _POLICY_KEYS, _POLICY_OPTIONAL)
+    rules = raw.get("rules")
+    if isinstance(rules, list):
+        problems += _rule_problems(rules)
+    if problems:
+        raise PolicyError(problems)
+
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", False),
+        rules=tuple(Rule(rule["prefix"], rule["keep"]) for rule in rules),
+    )
