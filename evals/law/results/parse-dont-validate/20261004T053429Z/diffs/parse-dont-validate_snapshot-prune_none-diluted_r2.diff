+    try:
+        with open(argv[1]) as f:
+            policy = json.load(f, object_pairs_hook=unique_keys)
+    except (OSError, ValueError) as e:
+        print(f"{argv[1]}: cannot read policy, nothing was deleted: {e}", file=sys.stderr)
+        return 1
+    try:
+        retention.apply(policy)
+    except retention.PolicyError as e:
+        print(f"{argv[1]}: invalid policy, nothing was deleted:", file=sys.stderr)
+        for problem in e.problems:
+            print(f"  - {problem}", file=sys.stderr)
+        return 1
     return 0
 
 
+def unique_keys(pairs):
+    """json keeps only the last of a repeated key; treat a repeat as a mistake."""
+    obj = {}
+    for key, value in pairs:
+        if key in obj:
+            raise ValueError(f"key {key!r} appears twice in one object")
+        obj[key] = value
+    return obj
+
+
 if __name__ == "__main__":
     sys.exit(main(sys.argv))
diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..fadcc8a 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,109 @@
 """Delete the snapshots a retention policy no longer keeps."""
+from difflib import get_close_matches
 from pathlib import Path
 
+POLICY_KEYS = ("snapshot_dir", "rules", "dry_run")
+RULE_KEYS = ("prefix", "keep")
+
+
+class PolicyError(ValueError):
+    """The policy is unusable; `problems` lists every mistake found in it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy first, so a mistake anywhere means nothing is deleted."""
+    problems = check(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def check(policy):
+    """Every mistake in the policy, as a list of messages; empty if it is usable."""
+    if not isinstance(policy, dict):
+        return ["the policy must be a JSON object"]
+    problems = _unknown_keys(policy, POLICY_KEYS, "policy")
+
+    root = policy.get("snapshot_dir")
+    if "snapshot_dir" not in policy:
+        problems.append("policy: missing 'snapshot_dir'")
+    elif not isinstance(root, str) or not root:
+        problems.append(f"snapshot_dir: must be a non-empty string, not {root!r}")
+    elif not Path(root).is_dir():
+        problems.append(f"snapshot_dir: {root!r} is not a directory")
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append(f"dry_run: must be true or false, not {policy['dry_run']!r}")
+
+    rules = policy.get("rules")
+    if "rules" not in policy:
+        problems.append("policy: missing 'rules'")
+    elif not isinstance(rules, list):
+        problems.append(f"rules: must be a list, not {rules!r}")
+    else:
+        prefixes = []
+        for i, rule in enumerate(rules):
+            where = f"rules[{i}]"
+            if not isinstance(rule, dict):
+                problems.append(f"{where}: must be an object, not {rule!r}")
+                continue
+            problems += _unknown_keys(rule, RULE_KEYS, where)
+            problems += _check_prefix(rule, where)
+            problems += _check_keep(rule, where)
+            if isinstance(rule.get("prefix"), str):
+                prefixes.append((where, rule["prefix"]))
+        problems += _overlaps(prefixes)
+    return problems
+
+
+def _unknown_keys(obj, known, where):
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = get_close_matches(str(key), known, n=1)
+            hint = f" (did you mean {close[0]!r}?)" if close else ""
+            problems.append(f"{where}: unknown key {key!r}{hint}")
+    return problems
+
+
+def _check_prefix(rule, where):
+    if "prefix" not in rule:
+        return [f"{where}: missing 'prefix'"]
+    prefix = rule["prefix"]
+    if not isinstance(prefix, str) or not prefix:
+        return [f"{where}: 'prefix' must be a non-empty string, not {prefix!r}"]
+    if any(c in prefix for c in "*?[/\\"):
+        return [f"{where}: 'prefix' {prefix!r} must not contain wildcards or path separators"]
+    return []
+
+
+def _check_keep(rule, where):
+    if "keep" not in rule:
+        return [f"{where}: missing 'keep'"]
+    keep = rule["keep"]
+    # bool is an int, and a negative keep would slice from the wrong end
+    if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+        return [f"{where}: 'keep' must be a whole number, 0 or more, not {keep!r}"]
+    return []
+
+
+def _overlaps(prefixes):
+    """A snapshot matching two rules could be deleted by one that the other keeps."""
+    problems = []
+    for n, (where_a, a) in enumerate(prefixes):
+        for where_b, b in prefixes[n + 1:]:
+            if a.startswith(b) or b.startswith(a):
+                problems.append(
+                    f"{where_a} and {where_b}: prefixes {a!r} and {b!r} match the same snapshots")
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
