+"""Parse a retention policy document into a Policy that is safe to act on."""
+from dataclasses import dataclass
+from pathlib import Path
+
+# Characters that would make a prefix mean something other than "names starting with this".
+GLOB_OR_PATH_CHARS = set("*?[]/\\")
+
+
+class PolicyError(ValueError):
+    """The policy document is wrong; `problems` lists every mistake found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+# [LAW:parse-dont-validate] The only way to get a Policy is through here, and
+# retention only accepts a Policy, so a malformed rule cannot reach a deletion.
+def parse(raw):
+    """Return the Policy described by a decoded JSON document, or raise PolicyError."""
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy must be a JSON object"])
+    problems = _key_problems(raw, "policy", required={"snapshot_dir", "rules"}, optional={"dry_run"})
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if "snapshot_dir" in raw and (not isinstance(snapshot_dir, str) or not snapshot_dir):
+        problems.append(f'"snapshot_dir" must be a non-empty string, got {snapshot_dir!r}')
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append(f'"dry_run" must be true or false, got {dry_run!r}')
+
+    rules = raw.get("rules", [])
+    if isinstance(rules, list):
+        for index, rule in enumerate(rules):
+            problems += _rule_problems(rule, f"rules[{index}]")
+    else:
+        problems.append(f'"rules" must be a list, got {rules!r}')
+
+    if problems:
+        raise PolicyError(problems)
+    problems = _overlap_problems([rule["prefix"] for rule in rules])
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(snapshot_dir),
+        dry_run=dry_run,
+        rules=tuple(Rule(rule["prefix"], rule["keep"]) for rule in rules),
+    )
+
+
+def _key_problems(obj, where, required, optional=frozenset()):
+    missing = [f'{where}: missing "{key}"' for key in sorted(required - obj.keys())]
+    unknown = [
+        f'{where}: unknown key "{key}" (expected {_names(required | optional)})'
+        for key in sorted(obj.keys() - required - optional)
+    ]
+    return missing + unknown
+
+
+def _rule_problems(rule, where):
+    if not isinstance(rule, dict):
+        return [f"{where}: must be an object, got {rule!r}"]
+    problems = _key_problems(rule, where, required={"prefix", "keep"})
+    if "prefix" in rule:
+        prefix = rule["prefix"]
+        if not isinstance(prefix, str) or not prefix:
+            # An empty prefix would claim every snapshot in the directory.
+            problems.append(f'{where}: "prefix" must be a non-empty string, got {prefix!r}')
+        elif GLOB_OR_PATH_CHARS & set(prefix):
+            problems.append(f'{where}: "prefix" must not contain any of * ? [ ] / \\, got {prefix!r}')
+    if "keep" in rule:
+        keep = rule["keep"]
+        # bool is an int in Python; `"keep": true` is not a count.
+        if type(keep) is not int or keep < 0:
+            problems.append(f'{where}: "keep" must be a whole number >= 0, got {keep!r}')
+    return problems
+
+
+def _overlap_problems(prefixes):
+    """A snapshot belongs to exactly one rule, so no prefix may start with another."""
+    return [
+        f"rules[{i}] and rules[{j}]: prefixes {a!r} and {b!r} overlap, "
+        f"so the same snapshots would be pruned by both"
+        for i, a in enumerate(prefixes)
+        for j, b in enumerate(prefixes)
+        if i < j and (a.startswith(b) or b.startswith(a))
+    ]
+
+
+def _names(keys):
+    return ", ".join(f'"{key}"' for key in sorted(keys))
