+@dataclass(frozen=True)
+class Pruning:
+    """What one rule does to its snapshot family."""
+    prefix: str
+    kept: tuple
+    expired: tuple
+
+
+def plan(policy):
+    """Decide every deletion for the whole policy, touching nothing."""
+    root = policy.snapshot_dir
+    if not root.is_dir():
+        raise NotADirectoryError(f'"snapshot_dir" is not a directory: {root}')
+    return [pruning(root, rule) for rule in policy.rules]
 
 
 def snapshots(root, prefix):
@@ -13,10 +23,22 @@ def snapshots(root, prefix):
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
 
 
-def prune(root, rule, dry_run):
-    for path in snapshots(root, rule["prefix"])[rule["keep"]:]:
-        if dry_run:
-            print(f"would delete {path}")
-        else:
-            path.unlink()
-            print(f"deleted {path}")
+def pruning(root, rule):
+    found = snapshots(root, rule.prefix)
+    return Pruning(rule.prefix, tuple(found[:rule.keep]), tuple(found[rule.keep:]))
+
+
+# [LAW:no-ambient-temporal-coupling] execute takes a finished plan, so the first
+# unlink cannot happen until every rule has been resolved.
+def execute(prunings, dry_run):
+    for p in prunings:
+        # [LAW:nothing-unseen] A rule that matched nothing prints "0 snapshots",
+        # so a mistyped prefix is visible instead of looking like a clean run.
+        print(f"{p.prefix}: {len(p.kept) + len(p.expired)} snapshots, "
+              f"keeping {len(p.kept)}, deleting {len(p.expired)}")
+        for path in p.expired:
+            if dry_run:
+                print(f"would delete {path}")
+            else:
+                path.unlink()
+                print(f"deleted {path}")
