--- a/fixture/prune.py
+++ b/work/prune.py
@@ -5,10 +5,16 @@ Usage: python3 prune.py <policy.json>
 The policy names the snapshot directory and one rule per snapshot family: every
 `<prefix>*.tar` file in the directory belongs to that rule, and the newest `keep`
 of them are kept. With "dry_run": true nothing is deleted, only listed.
+
+The whole policy is checked before the first deletion. If anything in it is
+wrong, every problem is listed on stderr and nothing is deleted.
+
+Exit status: 0 pruned (or dry run), 1 policy rejected, 2 bad usage.
 """
 import json
 import sys
 
+import policy
 import retention
 
 
@@ -16,11 +22,26 @@ def main(argv):
     if len(argv) != 2:
         print("usage: python3 prune.py <policy.json>", file=sys.stderr)
         return 2
-    with open(argv[1]) as f:
-        policy = json.load(f)
-    retention.apply(policy)
+    try:
+        with open(argv[1]) as f:
+            parsed = policy.parse(json.load(f))
+        prunings = retention.plan(parsed)
+    except policy.PolicyError as e:
+        return rejected(argv[1], e.problems)
+    except json.JSONDecodeError as e:
+        return rejected(argv[1], [f"not valid JSON: {e}"])
+    except OSError as e:
+        return rejected(argv[1], [str(e)])
+    retention.execute(prunings, parsed.dry_run)
     return 0
 
 
+def rejected(path, problems):
+    print(f"prune.py: {path} rejected, nothing was deleted:", file=sys.stderr)
+    for problem in problems:
+        print(f"  - {problem}", file=sys.stderr)
+    return 1
+
+
 if __name__ == "__main__":
     sys.exit(main(sys.argv))
