index 0000000..125992f
--- /dev/null
+++ b/work/policy.py
@@ -0,0 +1,103 @@
+"""Parse a retention policy, reporting every mistake in it at once."""
+from dataclasses import dataclass
+from difflib import get_close_matches
+
+
+class PolicyError(Exception):
+    """The policy is not usable; `problems` lists each mistake found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: str
+    dry_run: bool
+    rules: tuple
+
+
+def _is_text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int in Python; `"keep": true` is a mistake, not a count of 1.
+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
+
+
+# key -> (required, predicate, what a legal value is)
+POLICY_FIELDS = {
+    "snapshot_dir": (True, _is_text, "a non-empty string"),
+    "dry_run": (False, lambda v: isinstance(v, bool), "true or false"),
+    "rules": (True, lambda v: isinstance(v, list), "a list of rules"),
+}
+RULE_FIELDS = {
+    "prefix": (True, _is_text, "a non-empty string"),
+    # A negative keep would slice from the wrong end and delete the newest snapshots.
+    "keep": (True, _is_count, "a whole number, 0 or more"),
+}
+
+
+def _field_problems(obj, where, fields):
+    if not isinstance(obj, dict):
+        return [f"{where}: must be a JSON object, got {obj!r}"]
+    found = []
+    for key in obj:
+        if key not in fields:
+            close = get_close_matches(key, fields, n=1)
+            hint = f" (did you mean {close[0]!r}?)" if close else ""
+            found.append(f"{where}: unknown key {key!r}{hint}")
+    for key, (required, is_legal, expected) in fields.items():
+        if key not in obj:
+            if required:
+                found.append(f"{where}: missing {key!r}")
+        elif not is_legal(obj[key]):
+            found.append(f"{where}: {key!r} must be {expected}, got {obj[key]!r}")
+    return found
+
+
+def _rule_label(number, rule):
+    prefix = rule.get("prefix") if isinstance(rule, dict) else None
+    return f"rule {number} (prefix {prefix!r})" if _is_text(prefix) else f"rule {number}"
+
+
+def _overlap_problems(labelled):
+    """Each snapshot must belong to one rule, so no prefix may start with another."""
+    claims = [(label, rule["prefix"]) for label, rule in labelled
+              if isinstance(rule, dict) and _is_text(rule.get("prefix"))]
+    return [
+        f"{later}: overlaps {earlier}, so some snapshots would fall under both rules"
+        for i, (earlier, a) in enumerate(claims)
+        for later, b in claims[i + 1:]
+        if a.startswith(b) or b.startswith(a)
+    ]
+
+
+def parse(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError listing every mistake.
+
+    [LAW:parse-dont-validate] The only way to get a Policy is through here, so code
+    that deletes snapshots cannot be handed a policy that was never checked.
+    """
+    problems = _field_problems(raw, "policy", POLICY_FIELDS)
+    rules = raw.get("rules") if isinstance(raw, dict) else None
+    labelled = [(_rule_label(n, rule), rule)
+                for n, rule in enumerate(rules if isinstance(rules, list) else [], start=1)]
+    for label, rule in labelled:
+        problems += _field_problems(rule, label, RULE_FIELDS)
+    problems += _overlap_problems(labelled)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=raw["snapshot_dir"],
+        dry_run=raw.get("dry_run", False),
+        rules=tuple(Rule(prefix=r["prefix"], keep=r["keep"]) for r in rules),
+    )
