@@ -5,20 +5,49 @@ Usage: python3 prune.py <policy.json>
 The policy names the snapshot directory and one rule per snapshot family: every
 `<prefix>*.tar` file in the directory belongs to that rule, and the newest `keep`
 of them are kept. With "dry_run": true nothing is deleted, only listed.
+
+The whole policy is checked before anything is deleted. If it has a mistake, every
+problem is listed on stderr and nothing is touched.
+
+Exit codes: 0 pruned, 1 the policy is unusable (nothing deleted), 2 usage.
 """
 import json
+import os
 import sys
 
+import policy
 import retention
 
 
+def load(path):
+    """Read and parse the policy file; PolicyError covers every way it can be unusable."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise policy.PolicyError([f"cannot read file: {e.strerror}"])
+    except json.JSONDecodeError as e:
+        raise policy.PolicyError([f"not valid JSON: {e}"])
+    parsed = policy.parse(raw)
+    # A mistyped directory would otherwise match no snapshots and look like a clean run.
+    if not os.path.isdir(parsed.snapshot_dir):
+        raise policy.PolicyError(
+            [f"policy: 'snapshot_dir' {parsed.snapshot_dir!r} is not a directory"])
+    return parsed
+
+
 def main(argv):
     if len(argv) != 2:
         print("usage: python3 prune.py <policy.json>", file=sys.stderr)
         return 2
-    with open(argv[1]) as f:
-        policy = json.load(f)
-    retention.apply(policy)
+    try:
+        parsed = load(argv[1])
+    except policy.PolicyError as e:
+        print(f"prune.py: {argv[1]} has problems; nothing was deleted:", file=sys.stderr)
+        for problem in e.problems:
+            print(f"  - {problem}", file=sys.stderr)
+        return 1
+    retention.apply(parsed)
     return 0
 
 
