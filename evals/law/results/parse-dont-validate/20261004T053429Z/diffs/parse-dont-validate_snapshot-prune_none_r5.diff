+            # bool is an int in Python; `"keep": true` is not a count.
+            if not isinstance(keep, int) or isinstance(keep, bool) or keep < 0:
+                problems.append(f'{where}: "keep" must be a whole number, 0 or more, got {keep!r}')
+
+    # A snapshot must belong to exactly one rule, or two rules would each count it.
+    for n, (prefix, where) in enumerate(prefixes):
+        for other, _ in prefixes[:n]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(f'{where}: "prefix" overlaps with "{other}"')
+    return problems
+
+
+def apply(policy):
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
+    root = Path(policy["snapshot_dir"])
+    dry_run = policy.get("dry_run", False)
