-    retention.apply(policy)
+    try:
+        with open(argv[1]) as f:
+            policy = json.load(f)
+    except OSError as e:
+        return refuse(argv[1], [f"cannot read it: {e.strerror}"])
+    except ValueError as e:
+        return refuse(argv[1], [f"not valid JSON: {e}"])
+    try:
+        retention.apply(policy)
+    except retention.PolicyError as e:
+        return refuse(argv[1], e.problems)
     return 0
 
 
+def refuse(policy_path, problems):
+    print(f"prune.py: {policy_path} is invalid, nothing was deleted:", file=sys.stderr)
+    for problem in problems:
+        print(f"  - {problem}", file=sys.stderr)
+    return 1
+
+
 if __name__ == "__main__":
     sys.exit(main(sys.argv))
