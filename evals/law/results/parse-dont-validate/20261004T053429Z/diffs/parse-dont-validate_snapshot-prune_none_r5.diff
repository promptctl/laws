+class PolicyError(ValueError):
+    """The policy is not safe to act on. `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+def validate(policy):
+    """Return every problem found in the policy; an empty list means it is usable."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = []
+    problems += _key_problems("policy", policy, POLICY_KEYS, required={"snapshot_dir", "rules"})
+
+    if "snapshot_dir" in policy:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append(f'"snapshot_dir" must be a non-empty string, got {snapshot_dir!r}')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'"snapshot_dir" {snapshot_dir!r} is not a directory')
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append(f'"dry_run" must be true or false, got {policy["dry_run"]!r}')
+
+    if "rules" in policy:
+        rules = policy["rules"]
+        if not isinstance(rules, list):
+            problems.append(f'"rules" must be a list, got {rules!r}')
+        else:
+            problems += _rules_problems(rules)
+    return problems
+
+
+def _key_problems(where, obj, allowed, required):
+    problems = [f'{where}: unknown key "{key}"' for key in obj if key not in allowed]
+    problems += [f'{where}: missing "{key}"' for key in sorted(required) if key not in obj]
+    return problems
 
-def snapshots(root, prefix):
-    """Newest first: names end in an ISO date, so name order is age order."""
-    return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
 
+def _rules_problems(rules):
+    problems = []
+    prefixes = []
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where}: must be an object, got {rule!r}")
+            continue
+        if isinstance(rule.get("prefix"), str) and rule["prefix"]:
+            where += f' (prefix "{rule["prefix"]}")'
+        problems += _key_problems(where, rule, RULE_KEYS, required=RULE_KEYS)
 
-def prune(root, rule, dry_run):
-    for path in snapshots(root, rule["prefix"])[rule["keep"]:]:
+        if "prefix" in rule:
