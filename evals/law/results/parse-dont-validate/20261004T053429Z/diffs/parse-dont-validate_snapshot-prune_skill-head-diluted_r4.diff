@@ -0,0 +1,124 @@
+"""Read a retention policy file into a Policy, or report everything wrong with it."""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+JSON_TYPE_NAMES = {
+    dict: "an object",
+    list: "an array",
+    str: "a string",
+    bool: "true or false",
+    int: "an integer",
+    float: "a number",
+    type(None): "null",
+}
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+class PolicyError(ValueError):
+    """The policy file cannot be used; `problems` lists every reason found."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+def load(path):
+    """Read and parse the policy file at `path`, checking its snapshot directory exists."""
+    try:
+        with open(path) as f:
+            raw = json.load(f, object_pairs_hook=_reject_duplicate_keys)
+    except OSError as e:
+        raise PolicyError([f"cannot read the file: {e.strerror}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    policy = parse(raw)
+    # A mistyped directory would otherwise match no snapshots and look like a clean run.
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f'snapshot_dir "{policy.snapshot_dir}" is not a directory'])
+    return policy
+
+
+def parse(raw):
+    """Turn decoded JSON into a Policy; raise PolicyError naming every problem."""
+    # [LAW:parse-dont-validate] the only place policy shape is checked; retention
+    # takes the Policy this returns and never looks at raw JSON.
+    if type(raw) is not dict:
+        raise PolicyError([f"policy: must be an object, not {_json_type(raw)}"])
+    problems = []
+    _unknown_keys(raw, ("snapshot_dir", "dry_run", "rules"), "policy", problems)
+    snapshot_dir = _field(raw, "snapshot_dir", str, "policy", problems)
+    dry_run = _field({"dry_run": False, **raw}, "dry_run", bool, "policy", problems)
+    raw_rules = _field(raw, "rules", list, "policy", problems) or []
+    rules = [_rule(raw_rule, i, problems) for i, raw_rule in enumerate(raw_rules)]
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, tuple(Rule(*rule) for rule in rules))
+
+
+def _rule(raw, index, problems):
+    where = f"rules[{index}]"
+    if type(raw) is not dict:
+        problems.append(f"{where}: must be an object, not {_json_type(raw)}")
+        return None
+    if type(raw.get("prefix")) is str:
+        where += f' (prefix "{raw["prefix"]}")'
+    _unknown_keys(raw, ("prefix", "keep"), where, problems)
+    prefix = _field(raw, "prefix", str, where, problems)
+    keep = _field(raw, "keep", int, where, problems)
+    if prefix == "":
+        problems.append(f'{where}: "prefix" must not be empty')
+    # A negative keep would slice from the wrong end and delete only the oldest few.
+    if keep is not None and keep < 0:
+        problems.append(f'{where}: "keep" must be 0 or more, not {keep}')
+    return prefix, keep
+
+
+def _field(obj, key, expected, where, problems):
+    """obj[key] when it is exactly `expected`; otherwise record why not and return None."""
+    if key not in obj:
+        problems.append(f'{where}: missing required key "{key}"')
+        return None
+    value = obj[key]
+    # Exact type, because bool is a subclass of int and `"keep": true` is a mistake.
+    if type(value) is not expected:
+        problems.append(
+            f'{where}: "{key}" must be {JSON_TYPE_NAMES[expected]}, '
+            f"not {_json_type(value)}"
+        )
+        return None
+    return value
+
+
+def _unknown_keys(obj, known, where, problems):
+    for key in obj:
+        if key not in known:
+            close = difflib.get_close_matches(key, known, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+
+
+def _reject_duplicate_keys(pairs):
+    obj = {}
+    for key, value in pairs:
+        if key in obj:
+            raise PolicyError([f'key "{key}" appears twice in the same object'])
+        obj[key] = value
+    return obj
+
+
+def _json_type(value):
+    return JSON_TYPE_NAMES[type(value)]
