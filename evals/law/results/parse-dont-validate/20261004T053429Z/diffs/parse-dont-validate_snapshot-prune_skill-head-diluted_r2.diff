@@ -0,0 +1,109 @@
+"""Read a retention policy file into a Policy, or say everything that is wrong with it."""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class PolicyError(Exception):
+    """The policy file cannot be used; `problems` lists every reason found."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+# [LAW:parse-dont-validate] retention only accepts a Policy, and load() is the only
+# way to get one, so a policy with a mistake in it never reaches the code that deletes.
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def _is_text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int subclass; `"keep": true` is a mistake, not a count of 1
+    return type(value) is int and value >= 0
+
+
+# key -> (check, what the value must be)
+_RULE_KEYS = {
+    "prefix": (_is_text, "a non-empty string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+_POLICY_KEYS = {
+    "snapshot_dir": (_is_text, "a non-empty string"),
+    "dry_run": (lambda value: isinstance(value, bool), "true or false"),
+    "rules": (lambda value: isinstance(value, list), "a list of rules"),
+}
+
+
+def _problems(obj, where, keys, optional=()):
+    if not isinstance(obj, dict):
+        return [f"{where}: must be an object, got {json.dumps(obj)}"]
+    found = []
+    # An unknown key is an error, not noise: a misspelt "dry_run" would otherwise
+    # be ignored and turn a rehearsal into a real deletion.
+    for key in sorted(obj.keys() - keys.keys()):
+        close = difflib.get_close_matches(key, keys, n=1)
+        hint = f" (did you mean {close[0]!r}?)" if close else ""
+        found.append(f"{where}: unknown key {key!r}{hint}")
+    for key, (ok, expected) in keys.items():
+        if key not in obj:
+            if key not in optional:
+                found.append(f"{where}: missing {key!r}")
+        elif not ok(obj[key]):
+            found.append(f"{where}: {key!r} must be {expected}, got {json.dumps(obj[key])}")
+    return found
+
+
+def parse(raw):
+    """Turn decoded JSON into a Policy; raise PolicyError listing every problem."""
+    problems = _problems(raw, "policy", _POLICY_KEYS, optional={"dry_run"})
+    raw_rules = raw.get("rules") if isinstance(raw, dict) else None
+    raw_rules = raw_rules if isinstance(raw_rules, list) else []
+    for number, raw_rule in enumerate(raw_rules, start=1):
+        problems += _problems(raw_rule, f"rule {number}", _RULE_KEYS)
+    if problems:
+        raise PolicyError(problems)
+
+    rules = tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules)
+    # Overlapping prefixes put one snapshot under two rules with two different
+    # `keep` counts, and the second rule would try to delete what the first already did.
+    for i, first in enumerate(rules):
+        for j, second in enumerate(rules[i + 1:], start=i + 1):
+            if first.prefix.startswith(second.prefix) or second.prefix.startswith(first.prefix):
+                problems.append(
+                    f"rules {i + 1} and {j + 1}: prefixes {first.prefix!r} and "
+                    f"{second.prefix!r} overlap, so the same snapshots fall under both"
+                )
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(raw["snapshot_dir"]), raw.get("dry_run", False), rules)
+
+
+def load(path):
+    """Read and parse the policy file at `path`; raise PolicyError if it is unusable."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read policy file: {e}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    policy = parse(raw)
+    # A misspelt directory matches no snapshots, which would look like a clean run.
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f"policy: 'snapshot_dir' {str(policy.snapshot_dir)!r} is not a directory"])
+    return policy
