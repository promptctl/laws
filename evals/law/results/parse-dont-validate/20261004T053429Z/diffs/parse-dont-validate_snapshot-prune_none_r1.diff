diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..95c1d23 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,105 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+REQUIRED_POLICY_KEYS = {"snapshot_dir", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(ValueError):
+    """The policy is not safe to act on; `problems` lists every reason why."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy, then prune. Nothing is deleted unless all of it is valid."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Return a list of everything wrong with the policy (empty if it is usable)."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = _key_problems("policy", policy, POLICY_KEYS, REQUIRED_POLICY_KEYS)
+
+    if "snapshot_dir" in policy:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append('policy: "snapshot_dir" must be a non-empty string')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'policy: "snapshot_dir" {snapshot_dir!r} is not a directory')
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append('policy: "dry_run" must be true or false')
+
+    if "rules" in policy:
+        rules = policy["rules"]
+        if not isinstance(rules, list):
+            problems.append('policy: "rules" must be a list')
+        else:
+            problems.extend(_rules_problems(rules))
+    return problems
+
+
+def _rules_problems(rules):
+    problems = []
+    prefixes = []  # (where, prefix) of each rule whose prefix is usable
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where}: must be a JSON object")
+            continue
+        prefix = rule.get("prefix")
+        if isinstance(prefix, str) and prefix:
+            where += f" (prefix {prefix!r})"
+        problems.extend(_key_problems(where, rule, RULE_KEYS, RULE_KEYS))
+
+        if "prefix" in rule:
+            if not isinstance(prefix, str) or not prefix:
+                # An empty prefix would match every snapshot in the directory.
+                problems.append(f'{where}: "prefix" must be a non-empty string')
+            elif any(c in prefix for c in "*?[]/\\"):
+                problems.append(f'{where}: "prefix" must not contain any of * ? [ ] / \\')
+            else:
+                prefixes.append((where, prefix))
+
+        if "keep" in rule:
+            keep = rule["keep"]
+            # bool is an int in Python; a negative keep would delete the newest snapshots.
+            if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+                problems.append(f'{where}: "keep" must be a whole number, 0 or more (got {keep!r})')
+
+    # A snapshot must belong to exactly one rule, or one rule deletes what another keeps.
+    for n, (where, prefix) in enumerate(prefixes):
+        for other_where, other in prefixes[:n]:
+            if prefix == other:
+                problems.append(f"{where}: duplicates {other_where}")
+            elif prefix.startswith(other) or other.startswith(prefix):
+                problems.append(f"{where}: overlaps {other_where}, so some snapshots match both rules")
+    return problems
+
+
+def _key_problems(where, obj, allowed, required):
+    problems = []
+    for key in obj:
+        if key not in allowed:
+            close = difflib.get_close_matches(key, sorted(allowed), n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    for key in sorted(required - obj.keys()):
+        problems.append(f'{where}: missing "{key}"')
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
