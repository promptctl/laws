@@ -5,10 +5,16 @@ Usage: python3 prune.py <policy.json>
 The policy names the snapshot directory and one rule per snapshot family: every
 `<prefix>*.tar` file in the directory belongs to that rule, and the newest `keep`
 of them are kept. With "dry_run": true nothing is deleted, only listed.
+
+The whole policy is checked before anything is deleted: a mistake anywhere in it
+stops the run with every problem listed and every snapshot still in place.
+
+Exit status: 0 pruned, 1 the policy could not be used, 2 bad command line.
 """
 import json
 import sys
 
+import policy
 import retention
 
 
@@ -16,11 +22,31 @@ def main(argv):
     if len(argv) != 2:
         print("usage: python3 prune.py <policy.json>", file=sys.stderr)
         return 2
-    with open(argv[1]) as f:
-        policy = json.load(f)
-    retention.apply(policy)
+    try:
+        parsed = load(argv[1])
+    except policy.PolicyError as e:
+        print(f"prune.py: {argv[1]} is not a usable policy; nothing was deleted:", file=sys.stderr)
+        for problem in e.problems:
+            print(f"  - {problem}", file=sys.stderr)
+        return 1
+    retention.apply(parsed)
     return 0
 
 
+def load(path):
+    """Read a policy file; every way it can be unusable surfaces as PolicyError."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise policy.PolicyError([f"cannot read file: {e.strerror}"])
+    except json.JSONDecodeError as e:
+        raise policy.PolicyError([f"not valid JSON: {e}"])
+    parsed = policy.parse(raw)
+    if not parsed.snapshot_dir.is_dir():
+        raise policy.PolicyError([f'policy: "snapshot_dir" {str(parsed.snapshot_dir)!r} is not a directory'])
+    return parsed
+
+
 if __name__ == "__main__":
     sys.exit(main(sys.argv))
