+def day_problem(day):
+    """Say what's wrong with a `day` parameter, or return None if it's a usable date."""
+    if not day:
+        return "day is required, as YYYY-MM-DD"
+    try:
+        date.fromisoformat(day)
+    except ValueError:
+        if DAY_SHAPE.fullmatch(day):
+            return f"day {day!r} is not a real calendar date"
+        return f"day {day!r} is not in YYYY-MM-DD format"
+    return None
+
