+def unique_keys(pairs):
+    """Reject repeated keys, which json would otherwise resolve by keeping the last."""
+    obj = {}
+    for key, value in pairs:
+        if key in obj:
+            raise ValueError(f'key "{key}" appears more than once in the same object')
+        obj[key] = value
+    return obj
+
