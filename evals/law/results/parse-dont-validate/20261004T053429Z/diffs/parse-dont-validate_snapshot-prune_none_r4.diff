index f0bf84d..8b942ab 100644
--- a/fixture/prune.py
+++ b/work/prune.py
@@ -5,6 +5,9 @@ Usage: python3 prune.py <policy.json>
 The policy names the snapshot directory and one rule per snapshot family: every
 `<prefix>*.tar` file in the directory belongs to that rule, and the newest `keep`
 of them are kept. With "dry_run": true nothing is deleted, only listed.
+
+The whole policy is checked before anything is deleted: if any part of it is
+wrong, every problem is reported and the run exits with status 1.
 """
 import json
 import sys
@@ -16,11 +19,31 @@ def main(argv):
     if len(argv) != 2:
         print("usage: python3 prune.py <policy.json>", file=sys.stderr)
         return 2
-    with open(argv[1]) as f:
-        policy = json.load(f)
-    retention.apply(policy)
+    try:
+        with open(argv[1]) as f:
+            policy = json.load(f, object_pairs_hook=unique_keys)
+    except (OSError, ValueError) as e:
+        print(f"prune.py: cannot read policy {argv[1]}: {e}", file=sys.stderr)
+        return 1
+    try:
+        retention.apply(policy)
+    except retention.PolicyError as e:
+        print(f"prune.py: {argv[1]} is not a valid policy, nothing was deleted:", file=sys.stderr)
+        for problem in e.problems:
+            print(f"  - {problem}", file=sys.stderr)
+        return 1
     return 0
 
 
+def unique_keys(pairs):
+    """Refuse a repeated key, which json would otherwise resolve by silently keeping the last."""
+    obj = {}
+    for key, value in pairs:
+        if key in obj:
+            raise ValueError(f'key "{key}" appears more than once in the same object')
+        obj[key] = value
+    return obj
+
+
 if __name__ == "__main__":
     sys.exit(main(sys.argv))
diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..a339b15 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,114 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
+import json
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(Exception):
+    """The policy is unusable; `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy first, so a bad rule can't leave a half-done prune."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Return a list of problems with the policy; empty means it is safe to apply."""
+    if not isinstance(policy, dict):
+        return [f"policy must be a JSON object, not {_kind(policy)}"]
+    problems = _key_problems("policy", policy, POLICY_KEYS, required={"snapshot_dir", "rules"})
+
+    if "snapshot_dir" in policy:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append(f'"snapshot_dir" must be a non-empty string, not {_show(snapshot_dir)}')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'"snapshot_dir" {_show(snapshot_dir)} is not an existing directory')
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append(f'"dry_run" must be true or false, not {_show(policy["dry_run"])}')
+
+    if "rules" in policy:
+        rules = policy["rules"]
+        if not isinstance(rules, list):
+            problems.append(f'"rules" must be a list, not {_kind(rules)}')
+        else:
+            problems.extend(_rules_problems(rules))
+    return problems
+
+
+def _rules_problems(rules):
+    problems = []
+    prefixes = []
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where} must be an object, not {_kind(rule)}")
+            continue
+        prefix = rule.get("prefix")
+        if isinstance(prefix, str):
+            where += f" (prefix {_show(prefix)})"
+        problems.extend(_key_problems(where, rule, RULE_KEYS, required=RULE_KEYS))
+
+        if "prefix" in rule:
+            if not isinstance(prefix, str) or not prefix:
+                problems.append(f'{where}: "prefix" must be a non-empty string, not {_show(prefix)}')
+            elif any(c in prefix for c in "*?[]/\\"):
+                problems.append(f'{where}: "prefix" must be a plain file name prefix, without any of * ? [ ] / \\')
+            else:
+                prefixes.append((where, prefix))
+
+        if "keep" in rule:
+            keep = rule["keep"]
+            if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+                problems.append(f'{where}: "keep" must be a whole number, 0 or more, not {_show(keep)}')
+
+    # A file matching two rules would be pruned by whichever rule keeps fewer.
+    for n, (where, prefix) in enumerate(prefixes):
+        for other_where, other in prefixes[:n]:
+            if prefix == other:
+                problems.append(f"{where}: same prefix as {other_where}")
+            elif prefix.startswith(other) or other.startswith(prefix):
+                problems.append(
+                    f"{where}: prefix overlaps with {other_where}, so some snapshots would belong to both rules"
+                )
+    return problems
+
+
+def _key_problems(where, obj, known, required):
+    problems = []
+    missing = sorted(required - obj.keys())
+    for key in sorted(obj.keys() - known):
+        guess = difflib.get_close_matches(key, missing or sorted(known), n=1)
+        hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    for key in missing:
+        problems.append(f'{where}: missing "{key}"')
+    return problems
+
+
+def _kind(value):
+    names = {dict: "an object", list: "a list", str: "a string", bool: "a boolean", type(None): "null"}
+    return names.get(type(value), "a number")
+
+
+def _show(value):
+    return json.dumps(value)
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
