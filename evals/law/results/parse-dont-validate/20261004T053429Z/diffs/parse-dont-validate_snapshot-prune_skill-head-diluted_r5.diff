+"""Delete the snapshots a retention policy no longer keeps.
+
+Three stages, each consuming the previous one's output: `parse_policy` turns raw
+JSON into a `Policy`, `plan` reads the snapshot directory and decides what goes,
+`execute` deletes. Everything that can be wrong with a policy is found in the
+first two, so nothing is deleted under a policy that has a mistake in it.
+"""
+from dataclasses import dataclass
+from difflib import get_close_matches
 from pathlib import Path
 
 
-def apply(policy):
-    root = Path(policy["snapshot_dir"])
-    for rule in policy["rules"]:
-        prune(root, rule, dry_run=policy.get("dry_run", False))
+class PolicyError(ValueError):
+    """The policy cannot be applied. Carries every problem found, not just the first."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+@dataclass(frozen=True)
+class RulePlan:
+    rule: Rule
+    kept: tuple[Path, ...]
+    doomed: tuple[Path, ...]
+
+
+def _is_nonempty_str(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_bool(value):
+    return isinstance(value, bool)
+
+
+def _is_count(value):
+    # bool is an int subclass; `"keep": true` is a mistake, not a count of 1
+    return type(value) is int and value >= 0
+
+
+def _is_list(value):
+    return isinstance(value, list)
+
+
+# key -> (check, what a valid value is)
+_POLICY_REQUIRED = {
+    "snapshot_dir": (_is_nonempty_str, "a non-empty string"),
+    "rules": (_is_list, "a list of rules"),
+}
+_POLICY_OPTIONAL = {"dry_run": (_is_bool, "true or false")}
+_RULE_REQUIRED = {
+    "prefix": (_is_nonempty_str, "a non-empty string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+
+
+def _object_problems(where, raw, required, optional=None):
+    """Problems with one JSON object: wrong shape, unknown/missing keys, bad values."""
+    if not isinstance(raw, dict):
+        return [f"{where}: must be a JSON object, got {raw!r}"]
+    fields = {**required, **(optional or {})}
+    problems = []
+    for key in raw:
+        if key not in fields:
+            close = get_close_matches(key, fields, n=1)
+            hint = f" (did you mean {close[0]!r}?)" if close else ""
+            problems.append(f"{where}: unknown key {key!r}{hint}")
+    for key in required:
+        if key not in raw:
+            problems.append(f"{where}: missing required key {key!r}")
+    for key, (check, expected) in fields.items():
+        if key in raw and not check(raw[key]):
+            problems.append(f"{where}: {key!r} must be {expected}, got {raw[key]!r}")
+    return problems
+
+
+def _overlap_problems(rules):
+    """A snapshot must belong to one rule; overlapping prefixes make it belong to two."""
+    return [
+        f"rules[{i}] prefix {a.prefix!r} overlaps rules[{j}] prefix {b.prefix!r}: "
+        "the same snapshots would match both rules"
+        for i, a in enumerate(rules)
+        for j, b in enumerate(rules)
+        if i < j and (a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix))
+    ]
+
+
+def parse_policy(raw):
+    """Turn decoded JSON into a Policy, or raise PolicyError listing every mistake.
+
+    [LAW:parse-dont-validate] the only place policy shape is checked; `plan` and
+    `execute` take the typed result and never look at raw JSON.
+    """
+    problems = _object_problems("policy", raw, _POLICY_REQUIRED, _POLICY_OPTIONAL)
+    raw_rules = raw.get("rules") if isinstance(raw, dict) else None
+    rules = []
+    for i, raw_rule in enumerate(raw_rules if isinstance(raw_rules, list) else []):
+        rule_problems = _object_problems(f"rules[{i}]", raw_rule, _RULE_REQUIRED)
+        problems += rule_problems
+        if not rule_problems:
+            rules.append(Rule(prefix=raw_rule["prefix"], keep=raw_rule["keep"]))
+    if not problems:
+        problems = _overlap_problems(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", False),
+        rules=tuple(rules),
+    )
 
 
