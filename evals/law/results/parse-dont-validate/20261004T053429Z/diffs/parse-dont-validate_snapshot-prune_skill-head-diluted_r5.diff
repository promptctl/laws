     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
 
 
-def prune(root, rule, dry_run):
-    for path in snapshots(root, rule["prefix"])[rule["keep"]:]:
-        if dry_run:
-            print(f"would delete {path}")
-        else:
-            path.unlink()
-            print(f"deleted {path}")
+def plan(policy):
+    """Decide, for every rule, which snapshots stay and which go. Deletes nothing."""
+    root = policy.snapshot_dir
+    if not root.is_dir():
+        raise PolicyError([f"policy: snapshot_dir {str(root)!r} is not a directory"])
+    plans = []
+    for rule in policy.rules:
+        found = snapshots(root, rule.prefix)
+        plans.append(
+            RulePlan(rule, kept=tuple(found[: rule.keep]), doomed=tuple(found[rule.keep :]))
+        )
+    return plans
+
+
+def execute(plans, dry_run):
+    """Carry out a plan. [LAW:effects-at-boundaries] the only function that deletes."""
+    verb = "would delete" if dry_run else "deleted"
+    for rule_plan in plans:
+        for path in rule_plan.doomed:
+            if not dry_run:
+                path.unlink()
+            print(f"{verb} {path}")
+        # [LAW:nothing-unseen] a rule that matched nothing still reports, with zeros
+        print(
+            f"{rule_plan.rule.prefix}: kept {len(rule_plan.kept)}, "
+            f"{verb} {len(rule_plan.doomed)}"
+        )
