@@ -0,0 +1,110 @@
+"""Run with: python3 -m unittest test_prune"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+FAMILIES = {"db-": 6, "media-": 4, "logs-": 6}
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.tmp = Path(tmp.name)
+        self.snapshot_dir = self.tmp / "snapshots"
+        self.snapshot_dir.mkdir()
+        for prefix, count in FAMILIES.items():
+            for day in range(1, count + 1):
+                (self.snapshot_dir / f"{prefix}2026-09-{day:02}.tar").touch()
+
+    def run_prune(self, policy):
+        """Returns (exit code, stdout, stderr); policy is a dict or raw file text."""
+        path = self.tmp / "policy.json"
+        path.write_text(policy if isinstance(policy, str) else json.dumps(policy))
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            code = prune.main(["prune.py", str(path)])
+        return code, out.getvalue(), err.getvalue()
+
+    def policy(self, rules, **extra):
+        return {"snapshot_dir": str(self.snapshot_dir), "rules": rules, **extra}
+
+    def remaining(self):
+        return sorted(p.name for p in self.snapshot_dir.iterdir())
+
+    def assert_rejected_untouched(self, policy, *expected_in_stderr):
+        before = self.remaining()
+        code, _, err = self.run_prune(policy)
+        self.assertEqual(code, 1)
+        self.assertEqual(self.remaining(), before)
+        self.assertIn("nothing deleted", err)
+        for text in expected_in_stderr:
+            self.assertIn(text, err)
+
+    def test_valid_policy_keeps_newest(self):
+        code, out, _ = self.run_prune(
+            self.policy([{"prefix": "db-", "keep": 3}, {"prefix": "media-", "keep": 2}])
+        )
+        self.assertEqual(code, 0)
+        self.assertEqual(
+            [n for n in self.remaining() if not n.startswith("logs-")],
+            ["db-2026-09-04.tar", "db-2026-09-05.tar", "db-2026-09-06.tar",
+             "media-2026-09-03.tar", "media-2026-09-04.tar"],
+        )
+        self.assertIn("db-: kept 3, deleted 3", out)
+
+    def test_dry_run_deletes_nothing(self):
+        before = self.remaining()
+        code, out, _ = self.run_prune(self.policy([{"prefix": "db-", "keep": 3}], dry_run=True))
+        self.assertEqual(code, 0)
+        self.assertEqual(self.remaining(), before)
+        self.assertIn("would delete", out)
+
+    def test_typo_in_last_rule_deletes_nothing(self):
+        self.assert_rejected_untouched(
+            self.policy([
+                {"prefix": "db-", "keep": 3},
+                {"prefix": "media-", "keep": 2},
+                {"prefix": "logs-", "kepe": 4},
+            ]),
+            "rules[2]: unknown key 'kepe' (did you mean 'keep'?)",
+            "rules[2]: missing required key 'keep'",
+        )
+
+    def test_every_problem_is_reported(self):
+        self.assert_rejected_untouched(
+            self.policy([{"prefix": "", "keep": -1}, {"prefix": "db-", "keep": "3"}]),
+            "rules[0]: 'prefix'", "rules[0]: 'keep'", "rules[1]: 'keep'",
+        )
+
+    def test_misspelt_dry_run_is_not_a_real_run(self):
+        self.assert_rejected_untouched(
+            self.policy([{"prefix": "db-", "keep": 3}], dry_rnu=True),
+            "unknown key 'dry_rnu' (did you mean 'dry_run'?)",
+        )
+
+    def test_overlapping_prefixes(self):
+        self.assert_rejected_untouched(
+            self.policy([{"prefix": "db-", "keep": 3}, {"prefix": "db-2026", "keep": 1}]),
+            "overlaps",
+        )
+
+    def test_missing_snapshot_dir(self):
+        policy = self.policy([{"prefix": "db-", "keep": 3}])
+        policy["snapshot_dir"] = str(self.tmp / "snapshotz")
+        self.assert_rejected_untouched(policy, "is not a directory")
+
+    def test_invalid_json(self):
+        self.assert_rejected_untouched('{"snapshot_dir": ', "not valid JSON")
+
+    def test_policy_is_not_an_object(self):
+        self.assert_rejected_untouched("[]", "must be a JSON object")
+
+
+if __name__ == "__main__":
+    unittest.main()
