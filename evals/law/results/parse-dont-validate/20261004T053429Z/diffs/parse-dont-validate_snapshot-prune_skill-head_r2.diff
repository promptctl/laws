+class PolicyError(Exception):
+    """The policy is unusable. Carries every problem found, not just the first."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+def _is_count(value):
+    # bool is an int in Python; "keep": true is a mistake, not a 1
+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
+
+
+def _is_name(value):
+    return isinstance(value, str) and value != ""
+
+
+# field name -> (accepts, description of an acceptable value)
+POLICY_FIELDS = {
+    "snapshot_dir": (_is_name, "a non-empty string"),
+    "rules": (lambda v: isinstance(v, list), "a list of rules"),
+    "dry_run": (lambda v: isinstance(v, bool), "true or false"),
+}
+POLICY_DEFAULTS = {"dry_run": False}
+RULE_FIELDS = {
+    "prefix": (lambda v: isinstance(v, str), "a string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+
+
+def _read_fields(obj, where, fields, defaults, problems):
+    """The well-formed fields of `obj`; everything else is appended to `problems`."""
+    if not isinstance(obj, dict):
+        problems.append(f"{where}: must be an object, got {json_name(obj)}")
+        return {}
+    for key in obj.keys() - fields.keys():
+        near = difflib.get_close_matches(key, fields.keys() - obj.keys(), n=1)
+        hint = f' (did you mean "{near[0]}"?)' if near else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    values = dict(defaults)
+    for name, (accepts, expected) in fields.items():
+        if name not in obj:
+            if name not in defaults:
+                problems.append(f'{where}: missing "{name}"')
+        elif accepts(obj[name]):
+            values[name] = obj[name]
+        else:
+            problems.append(f'{where}: "{name}" must be {expected}, got {obj[name]!r}')
+    return values
+
+
+def json_name(value):
+    names = {dict: "an object", list: "a list", str: "a string", bool: "a boolean",
+             int: "a number", float: "a number", type(None): "null"}
+    return names[type(value)]
+
+
+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError listing every mistake.
+
+    [LAW:parse-dont-validate] This is the only place policy shape is checked; the
+    deleting code below takes a Policy and so cannot be reached with a bad one.
+    """
+    problems = []
+    top = _read_fields(raw, "policy", POLICY_FIELDS, POLICY_DEFAULTS, problems)
+
+    rules = []
+    for i, raw_rule in enumerate(top.get("rules", [])):
+        before = len(problems)
+        fields = _read_fields(raw_rule, f"rules[{i}]", RULE_FIELDS, {}, problems)
+        if len(problems) == before:
+            rules.append((i, Rule(**fields)))
+
+    # A snapshot matching two rules would be pruned by whichever keeps fewer.
+    for n, (i, a) in enumerate(rules):
+        for j, b in rules[n + 1:]:
+            if a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix):
+                problems.append(
+                    f'rules[{i}] and rules[{j}]: prefixes "{a.prefix}" and "{b.prefix}" '
+                    "overlap, so the same snapshot would belong to both"
+                )
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(top["snapshot_dir"]),
+        dry_run=top["dry_run"],
+        rules=tuple(rule for _, rule in rules),
+    )
 
 
