+def by_project(entries):
+    """Total hours per project, biggest first; equal totals go by project name."""
+    hours = defaultdict(Decimal)
+    for entry in entries:
+        hours[entry.project] += entry.hours
+    return dict(sorted(hours.items(), key=lambda item: (-item[1], item[0])))
+
+
 def render(entries):
