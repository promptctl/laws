+def plan(policy):
+    """Decide every rule's deletions; nothing is deleted here."""
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f'policy: "snapshot_dir" {str(policy.snapshot_dir)!r} is not a directory'])
+    prunings = []
+    for rule in policy.rules:
+        found = snapshots(policy.snapshot_dir, rule.prefix)
+        prunings.append(Pruning(rule, found[:rule.keep], found[rule.keep:]))
+    return prunings
+
+
+def carry_out(prunings, dry_run):
+    verb, remove = ("would delete", lambda path: None) if dry_run else ("deleted", Path.unlink)
+    for pruning in prunings:
+        # [LAW:nothing-unseen] a rule that matched nothing (a misspelt prefix,
+        # say) reports 0 found rather than passing in silence.
+        print(f"{pruning.rule.prefix}: {len(pruning.kept) + len(pruning.expired)} found, "
+              f"{len(pruning.kept)} kept, {len(pruning.expired)} expired")
+        for path in pruning.expired:
+            remove(path)
+            print(f"{verb} {path}")
diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..09f2a9a
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,97 @@
+"""Run with: python3 -m unittest test_prune"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+NAMES = [f"{family}-2026-09-0{day}.tar" for family in ("db", "media", "logs") for day in range(1, 7)]
+GOOD_RULES = [{"prefix": "db-", "keep": 3}, {"prefix": "media-", "keep": 2}, {"prefix": "logs-", "keep": 4}]
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name) / "snapshots"
+        self.dir.mkdir()
+        for name in NAMES:
+            (self.dir / name).touch()
+        self.policy_path = Path(tmp.name) / "policy.json"
+
+    def run_prune(self, policy):
+        text = policy if isinstance(policy, str) else json.dumps(policy)
+        self.policy_path.write_text(text)
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = prune.main(["prune.py", str(self.policy_path)])
+        return status, out.getvalue(), err.getvalue()
+
+    def remaining(self):
+        return sorted(path.name for path in self.dir.iterdir())
+
+    def policy(self, **changes):
+        return {"snapshot_dir": str(self.dir), "rules": GOOD_RULES, **changes}
+
+    def test_keeps_the_newest_of_each_family(self):
+        status, out, _ = self.run_prune(self.policy())
+        self.assertEqual(status, 0)
+        self.assertEqual(self.remaining(), sorted(
+            [f"db-2026-09-0{d}.tar" for d in (4, 5, 6)]
+            + [f"media-2026-09-0{d}.tar" for d in (5, 6)]
+            + [f"logs-2026-09-0{d}.tar" for d in (3, 4, 5, 6)]))
+        self.assertIn("db-: 6 found, 3 kept, 3 expired", out)
+
+    def test_dry_run_deletes_nothing(self):
+        status, out, _ = self.run_prune(self.policy(dry_run=True))
+        self.assertEqual(status, 0)
+        self.assertEqual(self.remaining(), sorted(NAMES))
+        self.assertIn("would delete", out)
+
+    def test_misspelt_key_in_last_rule_stops_before_any_deletion(self):
+        rules = GOOD_RULES[:2] + [{"prefix": "logs-", "kepe": 4}]
+        status, _, err = self.run_prune(self.policy(rules=rules))
+        self.assertEqual(status, 1)
+        self.assertEqual(self.remaining(), sorted(NAMES))
+        self.assertIn('rule 3 (prefix "logs-"): unknown key "kepe" (did you mean "keep"?)', err)
+
+    def test_every_mistake_is_reported_in_one_run(self):
+        rules = [{"prefix": "db-", "keep": "3"}, {"prefix": "media-"}]
+        _, _, err = self.run_prune(self.policy(rules=rules, dry_runn=True))
+        for expected in ('unknown key "dry_runn"', '"keep" must be', 'rule 2 (prefix "media-"): missing "keep"'):
+            self.assertIn(expected, err)
+
+    def test_mistakes_delete_nothing(self):
+        mistakes = {
+            "not json": "{",
+            "not an object": [],
+            "no rules": self.policy(rules=[]),
+            "negative keep": self.policy(rules=[{"prefix": "db-", "keep": -1}]),
+            "boolean keep": self.policy(rules=[{"prefix": "db-", "keep": True}]),
+            "empty prefix": self.policy(rules=[{"prefix": "", "keep": 0}]),
+            "wildcard prefix": self.policy(rules=[{"prefix": "*", "keep": 0}]),
+            "overlapping prefixes": self.policy(rules=[{"prefix": "db-", "keep": 3}, {"prefix": "db", "keep": 0}]),
+            "rule is not an object": self.policy(rules=["db-"]),
+            "missing directory": self.policy(snapshot_dir=str(self.dir / "nope")),
+            "misspelt dry_run": self.policy(dry_runn=True),
+        }
+        for name, policy in mistakes.items():
+            with self.subTest(name):
+                status, _, err = self.run_prune(policy)
+                self.assertEqual(status, 1)
+                self.assertIn("nothing was deleted", err)
+                self.assertEqual(self.remaining(), sorted(NAMES))
+
+    def test_missing_policy_file(self):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = prune.main(["prune.py", str(self.policy_path)])
+        self.assertEqual(status, 1)
+        self.assertIn("cannot read it", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
