+            where += f' (prefix "{rule["prefix"]}")'
+            prefixes.append((number, rule["prefix"]))
+        problems += _problems(rule, where, _RULE_FIELDS)
+    # Each snapshot must belong to one rule; otherwise the smaller `keep` wins unannounced.
+    for (n1, p1), (n2, p2) in itertools.combinations(prefixes, 2):
+        if p1.startswith(p2) or p2.startswith(p1):
+            problems.append(f'rule {n1} and rule {n2}: prefixes "{p1}" and "{p2}" match the same snapshots')
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", False),
