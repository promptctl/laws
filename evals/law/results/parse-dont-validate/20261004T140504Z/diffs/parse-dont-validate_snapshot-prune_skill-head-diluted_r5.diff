+class PolicyError(Exception):
+    """The policy cannot be carried out; `problems` lists every reason found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+@dataclass(frozen=True)
+class Pruning:
+    """One rule's decision: the newest `keep` snapshots stay, the rest expire."""
+    rule: Rule
+    kept: list
+    expired: list
+
+
+def _is_prefix(value):
+    # The prefix goes into a glob, so a wildcard or a path separator would
+    # reach snapshots outside the rule's own family.
+    return isinstance(value, str) and value != "" and not set(value) & set("*?[]/")
+
+
+# key -> (accepts the value?, what the value must be)
+_POLICY_FIELDS = {
+    "snapshot_dir": (lambda v: isinstance(v, str) and v != "", "a non-empty string"),
+    "dry_run": (lambda v: isinstance(v, bool), "true or false"),
+    "rules": (lambda v: isinstance(v, list) and v != [], "a non-empty list of rules"),
+}
+_RULE_FIELDS = {
+    "prefix": (_is_prefix, "a non-empty string without * ? [ ] or /"),
+    "keep": (lambda v: type(v) is int and v >= 0, "a whole number, 0 or more"),
+}
+
+
+def _problems(obj, where, fields, optional=()):
+    if not isinstance(obj, dict):
+        return [f"{where}: must be an object, not {json.dumps(obj)}"]
+    found = []
+    for key in sorted(obj.keys() - fields.keys()):
+        guess = difflib.get_close_matches(key, fields, n=1)
+        hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+        found.append(f'{where}: unknown key "{key}"{hint}')
+    for key, (accepts, expected) in fields.items():
+        if key not in obj:
+            if key not in optional:
+                found.append(f'{where}: missing "{key}"')
+        elif not accepts(obj[key]):
+            found.append(f'{where}: "{key}" must be {expected}, not {json.dumps(obj[key])}')
+    return found
+
+
+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError listing every mistake."""
+    # [LAW:parse-dont-validate] the only way to get a Policy is through here, so
+    # nothing downstream can meet a misspelt or missing key halfway through a run.
+    problems = _problems(raw, "policy", _POLICY_FIELDS, optional={"dry_run"})
+    rules = raw.get("rules") if isinstance(raw, dict) else None
+    rules = rules if isinstance(rules, list) else []
