diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..7e20212 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,95 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(ValueError):
+    """The policy is not safe to apply. `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy first, so a bad rule can't leave a half-done cleanup."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Return every problem found in the policy; an empty list means it is usable."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = _key_problems(policy, POLICY_KEYS, required={"snapshot_dir", "rules"})
+
+    if "snapshot_dir" in policy:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append("'snapshot_dir' must be a non-empty string")
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f"'snapshot_dir': {snapshot_dir!r} is not a directory")
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append("'dry_run' must be true or false")
+
+    if "rules" in policy:
+        rules = policy["rules"]
+        if not isinstance(rules, list):
+            problems.append("'rules' must be a list")
+        else:
+            prefixes = []
+            for i, rule in enumerate(rules):
+                problems += _rule_problems(rule, f"rules[{i}]", prefixes)
+    return problems
+
+
+def _rule_problems(rule, where, prefixes):
+    if not isinstance(rule, dict):
+        return [f"{where}: must be an object with 'prefix' and 'keep'"]
+    prefix = rule.get("prefix")
+    if isinstance(prefix, str) and prefix:
+        where = f"{where} (prefix {prefix!r})"
+    problems = [f"{where}: {p}" for p in _key_problems(rule, RULE_KEYS, required=RULE_KEYS)]
+
+    if "prefix" in rule:
+        if not isinstance(prefix, str) or not prefix:
+            problems.append(f"{where}: 'prefix' must be a non-empty string")
+        elif any(c in prefix for c in "/\\*?["):
+            problems.append(f"{where}: 'prefix' must not contain any of / \\ * ? [")
+        else:
+            # A snapshot matched by two rules would be pruned by whichever keeps fewer.
+            for other in prefixes:
+                if prefix.startswith(other) or other.startswith(prefix):
+                    problems.append(f"{where}: 'prefix' overlaps with the rule for {other!r}")
+            prefixes.append(prefix)
+
+    if "keep" in rule:
+        keep = rule["keep"]
+        if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+            problems.append(f"{where}: 'keep' must be a whole number >= 0, not {keep!r}")
+    return problems
+
+
+def _key_problems(obj, known, required):
+    problems = []
+    missing = sorted(required - obj.keys())
+    for key in sorted(obj.keys() - known):
+        guess = difflib.get_close_matches(str(key), missing or sorted(known), n=1)
+        hint = f" (did you mean {guess[0]!r}?)" if guess else ""
+        problems.append(f"unknown key {key!r}{hint}")
+    for key in missing:
+        problems.append(f"missing {key!r}")
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
