@@ -5,6 +5,9 @@ Usage: python3 prune.py <policy.json>
 The policy names the snapshot directory and one rule per snapshot family: every
 `<prefix>*.tar` file in the directory belongs to that rule, and the newest `keep`
 of them are kept. With "dry_run": true nothing is deleted, only listed.
+
+The whole policy is checked first. If anything in it is wrong, every problem is
+reported, nothing is deleted, and the exit status is 1.
 """
 import json
 import sys
@@ -16,11 +19,26 @@ def main(argv):
     if len(argv) != 2:
         print("usage: python3 prune.py <policy.json>", file=sys.stderr)
         return 2
-    with open(argv[1]) as f:
-        policy = json.load(f)
+    try:
+        with open(argv[1]) as f:
+            policy = json.load(f)
+        retention.check(policy)
+    except OSError as e:
+        return refuse(argv[1], [f"cannot read it: {e.strerror}"])
+    except json.JSONDecodeError as e:
