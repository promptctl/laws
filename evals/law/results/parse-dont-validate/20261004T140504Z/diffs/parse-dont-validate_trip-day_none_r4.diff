+def day_problem(day):
+    """What's wrong with a `day` parameter, or None if it's a real YYYY-MM-DD date."""
+    if not day:
+        return "missing 'day' parameter, expected a date like 2026-09-14"
+    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", day):
+        return f"invalid day {day!r}: expected YYYY-MM-DD, like 2026-09-14"
+    try:
+        date.fromisoformat(day)
+    except ValueError as e:
+        return f"invalid day {day!r}: {e}"
+    return None
