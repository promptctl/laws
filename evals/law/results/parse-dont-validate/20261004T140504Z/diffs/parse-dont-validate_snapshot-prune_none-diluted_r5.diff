diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..048c2f3 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,106 @@
 """Delete the snapshots a retention policy no longer keeps."""
+from difflib import get_close_matches
 from pathlib import Path
 
+POLICY_KEYS = ("snapshot_dir", "dry_run", "rules")
+RULE_KEYS = ("prefix", "keep")
+
+
+class PolicyError(Exception):
+    """The policy can't be acted on; `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy first, so a mistake in it never leaves a half-done prune."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Every problem with the policy, as a list of messages; empty if it is usable."""
+    if not isinstance(policy, dict):
+        return ["the policy must be a JSON object"]
+    problems = unknown_keys(policy, POLICY_KEYS, "the policy")
+
+    if "snapshot_dir" not in policy:
+        problems.append('"snapshot_dir" is missing')
+    else:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append(f'"snapshot_dir" must be a directory name, not {snapshot_dir!r}')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'"snapshot_dir": {snapshot_dir!r} is not an existing directory')
+
+    if not isinstance(policy.get("dry_run", False), bool):
+        problems.append(f'"dry_run" must be true or false, not {policy["dry_run"]!r}')
+
+    if "rules" not in policy:
+        problems.append('"rules" is missing')
+    elif not isinstance(policy["rules"], list):
+        problems.append('"rules" must be a list of rules')
+    else:
+        problems += validate_rules(policy["rules"])
+    return problems
+
+
+def validate_rules(rules):
+    problems = []
+    prefixes = {}  # valid prefix -> number of the first rule using it
+    for number, rule in enumerate(rules, start=1):
+        if not isinstance(rule, dict):
+            problems.append(f"rule {number} must be a JSON object, not {rule!r}")
+            continue
+        name = f"rule {number}"
+        if isinstance(rule.get("prefix"), str):
+            name += f' ("{rule["prefix"]}")'
+        problems += unknown_keys(rule, RULE_KEYS, name)
+
+        if "prefix" not in rule:
+            problems.append(f'{name}: "prefix" is missing')
+        else:
+            prefix = rule["prefix"]
+            if not isinstance(prefix, str) or not prefix:
+                problems.append(f'{name}: "prefix" must be a non-empty string, not {prefix!r}')
+            elif any(c in prefix for c in "*?[]/\\"):
+                problems.append(f'{name}: "prefix" must be a plain file name prefix, '
+                                "without wildcards or path separators")
+            else:
+                for other, other_number in prefixes.items():
+                    if prefix == other:
+                        problems.append(f"{name}: same prefix as rule {other_number}")
+                    elif prefix.startswith(other) or other.startswith(prefix):
+                        problems.append(f'{name}: prefix overlaps rule {other_number} ("{other}"), '
+                                        "so some snapshots would belong to both rules")
+                prefixes.setdefault(prefix, number)
+
+        if "keep" not in rule:
+            problems.append(f'{name}: "keep" is missing')
+        else:
+            keep = rule["keep"]
+            # bool is an int in Python; a negative keep would slice off the newest snapshots
+            if not isinstance(keep, int) or isinstance(keep, bool) or keep < 0:
+                problems.append(f'{name}: "keep" must be a whole number, 0 or more, not {keep!r}')
+    return problems
+
+
+def unknown_keys(obj, known, name):
+    problems = []
+    for key in obj:
+        if key not in known:
+            guess = get_close_matches(key, [k for k in known if k not in obj], n=1)
+            hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+            problems.append(f'{name}: unknown key "{key}"{hint}')
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
