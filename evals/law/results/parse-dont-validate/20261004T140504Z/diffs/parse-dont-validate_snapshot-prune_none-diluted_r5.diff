 import retention
 
 
+def unique_keys(pairs):
+    """json would silently keep only the last of a repeated key."""
+    obj = {}
+    for key, value in pairs:
+        if key in obj:
+            raise retention.PolicyError([f'key "{key}" appears more than once in the same object'])
+        obj[key] = value
+    return obj
+
+
+def load(path):
+    try:
+        with open(path) as f:
+            return json.load(f, object_pairs_hook=unique_keys)
+    except OSError as e:
+        raise retention.PolicyError([f"cannot read the file: {e.strerror}"])
+    except ValueError as e:
+        raise retention.PolicyError([f"not valid JSON: {e}"])
+
+
