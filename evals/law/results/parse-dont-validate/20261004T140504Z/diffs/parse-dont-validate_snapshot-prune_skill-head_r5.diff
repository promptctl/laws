@@ -0,0 +1,109 @@
+"""Parse a retention policy file into a Policy, or say everything that is wrong with it."""
+import json
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+class PolicyError(Exception):
+    """The policy file is unusable; `problems` lists every mistake found in it."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+def _is_text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int in Python; `"keep": true` is a mistake, not a count of 1.
+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
+
+
+# key -> (accepts the value, what to tell the user it must be)
+POLICY_FIELDS = {
+    "snapshot_dir": (_is_text, "a non-empty string"),
+    "dry_run": (lambda v: isinstance(v, bool), "true or false"),
+    "rules": (lambda v: isinstance(v, list), "a list of rules"),
+}
+RULE_FIELDS = {
+    "prefix": (_is_text, "a non-empty string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+
+
+def _problems(where, obj, fields):
+    if not isinstance(obj, dict):
+        return [f"{where}: must be an object, got {json.dumps(obj)}"]
+    found = []
+    for key in obj.keys() - fields.keys():
+        guess = get_close_matches(key, fields.keys() - obj.keys(), n=1)
+        hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+        found.append(f'{where}: unknown key "{key}"{hint}')
+    for key, (accepts, expected) in fields.items():
+        if key not in obj:
+            found.append(f'{where}: missing "{key}"')
+        elif not accepts(obj[key]):
+            found.append(f'{where}: "{key}" must be {expected}, got {json.dumps(obj[key])}')
+    return sorted(found)
+
+
+def parse(raw):
+    """Turn decoded JSON into a Policy. Raises PolicyError listing every mistake.
+
+    [LAW:parse-dont-validate] This is the only place a policy is checked; the
+    code that deletes files accepts a Policy and so cannot be handed a bad one.
+    """
+    if isinstance(raw, dict):
+        raw = {"dry_run": False, **raw}
+    problems = _problems("policy", raw, POLICY_FIELDS)
+
+    rules = raw.get("rules") if isinstance(raw, dict) else None
+    rules = rules if isinstance(rules, list) else []
+    for i, rule in enumerate(rules):
+        problems += _problems(f"rules[{i}]", rule, RULE_FIELDS)
+
+    # A snapshot must belong to exactly one rule, or which `keep` applies to it
+    # depends on rule order.
+    prefixes = [
+        (i, r["prefix"]) for i, r in enumerate(rules)
+        if isinstance(r, dict) and _is_text(r.get("prefix"))
+    ]
+    for n, (i, a) in enumerate(prefixes):
+        for j, b in prefixes[n + 1:]:
+            if a.startswith(b) or b.startswith(a):
+                problems.append(
+                    f'rules[{i}] and rules[{j}]: prefixes "{a}" and "{b}" match the same snapshots'
+                )
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw["dry_run"],
+        rules=tuple(Rule(r["prefix"], r["keep"]) for r in rules),
+    )
+
+
+def load(path):
+    with open(path) as f:
+        try:
+            raw = json.load(f)
+        except json.JSONDecodeError as e:
+            raise PolicyError([f"not valid JSON: {e}"]) from e
+    return parse(raw)
