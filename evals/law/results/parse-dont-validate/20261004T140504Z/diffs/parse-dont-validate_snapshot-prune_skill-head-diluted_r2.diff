+"""Parse a retention policy file's JSON into a Policy, or say everything wrong with it."""
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+POLICY_KEYS = ("snapshot_dir", "dry_run", "rules")
+RULE_KEYS = ("prefix", "keep")
+
+
+class PolicyError(ValueError):
+    """The policy file is malformed; `problems` lists every mistake found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def parse(raw):
+    """Turn decoded policy JSON into a Policy; raise PolicyError listing all mistakes."""
+    # [LAW:parse-dont-validate] the only place policy shape is checked; retention
+    # takes the Policy this returns and never re-checks.
+    if not isinstance(raw, dict):
+        raise PolicyError(["the policy must be a JSON object"])
+    problems = _key_problems("policy", raw, POLICY_KEYS, required=("snapshot_dir", "rules"))
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if "snapshot_dir" in raw and not (isinstance(snapshot_dir, str) and snapshot_dir):
+        problems.append(f'policy: "snapshot_dir" must be a non-empty string, not {snapshot_dir!r}')
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append(f'policy: "dry_run" must be true or false, not {dry_run!r}')
+
+    raw_rules = raw.get("rules", [])
+    if not isinstance(raw_rules, list):
+        problems.append(f'policy: "rules" must be a list, not {raw_rules!r}')
+        raw_rules = []
+    for index, raw_rule in enumerate(raw_rules):
+        problems += _rule_problems(f"rules[{index}]", raw_rule)
+    if problems:
+        raise PolicyError(problems)
+
+    rules = tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules)
+    problems = _overlap_problems(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, rules)
+
+
+def _key_problems(where, obj, allowed, required):
+    problems = []
+    for key in obj:
+        if key not in allowed:
+            guess = get_close_matches(key, allowed, n=1)
+            hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    problems += [f'{where}: missing "{key}"' for key in required if key not in obj]
+    return problems
+
+
+def _rule_problems(where, raw_rule):
+    if not isinstance(raw_rule, dict):
+        return [f"{where}: a rule must be a JSON object, not {raw_rule!r}"]
+    prefix = raw_rule.get("prefix")
+    if isinstance(prefix, str):
+        where = f'{where} (prefix "{prefix}")'
+    problems = _key_problems(where, raw_rule, RULE_KEYS, required=RULE_KEYS)
+    # An empty prefix would claim every .tar file in the directory.
+    if "prefix" in raw_rule and not (isinstance(prefix, str) and prefix):
+        problems.append(f'{where}: "prefix" must be a non-empty string, not {prefix!r}')
+    keep = raw_rule.get("keep")
+    # bool is an int subclass in Python; `"keep": true` is not a count.
+    if "keep" in raw_rule and not (type(keep) is int and keep >= 0):
+        problems.append(f'{where}: "keep" must be a whole number, 0 or more, not {keep!r}')
+    return problems
+
+
+def _overlap_problems(rules):
+    """A snapshot must belong to one rule, so no prefix may start with another."""
+    return [
+        f'rules[{i}] and rules[{j}]: prefixes "{a.prefix}" and "{b.prefix}" overlap, '
+        "so some snapshots would belong to both rules"
+        for i, a in enumerate(rules)
+        for j, b in enumerate(rules)
+        if i < j and (a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix))
+    ]
