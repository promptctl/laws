diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..0b666e8
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,94 @@
+"""Run with: python3 -m unittest"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import policy
+import prune
+
+FAMILIES = {"db-": 6, "media-": 4, "logs-": 6}
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.snapshot_dir = self.root / "snapshots"
+        self.snapshot_dir.mkdir()
+        for prefix, count in FAMILIES.items():
+            for day in range(1, count + 1):
+                (self.snapshot_dir / f"{prefix}2026-09-{day:02}.tar").touch()
+
+    def run_prune(self, **policy_fields):
+        body = {"snapshot_dir": str(self.snapshot_dir), **policy_fields}
+        path = self.root / "policy.json"
+        path.write_text(json.dumps(body))
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = prune.main(["prune.py", str(path)])
+        return status, err.getvalue()
+
+    def remaining(self):
+        return sorted(p.name for p in self.snapshot_dir.iterdir())
+
+    def test_mistake_in_last_rule_deletes_nothing(self):
+        before = self.remaining()
+        status, err = self.run_prune(rules=[
+            {"prefix": "db-", "keep": 3},
+            {"prefix": "media-", "keep": 2},
+            {"prefix": "logs-", "kepe": 4},
+        ])
+        self.assertEqual(status, 1)
+        self.assertEqual(self.remaining(), before)
+        self.assertIn('unknown key "kepe" (did you mean "keep"?)', err)
+        self.assertIn("nothing was deleted", err)
+
+    def test_valid_policy_keeps_the_newest(self):
+        status, _ = self.run_prune(rules=[{"prefix": "db-", "keep": 2}])
+        self.assertEqual(status, 0)
+        self.assertEqual(
+            [n for n in self.remaining() if n.startswith("db-")],
+            ["db-2026-09-05.tar", "db-2026-09-06.tar"])
+
+    def test_dry_run_deletes_nothing(self):
+        before = self.remaining()
+        status, _ = self.run_prune(dry_run=True, rules=[{"prefix": "db-", "keep": 0}])
+        self.assertEqual(status, 0)
+        self.assertEqual(self.remaining(), before)
+
+    def test_missing_snapshot_dir_is_reported(self):
+        status, err = self.run_prune(snapshot_dir=str(self.root / "snapshot"), rules=[])
+        self.assertEqual(status, 1)
+        self.assertIn("not an existing directory", err)
+
+
+class ParseTest(unittest.TestCase):
+    def problems(self, raw):
+        with self.assertRaises(policy.PolicyError) as caught:
+            policy.parse(raw)
+        return caught.exception.problems
+
+    def test_reports_every_mistake_at_once(self):
+        problems = self.problems({
+            "snapshot_dir": "s",
+            "dry_run": "false",
+            "rules": [{"prefix": "", "keep": 1}, {"prefix": "a-", "keep": -1},
+                      {"prefix": "b-", "keep": "3"}, {"prefix": "c-", "keep": True}],
+        })
+        self.assertEqual(len(problems), 5)
+
+    def test_rejects_overlapping_prefixes(self):
+        problems = self.problems({"snapshot_dir": "s", "rules": [
+            {"prefix": "db-", "keep": 1}, {"prefix": "db-old-", "keep": 1}]})
+        self.assertIn("overlap", problems[0])
+
+    def test_rejects_non_object(self):
+        self.assertEqual(len(self.problems([])), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
