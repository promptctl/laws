+"""Parse the contents of a policy file into a checked retention Policy."""
+import json
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+
+class PolicyError(ValueError):
+    """The policy has mistakes; `problems` lists every one found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def _is_text(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int subclass; `"keep": true` is a mistake, not a count of 1
+    return type(value) is int and value >= 0
+
+
+# key -> (check, what the value must be)
+_POLICY_FIELDS = {
+    "snapshot_dir": (_is_text, "a non-empty string"),
+    "dry_run": (lambda v: isinstance(v, bool), "true or false"),
+    "rules": (lambda v: isinstance(v, list), "a list of rules"),
+}
+_RULE_FIELDS = {
+    "prefix": (_is_text, "a non-empty string"),
+    "keep": (_is_count, "a whole number, 0 or more"),
+}
+
+
+def _problems(where, obj, fields, optional=frozenset()):
+    if not isinstance(obj, dict):
+        return [f"{where}: must be an object, not {json.dumps(obj)}"]
+    found = []
+    for key in sorted(obj.keys() - fields.keys()):
+        close = get_close_matches(key, fields, n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        found.append(f'{where}: unknown key "{key}"{hint}')
+    for key, (ok, expected) in fields.items():
+        if key not in obj:
+            if key not in optional:
+                found.append(f'{where}: missing "{key}"')
+        elif not ok(obj[key]):
+            found.append(f'{where}: "{key}" must be {expected}, not {json.dumps(obj[key])}')
+    return found
+
+
+def _overlaps(rules):
+    """A snapshot must belong to one rule, so no prefix may start with another."""
+    prefixes = [rule["prefix"] for rule in rules]
+    return [
+        f'rule {i + 1} and rule {j + 1}: prefixes "{a}" and "{b}" overlap, '
+        "so some snapshots would belong to both"
+        for i, a in enumerate(prefixes)
+        for j, b in enumerate(prefixes)
+        if i < j and (a.startswith(b) or b.startswith(a))
+    ]
+
+
+def parse(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError.
+
+    [LAW:parse-dont-validate] This is the only place a policy is checked;
+    retention takes the Policy it returns and never re-checks.
+    """
+    problems = _problems("policy", raw, _POLICY_FIELDS, optional={"dry_run"})
+    rules = raw.get("rules") if isinstance(raw, dict) else None
+    rules = rules if isinstance(rules, list) else []
+    for i, rule in enumerate(rules):
+        problems += _problems(f"rule {i + 1}", rule, _RULE_FIELDS)
+    if not problems:
+        problems = _overlaps(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", False),
+        rules=tuple(Rule(rule["prefix"], rule["keep"]) for rule in rules),
+    )
