diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..2348bb8
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,91 @@
+"""Run with: python3 -m unittest"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+NAMES = [f"{family}-2026-09-0{day}.tar" for family in ("db", "media", "logs") for day in range(1, 7)]
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.snapshot_dir = self.root / "snapshots"
+        self.snapshot_dir.mkdir()
+        for name in NAMES:
+            (self.snapshot_dir / name).touch()
+
+    def run_prune(self, policy):
+        """Return (exit status, stderr, snapshot names left on disk)."""
+        path = self.root / "policy.json"
+        path.write_text(policy if isinstance(policy, str) else json.dumps(policy))
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(io.StringIO()):
+            status = prune.main(["prune.py", str(path)])
+        return status, err.getvalue(), sorted(p.name for p in self.snapshot_dir.iterdir())
+
+    def policy(self, rules, **extra):
+        return {"snapshot_dir": str(self.snapshot_dir), "rules": rules, **extra}
+
+    def assert_rejected(self, policy, *expected_in_stderr):
+        status, err, left = self.run_prune(policy)
+        self.assertEqual(status, 1)
+        self.assertEqual(left, sorted(NAMES), "a rejected policy must delete nothing")
+        for text in expected_in_stderr:
+            self.assertIn(text, err)
+
+    def test_valid_policy_keeps_the_newest(self):
+        status, _, left = self.run_prune(self.policy(
+            [{"prefix": "db-", "keep": 3}, {"prefix": "media-", "keep": 2}, {"prefix": "logs-", "keep": 6}]))
+        self.assertEqual(status, 0)
+        self.assertEqual(left, sorted(
+            [f"db-2026-09-0{d}.tar" for d in (4, 5, 6)]
+            + [f"media-2026-09-0{d}.tar" for d in (5, 6)]
+            + [f"logs-2026-09-0{d}.tar" for d in range(1, 7)]))
+
+    def test_dry_run_deletes_nothing(self):
+        status, _, left = self.run_prune(self.policy([{"prefix": "db-", "keep": 1}], dry_run=True))
+        self.assertEqual(status, 0)
+        self.assertEqual(left, sorted(NAMES))
+
+    def test_typo_in_a_later_rule_stops_earlier_rules(self):
+        self.assert_rejected(
+            self.policy([{"prefix": "db-", "keep": 3}, {"prefix": "media-", "keep": 2},
+                         {"prefix": "logs-", "kepe": 4}]),
+            'rule 3: unknown key "kepe" (did you mean "keep"?)', 'rule 3: missing "keep"')
+
+    def test_every_problem_is_reported(self):
+        self.assert_rejected(
+            self.policy([{"prefix": "db-", "keep": "3"}, {"prefix": "", "keep": -1}], dry_run="no"),
+            'rule 1: "keep"', 'rule 2: "prefix"', 'rule 2: "keep"', 'policy: "dry_run"')
+
+    def test_wrong_shapes(self):
+        self.assert_rejected(self.policy([{"prefix": "db-", "keep": True}]), 'rule 1: "keep"')
+        self.assert_rejected(self.policy(["db-"]), "rule 1: must be an object")
+        self.assert_rejected({"rules": []}, 'policy: missing "snapshot_dir"')
+        self.assert_rejected([], "policy: must be an object")
+
+    def test_overlapping_prefixes(self):
+        self.assert_rejected(
+            self.policy([{"prefix": "db-", "keep": 3}, {"prefix": "db-2026", "keep": 1}]), "overlap")
+
+    def test_missing_snapshot_dir(self):
+        self.assert_rejected(
+            {"snapshot_dir": str(self.root / "snapshtos"), "rules": [{"prefix": "db-", "keep": 1}]},
+            "is not a directory")
+
+    def test_unreadable_policy_file(self):
+        self.assert_rejected('{"snapshot_dir": ', "not valid JSON")
+        with contextlib.redirect_stderr(io.StringIO()) as err:
+            self.assertEqual(prune.main(["prune.py", str(self.root / "absent.json")]), 1)
+        self.assertIn("cannot read the file", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
