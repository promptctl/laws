index 0000000..e3dc2bf
--- /dev/null
+++ b/work/policy.py
@@ -0,0 +1,104 @@
+"""Parse a retention policy into a Policy, or report everything wrong with it."""
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+
+class PolicyError(Exception):
+    """The policy is not usable; `problems` lists every mistake found, not just the first."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+def _non_empty_str(value):
+    return isinstance(value, str) and value != ""
+
+
+def _bool(value):
+    return isinstance(value, bool)
+
+
+def _count(value):
+    # bool is an int subclass: `"keep": true` must not pass as keep=1.
+    return type(value) is int and value >= 0
+
+
+_MISSING = object()
+
+# key -> (check, what a valid value is, default or _MISSING when the key is required)
+# An empty prefix would claim every .tar in the directory, so it is rejected.
+_POLICY_KEYS = {
+    "snapshot_dir": (_non_empty_str, "a non-empty string", _MISSING),
+    "dry_run": (_bool, "true or false", False),
+    "rules": (lambda v: isinstance(v, list), "a list of rules", _MISSING),
+}
+_RULE_KEYS = {
+    "prefix": (_non_empty_str, "a non-empty string", _MISSING),
+    "keep": (_count, "a whole number, 0 or more", _MISSING),
+}
+
+
+def _fields(raw, keys, where, problems):
+    """The valid fields of `raw`; every unknown, missing or ill-typed key is added to `problems`."""
+    if not isinstance(raw, dict):
+        problems.append(f"{where}: expected an object, got {raw!r}")
+        return {}
+    # [LAW:no-silent-failure] An unknown key is an error, not ignored: a misspelt
+    # "dry_run" would otherwise turn a dry run into a real deletion.
+    for key in raw.keys() - keys.keys():
+        close = get_close_matches(key, keys.keys(), n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    fields = {}
+    for key, (check, expected, default) in keys.items():
+        value = raw.get(key, default)
+        if value is _MISSING:
+            problems.append(f'{where}: missing "{key}"')
+        elif not check(value):
+            problems.append(f'{where}: "{key}" must be {expected}, got {value!r}')
+        else:
+            fields[key] = value
+    return fields
+
+
+def parse(raw):
+    """Turn decoded policy JSON into a Policy. Raises PolicyError listing every problem."""
+    # [LAW:parse-dont-validate] The only way to get a Policy is through here, so
+    # retention never sees a rule it cannot carry out.
+    problems = []
+    top = _fields(raw, _POLICY_KEYS, "policy", problems)
+    rules = [
+        _fields(rule, _RULE_KEYS, f"rules[{i}]", problems)
+        for i, rule in enumerate(top.get("rules", []))
+    ]
+    # Each snapshot belongs to exactly one rule; overlapping prefixes would let two
+    # rules with different `keep` both claim the same files.
+    prefixes = [(i, r["prefix"]) for i, r in enumerate(rules) if "prefix" in r]
+    for i, a in prefixes:
+        for j, b in prefixes:
+            if i != j and (i < j or a != b) and a.startswith(b):
+                problems.append(
+                    f'rules[{i}]: prefix "{a}" overlaps rules[{j}] prefix "{b}"'
+                )
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(top["snapshot_dir"]),
+        dry_run=top["dry_run"],
+        rules=tuple(Rule(**r) for r in rules),
+    )
