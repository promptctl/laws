+class PolicyError(ValueError):
+    """The policy is wrong. Carries every problem found, not only the first."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+_MISSING = object()
+
+
+def _is_nonempty_str(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_bool(value):
+    return type(value) is bool
+
+
+def _is_count(value):
+    # bool is an int subclass; "keep": true is a mistake, not a count of 1
+    return type(value) is int and value >= 0
+
+
+def _field(obj, key, where, ok, expected, problems, default=_MISSING):
+    value = obj.get(key, default)
+    if value is _MISSING:
+        problems.append(f'{where}: missing "{key}"')
+    elif not ok(value):
+        problems.append(f'{where}: "{key}" must be {expected}, got {json.dumps(value)}')
+    return value
+
+
+def _unknown_keys(obj, known, where, problems):
+    for key in sorted(obj.keys() - known):
+        close = difflib.get_close_matches(key, known, n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+
+
+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError listing every problem.
+
+    [LAW:parse-dont-validate] This is the one place the policy is checked; everything
+    that deletes takes a Policy, so a rule without `keep` cannot reach it.
+    """
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy: must be a JSON object"])
+    problems = []
+    # An unknown key is an error, not noise: a misspelt "dry_run" would otherwise delete for real.
+    _unknown_keys(raw, {"snapshot_dir", "dry_run", "rules"}, "policy", problems)
+    snapshot_dir = _field(raw, "snapshot_dir", "policy", _is_nonempty_str, "a non-empty string", problems)
+    dry_run = _field(raw, "dry_run", "policy", _is_bool, "true or false", problems, default=False)
+    raw_rules = _field(raw, "rules", "policy", lambda v: isinstance(v, list), "a list", problems)
+
+    rules = []
+    for i, raw_rule in enumerate(raw_rules if isinstance(raw_rules, list) else []):
+        where = f"rules[{i}]"
+        if not isinstance(raw_rule, dict):
+            problems.append(f"{where}: must be a JSON object, got {json.dumps(raw_rule)}")
+            continue
+        _unknown_keys(raw_rule, {"prefix", "keep"}, where, problems)
+        # An empty prefix would match every .tar in the directory.
+        prefix = _field(raw_rule, "prefix", where, _is_nonempty_str, "a non-empty string", problems)
+        keep = _field(raw_rule, "keep", where, _is_count, "a non-negative integer", problems)
+        rules.append((where, prefix, keep))
+
+    # Each snapshot belongs to one rule; with "db" and "db-" a file would be pruned twice.
+    prefixed = [(where, prefix) for where, prefix, _ in rules if _is_nonempty_str(prefix)]
+    for n, (where_a, a) in enumerate(prefixed):
+        for where_b, b in prefixed[n + 1:]:
+            if a.startswith(b) or b.startswith(a):
+                problems.append(f'{where_a} and {where_b}: prefixes "{a}" and "{b}" match the same snapshots')
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(snapshot_dir),
+        dry_run=dry_run,
+        rules=tuple(Rule(prefix, keep) for _, prefix, keep in rules),
+    )
 
 
