diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..78183b0
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,87 @@
+"""Run with: python3 -m unittest"""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+PRUNE = Path(__file__).with_name("prune.py")
+GOOD = {"prefix": "db-", "keep": 1}
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name)
+        (self.dir / "snapshots").mkdir()
+        for name in ("db-2026-09-01", "db-2026-09-02", "logs-2026-09-01", "logs-2026-09-02"):
+            (self.dir / "snapshots" / f"{name}.tar").touch()
+
+    def run_prune(self, policy):
+        text = policy if isinstance(policy, str) else json.dumps(policy)
+        (self.dir / "policy.json").write_text(text)
+        return subprocess.run(
+            [sys.executable, PRUNE, "policy.json"],
+            cwd=self.dir, capture_output=True, text=True,
+        )
+
+    def remaining(self):
+        return sorted(p.name for p in (self.dir / "snapshots").iterdir())
+
+    def assert_rejected(self, policy, *expected_in_stderr):
+        before = self.remaining()
+        result = self.run_prune(policy)
+        self.assertEqual(result.returncode, 1, result.stderr)
+        self.assertEqual(self.remaining(), before)
+        for text in expected_in_stderr:
+            self.assertIn(text, result.stderr)
+
+    def policy(self, *rules, **extra):
+        return {"snapshot_dir": "snapshots", "rules": list(rules), **extra}
+
+    def test_valid_policy_keeps_newest(self):
+        result = self.run_prune(self.policy(GOOD, {"prefix": "logs-", "keep": 2}))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(
+            self.remaining(),
+            ["db-2026-09-02.tar", "logs-2026-09-01.tar", "logs-2026-09-02.tar"],
+        )
+
+    def test_dry_run_deletes_nothing(self):
+        result = self.run_prune(self.policy(GOOD, dry_run=True))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(len(self.remaining()), 4)
+        self.assertIn("would delete", result.stdout)
+
+    def test_typo_in_later_rule_deletes_nothing(self):
+        self.assert_rejected(
+            self.policy(GOOD, {"prefix": "logs-", "kepe": 4}),
+            "rules[1]: unknown key 'kepe' (did you mean 'keep'?)",
+            "rules[1]: missing 'keep'",
+        )
+
+    def test_misspelled_dry_run_deletes_nothing(self):
+        self.assert_rejected(self.policy(GOOD, dry_runn=True), "unknown key 'dry_runn'")
+
+    def test_bad_values_deletes_nothing(self):
+        for rule in ({"prefix": "db-", "keep": -1}, {"prefix": "db-", "keep": "3"},
+                     {"prefix": "db-", "keep": True}, {"prefix": "", "keep": 1}, "db-"):
+            with self.subTest(rule=rule):
+                self.assert_rejected(self.policy(rule), "rules[0]")
+
+    def test_overlapping_prefixes_deletes_nothing(self):
+        self.assert_rejected(
+            self.policy(GOOD, {"prefix": "db-2026", "keep": 0}), "is also matched by"
+        )
+
+    def test_missing_snapshot_dir_is_rejected(self):
+        self.assert_rejected({"snapshot_dir": "snapshot", "rules": [GOOD]}, "not a directory")
+
+    def test_invalid_json_is_rejected(self):
+        self.assert_rejected('{"snapshot_dir": "snapshots",', "not valid JSON")
+
+
+if __name__ == "__main__":
+    unittest.main()
