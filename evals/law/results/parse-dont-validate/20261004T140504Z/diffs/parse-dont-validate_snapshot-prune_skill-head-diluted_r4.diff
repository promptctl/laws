+"""Read a retention policy file into a checked Policy, or say everything wrong with it."""
+import json
+from dataclasses import dataclass
+from difflib import get_close_matches
+from pathlib import Path
+
+
+class PolicyError(ValueError):
+    """The policy file has mistakes; `problems` lists every one found."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+# [LAW:parse-dont-validate] retention only accepts a Policy, and a Policy only
+# comes out of parse(), so no deletion can start from an unchecked file.
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+# key -> (accepts the value, what to tell the user it must be)
+_RULE_KEYS = {
+    "prefix": (lambda v: isinstance(v, str) and v != "", "a non-empty string"),
+    # bool is an int in Python; `"keep": true` is a mistake, not a count of 1
+    "keep": (lambda v: type(v) is int and v >= 0, "a whole number, 0 or more"),
+}
+_POLICY_KEYS = {
+    "snapshot_dir": (lambda v: isinstance(v, str) and v != "", "a non-empty string"),
+    "dry_run": (lambda v: isinstance(v, bool), "true or false"),
+    "rules": (lambda v: isinstance(v, list), "a list of rules"),
+}
+_POLICY_DEFAULTS = {"dry_run": False}
+
+
+def load(path):
+    """Read and parse the policy file at `path`. Raises PolicyError."""
+    with open(path) as f:
+        try:
+            raw = json.load(f)
+        except json.JSONDecodeError as e:
+            raise PolicyError([f"not valid JSON: {e}"]) from e
+    policy = parse(raw)
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f"snapshot_dir {str(policy.snapshot_dir)!r} is not a directory"])
+    return policy
+
+
+def parse(raw):
+    """Turn decoded JSON into a Policy. Raises PolicyError listing every problem."""
+    problems = []
+    top = _checked("policy", raw, _POLICY_KEYS, _POLICY_DEFAULTS, problems)
+    rules = top["rules"] if top and isinstance(top.get("rules"), list) else []
+    checked = [
+        _checked(f"rules[{i}]", rule, _RULE_KEYS, {}, problems)
+        for i, rule in enumerate(rules)
+    ]
+    problems += _overlaps(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(top["snapshot_dir"]),
+        dry_run=top["dry_run"],
+        rules=tuple(Rule(r["prefix"], r["keep"]) for r in checked),
+    )
+
+
+def _checked(where, obj, keys, defaults, problems):
+    """Record what is wrong with `obj` in `problems`; return it with defaults filled in."""
+    if not isinstance(obj, dict):
+        problems.append(f"{where}: must be an object, got {obj!r}")
+        return None
+    for key in sorted(obj.keys() - keys.keys()):
+        guess = get_close_matches(key, keys, n=1)
+        hint = f" (did you mean {guess[0]!r}?)" if guess else ""
+        problems.append(f"{where}: unknown key {key!r}{hint}")
+    obj = {**defaults, **obj}
+    for key, (accepts, expected) in keys.items():
+        if key not in obj:
+            problems.append(f"{where}: missing {key!r}")
+        elif not accepts(obj[key]):
+            problems.append(f"{where}: {key!r} must be {expected}, got {obj[key]!r}")
+    return obj
+
+
+def _overlaps(rules):
+    """A snapshot matched by two rules would be pruned twice, by different counts."""
+    prefixes = [
+        (i, rule["prefix"])
+        for i, rule in enumerate(rules)
+        if isinstance(rule, dict) and isinstance(rule.get("prefix"), str) and rule["prefix"]
+    ]
+    return [
+        f"rules[{j}]: prefix {long!r} is also matched by rules[{i}] prefix {short!r}"
+        for i, short in prefixes
+        for j, long in prefixes
+        if i != j and long.startswith(short) and (long != short or i < j)
+    ]
