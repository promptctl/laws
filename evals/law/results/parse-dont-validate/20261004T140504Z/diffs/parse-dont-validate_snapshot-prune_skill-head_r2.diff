+"""Read a retention policy file into a Policy that is safe to act on.
+
+[LAW:parse-dont-validate] This is the only place a policy file is checked. A
+Policy cannot exist unless the whole file was well formed, so retention never
+starts deleting on a policy it will later choke on.
+"""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class PolicyError(Exception):
+    """The policy file is unusable; `problems` lists every mistake found in it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+def load(path):
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read policy file: {e}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    return parse(raw)
+
+
+def parse(raw):
+    """Report every mistake at once, so one run of prune.py shows them all."""
+    if not isinstance(raw, dict):
+        raise PolicyError(["the policy must be a JSON object"])
+    problems = []
+    _check_keys(raw, "policy", {"snapshot_dir", "rules"}, {"dry_run"}, problems)
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if "snapshot_dir" in raw:
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append("snapshot_dir must be a non-empty string")
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f"snapshot_dir {snapshot_dir!r} is not an existing directory")
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append("dry_run must be true or false")
+
+    raw_rules = raw.get("rules", [])
+    if not isinstance(raw_rules, list):
+        problems.append("rules must be a list")
+        raw_rules = []
+    rules = [_parse_rule(r, f"rules[{i}]", problems) for i, r in enumerate(raw_rules)]
+    _check_overlap(raw_rules, problems)
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, tuple(rules))
+
+
+def _parse_rule(raw, where, problems):
+    if not isinstance(raw, dict):
+        problems.append(f"{where}: must be an object with 'prefix' and 'keep'")
+        return None
+    prefix, keep = raw.get("prefix"), raw.get("keep")
+    if isinstance(prefix, str) and prefix:
+        where = f"{where} (prefix {prefix!r})"
+    _check_keys(raw, where, {"prefix", "keep"}, set(), problems)
+    # An empty prefix would claim every snapshot in the directory.
+    if "prefix" in raw and not (isinstance(prefix, str) and prefix):
+        problems.append(f"{where}: prefix must be a non-empty string")
+    # bool is an int in Python; a negative keep would slice from the wrong end.
+    if "keep" in raw and (not isinstance(keep, int) or isinstance(keep, bool) or keep < 0):
+        problems.append(f"{where}: keep must be a whole number, 0 or more (got {keep!r})")
+    return Rule(prefix, keep)
+
+
+def _check_keys(obj, where, required, optional, problems):
+    missing = required - obj.keys()
+    for key in sorted(obj.keys() - required - optional):
+        guess = difflib.get_close_matches(key, sorted(missing | optional - obj.keys()), n=1)
+        if guess:
+            problems.append(f"{where}: unknown key {key!r} (did you mean {guess[0]!r}?)")
+            missing = missing - {guess[0]}
+        else:
+            problems.append(f"{where}: unknown key {key!r}")
+    for key in sorted(missing):
+        problems.append(f"{where}: missing {key!r}")
+
+
+def _check_overlap(raw_rules, problems):
+    """A snapshot matched by two rules would be pruned by both, in file order."""
+    prefixes = [
+        (i, r["prefix"]) for i, r in enumerate(raw_rules)
+        if isinstance(r, dict) and isinstance(r.get("prefix"), str) and r["prefix"]
+    ]
+    for n, (i, a) in enumerate(prefixes):
+        for j, b in prefixes[n + 1:]:
+            if a.startswith(b) or b.startswith(a):
+                problems.append(
+                    f"rules[{i}] and rules[{j}]: prefixes {a!r} and {b!r} match the same snapshots"
+                )
