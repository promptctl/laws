+"""The retention policy, and the one place a policy file is checked.
+
+`load` turns a policy file into a `Policy` or raises `PolicyError` listing every
+problem found. Nothing else in the program reads raw policy JSON, so a `Policy`
+in hand means the whole file was already checked.
+"""
+# [LAW:parse-dont-validate] The check returns a type the raw JSON could not be;
+# retention only accepts that type, so no deletion can start from an unchecked file.
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+POLICY_KEYS = ("snapshot_dir", "dry_run", "rules")
+RULE_KEYS = ("prefix", "keep")
+MISSING = object()
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+class PolicyError(Exception):
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+def load(path):
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read policy file: {e}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    policy = parse(raw)
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f'snapshot_dir "{policy.snapshot_dir}" is not a directory'])
+    return policy
+
+
+def parse(raw):
+    if not isinstance(raw, dict):
+        raise PolicyError(["the policy must be a JSON object"])
+    problems = unknown_keys(raw, POLICY_KEYS, "policy")
+
+    snapshot_dir = raw.get("snapshot_dir", MISSING)
+    if snapshot_dir is MISSING:
+        problems.append('policy: missing "snapshot_dir"')
+    elif not isinstance(snapshot_dir, str) or not snapshot_dir:
+        problems.append(f'policy: "snapshot_dir" must be a non-empty string, got {json.dumps(snapshot_dir)}')
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append(f'policy: "dry_run" must be true or false, got {json.dumps(dry_run)}')
+
+    raw_rules = raw.get("rules", MISSING)
+    if raw_rules is MISSING:
+        problems.append('policy: missing "rules"')
+        raw_rules = []
+    elif not isinstance(raw_rules, list):
+        problems.append('policy: "rules" must be a list')
+        raw_rules = []
+
+    rules = []
+    for i, raw_rule in enumerate(raw_rules):
+        rule_problems = rule_errors(raw_rule, f"rules[{i}]")
+        problems += rule_problems
+        if not rule_problems:
+            rules.append(Rule(raw_rule["prefix"], raw_rule["keep"]))
+
+    # A snapshot matched by two rules would be pruned by whichever keeps fewer.
+    for i, a in enumerate(rules):
+        for b in rules[i + 1:]:
+            if a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix):
+                problems.append(f'rules: prefixes "{a.prefix}" and "{b.prefix}" match the same snapshots')
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, tuple(rules))
+
+
+def rule_errors(raw, where):
+    if not isinstance(raw, dict):
+        return [f"{where}: must be a JSON object"]
+    problems = unknown_keys(raw, RULE_KEYS, where)
+
+    prefix = raw.get("prefix", MISSING)
+    if prefix is MISSING:
+        problems.append(f'{where}: missing "prefix"')
+    elif not isinstance(prefix, str) or not prefix:
+        # An empty prefix would claim every snapshot in the directory.
+        problems.append(f'{where}: "prefix" must be a non-empty string, got {json.dumps(prefix)}')
+    elif any(c in prefix for c in "*?[]/\\"):
+        # The prefix is spliced into a glob pattern; wildcards would widen the match.
+        problems.append(f'{where}: "prefix" must not contain wildcards or path separators, got {json.dumps(prefix)}')
+
+    keep = raw.get("keep", MISSING)
+    if keep is MISSING:
+        problems.append(f'{where}: missing "keep"')
+    elif isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+        # A negative keep would slice from the wrong end and delete the newest snapshots.
+        problems.append(f'{where}: "keep" must be a whole number, 0 or more, got {json.dumps(keep)}')
+
+    return problems
+
+
+def unknown_keys(raw, known, where):
+    problems = []
+    for key in raw:
+        if key not in known:
+            close = difflib.get_close_matches(key, known, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    return problems
