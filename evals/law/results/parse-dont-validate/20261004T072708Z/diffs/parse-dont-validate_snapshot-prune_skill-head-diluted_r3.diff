+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError naming every mistake."""
+    # [LAW:parse-dont-validate] the only place raw policy JSON is checked; everything
+    # that deletes takes a Policy, so a half-checked policy cannot reach a delete.
+    if not isinstance(raw, dict):
+        raise PolicyError([f"policy must be a JSON object, not {_json_type(raw)}"])
+
+    problems = _key_problems(raw, POLICY_KEYS, required=("snapshot_dir", "rules"), where="policy")
+
+    snapshot_dir = raw.get("snapshot_dir", "")
+    if "snapshot_dir" in raw and (not isinstance(snapshot_dir, str) or not snapshot_dir):
+        problems.append(f"policy: 'snapshot_dir' must be a non-empty string, not {snapshot_dir!r}")
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append(f"policy: 'dry_run' must be true or false, not {dry_run!r}")
+
+    raw_rules = raw.get("rules", [])
+    if not isinstance(raw_rules, list):
+        problems.append(f"policy: 'rules' must be a list, not {_json_type(raw_rules)}")
+        raw_rules = []
+    for i, raw_rule in enumerate(raw_rules):
+        problems += _rule_problems(raw_rule, where=f"rules[{i}]")
+
+    if problems:
+        raise PolicyError(problems)
+
+    rules = tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules)
+    problems = _overlap_problems(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, rules)
+
+
+def _rule_problems(raw_rule, where):
+    if not isinstance(raw_rule, dict):
+        return [f"{where}: a rule must be a JSON object, not {_json_type(raw_rule)}"]
+    if isinstance(raw_rule.get("prefix"), str):
+        where = f"{where} ({raw_rule['prefix']!r})"
+
+    problems = _key_problems(raw_rule, RULE_KEYS, required=RULE_KEYS, where=where)
+    if "prefix" in raw_rule:
+        prefix = raw_rule["prefix"]
+        # An empty prefix would claim every snapshot in the directory.
+        if not isinstance(prefix, str) or not prefix:
+            problems.append(f"{where}: 'prefix' must be a non-empty string, not {prefix!r}")
+    if "keep" in raw_rule:
+        keep = raw_rule["keep"]
+        # bool is an int in Python; a negative keep would slice from the wrong end.
+        if type(keep) is not int or keep < 0:
+            problems.append(f"{where}: 'keep' must be a whole number >= 0, not {keep!r}")
+    return problems
+
+
+def _key_problems(obj, known, required, where):
+    problems = []
+    for key in obj:
+        if key not in known:
+            guess = get_close_matches(key, known, n=1)
+            hint = f" (did you mean {guess[0]!r}?)" if guess else ""
+            problems.append(f"{where}: unknown key {key!r}{hint}")
+    for key in required:
+        if key not in obj:
+            problems.append(f"{where}: missing required key {key!r}")
+    return problems
+
+
+def _overlap_problems(rules):
+    """A snapshot belongs to one rule, so no prefix may start with another rule's prefix."""
+    return [
+        f"rules[{i}] ({a.prefix!r}) and rules[{j}] ({b.prefix!r}) match the same snapshots"
+        for i, a in enumerate(rules)
+        for j, b in enumerate(rules)
+        if i < j and (a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix))
+    ]
+
+
+def _json_type(value):
+    names = {dict: "an object", list: "a list", str: "a string", bool: "a boolean", type(None): "null"}
+    return names.get(type(value), "a number")
 
 
