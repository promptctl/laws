-    retention.apply(policy)
+    try:
+        with open(argv[1]) as f:
+            raw = json.load(f)
+    except (OSError, json.JSONDecodeError) as error:
+        print(f"prune: cannot read policy {argv[1]}: {error}", file=sys.stderr)
+        return 1
+    try:
+        retention.apply(policy.parse(raw))
+    except policy.PolicyError as error:
+        print(f"prune: {argv[1]} is not a valid policy, nothing was deleted:", file=sys.stderr)
+        for problem in error.problems:
+            print(f"  - {problem}", file=sys.stderr)
+        return 1
     return 0
 
 
