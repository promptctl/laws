+def apply(policy):
+    # The whole plan is worked out before the first deletion, so anything that
+    # can go wrong while reading the policy or the directory goes wrong first.
+    for path in expired(policy):
+        if policy.dry_run:
             print(f"would delete {path}")
         else:
             path.unlink()
             print(f"deleted {path}")
+
+
+def expired(policy):
+    """Every snapshot the policy no longer keeps, across all rules."""
+    if not policy.snapshot_dir.is_dir():
+        raise PolicyError([f'policy: "snapshot_dir" {policy.snapshot_dir} is not a directory'])
+    return [
+        path
+        for rule in policy.rules
+        for path in snapshots(policy.snapshot_dir, rule.prefix)[rule.keep:]
+    ]
+
+
+def snapshots(root, prefix):
+    """Newest first: names end in an ISO date, so name order is age order."""
+    # The prefix is literal text, not a pattern: "*" in a policy must not match everything.
+    return sorted(root.glob(f"{glob.escape(prefix)}*.tar"), reverse=True)
