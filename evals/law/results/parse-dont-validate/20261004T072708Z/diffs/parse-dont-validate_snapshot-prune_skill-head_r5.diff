@@ -0,0 +1,120 @@
+"""The retention policy: what a policy file means once it has been checked."""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class PolicyError(Exception):
+    """The policy file is wrong; `problems` lists every mistake found in it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+POLICY_KEYS = ("snapshot_dir", "dry_run", "rules")
+RULE_KEYS = ("prefix", "keep")
+
+
+def parse(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError.
+
+    # [LAW:parse-dont-validate] The only way to get a Policy is through here, so
+    # retention never sees a rule with a missing or nonsensical field.
+    Every mistake is collected, not just the first, so one run names them all.
+    """
+    if not isinstance(raw, dict):
+        raise PolicyError([f"the policy must be a JSON object, got {json.dumps(raw)}"])
+    problems = _unknown_keys(raw, POLICY_KEYS, "policy")
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if "snapshot_dir" not in raw:
+        problems.append('policy: missing "snapshot_dir"')
+    elif not isinstance(snapshot_dir, str) or not snapshot_dir:
+        problems.append(
+            f'policy: "snapshot_dir" must be a non-empty string, got {json.dumps(snapshot_dir)}'
+        )
+
+    dry_run = raw.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append(f'policy: "dry_run" must be true or false, got {json.dumps(dry_run)}')
+
+    raw_rules = raw.get("rules")
+    if "rules" not in raw:
+        problems.append('policy: missing "rules"')
+        raw_rules = []
+    elif not isinstance(raw_rules, list):
+        problems.append(f'policy: "rules" must be a list, got {json.dumps(raw_rules)}')
+        raw_rules = []
+
+    rules = {}  # position in the file -> Rule, so messages can point at the line to fix
+    for index, raw_rule in enumerate(raw_rules):
+        rule_problems = _rule_problems(raw_rule, f"rules[{index}]")
+        problems.extend(rule_problems)
+        if not rule_problems:
+            rules[index] = Rule(raw_rule["prefix"], raw_rule["keep"])
+    problems.extend(_overlapping_prefixes(rules))
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, tuple(rules.values()))
+
+
+def _rule_problems(raw_rule, where):
+    if not isinstance(raw_rule, dict):
+        return [f"{where}: a rule must be a JSON object, got {json.dumps(raw_rule)}"]
+    prefix = raw_rule.get("prefix")
+    if isinstance(prefix, str) and prefix:
+        where = f'{where} (prefix "{prefix}")'
+    problems = _unknown_keys(raw_rule, RULE_KEYS, where)
+
+    if "prefix" not in raw_rule:
+        problems.append(f'{where}: missing "prefix"')
+    elif not isinstance(prefix, str) or not prefix:
+        # An empty prefix would claim every snapshot in the directory.
+        problems.append(f'{where}: "prefix" must be a non-empty string, got {json.dumps(prefix)}')
+
+    keep = raw_rule.get("keep")
+    if "keep" not in raw_rule:
+        problems.append(f'{where}: missing "keep"')
+    elif isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+        # A negative keep would slice from the wrong end and delete the newest snapshots.
+        problems.append(
+            f'{where}: "keep" must be a whole number, 0 or more, got {json.dumps(keep)}'
+        )
+    return problems
+
+
+def _unknown_keys(raw, known, where):
+    problems = []
+    for key in raw:
+        if key not in known:
+            guess = difflib.get_close_matches(key, known, n=1)
+            hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    return problems
+
+
+def _overlapping_prefixes(rules):
+    """Each snapshot must belong to exactly one rule, so no prefix may start another."""
+    return [
+        f'rules[{i}] (prefix "{a.prefix}") and rules[{j}] (prefix "{b.prefix}") '
+        "claim the same snapshots"
+        for i, a in rules.items()
+        for j, b in rules.items()
+        if i < j and (a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix))
+    ]
