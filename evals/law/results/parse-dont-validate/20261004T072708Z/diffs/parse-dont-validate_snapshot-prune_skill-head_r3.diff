diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..200bdf3
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,89 @@
+"""Run with: python3 -m unittest"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name)
+        self.snapshots = self.dir / "snapshots"
+        self.snapshots.mkdir()
+        for family in ("db-", "logs-"):
+            for day in range(1, 6):
+                (self.snapshots / f"{family}2026-09-0{day}.tar").touch()
+
+    def run_prune(self, **policy):
+        policy.setdefault("snapshot_dir", str(self.snapshots))
+        path = self.dir / "policy.json"
+        path.write_text(json.dumps(policy))
+        err = io.StringIO()
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err):
+            status = prune.main(["prune.py", str(path)])
+        return status, err.getvalue()
+
+    def remaining(self):
+        return sorted(p.name for p in self.snapshots.iterdir())
+
+    def assert_rejected_untouched(self, expected_message, **policy):
+        before = self.remaining()
+        status, err = self.run_prune(**policy)
+        self.assertEqual(status, 1)
+        self.assertIn(expected_message, err)
+        self.assertEqual(self.remaining(), before)
+
+    def test_keeps_newest(self):
+        status, _ = self.run_prune(rules=[{"prefix": "db-", "keep": 2}])
+        self.assertEqual(status, 0)
+        self.assertEqual(
+            self.remaining(),
+            ["db-2026-09-04.tar", "db-2026-09-05.tar"] + [f"logs-2026-09-0{d}.tar" for d in range(1, 6)],
+        )
+
+    def test_dry_run_deletes_nothing(self):
+        before = self.remaining()
+        status, _ = self.run_prune(dry_run=True, rules=[{"prefix": "db-", "keep": 2}])
+        self.assertEqual(status, 0)
+        self.assertEqual(self.remaining(), before)
+
+    def test_typo_in_a_later_rule_stops_earlier_rules_too(self):
+        self.assert_rejected_untouched(
+            'rules[1]: unknown key "kepe" (did you mean "keep"?)',
+            rules=[{"prefix": "db-", "keep": 2}, {"prefix": "logs-", "kepe": 4}],
+        )
+
+    def test_every_problem_is_reported_at_once(self):
+        status, err = self.run_prune(
+            dry_run="no", rules=[{"prefix": "", "keep": "3"}, {"prefix": "logs-", "keep": -1}]
+        )
+        self.assertEqual(status, 1)
+        for message in ('"dry_run" must be', '"prefix" must not be empty', '"keep" must be an integer', "0 or more"):
+            self.assertIn(message, err)
+
+    def test_overlapping_prefixes(self):
+        self.assert_rejected_untouched(
+            "overlap", rules=[{"prefix": "db-", "keep": 2}, {"prefix": "d", "keep": 1}]
+        )
+
+    def test_missing_snapshot_dir(self):
+        self.assert_rejected_untouched(
+            "is not a directory", snapshot_dir=str(self.dir / "snapshotz"), rules=[{"prefix": "db-", "keep": 2}]
+        )
+
+    def test_invalid_json(self):
+        path = self.dir / "policy.json"
+        path.write_text("{not json")
+        with contextlib.redirect_stderr(io.StringIO()) as err:
+            self.assertEqual(prune.main(["prune.py", str(path)]), 1)
+        self.assertIn("not valid JSON", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
