+"""Parse a retention policy file into a Policy, or report everything wrong with it."""
+import difflib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class PolicyError(Exception):
+    """The policy cannot be acted on; `problems` lists every reason found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple
+
+
+_REQUIRED = object()
+_JSON_NAMES = {str: "a string", int: "an integer", bool: "true or false", list: "a list"}
+
+# name -> (JSON type, default)
+_POLICY_FIELDS = {"snapshot_dir": (str, _REQUIRED), "dry_run": (bool, False), "rules": (list, _REQUIRED)}
+_RULE_FIELDS = {"prefix": (str, _REQUIRED), "keep": (int, _REQUIRED)}
+
+
+def load(path):
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise PolicyError([f"cannot read {path}: {e.strerror}"]) from e
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"{path} is not valid JSON: {e}"]) from e
+    return parse(raw)
+
+
+# [LAW:parse-dont-validate] the only place a policy is checked; everything
+# downstream takes a Policy and never re-checks.
+def parse(raw):
+    problems = []
+    fields = _fields(raw, "policy", _POLICY_FIELDS, problems)
+    rules = tuple(
+        rule
+        for i, raw_rule in enumerate(fields.get("rules", []))
+        if (rule := _rule(raw_rule, f"rules[{i}]", problems)) is not None
+    )
+    problems += _overlaps(rules)
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(fields["snapshot_dir"]), fields["dry_run"], rules)
+
+
+def _rule(raw, where, problems):
+    before = len(problems)
+    fields = _fields(raw, where, _RULE_FIELDS, problems)
+    prefix, keep = fields.get("prefix"), fields.get("keep")
+    # An empty prefix would claim every snapshot in the directory.
+    if prefix == "":
+        problems.append(f'{where}: "prefix" must not be empty')
+    if prefix is not None and ("/" in prefix or "\\" in prefix):
+        problems.append(f'{where}: "prefix" must not contain a path separator')
+    if keep is not None and keep < 0:
+        problems.append(f'{where}: "keep" must be 0 or more, got {keep}')
+    return Rule(prefix, keep) if len(problems) == before else None
+
+
+def _fields(raw, where, spec, problems):
+    """The correctly-typed fields of `raw`; anything else becomes a problem."""
+    if type(raw) is not dict:
+        problems.append(f"{where}: must be an object")
+        return {}
+    for key in raw.keys() - spec.keys():
+        close = difflib.get_close_matches(key, spec.keys(), n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    fields = {}
+    for name, (json_type, default) in spec.items():
+        value = raw.get(name, default)
+        if value is _REQUIRED:
+            problems.append(f'{where}: missing "{name}"')
+        elif type(value) is not json_type:  # exact: JSON true is not an integer
+            problems.append(f'{where}: "{name}" must be {_JSON_NAMES[json_type]}, got {json.dumps(value)}')
+        else:
+            fields[name] = value
+    return fields
+
+
+def _overlaps(rules):
+    """Each snapshot must belong to exactly one rule, or two `keep`s fight over it."""
+    return [
+        f'rules: prefixes "{a.prefix}" and "{b.prefix}" overlap, so the same snapshots would belong to both'
+        for i, a in enumerate(rules)
+        for b in rules[i + 1:]
+        if a.prefix.startswith(b.prefix) or b.prefix.startswith(a.prefix)
+    ]
