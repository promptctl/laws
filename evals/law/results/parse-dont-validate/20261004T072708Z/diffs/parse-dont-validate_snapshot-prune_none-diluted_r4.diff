diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..994df17 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,101 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = ("snapshot_dir", "dry_run", "rules")
+RULE_KEYS = ("prefix", "keep")
+
+
+class PolicyError(ValueError):
+    """The policy cannot be applied; `problems` lists every reason found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy first, so a bad one deletes nothing at all."""
+    problems = check(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def check(policy):
+    """Every problem with the policy, as messages; empty if it is safe to apply."""
+    if not isinstance(policy, dict):
+        return ["the policy must be a JSON object"]
+    problems = _key_problems(policy, POLICY_KEYS, ("snapshot_dir", "rules"), "policy")
+
+    if "snapshot_dir" in policy:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append('policy: "snapshot_dir" must be a non-empty string')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'policy: "snapshot_dir" {snapshot_dir!r} is not a directory')
+
+    if not isinstance(policy.get("dry_run", False), bool):
+        problems.append('policy: "dry_run" must be true or false')
+
+    if "rules" in policy:
+        rules = policy["rules"]
+        if isinstance(rules, list):
+            problems += _rules_problems(rules)
+        else:
+            problems.append('policy: "rules" must be a list')
+    return problems
+
+
+def _rules_problems(rules):
+    problems = []
+    prefixes = []
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where}: must be a JSON object")
+            continue
+        prefix = rule.get("prefix")
+        if isinstance(prefix, str):
+            where += f' (prefix "{prefix}")'
+        problems += _key_problems(rule, RULE_KEYS, RULE_KEYS, where)
+
+        if "prefix" in rule:
+            if not isinstance(prefix, str) or not prefix:
+                problems.append(f'{where}: "prefix" must be a non-empty string')
+            elif any(c in prefix for c in "*?[]/\\"):
+                problems.append(f'{where}: "prefix" must not contain any of * ? [ ] / \\')
+            else:
+                # A snapshot matched by two rules would be deleted by one of
+                # them even when the other says to keep it.
+                for j, other in prefixes:
+                    if prefix.startswith(other) or other.startswith(prefix):
+                        problems.append(
+                            f'{where}: matches the same files as rules[{j}] (prefix "{other}")')
+                prefixes.append((i, prefix))
+
+        if "keep" in rule:
+            keep = rule["keep"]
+            if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+                problems.append(f'{where}: "keep" must be a whole number, 0 or more')
+    return problems
+
+
+def _key_problems(obj, known, required, where):
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = difflib.get_close_matches(key, known, n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    for key in required:
+        if key not in obj:
+            problems.append(f'{where}: missing "{key}"')
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
