 """Delete the snapshots a retention policy no longer keeps."""
+import json
+from dataclasses import dataclass
+from difflib import get_close_matches
 from pathlib import Path
 
 
+class PolicyError(ValueError):
+    """The policy is unusable; `problems` lists every mistake found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+_MISSING = object()
+
+
+def _is_str(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is an int subclass: `"keep": true` must not mean keep 1.
+    return isinstance(value, int) and not isinstance(value, bool) and value >= 0
+
+
+def _unknown_keys(obj, known, where):
+    for key in sorted(obj.keys() - known):
+        close = get_close_matches(key, known, n=1)
+        hint = f' (did you mean "{close[0]}"?)' if close else ""
+        yield f'{where}: unknown key "{key}"{hint}'
+
+
+def _field(obj, key, where, ok, expected, problems, default=_MISSING):
+    if key not in obj:
+        if default is _MISSING:
+            problems.append(f'{where}: missing "{key}"')
+        return default
+    value = obj[key]
+    if not ok(value):
+        problems.append(f'{where}: "{key}" must be {expected}, got {json.dumps(value)}')
+    return value
+
+
+# [LAW:parse-dont-validate] The one place raw JSON becomes a Policy. Everything
+# that deletes takes a Policy, so a malformed rule cannot reach an unlink.
+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError listing every mistake."""
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy: must be a JSON object"])
+    problems = list(_unknown_keys(raw, {"snapshot_dir", "dry_run", "rules"}, "policy"))
+    snapshot_dir = _field(raw, "snapshot_dir", "policy", _is_str, "a non-empty string", problems)
+    dry_run = _field(raw, "dry_run", "policy", lambda v: isinstance(v, bool),
+                     "true or false", problems, default=False)
+    raw_rules = _field(raw, "rules", "policy", lambda v: isinstance(v, list), "a list", problems)
+
+    rules = []
+    for i, raw_rule in enumerate(raw_rules if isinstance(raw_rules, list) else []):
+        where = f"rules[{i}]"
+        if not isinstance(raw_rule, dict):
+            problems.append(f"{where}: must be a JSON object, got {json.dumps(raw_rule)}")
+            continue
+        problems.extend(_unknown_keys(raw_rule, {"prefix", "keep"}, where))
+        prefix = _field(raw_rule, "prefix", where, _is_str, "a non-empty string", problems)
+        keep = _field(raw_rule, "keep", where, _is_count, "a whole number, 0 or more", problems)
+        # A snapshot must belong to exactly one rule, so no prefix may extend another.
+        for j, earlier in enumerate(rules):
+            if _is_str(prefix) and _is_str(earlier.prefix) and (
+                    prefix.startswith(earlier.prefix) or earlier.prefix.startswith(prefix)):
+                problems.append(f'{where}: prefix "{prefix}" overlaps rules[{j}] prefix '
+                                f'"{earlier.prefix}", so a snapshot would fall under both')
+        rules.append(Rule(prefix, keep))
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(Path(snapshot_dir), dry_run, tuple(rules))
+
+
