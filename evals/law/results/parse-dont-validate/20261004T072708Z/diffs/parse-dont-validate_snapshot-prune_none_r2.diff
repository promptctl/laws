diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..67bdcdf 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,106 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+# A prefix is a literal start of a file name: nothing that globs or leaves the directory.
+PREFIX_FORBIDDEN = set("*?[]/\\")
+
+
+class PolicyError(ValueError):
+    """The policy is not safe to act on. `problems` lists every mistake found."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy, then prune. Raises PolicyError before deleting anything."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Return a description of every mistake in the policy; empty if it is usable."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = _key_problems(policy, POLICY_KEYS, required={"snapshot_dir", "rules"}, where="policy")
+
+    if "snapshot_dir" in policy:
+        snapshot_dir = policy["snapshot_dir"]
+        if not isinstance(snapshot_dir, str) or not snapshot_dir:
+            problems.append(f'"snapshot_dir" must be a non-empty string, got {snapshot_dir!r}')
+        elif not Path(snapshot_dir).is_dir():
+            problems.append(f'"snapshot_dir" {snapshot_dir!r} is not an existing directory')
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append(f'"dry_run" must be true or false, got {policy["dry_run"]!r}')
+
+    if "rules" in policy:
+        rules = policy["rules"]
+        if not isinstance(rules, list):
+            problems.append(f'"rules" must be a list, got {rules!r}')
+        else:
+            problems.extend(_rules_problems(rules))
+    return problems
+
+
+def _rules_problems(rules):
+    problems = []
+    prefixes = []  # (where, prefix) of each well-formed prefix, to check for overlaps
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where} must be an object, got {rule!r}")
+            continue
+        if isinstance(rule.get("prefix"), str):
+            where += f' (prefix "{rule["prefix"]}")'
+        problems.extend(_key_problems(rule, RULE_KEYS, required=RULE_KEYS, where=where))
+
+        if "prefix" in rule:
+            prefix = rule["prefix"]
+            if not isinstance(prefix, str) or not prefix:
+                problems.append(f'{where}: "prefix" must be a non-empty string, got {prefix!r}')
+            elif PREFIX_FORBIDDEN & set(prefix):
+                problems.append(f'{where}: "prefix" must not contain any of * ? [ ] / \\')
+            else:
+                prefixes.append((where, prefix))
+
+        if "keep" in rule:
+            keep = rule["keep"]
+            # bool is an int in Python; a negative keep would slice off the *newest* snapshots
+            if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+                problems.append(f'{where}: "keep" must be a whole number >= 0, got {keep!r}')
+
+    for n, (where, prefix) in enumerate(prefixes):
+        for other_where, other in prefixes[:n]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(
+                    f"{where}: overlaps {other_where}, so some snapshots would belong to both rules"
+                )
+    return problems
+
+
+def _key_problems(obj, allowed, required, where):
+    problems = []
+    missing = [key for key in sorted(required) if key not in obj]
+    for key in obj:
+        if key in allowed:
+            continue
+        guess = difflib.get_close_matches(key, sorted(allowed), n=1)
+        hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+        problems.append(f'{where}: unknown key "{key}"{hint}')
+    for key in missing:
+        problems.append(f'{where}: missing "{key}"')
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
