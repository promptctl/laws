+class BadDay(ValueError):
+    """The request's `day` parameter is missing or is not a calendar date; the message says why."""
+
+
+# [LAW:parse-dont-validate] The query string becomes a date here, once; trips.py only ever sees a date.
+def parse_day(query_string):
+    values = parse_qs(query_string).get("day")
+    if not values:
+        raise BadDay("day is required, formatted YYYY-MM-DD (e.g. day=2026-09-14)")
+    raw = values[0]
+    # date.fromisoformat also takes 20260914 and 2026-W38-1; the API's contract is YYYY-MM-DD only.
+    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", raw, re.ASCII):
+        raise BadDay(f"day={raw!r} is not formatted YYYY-MM-DD (e.g. day=2026-09-14)")
+    try:
+        return date.fromisoformat(raw)
+    except ValueError as e:
+        raise BadDay(f"day={raw!r} is not a real calendar date: {e}") from e
+
+
