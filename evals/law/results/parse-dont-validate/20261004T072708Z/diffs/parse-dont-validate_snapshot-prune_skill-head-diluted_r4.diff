+"""Parse the JSON of a retention policy file into a Policy.
+
+A Policy only exists if the whole file is well formed, so anything that takes one
+(retention.apply) can delete without re-checking it.
+"""
+import difflib
+import itertools
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class PolicyError(ValueError):
+    """Everything wrong with a policy file, one problem per line."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+_REQUIRED = object()
+
+# key -> (is the value legal?, what a legal value is, default)
+_POLICY_KEYS = {
+    "snapshot_dir": (lambda v: isinstance(v, str) and v != "", "a non-empty string", _REQUIRED),
+    "dry_run": (lambda v: isinstance(v, bool), "true or false", False),
+    "rules": (lambda v: isinstance(v, list), "a list of rules", _REQUIRED),
+}
+_RULE_KEYS = {
+    # An empty prefix would claim every .tar file in the directory.
+    "prefix": (lambda v: isinstance(v, str) and v != "", "a non-empty string", _REQUIRED),
+    # bool is an int in Python; `"keep": true` is not a count.
+    "keep": (lambda v: type(v) is int and v >= 0, "a non-negative integer", _REQUIRED),
+}
+
+
+def _read(raw, where, keys):
+    """Check one JSON object against its legal keys; return (legal values, problems)."""
+    if not isinstance(raw, dict):
+        return {}, [f"{where}: must be an object, got {raw!r}"]
+    problems = []
+    # Unknown keys are errors, not noise: a misspelt "keep" or "dry_run" changes what gets deleted.
+    for key in sorted(raw.keys() - keys.keys()):
+        guess = difflib.get_close_matches(key, sorted(keys.keys() - raw.keys()), n=1)
+        hint = f" (did you mean {guess[0]!r}?)" if guess else ""
+        problems.append(f"{where}: unknown key {key!r}{hint}")
+    values = {}
+    for key, (is_legal, legal, default) in keys.items():
+        value = raw.get(key, default)
+        if value is _REQUIRED:
+            problems.append(f"{where}: missing {key!r}")
+        elif not is_legal(value):
+            problems.append(f"{where}: {key!r} must be {legal}, got {value!r}")
+        else:
+            values[key] = value
+    return values, problems
+
+
+def parse(raw):
+    """Return the Policy described by decoded JSON, or raise PolicyError listing every problem."""
+    # [LAW:parse-dont-validate] the one checkpoint for policy files: it reports every
+    # problem at once and hands back a type that cannot hold a malformed rule.
+    top, problems = _read(raw, "policy", _POLICY_KEYS)
+    rules = []
+    for i, raw_rule in enumerate(top.get("rules", [])):
+        values, rule_problems = _read(raw_rule, f"rules[{i}]", _RULE_KEYS)
+        problems += rule_problems
+        rules.append(values)
+
+    prefixes = [(i, rule["prefix"]) for i, rule in enumerate(rules) if "prefix" in rule]
+    for (i, a), (j, b) in itertools.combinations(prefixes, 2):
+        if a.startswith(b) or b.startswith(a):
+            problems.append(
+                f"rules[{i}] and rules[{j}]: prefixes {a!r} and {b!r} overlap, "
+                "so the same snapshots would belong to both rules"
+            )
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(top["snapshot_dir"]),
+        dry_run=top["dry_run"],
+        rules=tuple(Rule(**rule) for rule in rules),
+    )
