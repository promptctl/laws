diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..3920d09
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,86 @@
+"""Run with: python3 -m unittest"""
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+GOOD = {
+    "snapshot_dir": "snapshots",
+    "rules": [{"prefix": "db-", "keep": 1}, {"prefix": "logs-", "keep": 2}],
+}
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.addCleanup(os.chdir, os.getcwd())
+        os.chdir(tmp.name)
+        Path("snapshots").mkdir()
+        for family in ("db-", "logs-"):
+            for day in (1, 2, 3):
+                Path(f"snapshots/{family}2026-09-0{day}.tar").touch()
+
+    def run_prune(self, policy):
+        """Return (exit status, stderr, snapshot names left behind)."""
+        text = policy if isinstance(policy, str) else json.dumps(policy)
+        Path("policy.json").write_text(text)
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(io.StringIO()):
+            status = prune.main(["prune.py", "policy.json"])
+        return status, err.getvalue(), sorted(p.name for p in Path("snapshots").iterdir())
+
+    def assert_rejected_untouched(self, policy, *expected):
+        status, err, left = self.run_prune(policy)
+        self.assertEqual(status, 1)
+        self.assertEqual(len(left), 6, "a rejected policy must not delete anything")
+        for text in expected:
+            self.assertIn(text, err)
+
+    def test_good_policy_keeps_the_newest(self):
+        status, err, left = self.run_prune(GOOD)
+        self.assertEqual((status, err), (0, ""))
+        self.assertEqual(left, ["db-2026-09-03.tar", "logs-2026-09-02.tar", "logs-2026-09-03.tar"])
+
+    def test_dry_run_deletes_nothing(self):
+        status, _, left = self.run_prune({**GOOD, "dry_run": True})
+        self.assertEqual((status, len(left)), (0, 6))
+
+    def test_misspelt_key_in_a_later_rule(self):
+        policy = {**GOOD, "rules": [GOOD["rules"][0], {"prefix": "logs-", "kepe": 2}]}
+        self.assert_rejected_untouched(policy, "rules[1]", "'kepe'", "did you mean 'keep'?")
+
+    def test_every_problem_is_reported_at_once(self):
+        policy = {"snapshot_dir": "snapshots", "dry_runn": True,
+                  "rules": [{"prefix": "", "keep": 1}, {"prefix": "db-", "keep": -1}, "logs-"]}
+        self.assert_rejected_untouched(policy, "'dry_runn'", "rules[0]", "rules[1]", "rules[2]")
+
+    def test_wrong_types(self):
+        for keep in ("3", 2.5, True, None):
+            policy = {**GOOD, "rules": [{"prefix": "db-", "keep": keep}]}
+            self.assert_rejected_untouched(policy, "'keep' must be a non-negative integer")
+        self.assert_rejected_untouched({**GOOD, "dry_run": "false"}, "'dry_run'")
+        self.assert_rejected_untouched([], "policy: must be an object")
+
+    def test_overlapping_prefixes(self):
+        policy = {**GOOD, "rules": [{"prefix": "db-", "keep": 3}, {"prefix": "db-2026", "keep": 1}]}
+        self.assert_rejected_untouched(policy, "overlap")
+
+    def test_missing_snapshot_dir(self):
+        self.assert_rejected_untouched({**GOOD, "snapshot_dir": "snapshot"}, "is not a directory")
+
+    def test_broken_json_and_missing_file(self):
+        self.assert_rejected_untouched('{"snapshot_dir": ', "not valid JSON")
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err):
+            self.assertEqual(prune.main(["prune.py", "nope.json"]), 1)
+        self.assertIn("cannot read the file", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
