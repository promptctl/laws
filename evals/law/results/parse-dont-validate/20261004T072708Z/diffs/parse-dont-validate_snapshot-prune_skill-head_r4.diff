+"""Parse a retention policy file into a Policy, or say everything that is wrong with it."""
+import difflib
+import json
+from dataclasses import dataclass
+
+
+class PolicyError(Exception):
+    """The policy file is not a usable policy. `problems` lists every mistake found."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: str
+    dry_run: bool
+    rules: tuple
+
+
+# [LAW:parse-dont-validate] The only way to get a Policy is through loads(), so
+# retention never sees a rule with a missing, misspelled or nonsensical field.
+def loads(text):
+    try:
+        raw = json.loads(text, object_pairs_hook=_unique_keys)
+    except json.JSONDecodeError as e:
+        raise PolicyError([f"not valid JSON: {e}"]) from e
+    problems = []
+    policy = _policy(raw, problems)
+    if problems:
+        raise PolicyError(problems)
+    return policy
+
+
+def _unique_keys(pairs):
+    # JSON silently lets a repeated key overwrite the earlier one.
+    keys = [key for key, _ in pairs]
+    repeated = sorted({key for key in keys if keys.count(key) > 1})
+    if repeated:
+        raise PolicyError([f"key {key!r} appears more than once in the same object" for key in repeated])
+    return dict(pairs)
+
+
+def _policy(raw, problems):
+    fields = _fields(raw, "policy", {"snapshot_dir", "rules"}, {"dry_run"}, problems)
+    snapshot_dir = fields.get("snapshot_dir", "x")
+    if not isinstance(snapshot_dir, str) or not snapshot_dir:
+        problems.append(f"snapshot_dir: must be a non-empty string, got {snapshot_dir!r}")
+    dry_run = fields.get("dry_run", False)
+    if not isinstance(dry_run, bool):
+        problems.append(f"dry_run: must be true or false, got {dry_run!r}")
+    raw_rules = fields.get("rules", [])
+    if not isinstance(raw_rules, list):
+        problems.append(f"rules: must be a list, got {raw_rules!r}")
+        raw_rules = []
+    rules = tuple(_rule(raw_rule, f"rules[{i}]", problems) for i, raw_rule in enumerate(raw_rules))
+    _check_disjoint(rules, problems)
+    return Policy(snapshot_dir, dry_run, rules)
+
+
+def _rule(raw, where, problems):
+    fields = _fields(raw, where, {"prefix", "keep"}, set(), problems)
+    prefix = fields.get("prefix", "x")
+    if not isinstance(prefix, str) or not prefix:
+        # An empty prefix would claim every snapshot in the directory.
+        problems.append(f"{where}.prefix: must be a non-empty string, got {prefix!r}")
+    keep = fields.get("keep", 0)
+    if isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+        # A negative keep would slice from the wrong end and delete the newest snapshots.
+        problems.append(f"{where}.keep: must be a whole number, 0 or more, got {keep!r}")
+    return Rule(prefix, keep)
+
+
+def _fields(raw, where, required, optional, problems):
+    """The object's fields, having reported any key that is unknown or missing."""
+    if not isinstance(raw, dict):
+        problems.append(f"{where}: must be an object, got {raw!r}")
+        return {}
+    allowed = required | optional
+    for key in raw.keys() - allowed:
+        guess = difflib.get_close_matches(key, sorted(allowed), n=1)
+        hint = f" (did you mean {guess[0]!r}?)" if guess else f" (allowed: {', '.join(sorted(allowed))})"
+        problems.append(f"{where}: unknown key {key!r}{hint}")
+    for key in sorted(required - raw.keys()):
+        problems.append(f"{where}: missing required key {key!r}")
+    return raw
+
+
+def _check_disjoint(rules, problems):
+    # If one prefix starts with another, a snapshot belongs to both rules and
+    # the smaller `keep` would delete what the other rule means to keep.
+    prefixes = [(i, rule.prefix) for i, rule in enumerate(rules) if isinstance(rule.prefix, str) and rule.prefix]
+    for i, a in prefixes:
+        for j, b in prefixes:
+            if i < j and (a.startswith(b) or b.startswith(a)):
+                problems.append(f"rules[{i}] and rules[{j}]: prefixes {a!r} and {b!r} match the same snapshots")
