-            path.unlink()
-            print(f"deleted {path}")
+def _plan_rule(rule, newest_first):
+    """Names end in an ISO date, so name order is age order."""
+    family = [p for p in newest_first if p.name.startswith(rule.prefix)]
+    return RulePlan(rule.prefix, tuple(family[:rule.keep]), tuple(family[rule.keep:]))
+
+
+def execute(plans, dry_run):
+    verb = "would delete" if dry_run else "deleted"
+    for rule_plan in plans:
+        for path in rule_plan.doomed:
+            if not dry_run:
+                path.unlink()
+            print(f"{verb} {path}")
+        # [LAW:nothing-unseen] A rule that matched nothing still reports, so a
+        # mistyped prefix shows up as "0 snapshots" instead of as silence.
+        total = len(rule_plan.kept) + len(rule_plan.doomed)
+        print(f"{rule_plan.prefix}: {total} snapshots, kept {len(rule_plan.kept)}, {verb} {len(rule_plan.doomed)}")
diff --git a/work/test_prune.py b/work/test_prune.py
new file mode 100644
index 0000000..eab4dd3
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,95 @@
+"""Run with: python3 -m unittest test_prune"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name)
+        self.snapshots = self.dir / "snapshots"
+        self.snapshots.mkdir()
+        for family in ("db-", "logs-"):
+            for day in range(1, 6):
+                (self.snapshots / f"{family}2026-09-0{day}.tar").touch()
+
+    def run_prune(self, policy):
+        policy_file = self.dir / "policy.json"
+        policy_file.write_text(policy if isinstance(policy, str) else json.dumps(policy))
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            status = prune.main(["prune.py", str(policy_file)])
+        return status, out.getvalue(), err.getvalue()
+
+    def remaining(self):
+        return sorted(p.name for p in self.snapshots.iterdir())
+
+    def policy(self, rules, **extra):
+        return {"snapshot_dir": str(self.snapshots), "rules": rules, **extra}
+
+    def assert_rejected_untouched(self, policy, *expected_in_stderr):
+        before = self.remaining()
+        status, _, err = self.run_prune(policy)
+        self.assertEqual(status, 1)
+        self.assertEqual(self.remaining(), before)
+        for text in expected_in_stderr:
+            self.assertIn(text, err)
+
+    def test_keeps_the_newest_of_each_family(self):
+        status, _, _ = self.run_prune(self.policy([{"prefix": "db-", "keep": 2}, {"prefix": "logs-", "keep": 4}]))
+        self.assertEqual(status, 0)
+        self.assertEqual(
+            self.remaining(),
+            ["db-2026-09-04.tar", "db-2026-09-05.tar"] + [f"logs-2026-09-0{d}.tar" for d in range(2, 6)],
+        )
+
+    def test_dry_run_deletes_nothing(self):
+        before = self.remaining()
+        status, out, _ = self.run_prune(self.policy([{"prefix": "db-", "keep": 2}], dry_run=True))
+        self.assertEqual(status, 0)
+        self.assertEqual(self.remaining(), before)
+        self.assertIn("would delete", out)
+
+    def test_misspelled_key_in_a_later_rule_stops_earlier_rules_too(self):
+        self.assert_rejected_untouched(
+            self.policy([{"prefix": "db-", "keep": 2}, {"prefix": "logs-", "kepe": 4}]),
+            "rules[1]: unknown key 'kepe' (did you mean 'keep'?)",
+            "rules[1]: missing required key 'keep'",
+        )
+
+    def test_every_mistake_is_reported_at_once(self):
+        self.assert_rejected_untouched(
+            self.policy([{"prefix": "db-", "keep": -1}, {"prefix": "", "keep": "4"}], dry_runn=True),
+            "unknown key 'dry_runn'",
+            "rules[0].keep",
+            "rules[1].prefix",
+            "rules[1].keep",
+        )
+
+    def test_overlapping_prefixes_are_rejected(self):
+        self.assert_rejected_untouched(
+            self.policy([{"prefix": "db-", "keep": 2}, {"prefix": "db-2026", "keep": 4}]),
+            "match the same snapshots",
+        )
+
+    def test_repeated_key_is_rejected(self):
+        text = json.dumps(self.policy([])).replace('"rules": []', '"rules": [{"prefix": "db-", "keep": 4, "keep": 1}]')
+        self.assert_rejected_untouched(text, "'keep' appears more than once")
+
+    def test_invalid_json_is_rejected(self):
+        self.assert_rejected_untouched("{not json", "not valid JSON")
+
+    def test_missing_snapshot_dir_is_rejected(self):
+        policy = {"snapshot_dir": str(self.dir / "snapshot"), "rules": [{"prefix": "db-", "keep": 2}]}
+        self.assert_rejected_untouched(policy, "cannot read snapshot directory")
+
+
+if __name__ == "__main__":
+    unittest.main()
