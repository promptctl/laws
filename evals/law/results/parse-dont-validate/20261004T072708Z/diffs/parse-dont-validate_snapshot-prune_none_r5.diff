diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..5154a46 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,106 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = ("snapshot_dir", "dry_run", "rules")
+RULE_KEYS = ("prefix", "keep")
+
+
+class PolicyError(ValueError):
+    """The policy is wrong; `problems` lists everything found, one line each."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Validate the whole policy first, so a bad rule never leaves a half-done prune."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Return every problem in the policy as a list of messages (empty if it is fine)."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = _unknown_keys(policy, POLICY_KEYS, "policy")
+
+    if "snapshot_dir" not in policy:
+        problems.append("policy: missing 'snapshot_dir'")
+    elif not isinstance(policy["snapshot_dir"], str) or not policy["snapshot_dir"]:
+        problems.append("policy: 'snapshot_dir' must be a non-empty string")
+    elif not Path(policy["snapshot_dir"]).is_dir():
+        problems.append(
+            f"policy: snapshot_dir {policy['snapshot_dir']!r} is not an existing directory"
+        )
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append("policy: 'dry_run' must be true or false")
+
+    if "rules" not in policy:
+        problems.append("policy: missing 'rules'")
+    elif not isinstance(policy["rules"], list):
+        problems.append("policy: 'rules' must be a list")
+    else:
+        problems += _validate_rules(policy["rules"])
+    return problems
+
+
+def _validate_rules(rules):
+    problems = []
+    prefixes = []  # (label, prefix) of the rules whose prefix is usable
+    for i, rule in enumerate(rules, start=1):
+        if not isinstance(rule, dict):
+            problems.append(f"rule {i}: must be a JSON object")
+            continue
+        prefix = rule.get("prefix")
+        label = f"rule {i} ({prefix!r})" if isinstance(prefix, str) else f"rule {i}"
+        problems += _unknown_keys(rule, RULE_KEYS, label)
+
+        if "prefix" not in rule:
+            problems.append(f"{label}: missing 'prefix'")
+        elif not isinstance(prefix, str) or not prefix:
+            problems.append(f"{label}: 'prefix' must be a non-empty string")
+        elif any(c in prefix for c in "*?[]/\\"):
+            # The prefix is used in a glob, where these would match other families.
+            problems.append(f"{label}: 'prefix' must not contain any of * ? [ ] / \\")
+        else:
+            prefixes.append((label, prefix))
+
+        keep = rule.get("keep")
+        if "keep" not in rule:
+            problems.append(f"{label}: missing 'keep'")
+        elif isinstance(keep, bool) or not isinstance(keep, int) or keep < 0:
+            problems.append(f"{label}: 'keep' must be a whole number >= 0, got {keep!r}")
+
+    # A snapshot matched by two rules would be pruned by whichever keeps fewer.
+    for n, (label, prefix) in enumerate(prefixes):
+        for other_label, other in prefixes[n + 1:]:
+            if prefix.startswith(other) or other.startswith(prefix):
+                problems.append(
+                    f"{other_label}: prefix overlaps with {label}, "
+                    "so the same snapshots would match both rules"
+                )
+    return problems
+
+
+def _unknown_keys(obj, known, label):
+    problems = []
+    for key in obj:
+        if key in known:
+            continue
+        missing = [k for k in known if k not in obj]
+        close = difflib.get_close_matches(str(key), missing, n=1)
+        hint = f" (did you mean {close[0]!r}?)" if close else ""
+        problems.append(f"{label}: unknown key {key!r}{hint}")
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
