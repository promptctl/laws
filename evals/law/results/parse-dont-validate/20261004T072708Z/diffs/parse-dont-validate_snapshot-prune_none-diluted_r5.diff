diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..3b0e911 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,13 +1,97 @@
 """Delete the snapshots a retention policy no longer keeps."""
+import difflib
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(ValueError):
+    """The policy is unusable; `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
 
 def apply(policy):
+    """Check the whole policy first, so a bad rule can't leave a half-done prune."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
 
 
+def validate(policy):
+    """Return a list of problems with the policy; empty if it is safe to apply."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = _unknown_keys(policy, POLICY_KEYS, "policy")
+
+    if "snapshot_dir" not in policy:
+        problems.append('policy: missing "snapshot_dir"')
+    elif not isinstance(policy["snapshot_dir"], str) or not policy["snapshot_dir"]:
+        problems.append('policy: "snapshot_dir" must be a non-empty string')
+    elif not Path(policy["snapshot_dir"]).is_dir():
+        problems.append(
+            f'policy: "snapshot_dir" {policy["snapshot_dir"]!r} is not a directory')
+
+    if not isinstance(policy.get("dry_run", False), bool):
+        problems.append('policy: "dry_run" must be true or false')
+
+    if "rules" not in policy:
+        problems.append('policy: missing "rules"')
+    elif not isinstance(policy["rules"], list):
+        problems.append('policy: "rules" must be a list')
+    else:
+        prefixes = []
+        for i, rule in enumerate(policy["rules"]):
+            problems.extend(_validate_rule(rule, f"rules[{i}]", prefixes))
+    return problems
+
+
+def _validate_rule(rule, where, prefixes):
+    if not isinstance(rule, dict):
+        return [f"{where}: must be a JSON object"]
+    if isinstance(rule.get("prefix"), str):
+        where = f'{where} (prefix "{rule["prefix"]}")'
+    problems = _unknown_keys(rule, RULE_KEYS, where)
+
+    if "prefix" not in rule:
+        problems.append(f'{where}: missing "prefix"')
+    elif not isinstance(rule["prefix"], str) or not rule["prefix"]:
+        # An empty prefix would match every snapshot in the directory.
+        problems.append(f'{where}: "prefix" must be a non-empty string')
+    elif any(c in rule["prefix"] for c in "*?[]/\\"):
+        problems.append(f'{where}: "prefix" must not contain any of * ? [ ] / \\')
+    else:
+        for other in prefixes:
+            if other.startswith(rule["prefix"]) or rule["prefix"].startswith(other):
+                problems.append(
+                    f'{where}: overlaps the rule for prefix "{other}", '
+                    "so some snapshots would belong to both")
+        prefixes.append(rule["prefix"])
+
+    if "keep" not in rule:
+        problems.append(f'{where}: missing "keep"')
+    elif type(rule["keep"]) is not int or rule["keep"] < 0:
+        # A negative keep would slice from the wrong end and delete the newest.
+        problems.append(f'{where}: "keep" must be a whole number, 0 or more')
+    return problems
+
+
+def _unknown_keys(obj, known, where):
+    problems = []
+    for key in obj:
+        if key not in known:
+            close = difflib.get_close_matches(str(key), sorted(known), n=1)
+            hint = f' (did you mean "{close[0]}"?)' if close else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    return problems
+
+
 def snapshots(root, prefix):
     """Newest first: names end in an ISO date, so name order is age order."""
     return sorted(root.glob(f"{prefix}*.tar"), reverse=True)
