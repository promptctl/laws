index 0000000..03deea4
--- /dev/null
+++ b/work/test_prune.py
@@ -0,0 +1,97 @@
+"""Run with: python3 -m unittest test_prune"""
+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import prune
+import retention
+
+DAYS = [f"2026-09-0{d}" for d in range(1, 7)]
+
+
+class PruneTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.dir = Path(tmp.name)
+        self.snapshot_dir = self.dir / "snapshots"
+        self.snapshot_dir.mkdir()
+        for family in ("db-", "media-", "logs-"):
+            for day in DAYS:
+                (self.snapshot_dir / f"{family}{day}.tar").touch()
+
+    def names(self):
+        return sorted(p.name for p in self.snapshot_dir.iterdir())
+
+    def run_prune(self, policy):
+        """Return (exit status, stderr) of prune.py run on `policy`."""
+        policy_file = self.dir / "policy.json"
+        policy_file.write_text(policy if isinstance(policy, str) else json.dumps(policy))
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(io.StringIO()):
+            status = prune.main(["prune.py", str(policy_file)])
+        return status, err.getvalue()
+
+    def policy(self, rules, **extra):
+        return {"snapshot_dir": str(self.snapshot_dir), "rules": rules, **extra}
+
+    def test_valid_policy_keeps_the_newest(self):
+        status, _ = self.run_prune(self.policy([{"prefix": "db-", "keep": 2}]))
+        self.assertEqual(status, 0)
+        self.assertEqual([n for n in self.names() if n.startswith("db-")],
+                         ["db-2026-09-05.tar", "db-2026-09-06.tar"])
+        self.assertEqual(len(self.names()), 14)
+
+    def test_dry_run_deletes_nothing(self):
+        status, _ = self.run_prune(self.policy([{"prefix": "db-", "keep": 2}], dry_run=True))
+        self.assertEqual(status, 0)
+        self.assertEqual(len(self.names()), 18)
+
+    def test_mistake_in_a_later_rule_deletes_nothing(self):
+        before = self.names()
+        status, err = self.run_prune(self.policy([
+            {"prefix": "db-", "keep": 3},
+            {"prefix": "media-", "keep": 2},
+            {"prefix": "logs-", "kepe": 4},
+        ]))
+        self.assertEqual(status, 1)
+        self.assertEqual(self.names(), before)
+        self.assertIn("rule 3 ('logs-'): unknown key 'kepe' (did you mean 'keep'?)", err)
+        self.assertIn("rule 3 ('logs-'): missing 'keep'", err)
+
+    def test_every_rejected_policy_deletes_nothing(self):
+        good = {"prefix": "db-", "keep": 0}
+        rejected = {
+            "negative keep": self.policy([good, {"prefix": "logs-", "keep": -1}]),
+            "keep not a number": self.policy([good, {"prefix": "logs-", "keep": "4"}]),
+            "keep is a bool": self.policy([good, {"prefix": "logs-", "keep": True}]),
+            "empty prefix": self.policy([good, {"prefix": "", "keep": 1}]),
+            "overlapping prefixes": self.policy([good, {"prefix": "db-2026", "keep": 1}]),
+            "rule not an object": self.policy([good, "logs-"]),
+            "rules not a list": self.policy({"db-": 0}),
+            "dry_run not a bool": self.policy([good], dry_run="yes"),
+            "unknown top-level key": self.policy([good], dryrun=True),
+            "missing snapshot_dir": {"rules": [good]},
+            "snapshot_dir missing on disk": {"snapshot_dir": str(self.dir / "nope"), "rules": [good]},
+            "policy not an object": [good],
+            "not JSON": "{",
+        }
+        before = self.names()
+        for name, policy in rejected.items():
+            with self.subTest(name):
+                status, err = self.run_prune(policy)
+                self.assertEqual(status, 1)
+                self.assertIn("nothing deleted", err)
+                self.assertEqual(self.names(), before)
+
+    def test_all_problems_are_reported_together(self):
+        with self.assertRaises(retention.PolicyError) as caught:
+            retention.parse_policy({"rules": [{"prefix": "a-"}, {"keep": -1}]})
+        self.assertEqual(len(caught.exception.problems), 4)
+
+
+if __name__ == "__main__":
+    unittest.main()
