+class PolicyError(ValueError):
+    """The policy is malformed; `problems` lists every fault found, not just the first."""
+
+    def __init__(self, problems):
+        super().__init__("\n".join(problems))
+        self.problems = problems
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: Path
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+def _non_empty_string(value):
+    return isinstance(value, str) and value != ""
+
+
+# Field name -> (accepts, description of what is accepted).
+_POLICY_FIELDS = {
+    "snapshot_dir": (_non_empty_string, "a non-empty string"),
+    "rules": (lambda v: isinstance(v, list), "a list of rules"),
+    "dry_run": (lambda v: isinstance(v, bool), "true or false"),
+}
+_POLICY_DEFAULTS = {"dry_run": False}
+_RULE_FIELDS = {
+    "prefix": (_non_empty_string, "a non-empty string"),
+    # bool is an int in Python; a negative keep would slice from the wrong end
+    # and delete everything except the oldest snapshots.
+    "keep": (lambda v: type(v) is int and v >= 0, "a whole number, 0 or more"),
+}
+
+
+def _field_problems(where, raw, fields, defaults):
+    if not isinstance(raw, dict):
+        return [f"{where}: must be an object, got {raw!r}"]
+    problems = []
+    for key in sorted(raw.keys() - fields.keys()):
+        near = get_close_matches(key, fields.keys(), n=1)
+        hint = f" (did you mean {near[0]!r}?)" if near else ""
+        problems.append(f"{where}: unknown key {key!r}{hint}")
+    for name, (accepts, expected) in fields.items():
+        if name not in raw:
+            if name not in defaults:
+                problems.append(f"{where}: missing {name!r}")
+        elif not accepts(raw[name]):
+            problems.append(f"{where}: {name!r} must be {expected}, got {raw[name]!r}")
+    return problems
+
+
+def parse_policy(raw):
+    """Turn decoded policy JSON into a Policy, or raise PolicyError.
+
+    [LAW:parse-dont-validate] This is the only place a policy is checked.
+    apply() takes the Policy it returns, so no deletion can start from a
+    policy that has a mistake anywhere in it.
+    """
+    problems = _field_problems("policy", raw, _POLICY_FIELDS, _POLICY_DEFAULTS)
+    raw_rules = raw.get("rules") if isinstance(raw, dict) else None
+    labelled = []
+    for number, rule in enumerate(raw_rules if isinstance(raw_rules, list) else [], 1):
+        prefix = rule.get("prefix") if isinstance(rule, dict) else None
+        where = f"rule {number} ({prefix!r})" if isinstance(prefix, str) else f"rule {number}"
+        labelled.append((where, prefix))
+        problems += _field_problems(where, rule, _RULE_FIELDS, {})
+    if not problems:
+        # A snapshot matching two prefixes would be pruned by both rules.
+        for i, (where, prefix) in enumerate(labelled):
+            for other_where, other in labelled[:i]:
+                if prefix.startswith(other) or other.startswith(prefix):
+                    problems.append(f"{where}: prefix overlaps {other_where}")
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=Path(raw["snapshot_dir"]),
+        dry_run=raw.get("dry_run", _POLICY_DEFAULTS["dry_run"]),
+        rules=tuple(Rule(r["prefix"], r["keep"]) for r in raw_rules),
+    )
+
+
+def apply(policy: Policy):
+    for rule in policy.rules:
+        prune(policy.snapshot_dir, rule, policy.dry_run)
 
 
