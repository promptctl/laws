diff --git a/fixture/retention.py b/work/retention.py
index 1fe863f..4ef1e1c 100644
--- a/fixture/retention.py
+++ b/work/retention.py
@@ -1,8 +1,85 @@
 """Delete the snapshots a retention policy no longer keeps."""
 from pathlib import Path
 
+POLICY_KEYS = {"snapshot_dir", "dry_run", "rules"}
+RULE_KEYS = {"prefix", "keep"}
+
+
+class PolicyError(ValueError):
+    """The policy is unusable; `problems` lists everything wrong with it."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+def validate(policy):
+    """Return every problem found in the policy; an empty list means it is safe to apply."""
+    if not isinstance(policy, dict):
+        return ["policy must be a JSON object"]
+    problems = []
+
+    for key in sorted(policy.keys() - POLICY_KEYS):
+        problems.append(f"unknown key {key!r} (expected one of {sorted(POLICY_KEYS)})")
+
+    if "snapshot_dir" not in policy:
+        problems.append("missing 'snapshot_dir'")
+    elif not isinstance(policy["snapshot_dir"], str) or not policy["snapshot_dir"]:
+        problems.append("'snapshot_dir' must be a non-empty string")
+    elif not Path(policy["snapshot_dir"]).is_dir():
+        problems.append(f"'snapshot_dir' {policy['snapshot_dir']!r} is not a directory")
+
+    if "dry_run" in policy and not isinstance(policy["dry_run"], bool):
+        problems.append("'dry_run' must be true or false")
+
+    if "rules" not in policy:
+        problems.append("missing 'rules'")
+    elif not isinstance(policy["rules"], list):
+        problems.append("'rules' must be a list")
+    else:
+        prefixes = []
+        for i, rule in enumerate(policy["rules"]):
+            problems.extend(f"rules[{i}]: {p}" for p in validate_rule(rule))
+            if isinstance(rule, dict) and isinstance(rule.get("prefix"), str):
+                prefixes.append((i, rule["prefix"]))
+        # A file matching two rules would be pruned by whichever keeps fewer.
+        for n, (i, a) in enumerate(prefixes):
+            for j, b in prefixes[n + 1:]:
+                if a and b and (a.startswith(b) or b.startswith(a)):
+                    problems.append(
+                        f"rules[{i}] and rules[{j}]: prefixes {a!r} and {b!r} match the same files"
+                    )
+    return problems
+
+
+def validate_rule(rule):
+    if not isinstance(rule, dict):
+        return ["must be an object"]
+    problems = []
+    label = f" (prefix {rule['prefix']!r})" if isinstance(rule.get("prefix"), str) else ""
+
+    for key in sorted(rule.keys() - RULE_KEYS):
+        problems.append(f"unknown key {key!r}{label} (expected one of {sorted(RULE_KEYS)})")
+
+    if "prefix" not in rule:
+        problems.append("missing 'prefix'")
+    elif not isinstance(rule["prefix"], str) or not rule["prefix"]:
+        problems.append("'prefix' must be a non-empty string")
+    elif any(c in rule["prefix"] for c in "*?[]/\\"):
+        problems.append(f"'prefix' {rule['prefix']!r} must not contain wildcards or path separators")
+
+    if "keep" not in rule:
+        problems.append(f"missing 'keep'{label}")
+    elif isinstance(rule["keep"], bool) or not isinstance(rule["keep"], int) or rule["keep"] < 0:
+        problems.append(f"'keep' must be a non-negative integer, got {rule['keep']!r}{label}")
+    return problems
+
 
 def apply(policy):
+    """Validate the whole policy, then prune. Nothing is deleted if any part is invalid."""
+    problems = validate(policy)
+    if problems:
+        raise PolicyError(problems)
     root = Path(policy["snapshot_dir"])
     for rule in policy["rules"]:
         prune(root, rule, dry_run=policy.get("dry_run", False))
