+def bad_day(day):
+    """Return what's wrong with a `day` parameter, or None if it's a real YYYY-MM-DD date."""
+    if not day:
+        return "missing 'day' parameter; expected a date as YYYY-MM-DD"
+    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", day):
+        return f"bad day {day!r}: expected a date as YYYY-MM-DD"
+    try:
+        date.fromisoformat(day)
+    except ValueError as e:
+        return f"bad day {day!r}: no such date ({e})"
+    return None
