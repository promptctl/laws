@@ -0,0 +1,109 @@
+"""Parse the contents of a retention policy file into a Policy.
+
+A Policy can only be built from a file with no mistakes in it, so anything that
+takes a Policy can act on it without checking it again.
+"""
+from dataclasses import dataclass
+from difflib import get_close_matches
+
+
+@dataclass(frozen=True)
+class Rule:
+    prefix: str
+    keep: int
+
+
+@dataclass(frozen=True)
+class Policy:
+    snapshot_dir: str
+    dry_run: bool
+    rules: tuple[Rule, ...]
+
+
+class PolicyError(ValueError):
+    """Every mistake found in a policy file, one message per mistake."""
+
+    def __init__(self, problems):
+        super().__init__("; ".join(problems))
+        self.problems = problems
+
+
+POLICY_REQUIRED = ("snapshot_dir", "rules")
+POLICY_OPTIONAL = ("dry_run",)
+RULE_REQUIRED = ("prefix", "keep")
+
+
+# [LAW:parse-dont-validate] the one place a policy is checked; it returns a Policy or raises
+def parse(raw):
+    """Return the Policy described by `raw` (decoded JSON), or raise PolicyError."""
+    if not isinstance(raw, dict):
+        raise PolicyError(["policy: must be a JSON object"])
+
+    problems = _key_problems("policy", raw, POLICY_REQUIRED, POLICY_OPTIONAL)
+
+    snapshot_dir = raw.get("snapshot_dir")
+    if "snapshot_dir" in raw and not _is_nonempty_str(snapshot_dir):
+        problems.append('policy: "snapshot_dir" must be a non-empty string')
+
+    # A truthy non-bool such as "false" would otherwise decide whether files get deleted.
+    dry_run = raw.get("dry_run", False)
+    if type(dry_run) is not bool:
+        problems.append('policy: "dry_run" must be true or false')
+
+    rules = raw.get("rules")
+    if "rules" in raw:
+        problems += _rules_problems(rules)
+
+    if problems:
+        raise PolicyError(problems)
+    return Policy(
+        snapshot_dir=snapshot_dir,
+        dry_run=dry_run,
+        rules=tuple(Rule(prefix=r["prefix"], keep=r["keep"]) for r in rules),
+    )
+
+
+def _rules_problems(rules):
+    if not isinstance(rules, list):
+        return ['policy: "rules" must be a list']
+    problems = []
+    seen = set()
+    for i, rule in enumerate(rules):
+        where = f"rules[{i}]"
+        if not isinstance(rule, dict):
+            problems.append(f"{where}: must be a JSON object")
+            continue
+        prefix = rule.get("prefix")
+        if _is_nonempty_str(prefix):
+            where = f'{where} ("{prefix}")'
+            if prefix in seen:
+                problems.append(f"{where}: another rule already has this prefix")
+            seen.add(prefix)
+        elif "prefix" in rule:
+            # An empty prefix would match every snapshot in the directory.
+            problems.append(f'{where}: "prefix" must be a non-empty string')
+        problems += _key_problems(where, rule, RULE_REQUIRED, ())
+        # A negative keep would slice from the wrong end and delete the newest snapshots.
+        if "keep" in rule and not _is_count(rule["keep"]):
+            problems.append(f'{where}: "keep" must be a whole number, 0 or more')
+    return problems
+
+
+def _key_problems(where, obj, required, optional):
+    known = (*required, *optional)
+    problems = [f'{where}: missing "{key}"' for key in required if key not in obj]
+    for key in obj:
+        if key not in known:
+            guess = get_close_matches(key, known, n=1)
+            hint = f' (did you mean "{guess[0]}"?)' if guess else ""
+            problems.append(f'{where}: unknown key "{key}"{hint}')
+    return problems
+
+
+def _is_nonempty_str(value):
+    return isinstance(value, str) and value != ""
+
+
+def _is_count(value):
+    # bool is a subclass of int; `"keep": true` is not a count.
+    return type(value) is int and value >= 0
