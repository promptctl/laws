@@ -5,20 +5,51 @@ Usage: python3 prune.py <policy.json>
 The policy names the snapshot directory and one rule per snapshot family: every
 `<prefix>*.tar` file in the directory belongs to that rule, and the newest `keep`
 of them are kept. With "dry_run": true nothing is deleted, only listed.
+
+The whole policy is checked before anything is deleted. If it has a mistake in
+it, every mistake is listed on stderr and nothing is deleted.
+
+Exit status: 0 the policy was applied, 1 the policy could not be used,
+2 wrong command line.
 """
 import json
 import sys
+from pathlib import Path
 
+import policy
 import retention
 
 
+def load(path):
+    """Return the Policy in the file at `path`, or raise policy.PolicyError."""
+    try:
+        with open(path) as f:
+            raw = json.load(f)
+    except OSError as e:
+        raise policy.PolicyError([f"cannot read the file: {e.strerror}"]) from e
+    except json.JSONDecodeError as e:
+        raise policy.PolicyError([f"not valid JSON: {e}"]) from e
+    parsed = policy.parse(raw)
+    # A mistyped directory would match no snapshots and look like a clean run.
+    if not Path(parsed.snapshot_dir).is_dir():
+        raise policy.PolicyError(
+            [f'policy: "snapshot_dir" is not a directory: {parsed.snapshot_dir}']
+        )
+    return parsed
+
+
 def main(argv):
     if len(argv) != 2:
         print("usage: python3 prune.py <policy.json>", file=sys.stderr)
         return 2
-    with open(argv[1]) as f:
-        policy = json.load(f)
-    retention.apply(policy)
+    try:
+        parsed = load(argv[1])
+    except policy.PolicyError as e:
+        print(f"{argv[1]}: invalid policy, nothing was deleted:", file=sys.stderr)
+        for problem in e.problems:
+            print(f"  {problem}", file=sys.stderr)
+        return 1
+    retention.apply(parsed)
     return 0
 
 
