+def total_hours(entries):
+    return sum((e.hours for e in entries), Decimal("0"))
+
+
+def by_project(entries):
+    """Hours per project, biggest first; equal hours fall back to project name."""
+    projects = defaultdict(list)
+    for entry in entries:
+        projects[entry.project].append(entry)
+    hours = {project: total_hours(es) for project, es in projects.items()}
+    return dict(sorted(hours.items(), key=lambda item: (-item[1], item[0])))
+
