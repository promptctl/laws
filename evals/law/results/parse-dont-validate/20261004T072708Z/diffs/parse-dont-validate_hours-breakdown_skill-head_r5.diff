+def by_project(entries):
+    """Projects with their total hours, biggest first; equal totals order by name."""
+    projects = defaultdict(list)
+    for entry in entries:
+        projects[entry.project].append(entry)
+    totals = {project: total(project_entries) for project, project_entries in projects.items()}
+    return dict(sorted(totals.items(), key=lambda item: (-item[1], item[0])))
